    private string ExtractErrorMessage(string exceptionMessage)
    {
        try
        {
            // Try to extract message from "Details: {json}" pattern
            var detailsIndex = exceptionMessage.IndexOf("Details: {");
            if (detailsIndex >= 0)
            {
                var jsonStart = exceptionMessage.IndexOf('{', detailsIndex);
                var jsonEnd = exceptionMessage.LastIndexOf('}');
                if (jsonStart >= 0 && jsonEnd > jsonStart)
                {
                    var json = exceptionMessage.Substring(jsonStart, jsonEnd - jsonStart + 1);
                    
                    // Parse JSON to extract message field
                    var messagePattern = @"""message"":""([^""]+)""";
                    var match = System.Text.RegularExpressions.Regex.Match(json, messagePattern);
                    if (match.Success)
                    {
                        return match.Groups[1].Value;
                    }
                }
            }
            
            // Fallback: return original message if parsing fails
            return exceptionMessage;
        }
        catch
        {
            return exceptionMessage;
        }
    }

