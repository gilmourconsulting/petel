@page "/login"
@layout EmptyLayout
@inject ApiService ApiService
@inject TokenService TokenService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SessionStateService SessionState

<div class="login-container">
    <div class="logo">
        <img src="/images/petel_logo.png" alt="לוגו המערכת" />
    </div>
    <div class="spacer"></div>

    <div class="login-header">
        <h1 class="login-title">מערכת ניהול אגרות תלמידי חוץ</h1>
        @if (!string.IsNullOrEmpty(_environmentIndicator))
        {
            <div style="background: #ff9800; color: white; padding: 8px 16px; border-radius: 4px; font-weight: bold; margin: 10px auto; max-width: fit-content;">
                @_environmentIndicator
            </div>
        }
        <p class="login-subtitle">בחר את הארגון שלך ולאחר מכן הזן את פרטי ההתחברות</p>
    </div>

    <div class="step-indicator">
        <div class="step @(_currentStep >= 1 ? "active" : "") @(_currentStep > 1 ? "completed" : "")">
            <span class="step-number">1</span>
            <span>בחר ארגון</span>
        </div>
        <div class="step-divider"></div>
        <div class="step @(_currentStep >= 2 ? "active" : "") @(_currentStep > 2 ? "completed" : "")">
            <span class="step-number">2</span>
            <span>הזן פרטים</span>
        </div>
        <div class="step-divider"></div>
        <div class="step @(_currentStep >= 3 ? "active" : "")">
            <span class="step-number">3</span>
            <span>התחבר</span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-message" style="display: block;">
            @_errorMessage
        </div>
    }

    <div class="form-group">
        <label for="entity" class="form-label">מוסד חינוכי/עיריה/רשת</label>
        <div class="autocomplete-container">
            <input type="text" 
                   @ref="_entityInput"
                   class="autocomplete-input" 
                   placeholder="הזן לפחות 3 תווים לחיפוש..."
                   value="@_searchText"
                   @oninput="OnSearchTextChanged"
                   @onkeydown="HandleAutocompleteKeyDown"
                   @onfocus="OnAutocompleteFocus"
                   autocomplete="off" />
            <div class="autocomplete-arrow"></div>
            <div class="autocomplete-dropdown @(_showDropdown ? "show" : "")">
                @if (_filteredEntities.Count == 0 && _searchText.Length >= 3)
                {
                    <div class="autocomplete-no-results">לא נמצאו תוצאות</div>
                }
                else
                {
                    @for (int i = 0; i < _filteredEntities.Count; i++)
                    {
                        var entity = _filteredEntities[i];
                        var index = i;
                        <div class="autocomplete-option @(index == _selectedIndex ? "highlighted" : "") @(entity.Id == _selectedEntityId ? "selected" : "")"
                             @onclick="@(() => SelectEntity(entity))"
                             @onmouseenter="@(() => _selectedIndex = index)">
                            @entity.Name
                        </div>
                    }
                }
            </div>
        </div>
        <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
            בחר את הארגון שלך לפני הזנת פרטי ההתחברות
        </small>
    </div>

    <div class="credentials-section @(_currentStep >= 2 ? "show" : "")" style="@(_currentStep >= 2 ? "display: block;" : "display: none;")">
        <div class="form-group">
            <label for="username" class="form-label">שם משתמש</label>
            <input type="text" 
                   class="form-input" 
                   @bind="_username"
                   @onkeydown="HandleEnterKey"
                   autocomplete="username" />
        </div>

        <div class="form-group">
            <label for="password" class="form-label">סיסמה</label>
            <div style="position: relative;">
                <input type="@(_showPassword ? "text" : "password")" 
                       class="form-input" 
                       style="padding-left: 40px; direction: ltr; text-align: left;"
                       @bind="_password"
                       @onkeydown="HandleEnterKey"
                       autocomplete="current-password" />
                <button type="button"
                        @onclick="TogglePasswordVisibility"
                        title="@(_showPassword ? "הסתר סיסמה" : "הצג סיסמה")"
                        style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0; color: #666; display: flex; align-items: center;">
                    @if (_showPassword)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    }
                </button>
            </div>
        </div>
    </div>

    <button type="button" 
            class="login-button" 
            @onclick="HandleLogin" 
            disabled="@(_selectedEntityId == 0 || _isLoading)">
        @if (_isLoading)
        {
            <span>מתחבר...</span>
        }
        else if (_selectedEntityId == 0)
        {
            <span>בחר ישות תחילה</span>
        }
        else
        {
            <span>התחבר</span>
        }
    </button>

    @if (!string.IsNullOrEmpty(_errorMessage) && _selectedEntityId != 0 && !string.IsNullOrWhiteSpace(_username))
    {
        <div style="text-align: center; margin-top: 10px;">
            <button type="button" class="btn-link" @onclick="InitiateForgotPassword" disabled="@_isLoading"
                    style="font-size: 13px; color: #0066cc; background: none; border: none; cursor: pointer; text-decoration: underline;">
                שכחתי סיסמה
            </button>
        </div>
    }

    <!-- OTP Modal Overlay -->
    <div class="modal-overlay" style="display: @(_requiresOtp ? "flex" : "none");">
        <div class="modal-content otp-modal">
            <div class="modal-header">
                <h2>אימות באמצעות דוא"ל</h2>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_maskedEmail))
                {
                    <p style="margin-bottom: 16px; color: #555;">קוד אימות נשלח אל <strong>@_maskedEmail</strong></p>
                }
                @if (!string.IsNullOrEmpty(_otpErrorMessage))
                {
                    <div class="error-message" style="display: block; margin-bottom: 15px;">
                        @_otpErrorMessage
                    </div>
                }
                <div class="otp-input-container">
                    <input type="text" 
                           class="form-input" 
                           maxlength="6" 
                           @bind="_otpCode"
                           @bind:event="oninput"
                           @onkeydown="HandleOtpEnterKey"
                           @onkeydown:stopPropagation="true"
                           placeholder="הזן 6 ספרות" 
                           autocomplete="off" 
                           inputmode="numeric" />
                    <small>הזן את קוד האימות בן 6 הספרות שנשלח לדוא"ל שלך</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="CancelOtp">ביטול</button>
                <button type="button" class="btn-link" @onclick="ResendOtp" disabled="@_isLoading" style="margin-left: auto; margin-right: 8px;">שלח שוב</button>
                <button type="button" class="btn-primary" @onclick="HandleOtpVerification" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>מאמת...</span>
                    }
                    else
                    {
                        <span>אמת</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Password Change Modal -->
    <div class="modal-overlay" style="display: @(_requiresPasswordChange ? "flex" : "none");">
        <div class="modal-content" style="max-width: 420px; width: 90%;">
            <div class="modal-header">
                <h2>@(_isForgotPasswordFlow ? "איפוס סיסמה" : "שינוי סיסמה נדרש")</h2>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_passwordExpirationMessage))
                {
                    <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; color: #856404; font-size: 14px;">
                        @_passwordExpirationMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(_passwordChangeErrorMessage))
                {
                    <div class="error-message" style="display: block; margin-bottom: 15px; white-space: pre-line;">
                        @_passwordChangeErrorMessage
                    </div>
                }
                <div class="form-group">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">סיסמה חדשה: <span style="color: red;">*</span></label>
                    <div style="position: relative;">
                        <input type="@(_showNewPassword ? "text" : "password")"
                               class="form-input"
                               style="padding-left: 40px; direction: ltr; text-align: left;"
                               @bind="_newPassword"
                               @bind:event="oninput"
                               @onkeydown="HandleNewPasswordEnterKey"
                               @onkeydown:stopPropagation="true"
                               placeholder="מינימום 6 תווים"
                               autocomplete="new-password" />
                        <button type="button" @onclick="ToggleNewPasswordVisibility"
                                title="@(_showNewPassword ? "הסתר סיסמה" : "הצג סיסמה")"
                                style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0; color: #666; display: flex; align-items: center;">
                            @if (_showNewPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                    <small style="color: #6c757d; display: block; margin-top: 4px;">
                        @if (_passwordRequirements.Count > 0)
                        {
                            <span>דרישות: @string.Join(" | ", _passwordRequirements)</span>
                        }
                    </small>
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">אישור סיסמה חדשה: <span style="color: red;">*</span></label>
                    <div style="position: relative;">
                        <input type="@(_showConfirmPassword ? "text" : "password")"
                               class="form-input"
                               style="padding-left: 40px; direction: ltr; text-align: left;"
                               @bind="_confirmNewPassword"
                               @bind:event="oninput"
                               @onkeydown="HandleNewPasswordEnterKey"
                               @onkeydown:stopPropagation="true"
                               placeholder="חזור על הסיסמה החדשה"
                               autocomplete="new-password" />
                        <button type="button" @onclick="ToggleConfirmPasswordVisibility"
                                title="@(_showConfirmPassword ? "הסתר סיסמה" : "הצג סיסמה")"
                                style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; padding: 0; color: #666; display: flex; align-items: center;">
                            @if (_showConfirmPassword)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/>
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                    <circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="CancelPasswordChange">ביטול</button>
                <button type="button" class="btn-primary" @onclick="HandlePasswordChange" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>שומר...</span>
                    }
                    else
                    {
                        <span>שמור סיסמה</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="form-footer">
        @_systemVersion
    </div>
</div>

@code {
    [Inject] private ILogger<Login> _logger { get; set; } = default!;

    private ElementReference _entityInput;
    private string _searchText = "";
    private string _username = "";
    private string _password = "";
    private int _selectedEntityId = 0;
    private string _selectedEntityName = "";
    private string _errorMessage = "";
    private bool _isLoading = false;
    private List<EntityDto> _entities = new();
    private List<EntityDto> _filteredEntities = new();
    private bool _showDropdown = false;
    private int _selectedIndex = -1;
    private int _currentStep = 1;
    private string _systemVersion = "טוען...";
    private string _environmentIndicator = "";

    // System attributes (loaded once on page init)
    private List<SystemAttributeResponse> _allAttributes = new();
    private List<string> _passwordRequirements = new();

    private bool _showPassword = false;
    private bool _requiresOtp = false;
    private string _otpCode = "";
    private string? _tempToken;
    private string _otpErrorMessage = "";
    private string _maskedEmail = "";

    private bool _requiresPasswordChange = false;
    private bool _isForgotPasswordFlow = false;
    private string _passwordExpirationMessage = "";
    private string _newPassword = "";
    private string _confirmNewPassword = "";
    private bool _showNewPassword = false;
    private bool _showConfirmPassword = false;
    private string _passwordChangeErrorMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Clear any existing session on login page load
                await TokenService.ClearTokenAsync();
                SessionState.ClearSession();
                _logger.LogInformation("Cleared previous session on login page load");

                // Load all system attributes once — shared by version, env indicator, password policy
                await LoadAllAttributes();
                _logger.LogInformation("Loaded {Count} system attributes", _allAttributes.Count);
                
                // Load entities for the dropdown
                await LoadEntities();
                _logger.LogInformation("Loaded {Count} entities", _entities.Count);
                
                // Load system version
                LoadSystemVersion();
                _logger.LogInformation("System version loaded: {Version}", _systemVersion);
                
                // Load environment indicator
                LoadEnvironmentIndicator();
                _logger.LogInformation("Environment indicator loaded: {Env}", _environmentIndicator);

                // Load password policy from system attributes
                await LoadPasswordPolicy();
                _logger.LogInformation("Password policy loaded: {Count} requirements", _passwordRequirements.Count);
                
                StateHasChanged();
                
                // Set focus to entity input after rendering with delay
                try
                {
                    await Task.Delay(200);
                    await _entityInput.FocusAsync();
                    _logger.LogInformation("Focus set to entity input");
                }
                catch (JSDisconnectedException)
                {
                    _logger.LogDebug("Circuit disconnected during focus attempt");
                }
                catch (TaskCanceledException)
                {
                    _logger.LogDebug("Focus operation cancelled");
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(ex, "Failed to focus input");
                }
            }
            catch (ObjectDisposedException ex)
            {
                _logger.LogWarning(ex, "Component disposed during initialization");
            }
            catch (TaskCanceledException ex)
            {
                _logger.LogDebug(ex, "Initialization cancelled");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error during first render initialization");
            }
        }
    }

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }

    private async Task LoadAllAttributes()
    {
        try
        {
            _allAttributes = await ApiService.GetPublicAsync<List<SystemAttributeResponse>>("systemattributes") ?? new();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load system attributes");
            _allAttributes = new List<SystemAttributeResponse>();
        }
    }

    private async Task LoadEntities()
    {
        try
        {
            _entities = await ApiService.GetPublicAsync<List<EntityDto>>("entities/login") ?? new();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load entities");
            _entities = new List<EntityDto>();
        }
    }

    private void LoadSystemVersion()
    {
        var attr = _allAttributes.FirstOrDefault(a => a.Id == 1 || a.Description == "System Version");
        _systemVersion = attr != null && !string.IsNullOrEmpty(attr.Value)
            ? $"מערכת ניהול - גרסה {attr.Value}"
            : "מערכת ניהול";
    }

    private void LoadEnvironmentIndicator()
    {
        var envAttr = _allAttributes.FirstOrDefault(a =>
            string.Equals(a.Name, "System_Environment", StringComparison.OrdinalIgnoreCase));

        if (envAttr == null || string.IsNullOrEmpty(envAttr.Value))
        {
            _logger.LogWarning("System_Environment attribute not found or empty");
            return;
        }

        var envValue = envAttr.Value.Trim().ToLowerInvariant();
        _logger.LogInformation("Environment attribute found: '{Value}' -> '{Lower}'", envAttr.Value, envValue);

        if (envValue == "development")
            _environmentIndicator = "DEV";
        else if (envValue == "test")
            _environmentIndicator = "סביבת בדיקות";
        // Production or any other value: don't show anything
    }

    private async Task LoadPasswordPolicy()
    {
        try
        {
            var result = await ApiService.GetPublicAsync<PasswordPolicyResponse>("auth/password-policy");
            if (result?.Requirements != null)
                _passwordRequirements = result.Requirements;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to load password policy");
        }
    }

    private void OnSearchTextChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        FilterEntities();
    }

    private void OnAutocompleteFocus()
    {
        if (_searchText.Length >= 3)
        {
            FilterEntities();
        }
    }

    private void FilterEntities()
    {
        if (_searchText.Length < 3)
        {
            _filteredEntities = new();
            _showDropdown = false;
            return;
        }

        var searchLower = _searchText.ToLower();
        _filteredEntities = _entities
            .Where(e => e.Name.ToLower().Contains(searchLower))
            .Take(10)
            .ToList();

        _showDropdown = true;
        _selectedIndex = -1;
    }

    private void SelectEntity(EntityDto entity)
    {
        _selectedEntityId = entity.Id;
        _selectedEntityName = entity.Name;
        _searchText = entity.Name;
        _showDropdown = false;
        _currentStep = 2;
        _errorMessage = "";
    }

    private async Task HandleAutocompleteKeyDown(KeyboardEventArgs e)
    {
        if (!_showDropdown || _filteredEntities.Count == 0)
        {
            if (e.Key != "ArrowDown" && e.Key != "ArrowUp" && e.Key != "Enter" && e.Key != "Escape")
                return;
        }

        if (e.Key == "ArrowDown")
        {
            _selectedIndex = Math.Min(_selectedIndex + 1, _filteredEntities.Count - 1);
        }
        else if (e.Key == "ArrowUp")
        {
            _selectedIndex = Math.Max(_selectedIndex - 1, 0);
        }
        else if (e.Key == "Enter" && _selectedIndex >= 0)
        {
            SelectEntity(_filteredEntities[_selectedIndex]);
        }
        else if (e.Key == "Escape")
        {
            _showDropdown = false;
        }
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleOtpEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleOtpVerification();
        }
    }

    private async Task HandleLogin()
    {
        _errorMessage = "";
        _currentStep = 3;

        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "נא להזין שם משתמש";
            _currentStep = 2;
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errorMessage = "נא להזין סיסמה";
            _currentStep = 2;
            return;
        }

        if (_selectedEntityId == 0)
        {
            _errorMessage = "נא לבחור ישות";
            _currentStep = 1;
            return;
        }

        _isLoading = true;

        try
        {
            var loginRequest = new LoginRequest
            {
                Username = _username,
                Password = _password,
                EntityId = _selectedEntityId
            };

            var response = await ApiService.PostAsync<LoginRequest, LoginResponse>("auth/login", loginRequest);

            if (response != null)
            {
                // Check password change requirement
                if (response.RequiresPasswordChange)
                {
                    _requiresPasswordChange = true;
                    _tempToken = response.TempToken;
                    _passwordExpirationMessage = response.PasswordExpirationMessage ?? "נדרשת החלפת סיסמה";
                    return;
                }

                // Check OTP requirements — send email OTP and show masked email
                if (response.RequiresOtp)
                {
                    _requiresOtp = true;
                    _tempToken = response.TempToken;
                    _maskedEmail = response.MaskedEmail ?? "";
                    return;
                }

                // Now check success flag (for actual login failures)
                if (response.Success)
                {
                    await TokenService.SetTokenAsync(response.Token);
                    Navigation.NavigateTo("/maindashboard?fromLogin=true");
                }
                else
                {
                    _errorMessage = response.Message ?? "שגיאה בהתחברות";
                    _currentStep = 2;
                }
            }
            else
            {
                _errorMessage = "שגיאה בהתחברות";
                _currentStep = 2;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ExtractErrorMessage(ex.Message);
            _currentStep = 2;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleOtpVerification()
    {
        _otpErrorMessage = "";

        if (string.IsNullOrWhiteSpace(_otpCode) || _otpCode.Length != 6)
        {
            _otpErrorMessage = "נא להזין קוד בן 6 ספרות";
            return;
        }

        _isLoading = true;

        try
        {
            var otpRequest = new { TempToken = _tempToken, Code = _otpCode };
            var response = await ApiService.PostAsync<object, LoginResponse>("otp/validate", otpRequest);

            if (response != null && response.Success)
            {
                await TokenService.SetTokenAsync(response.Token);
                Navigation.NavigateTo("/maindashboard?fromLogin=true");
            }
            else if (response?.RequiresPasswordChange == true)
            {
                _requiresOtp = false;
                _otpCode = "";
                _requiresPasswordChange = true;
                _tempToken = response.TempToken ?? _tempToken;
                _passwordExpirationMessage = response.PasswordExpirationMessage ?? "נדרשת החלפת סיסמה";
            }
            else
            {
                // Keep modal open and show error within modal
                _otpCode = "";
                _otpErrorMessage = response?.Message ?? "קוד אימות שגוי";
            }
        }
        catch (Exception ex)
        {
            // Keep modal open and show error within modal
            _otpCode = "";
            _otpErrorMessage = ExtractErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CancelOtp()
    {
        _requiresOtp = false;
        _otpCode = "";
        _otpErrorMessage = "";
        _maskedEmail = "";
        _tempToken = null;
        _isForgotPasswordFlow = false;
        _currentStep = 2;
    }

    private async Task ResendOtp()
    {
        if (string.IsNullOrEmpty(_tempToken)) return;

        _otpErrorMessage = "";
        _isLoading = true;

        try
        {
            var sendRequest = new { TempToken = _tempToken };
            var response = await ApiService.PostAsync<object, SendOtpResponse>("otp/send", sendRequest);

            if (response != null && response.Success)
            {
                _maskedEmail = response.MaskedEmail ?? _maskedEmail;
                _otpCode = "";
                _otpErrorMessage = "";
                _logger.LogInformation("OTP resent successfully");
            }
            else
            {
                _otpErrorMessage = response?.Message ?? "שגיאה בשליחת קוד חדש";
            }
        }
        catch (Exception ex)
        {
            _otpErrorMessage = ExtractErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandlePasswordChange()
    {
        _passwordChangeErrorMessage = "";

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordChangeErrorMessage = "נא להזין סיסמה חדשה";
            return;
        }

        if (_newPassword != _confirmNewPassword)
        {
            _passwordChangeErrorMessage = "הסיסמאות אינן תואמות";
            return;
        }

        _isLoading = true;

        try
        {
            object changeRequest;
            string endpoint;

            if (_isForgotPasswordFlow)
            {
                // Forgot-password flow — no old password, different endpoint
                changeRequest = new { TempToken = _tempToken, NewPassword = _newPassword };
                endpoint = "auth/reset-password";
            }
            else
            {
                changeRequest = new { TempToken = _tempToken, OldPassword = _password, NewPassword = _newPassword };
                endpoint = "auth/change-expired-password";
            }

            var response = await ApiService.PostAsync<object, LoginResponse>(endpoint, changeRequest);

            if (response != null && response.Success)
            {
                _requiresPasswordChange = false;
                _isForgotPasswordFlow = false;
                _newPassword = "";
                _confirmNewPassword = "";
                _passwordChangeErrorMessage = "";
                _tempToken = null;
                _password = "";
                _currentStep = 2;
                _errorMessage = "הסיסמה שונתה בהצלחה. אנא התחבר עם הסיסמה החדשה";
            }
            else
            {
                _passwordChangeErrorMessage = response?.Message ?? "שגיאה בשינוי הסיסמה";
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error changing password");
            _passwordChangeErrorMessage = ExtractErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task InitiateForgotPassword()
    {
        if (_selectedEntityId == 0 || string.IsNullOrWhiteSpace(_username))
        {
            _errorMessage = "נא להזין שם משתמש ולבחור ארגון תחילה";
            return;
        }

        _isLoading = true;
        _errorMessage = "";

        try
        {
            var request = new { Username = _username, EntityId = _selectedEntityId };
            var response = await ApiService.PostAsync<object, ForgotPasswordResponse>("auth/forgot-password", request);

            if (response != null && response.Success)
            {
                _isForgotPasswordFlow = true;
                _requiresOtp = true;
                _tempToken = response.TempToken;
                _maskedEmail = response.MaskedEmail ?? "";
                _otpErrorMessage = "";
                _otpCode = "";
            }
            else
            {
                _errorMessage = response?.Message ?? "שגיאה בשליחת קוד האימות";
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error initiating forgot-password");
            _errorMessage = ExtractErrorMessage(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

