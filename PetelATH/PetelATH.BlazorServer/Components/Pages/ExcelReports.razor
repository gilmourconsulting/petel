@page "/excelreports"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using System.Text.Json
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="excelreports_create" ScreenName="@PageName" FunctionName="ShowCreateModal"
                      OnClick="ShowCreateModal" CssClass="context-btn" Title="יצירת דוח חדש">
            + דוח חדש
        </SecureButton>
        <div class="context-spacer"></div>
        <SecureButton ActionName="excelreports_back" ScreenName="@PageName" FunctionName="NavigateBack"
                      OnClick="NavigateBack" CssClass="context-navigation-btn" Title="חזרה">
            חזרה
        </SecureButton>
    </div>

    <div class="students-content">
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">דוחות Excel</div>
                <div class="left-spacer"></div>
            </div>
        </div>

        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner"><p>טוען דוחות...</p></div>
            }
            else if (!_reports.Any())
            {
                <div style="padding:24px; text-align:center; color:#6c757d;">
                    לא קיימים דוחות. לחץ על "+ דוח חדש" כדי ליצור.
                </div>
            }
            else
            {
                <div class="table-container" style="overflow-x:auto;">
                    <table class="data-table" style="min-width:900px;">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th>שם הדוח</th>
                                <th>סוג</th>
                                <th>תיאור</th>
                                <th>חוצה שנים</th>
                                <th>הקשר ישות</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _reports)
                            {
                                <tr>
                                    <td>
                                        <button class="btn-icon" title="הפעל דוח" @onclick="() => ShowRunModal(r)">
                                            <img src="/images/stats_icon.png" alt="הפעל" class="action-icon-natural" />
                                        </button>
                                        <SecureButton ActionName="can_edit_excel_report"
                                                      ScreenName="@PageName"
                                                      FunctionName="EditReport"
                                                      OnClick="() => EditReport(r)"
                                                      CssClass="btn-icon"
                                                      Title="ערוך הגדרות"
                                                      HideIfNoAccess="true">
                                            <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural" />
                                        </SecureButton>
                                        <SecureButton ActionName="can_delete_excel_report"
                                                      ScreenName="@PageName"
                                                      FunctionName="ConfirmDelete"
                                                      OnClick="() => ConfirmDelete(r)"
                                                      CssClass="btn-icon"
                                                      Title="מחק דוח"
                                                      HideIfNoAccess="true">
                                            <img src="/images/delete_icon.png" alt="מחק" class="action-icon-natural" />
                                        </SecureButton>
                                    </td>
                                    <td>@r.Name</td>
                                    <td>@ReportTypeLabel(r.ReportType)</td>
                                    <td>@r.Description</td>
                                    <td>@(r.AllowCrossYear ? "כן" : "לא")</td>
                                    <td>@(r.RequiresEntityContext ? "כן" : "לא")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger" style="position:fixed;bottom:20px;left:20px;right:20px;z-index:9999;max-width:600px;margin:0 auto;">
        @_errorMessage
        <button @onclick="() => _errorMessage = string.Empty" style="float:left;background:none;border:none;cursor:pointer;">✕</button>
    </div>
}

<!-- ─── Create/Edit Report Modal ─────────────────────────────────── -->
@if (_showCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width:480px;">
            <div class="modal-header">
                <h3>@(_editingReport == null ? "דוח חדש" : "עריכת דוח")</h3>
                <button @onclick="CloseCreateModal" style="background:none;border:none;font-size:1.4em;cursor:pointer;">✕</button>
            </div>
            <div class="modal-body">
                <div style="margin-bottom:14px;">
                    <label style="display:block;font-weight:600;margin-bottom:4px;">שם הדוח <span style="color:red;">*</span></label>
                    <input type="text" @bind="_formName" style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;" />
                </div>
                <div style="margin-bottom:14px;">
                    <label style="display:block;font-weight:600;margin-bottom:4px;">תיאור</label>
                    <textarea @bind="_formDescription" rows="2" style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;"></textarea>
                </div>
                <div style="margin-bottom:14px;">
                    <label style="display:block;font-weight:600;margin-bottom:4px;">סוג דוח <span style="color:red;">*</span></label>
                    <select @bind="_formReportType" style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                        <option value="query_builder">בונה שאילתות (Query Builder)</option>
                        <option value="template">תבנית Excel</option>
                    </select>
                </div>
                <div style="display:flex;gap:15px;margin-bottom:14px;">
                    <div style="flex:1;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" @bind="_formAllowCrossYear" />
                            <span>אפשר דוח חוצה שנים</span>
                        </label>
                    </div>
                    <div style="flex:1;">
                        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" @bind="_formRequiresEntityContext" />
                            <span>דורש בחירת ישות</span>
                        </label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="alert alert-danger" style="padding:8px;font-size:0.9em;">@_modalError</div>
                }

                @if (_formReportType == "template" && _editingReport != null)
                {
                    <hr style="margin:16px 0 12px;" />
                    <div style="margin-bottom:6px;">
                        <strong style="font-size:0.95em;">תבנית Excel</strong>
                    </div>
                    @if (!string.IsNullOrEmpty(_editingReport.TemplateFilename))
                    {
                        <div style="font-size:0.88em;color:#198754;margin-bottom:8px;">✅ תבנית נוכחית: @_editingReport.TemplateFilename</div>
                    }
                    else
                    {
                        <div style="font-size:0.88em;color:#6c757d;margin-bottom:8px;">עדיין לא הועלתה תבנית.</div>
                    }
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                        <InputFile OnChange="HandleTemplateFileSelected" accept=".xlsx"
                                   style="flex:1;min-width:0;font-size:0.88em;" />
                        <button type="button" @onclick="UploadTemplate"
                                disabled="@(_isUploadingTemplate || _selectedTemplateFile == null)"
                                style="padding:6px 14px;border:1px solid #0d6efd;border-radius:4px;background:#e7f0ff;color:#0d6efd;cursor:pointer;white-space:nowrap;font-size:0.88em;">
                            @(_isUploadingTemplate ? "מעלה..." : "העלה תבנית")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(_templateUploadMessage))
                    {
                        <div style="margin-top:6px;font-size:0.85em;">@_templateUploadMessage</div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button @onclick="SaveReport" class="btn btn-primary" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
                <button @onclick="CloseCreateModal" class="btn btn-secondary">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- ─── Run Report Modal ──────────────────────────────────────────── -->
@if (_showRunModal && _runningReport != null)
{
    <div class="modal-overlay" @onclick="CloseRunModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width:460px;">
            <div class="modal-header">
                <h3>הפעלת דוח: @_runningReport.Name</h3>
                <button @onclick="CloseRunModal" style="background:none;border:none;font-size:1.4em;cursor:pointer;">✕</button>
            </div>
            <div class="modal-body">
                @if (_paramsLoading)
                {
                    <div style="text-align:center;padding:20px;color:#6c757d;">טוען פרמטרים...</div>
                }
                else if (!_visibleParams.Any())
                {
                    <div style="color:#6c757d;padding:8px 0;">דוח זה אינו דורש פרמטרים.</div>
                }
                else
                {
                    @foreach (var p in _visibleParams)
                    {
                        <div style="margin-bottom:14px;">
                            <label style="display:block;font-weight:600;margin-bottom:4px;">
                                @p.ParamLabelHe
                                @if (p.IsRequired) { <span style="color:red;"> *</span> }
                            </label>

                            @if (p.ParamType == "year_selector")
                            {
                                <select value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                        @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                        style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                                    <option value="">-- בחר שנה --</option>
                                    @foreach (var y in _schoolYears)
                                    {
                                        <option value="@y.Id">@y.HebrewYear</option>
                                    }
                                </select>
                            }
                            else if (p.ParamType == "council_selector")
                            {
                                <select value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                        @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                        style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                                    <option value="">-- בחר רשות --</option>
                                    @foreach (var c in _councils)
                                    {
                                        <option value="@c.Id">@c.CouncilName</option>
                                    }
                                </select>
                            }
                            else if (p.ParamType == "entity_selector")
                            {
                                <select value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                        @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                        style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                                    <option value="">-- בחר ישות --</option>
                                    @foreach (var en in _entities)
                                    {
                                        <option value="@en.Id">@en.EntityName</option>
                                    }
                                </select>
                            }
                            else if (p.ParamType == "network_selector")
                            {
                                <select value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                        @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                        style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                                    <option value="">כל הרשתות</option>
                                    @foreach (var net in _networks)
                                    {
                                        <option value="@net.Id">@net.Name</option>
                                    }
                                </select>
                            }
                            else if (p.ParamType == "enum")
                            {
                                <select value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                        @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                        style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;background:white;">
                                    <option value="">-- בחר --</option>
                                    @foreach (var opt in ParseEnumOptions(p.OptionsJson))
                                    {
                                        <option value="@opt.Value">@opt.Label</option>
                                    }
                                </select>
                            }
                            else if (p.ParamType == "number")
                            {
                                <input type="number"
                                       value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                       @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                       style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;" />
                            }
                            else
                            {
                                <input type="text"
                                       value="@_paramValues.GetValueOrDefault(p.ParamName)"
                                       @onchange="e => _paramValues[p.ParamName] = e.Value?.ToString() ?? string.Empty"
                                       style="width:100%;padding:8px;border:1px solid #dee2e6;border-radius:4px;" />
                            }
                        </div>
                    }
                }

                @if (!string.IsNullOrEmpty(_runError))
                {
                    <div class="alert alert-danger" style="padding:8px;font-size:0.9em;">@_runError</div>
                }
            </div>
            <div class="modal-footer">
                <button @onclick="RunReport" class="btn btn-primary" disabled="@(_isRunning || _paramsLoading)">
                    @(_isRunning ? "מייצר דוח..." : "הורד Excel")
                </button>
                <button @onclick="CloseRunModal" class="btn btn-secondary">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "excelreports";

    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private List<ExcelReportDto> _reports = new();
    private List<HebrewYearDto> _schoolYears = new();
    private bool _isAdmin = false;

    // Create/Edit modal
    private bool _showCreateModal = false;
    private ExcelReportDto? _editingReport;
    private string _formName = string.Empty;
    private string _formDescription = string.Empty;
    private string _formReportType = "query_builder";
    private bool _formAllowCrossYear = false;
    private bool _formRequiresEntityContext = false;
    private bool _isSaving = false;
    private string _modalError = string.Empty;

    // Template upload (used in edit modal)
    private IBrowserFile? _selectedTemplateFile;
    private bool _isUploadingTemplate = false;
    private string _templateUploadMessage = string.Empty;

    // Run modal
    private bool _showRunModal   = false;
    private bool _paramsLoading  = false;
    private bool _isRunning      = false;
    private string _runError     = string.Empty;
    private ExcelReportDto? _runningReport;
    private List<ReportParamDef> _paramDefs  = new();
    private Dictionary<string, string> _paramValues = new();
    private List<CouncilDto> _councils = new();
    private List<EntityDto>  _entities = new();
    private List<NetworkDto> _networks = new();
    private bool _isType6 = false;

    private IEnumerable<ReportParamDef> _visibleParams =>
        _paramDefs.Where(p =>
            p.ParamType != "session_entity" &&
            p.ParamType != "session_year" &&
            !(p.ParamType == "network_selector" && !_isType6));

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null) return;

        _isAdmin = session.EntityTypeId == "1";
        _isType6 = session.EntityTypeId == "6";

        await Task.WhenAll(LoadReports(), LoadSchoolYears());
        _isLoading = false;
    }

    private async Task LoadReports()
    {
        try
        {
            var result = await ApiService.GetAsync<ApiResult<List<ExcelReportDto>>>("excelreports");
            if (result?.Success == true)
                _reports = result.Data ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = $"שגיאה בטעינת דוחות: {ex.Message}";
        }
    }

    private async Task LoadSchoolYears()
    {
        try
        {
            var years = await ApiService.GetAsync<List<HebrewYearDto>>("schoolyearconfig/hebrew-years");
            _schoolYears = years ?? new();
        }
        catch { /* non-critical */ }
    }

    private void ShowCreateModal()
    {
        _editingReport = null;
        _formName = string.Empty;
        _formDescription = string.Empty;
        _formReportType = "query_builder";
        _formAllowCrossYear = false;
        _formRequiresEntityContext = false;
        _modalError = string.Empty;
        _showCreateModal = true;
    }

    private void CloseCreateModal() => _showCreateModal = false;

    private async Task SaveReport()
    {
        _modalError = string.Empty;
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _modalError = "שם הדוח נדרש";
            return;
        }

        _isSaving = true;
        try
        {
            var body = new SaveReportBody
            {
                Name = _formName,
                Description = _formDescription,
                ReportType = _formReportType,
                AllowCrossYear = _formAllowCrossYear,
                RequiresEntityContext = _formRequiresEntityContext
            };

            if (_editingReport == null)
            {
                var result = await ApiService.PostAsync<SaveReportBody, ApiResult<object>>("excelreports", body);
                if (result?.Success != true)
                {
                    _modalError = "שגיאה ביצירת הדוח";
                    return;
                }
            }
            else
            {
                var result = await ApiService.PutAsync<SaveReportBody, ApiResult<object>>(
                    $"excelreports/{_editingReport.Id}", body);
                if (result?.Success != true)
                {
                    _modalError = "שגיאה בשמירת הדוח";
                    return;
                }
            }

            CloseCreateModal();
            await LoadReports();
        }
        catch (Exception ex)
        {
            _modalError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ConfirmDelete(ExcelReportDto r)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"למחוק את הדוח '{r.Name}'?"))
            return;

        try
        {
            await ApiService.DeleteAsync($"excelreports/{r.Id}");
            await LoadReports();
        }
        catch (Exception ex)
        {
            _errorMessage = $"שגיאה במחיקה: {ex.Message}";
        }
    }

    private void NavigateToBuilder(ExcelReportDto r)
    {
        Navigation.NavigateTo($"/excelreports/{r.Id}/builder");
    }

    /// <summary>Routes to builder for query_builder reports, or opens the edit modal for template reports.</summary>
    private void EditReport(ExcelReportDto r)
    {
        if (r.ReportType == "template")
            ShowEditModal(r);
        else
            NavigateToBuilder(r);
    }

    private void ShowEditModal(ExcelReportDto r)
    {
        _editingReport = r;
        _formName = r.Name;
        _formDescription = r.Description ?? string.Empty;
        _formReportType = r.ReportType;
        _formAllowCrossYear = r.AllowCrossYear;
        _formRequiresEntityContext = r.RequiresEntityContext;
        _modalError = string.Empty;
        _selectedTemplateFile = null;
        _templateUploadMessage = string.Empty;
        _showCreateModal = true;
    }

    private void HandleTemplateFileSelected(InputFileChangeEventArgs e)
    {
        _selectedTemplateFile = e.File;
        _templateUploadMessage = string.Empty;
    }

    private async Task UploadTemplate()
    {
        if (_editingReport == null || _selectedTemplateFile == null) return;

        _isUploadingTemplate = true;
        _templateUploadMessage = string.Empty;
        try
        {
            using var content = new MultipartFormDataContent();
            await using var stream = _selectedTemplateFile.OpenReadStream(10L * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            content.Add(fileContent, "file", _selectedTemplateFile.Name);

            var result = await ApiService.PostMultipartAsync<UploadTemplateResult>(
                $"excelreporttemplates/{_editingReport.Id}/upload", content);

            if (result?.Success == true)
            {
                var count = result.Data?.Placeholders?.Count ?? 0;
                _templateUploadMessage = $"✅ הועלה בהצלחה — {count} מציינים נמצאו";
                // Update the display name without a full reload
                var idx = _reports.FindIndex(rep => rep.Id == _editingReport.Id);
                if (idx >= 0) _reports[idx].TemplateFilename = _selectedTemplateFile.Name;
                _editingReport = new ExcelReportDto
                {
                    Id = _editingReport.Id, Name = _editingReport.Name,
                    Description = _editingReport.Description, ReportType = _editingReport.ReportType,
                    AllowCrossYear = _editingReport.AllowCrossYear,
                    RequiresEntityContext = _editingReport.RequiresEntityContext,
                    SortOrder = _editingReport.SortOrder, IsActive = _editingReport.IsActive,
                    TemplateFilename = _selectedTemplateFile.Name
                };
                _selectedTemplateFile = null;
            }
            else
            {
                _templateUploadMessage = "❌ שגיאה בהעלאת הקובץ";
            }
        }
        catch (Exception ex)
        {
            _templateUploadMessage = $"❌ {ex.Message}";
        }
        finally
        {
            _isUploadingTemplate = false;
        }
    }

    private async Task ShowRunModal(ExcelReportDto r)
    {
        _runningReport = r;
        _paramDefs     = new();
        _paramValues   = new();
        _runError      = string.Empty;
        _paramsLoading = true;
        _showRunModal  = true;
        StateHasChanged();

        try
        {
            var result = await ApiService.GetAsync<ParamsApiResult>($"excelreports/{r.Id}/params");
            if (result?.Success == true && result.Data != null)
            {
                _paramDefs = result.Data;
                // Seed values with defaults
                foreach (var p in _paramDefs)
                    _paramValues[p.ParamName] = p.DefaultValue ?? string.Empty;

                // Lazy-load council list if needed
                if (_paramDefs.Any(p => p.ParamType == "council_selector") && !_councils.Any())
                {
                    var councils = await ApiService.GetAsync<List<CouncilDto>>("councils");
                    _councils = councils ?? new();
                }

                // Lazy-load entity list if needed
                if (_paramDefs.Any(p => p.ParamType == "entity_selector") && !_entities.Any())
                {
                    var entities = await ApiService.GetAsync<List<EntityDto>>("entities");
                    _entities = entities ?? new();
                }

                // Lazy-load sub-network list for type-6 entity users
                if (_paramDefs.Any(p => p.ParamType == "network_selector") && !_networks.Any())
                {
                    var ownerResult = await ApiService.GetAsync<OwnerOptionsResult>("entities/owner-options");
                    _networks = ownerResult?.OwnerOptions?.Select(o => new NetworkDto { Id = o.Id, Name = o.Name }).ToList() ?? new();
                }
            }
        }
        catch (Exception ex)
        {
            _runError = $"שגיאה בטעינת פרמטרים: {ex.Message}";
        }
        finally
        {
            _paramsLoading = false;
        }
    }

    private void CloseRunModal() => _showRunModal = false;

    private async Task RunReport()
    {
        if (_runningReport == null) return;
        _runError = string.Empty;

        // Client-side required-field validation
        foreach (var p in _visibleParams.Where(p => p.IsRequired))
        {
            if (!_paramValues.TryGetValue(p.ParamName, out var v) || string.IsNullOrWhiteSpace(v))
            {
                _runError = $"שדה חובה: {p.ParamLabelHe}";
                return;
            }
        }

        _isRunning = true;
        try
        {
            // Collect non-empty values only
            var runtimeParams = _paramValues
                .Where(kv => !string.IsNullOrWhiteSpace(kv.Value))
                .ToDictionary(kv => kv.Key, kv => kv.Value);

            var fileBytes = await ApiService.PostForFileAsync(
                $"excelreports/{_runningReport.Id}/generate",
                new GenerateReportBody { RuntimeParams = runtimeParams });

            if (fileBytes != null && fileBytes.Length > 0)
            {
                var base64  = Convert.ToBase64String(fileBytes);
                var fileName = $"{_runningReport.Name}_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
                await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", base64, fileName,
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                CloseRunModal();
            }
            else
            {
                _runError = "שגיאה בהורדת הדוח";
            }
        }
        catch (Exception ex)
        {
            _runError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isRunning = false;
        }
    }

