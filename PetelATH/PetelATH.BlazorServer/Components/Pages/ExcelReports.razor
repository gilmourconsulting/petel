    private static IEnumerable<EnumOption> ParseEnumOptions(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) yield break;
        List<JsonElement>? elems;
        try { elems = JsonSerializer.Deserialize<List<JsonElement>>(json); }
        catch { yield break; }
        if (elems == null) yield break;
        foreach (var e in elems)
        {
            var v = e.TryGetProperty("value", out var vp) ? vp.GetString() ?? string.Empty : string.Empty;
            var l = e.TryGetProperty("label", out var lp) ? lp.GetString() ?? string.Empty : v;
            yield return new EnumOption(v, l);
        }
    }
