    private async Task RunGenerateCouncilDocs(bool regenerateAll)
    {
        _showGenerateCouncilDocsModal = false;

        var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
        if (yearIdResponse == null || !yearIdResponse.TryGetValue("value", out var yearIdStr))
        {
            await JSRuntime.InvokeVoidAsync("alert", "לא נמצאה שנת לימודים נבחרת");
            return;
        }

        _showCouncilDocsProgress = true;
        _councilDocsResult = null;
        StateHasChanged();

        try
        {
            var response = await ApiService.PostAsync<object, CouncilDocsApiResponse>(
                $"documents/generate-council-combined?yearId={yearIdStr}&regenerateAll={regenerateAll}",
                new object());

            _showCouncilDocsProgress = false;

            if (response != null)
            {
                _councilDocsResult = new CouncilDocsResult
                {
                    CouncilsProcessed = response.CouncilsProcessed,
                    ExcelCreated      = response.ExcelCreated,
                    ExcelUpdated      = response.ExcelUpdated,
                    ExcelFailed       = response.ExcelFailed,
                    WordCreated       = response.WordCreated,
                    WordUpdated       = response.WordUpdated,
                    WordFailed        = response.WordFailed,
                    StudentsUpdated   = response.StudentsUpdated,
                };
                _showCouncilDocsSummary = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "הפעולה הסתיימה אך לא התקבלה תשובה מהשרת");
            }
        }
        catch (Exception ex)
        {
            _showCouncilDocsProgress = false;
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בייצוא מסמכי רשויות:\n{ex.Message}");
        }

        StateHasChanged();
    }

