@page "/schoollist"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Components.Shared
@using PetelATH.BlazorServer.Components.Modals
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="schoollist_entityDocuments" ScreenName="@PageName" FunctionName="NavigateToEntityDocuments" 
                      OnClick="NavigateToEntityDocuments" CssClass="context-btn" Title="צפייה במסמכי הישות">
            מסמכי ישות
        </SecureButton>
        <SecureButton ActionName="schoollist_councilsList" ScreenName="@PageName" FunctionName="NavigateToCouncilsList" 
                      OnClick="NavigateToCouncilsList" CssClass="context-btn" Title="צפייה ברשימת הרשויות המשלחות">
            סיכום רשויות משלחות
        </SecureButton>
        <SecureButton ActionName="schoollist_generateCouncilExcels" ScreenName="@PageName" FunctionName="GenerateCouncilExcels"
                      OnClick="GenerateCouncilExcels" CssClass="context-btn" Title="יצירת דוח 10 לכל רשות משלחת">
            יצירת דוח 10
        </SecureButton>
        @if (_isGenerating)
        {
            <span style="font-size: 0.85em; color: #0d6efd; margin-right: 8px;">יוצר דוח 10... אנא המתן</span>
        }
        <SecureButton ActionName="schoollist_togglePricingSelection" ScreenName="@PageName" FunctionName="ToggleSelectionMode"
                      OnClick="ToggleSelectionMode" CssClass="@PricingToggleCssClass"
                      Title="בחר מספר בתי ספר להפעלת תמחור מרובה">
            @PricingToggleLabel
        </SecureButton>
        @if (_selectionMode && _selectedSchoolYearIds.Count > 0)
        {
            <SecureButton ActionName="schoollist_runPricingMultiple" ScreenName="@PageName" FunctionName="RunPricingForSelected"
                          OnClick="RunPricingForSelected" CssClass="context-btn"
                          Title="חשב ושמור תמחור לבתי הספר הנבחרים"
                          Disabled="@_isRunningPricing">
                הפעל תמחור לנבחרים (@_selectedSchoolYearIds.Count)
            </SecureButton>
        }
        @if (_isRunningPricing)
        {
            <span style="font-size: 0.85em; color: #0d6efd; margin-right: 8px;">מחשב תמחור... אנא המתן</span>
        }
        <div class="context-spacer"></div>
        <SecureButton ActionName="schoollist_backToDashboard" ScreenName="@PageName" FunctionName="NavigateBackToDashboard" 
                      OnClick="NavigateBackToDashboard" CssClass="context-navigation-btn" Title="חזרה למסך הראשי">
            חזרה למסך הראשי
        </SecureButton>
    </div>

    <!-- Pricing result panel -->
    @if (_pricingSummary != null || _pricingLog.Count > 0)
    {
        <div style="margin: 8px 16px; padding: 10px 14px; border-radius: 6px; font-size: 0.85em; direction: rtl;
                    background: @(_pricingSuccess ? "#d1e7dd" : "#f8d7da");
                    border: 1px solid @(_pricingSuccess ? "#badbcc" : "#f5c2c7");
                    color: @(_pricingSuccess ? "#0a3622" : "#842029");">
            @if (_pricingSummary != null)
            {
                <div style="font-weight: 600; margin-bottom: @(_pricingLog.Count > 0 ? "8px" : "0");">@_pricingSummary</div>
            }
            @if (_pricingLog.Count > 0)
            {
                <div style="max-height: 220px; overflow-y: auto; font-family: monospace; white-space: pre-wrap;
                            background: rgba(0,0,0,0.05); border-radius: 4px; padding: 6px 8px;">
                    @foreach (var line in _pricingLog)
                    {
                        <div>@line</div>
                    }
                </div>
            }
        </div>
    }

    <!-- Council Excel generation log panel -->
    @if (_generateSummary != null || _generateLog.Count > 0)
    {
        <div style="margin: 8px 16px; padding: 10px 14px; border-radius: 6px; font-size: 0.85em; direction: rtl;
                    background: @(_generateSuccess ? "#d1e7dd" : "#f8d7da");
                    border: 1px solid @(_generateSuccess ? "#badbcc" : "#f5c2c7");
                    color: @(_generateSuccess ? "#0a3622" : "#842029");">
            @if (_generateSummary != null)
            {
                <div style="font-weight: 600; margin-bottom: @(_generateLog.Count > 0 ? "8px" : "0");">@_generateSummary</div>
            }
            @if (_generateLog.Count > 0)
            {
                <div style="max-height: 220px; overflow-y: auto; font-family: monospace; white-space: pre-wrap;
                            background: rgba(0,0,0,0.05); border-radius: 4px; padding: 6px 8px;">
                    @foreach (var line in _generateLog)
                    {
                        <div>@line</div>
                    }
                </div>
            }
        </div>
    }

    <!-- Main content -->
    <div class="students-content">
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">רשימת בתי ספר</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
            <div class="content-card">
                <div class="header-actions">
                    <button class="btn-icon" title="הוספת בית ספר חדש" @onclick="ShowAddSchoolModal">
                        <img src="/images/Plus icon.png" alt="הוספת בית ספר חדש" class="action-icon-natural">
                    </button>
                </div>
                @if (!_isLoading && _schools.Count > 0)
                {
                    <SchoolsSummaryBar Schools="@_schools" />
                }
                <div class="content-card">
                    <!-- Filter Section -->
                    <div style="padding: 15px 20px; border-bottom: 1px solid #dee2e6;">
                        <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
                            <div style="flex: 2; min-width: 180px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">שם בית ספר</label>
                                <input type="text" @bind="_filterName" @bind:event="oninput"
                                    placeholder="סנן לפי שם..."
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                            </div>
                            <div style="flex: 2; min-width: 180px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">כתובת</label>
                                <input type="text" @bind="_filterAddress" @bind:event="oninput"
                                    placeholder="סנן לפי כתובת..."
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                            </div>
                            <div style="flex: 2; min-width: 160px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">מפקח</label>
                                <input type="text" @bind="_filterInspector" @bind:event="oninput"
                                    placeholder="סנן לפי מפקח..."
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                            </div>
                            <div style="flex: 2; min-width: 160px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">אפיון המוסד</label>
                                <input type="text" @bind="_filterCharacterization" @bind:event="oninput"
                                    placeholder="סנן לפי אפיון..."
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                            </div>
                            <div style="flex: 1; min-width: 140px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">שלב חינוך</label>
                                <select @bind="_filterEducationStage"
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; background: white; box-sizing: border-box;">
                                    <option value="">הכל</option>
                                    @foreach (var stage in _distinctEducationStages)
                                    {
                                        <option value="@stage">@stage</option>
                                    }
                                </select>
                            </div>
                            <div style="flex: 2; min-width: 160px;">
                                <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">בעלים</label>
                                <input type="text" @bind="_filterOwner" @bind:event="oninput"
                                    placeholder="סנן לפי בעלים..."
                                    style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                            </div>
                            <div style="padding-bottom: 1px;">
                                <button @onclick="ClearFilters"
                                    style="padding: 7px 16px; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9em; white-space: nowrap;">
                                    נקה סינון
                                </button>
                            </div>
                        </div>
                        @if (HasActiveFilters)
                        {
                            <div style="margin-top: 10px; font-size: 0.85em; color: #555;">
                                מציג <strong>@FilteredSchools.Count()</strong> בתי ספר מתוך <strong>@_schools.Count</strong>
                            </div>
                        }
                    </div>

                    <!-- Schools table -->
                    <div class="schools-table-section">
                        <div id="schoolsTableContainer">
                            @if (_isLoading)
                            {
                                <div class="loading-spinner">
                                    <p>טוען רשימת בתי ספר...</p>
                                </div>
                            }
                            else if (_schools.Count == 0)
                            {
                                <div class="alert alert-info">לא נמצאו בתי ספר</div>
                            }
                            else
                            {
                                <div class="table-container" style="overflow-x: auto; max-width: 100%;">
                                    <table class="data-table" style="min-width: 1200px;">
                                        <thead>
                                            <tr>
                                                @if (_selectionMode)
                                                {
                                                    <th style="width: 36px; text-align: center;">
                                                        <input type="checkbox"
                                                               checked="@AreAllFilteredSelected"
                                                               @onchange="ToggleSelectAll"
                                                               title="בחר/בטל הכל" />
                                                    </th>
                                                }
                                                <th>פעולות</th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.Name))">
                                                    שם בית ספר @GetSortIcon(nameof(SchoolDto.Name))
                                                </th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.Symbol))">
                                                    סמל מוסד @GetSortIcon(nameof(SchoolDto.Symbol))
                                                </th>
                                                <th>כתובת</th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.PrincipalName))">
                                                    שם המנהל @GetSortIcon(nameof(SchoolDto.PrincipalName))
                                                </th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.InspectorName))">
                                                    שם המפקח @GetSortIcon(nameof(SchoolDto.InspectorName))
                                                </th>
                                                <th>אפיון המוסד</th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.ContactPerson))">
                                                    איש קשר במוסד @GetSortIcon(nameof(SchoolDto.ContactPerson))
                                                </th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.EducationStage))">
                                                    שלב חינוך @GetSortIcon(nameof(SchoolDto.EducationStage))
                                                </th>
                                                <th @onclick="() => SortTable(nameof(SchoolDto.OwnerName))">
                                                    בעלים @GetSortIcon(nameof(SchoolDto.OwnerName))
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{ var filtered = FilteredSchools.ToList(); }
                                            @if (filtered.Count == 0)
                                            {
                                                <tr>
                                                    <td colspan="@(_selectionMode ? 11 : 10)" style="text-align: center; padding: 20px; color: #666;">אין בתי ספר התואמים לסינון</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var school in filtered)
                                                {
                                                    <tr>
                                                        @if (_selectionMode)
                                                        {
                                                            <td style="text-align: center;">
                                                                @if (school.SchoolYearId.HasValue)
                                                                {
                                                                    <input type="checkbox"
                                                                           checked="@_selectedSchoolYearIds.Contains(school.SchoolYearId.Value)"
                                                                           @onchange="() => ToggleSchoolSelection(school.SchoolYearId.Value)" />
                                                                }
                                                            </td>
                                                        }
                                                        <td>
                                                            <div class="actions-cell">
                                                                <button class="btn btn-sm btn-icon" 
                                                                        @onclick="() => ViewSchool(school.Id, school.Name)" 
                                                                        title="צפייה">
                                                                    <img src="/images/view_icon.png" alt="צפייה" class="action-icon-natural">
                                                                </button>
                                                            </div>
                                                        </td>
                                                        <td>@school.Name</td>
                                                        <td>@school.Symbol</td>
                                                        <td>@school.Address</td>
                                                        <td>@school.PrincipalName</td>
                                                        <td>@school.InspectorName</td>
                                                        <td>@school.CharacterizationName</td>
                                                        <td>@school.ContactPerson</td>
                                                        <td>@school.EducationStage</td>
                                                        <td>@school.OwnerName</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add School Modal -->
<AddSchoolModal @ref="_addSchoolModal" OnSchoolAdded="LoadData" />

@code {
    private List<SchoolDto> _schools = new();
    private List<SchoolDto> _sortedSchools = new();
    private bool _isLoading = true;
    private string _yearDisplay = "";
    private string _sortColumn = nameof(SchoolDto.Name);
    private bool _sortAscending = true;

    // Filter state
    private string _filterName = string.Empty;
    private string _filterAddress = string.Empty;
    private string _filterInspector = string.Empty;
    private string _filterCharacterization = string.Empty;
    private string _filterEducationStage = string.Empty;
    private string _filterOwner = string.Empty;

    private List<string> _distinctEducationStages => _schools
        .Where(s => !string.IsNullOrEmpty(s.EducationStage))
        .Select(s => s.EducationStage!)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    private IEnumerable<SchoolDto> FilteredSchools => _sortedSchools.Where(s =>
        (string.IsNullOrEmpty(_filterName) || (s.Name ?? "").Contains(_filterName, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterAddress) || (s.Address ?? "").Contains(_filterAddress, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterInspector) || (s.InspectorName ?? "").Contains(_filterInspector, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterCharacterization) || (s.CharacterizationName ?? "").Contains(_filterCharacterization, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterEducationStage) || s.EducationStage == _filterEducationStage) &&
        (string.IsNullOrEmpty(_filterOwner) || (s.OwnerName ?? "").Contains(_filterOwner, StringComparison.OrdinalIgnoreCase))
    );

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterName) ||
        !string.IsNullOrEmpty(_filterAddress) ||
        !string.IsNullOrEmpty(_filterInspector) ||
        !string.IsNullOrEmpty(_filterCharacterization) ||
        !string.IsNullOrEmpty(_filterEducationStage) ||
        !string.IsNullOrEmpty(_filterOwner);

    private void ClearFilters()
    {
        _filterName = string.Empty;
        _filterAddress = string.Empty;
        _filterInspector = string.Empty;
        _filterCharacterization = string.Empty;
        _filterEducationStage = string.Empty;
        _filterOwner = string.Empty;
    }

    // Selection state
    private bool _selectionMode = false;
    private HashSet<int> _selectedSchoolYearIds = new();
    private Dictionary<int, string> _schoolYearIdToName = new();

    private string PricingToggleCssClass => _selectionMode ? "context-btn context-btn-active" : "context-btn";
    private string PricingToggleLabel    => _selectionMode ? "ביטול בחירה" : "תמחור מרובה";

    private void ToggleSelectionMode()
    {
        _selectionMode = !_selectionMode;
        if (!_selectionMode)
        {
            _selectedSchoolYearIds.Clear();
        }
    }

    private bool AreAllFilteredSelected
    {
        get
        {
            var validIds = FilteredSchools
                .Where(s => s.SchoolYearId.HasValue)
                .Select(s => s.SchoolYearId!.Value)
                .ToList();
            return validIds.Count > 0 && validIds.All(id => _selectedSchoolYearIds.Contains(id));
        }
    }

    private void ToggleSchoolSelection(int schoolYearId)
    {
        if (!_selectedSchoolYearIds.Remove(schoolYearId))
            _selectedSchoolYearIds.Add(schoolYearId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var validIds = FilteredSchools
            .Where(s => s.SchoolYearId.HasValue)
            .Select(s => s.SchoolYearId!.Value)
            .ToList();

        if (AreAllFilteredSelected)
            foreach (var id in validIds) _selectedSchoolYearIds.Remove(id);
        else
            foreach (var id in validIds) _selectedSchoolYearIds.Add(id);
    }

    // Bulk pricing state
    private bool _isRunningPricing = false;
    private string? _pricingSummary;
    private bool _pricingSuccess;
    private List<string> _pricingLog = new();

    private async Task RunPricingForSelected()
    {
        if (_selectedSchoolYearIds.Count == 0) return;

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            $"לחשב ולשמור תמחור עבור {_selectedSchoolYearIds.Count} בתי ספר נבחרים? הפעולה תיצור גרסאות תלמיד חדשות.");
        if (!confirm) return;

        _isRunningPricing = true;
        _pricingSummary = null;
        _pricingLog = new();
        _pricingSuccess = true;
        StateHasChanged();

        var schoolIds = _selectedSchoolYearIds.ToList();
        int totalSuccess = 0, totalFail = 0, totalSkipped = 0;

        try
        {
            for (int i = 0; i < schoolIds.Count; i++)
            {
                var schoolYearId = schoolIds[i];
                var schoolName = _schoolYearIdToName.TryGetValue(schoolYearId, out var n) ? n : $"בית ספר {schoolYearId}";
                _pricingLog.Add($"[{i + 1}/{schoolIds.Count}] {schoolName} – מחשב...");
                StateHasChanged();

                try
                {
                    var result = await ApiService.PostAsync<object, SchoolPricingResult>(
                        $"studentpricing/calculate-school/{schoolYearId}?save=true", new object());

                    if (result?.Success == true && result.Data != null)
                    {
                        var d = result.Data;
                        totalSuccess += d.SuccessCount;
                        totalFail    += d.FailCount;
                        totalSkipped += d.SkippedCount;
                        _pricingLog[_pricingLog.Count - 1] =
                            $"[{i + 1}/{schoolIds.Count}] ✅ {schoolName} – " +
                            $"{d.TotalStudents} תלמידים, {d.SuccessCount} הצליחו" +
                            (d.FailCount    > 0 ? $", {d.FailCount} נכשלו"  : "") +
                            (d.SkippedCount > 0 ? $", {d.SkippedCount} דולגו" : "");
                    }
                    else
                    {
                        _pricingSuccess = false;
                        _pricingLog[_pricingLog.Count - 1] =
                            $"[{i + 1}/{schoolIds.Count}] ❌ {schoolName} – {result?.Message ?? "שגיאה לא ידועה"}";
                    }
                }
                catch (Exception ex)
                {
                    _pricingSuccess = false;
                    _pricingLog[_pricingLog.Count - 1] =
                        $"[{i + 1}/{schoolIds.Count}] ❌ {schoolName} – שגיאה: {ex.Message}";
                }

                StateHasChanged();
            }

            _pricingSummary = _pricingSuccess
                ? $"חישוב תמחור הושלם: {totalSuccess} הצליחו, {totalFail} נכשלו, {totalSkipped} דולגו"
                : $"חישוב תמחור הסתיים עם שגיאות: {totalSuccess} הצליחו, {totalFail} נכשלו";

            _selectionMode = false;
            _selectedSchoolYearIds.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error running bulk pricing: {ex.Message}");
            _pricingSuccess = false;
            _pricingSummary = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isRunningPricing = false;
            StateHasChanged();
        }
    }

    private class SchoolPricingResult
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public SchoolPricingData? Data { get; set; }
    }

    private class SchoolPricingData
    {
        public int TotalStudents { get; set; }
        public int SuccessCount  { get; set; }
        public int FailCount     { get; set; }
        public int SkippedCount  { get; set; }
    }

    // Add school modal reference
    private AddSchoolModal? _addSchoolModal;

    // Council Excel export state
    private bool _isGenerating = false;
    private string? _generateSummary;
    private bool _generateSuccess;
    private List<string> _generateLog = new();

    // REQUIRED by SecurePageBase
    protected override string PageName => "schoollist";

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            // Get year value for display from backend session
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearValue");
            _yearDisplay = yearValueResponse?["value"] ?? "";

            // Get year ID for API call from backend session
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            var yearId = yearIdResponse?["value"];
            
            if (string.IsNullOrEmpty(yearId))
            {
                Console.WriteLine("❌ No SelectedYearId in session");
                return;
            }

            // Fetch schools from API
            _schools = await ApiService.GetAsync<List<SchoolDto>>($"entities/schools?yearId={yearId}") ?? new();

            // Build lookup for pricing progress log
            _schoolYearIdToName = _schools
                .Where(s => s.SchoolYearId.HasValue)
                .ToDictionary(s => s.SchoolYearId!.Value, s => s.Name);

            Console.WriteLine($"🏫 Loaded {_schools.Count} schools");
            
            // Apply initial sort
            ApplySort();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading schools: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בטעינת רשימת בתי ספר");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        _sortedSchools = _sortColumn switch
        {
            nameof(SchoolDto.Name) => _sortAscending 
                ? _schools.OrderBy(s => s.Name).ToList() 
                : _schools.OrderByDescending(s => s.Name).ToList(),
            nameof(SchoolDto.Symbol) => _sortAscending 
                ? _schools.OrderBy(s => s.Symbol).ToList() 
                : _schools.OrderByDescending(s => s.Symbol).ToList(),
            nameof(SchoolDto.PrincipalName) => _sortAscending 
                ? _schools.OrderBy(s => s.PrincipalName).ToList() 
                : _schools.OrderByDescending(s => s.PrincipalName).ToList(),
            nameof(SchoolDto.InspectorName) => _sortAscending 
                ? _schools.OrderBy(s => s.InspectorName).ToList() 
                : _schools.OrderByDescending(s => s.InspectorName).ToList(),
            nameof(SchoolDto.ContactPerson) => _sortAscending 
                ? _schools.OrderBy(s => s.ContactPerson).ToList() 
                : _schools.OrderByDescending(s => s.ContactPerson).ToList(),
            nameof(SchoolDto.EducationStage) => _sortAscending 
                ? _schools.OrderBy(s => s.EducationStage).ToList() 
                : _schools.OrderByDescending(s => s.EducationStage).ToList(),
            nameof(SchoolDto.OwnerName) => _sortAscending 
                ? _schools.OrderBy(s => s.OwnerName).ToList() 
                : _schools.OrderByDescending(s => s.OwnerName).ToList(),
            _ => _schools.OrderBy(s => s.Name).ToList()
        };
    }

    private string GetSortIcon(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

