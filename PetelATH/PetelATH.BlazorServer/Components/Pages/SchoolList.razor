    private async Task GenerateCouncilExcels()
    {
        var warningMessage = "התהליך ייצור/יעדכן קבצי דוח 10 לכל הרשויות המשלחות עבור שנת הלימודים שנבחרה. האם להמשיך?";
        var shouldContinue = await JSRuntime.InvokeAsync<bool>("confirm", warningMessage);
        if (!shouldContinue)
        {
            _generateSuccess = false;
            _generateSummary = "הפעולה בוטלה על ידי המשתמש";
            _generateLog = new();
            StateHasChanged();
            return;
        }

        _isGenerating = true;
        _generateSummary = null;
        _generateLog = new();
        StateHasChanged();

        try
        {
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            var yearId = yearIdResponse?["value"];

            if (string.IsNullOrEmpty(yearId))
            {
                _generateSuccess = false;
                _generateSummary = "לא נבחרה שנת לימודים";
                return;
            }

            var result = await ApiService.PostAsync<object, GenerateCouncilResult>(
                $"documents/generate-council-excels?yearId={yearId}", new object());

            _generateSuccess = result?.Success ?? false;
            _generateSummary = result?.Message ?? "הפעולה הסתיימה.";
            _generateLog     = result?.Log ?? new List<string>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating council Excels: {ex.Message}");
            _generateSuccess = false;
            _generateSummary = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private record GenerateCouncilResult(
        bool Success,
        string Message,
        int Created,
        int Updated,
        int Failed,
        List<string> Log
    );

