    private async Task LinkCouncilDocumentsForAllSchools()
    {
        if (_schools == null || _schools.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אין בתי ספר ברשימה");
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"האם ברצונך לקשר מסמכי תלמידים לישות הרשות השולחת שלהם?\n" +
            $"יעובדו {_schools.Count} בתי ספר.\n\n" +
            "פעולה זו לא תשכפל קישורים קיימים.");

        if (!confirmed) return;

        _isLinkingCouncilDocs = true;
        _councilLinkSummary = null;
        _councilLinkLog = new();
        _councilLinkSuccess = false;
        StateHasChanged();

        int totalLinked = 0;
        int totalSkipped = 0;
        int totalErrors = 0;
        int totalStudents = 0;
        int schoolsProcessed = 0;

        try
        {
            foreach (var school in _schools)
            {
                if (!school.SchoolYearId.HasValue) continue;

                try
                {
                    var result = await ApiService.PostAsync<object, SchoolCouncilLinkResult>(
                        $"documents/link-council-documents-for-school?schoolYearId={school.SchoolYearId.Value}",
                        new object());

                    if (result != null)
                    {
                        totalStudents += result.StudentsProcessed;
                        totalLinked   += result.TotalLinked;
                        totalSkipped  += result.TotalSkipped;
                        totalErrors   += result.ErrorCount;

                        var status = result.Success ? "✓" : "✗";
                        _councilLinkLog.Add(
                            $"{status} {school.Name} — תלמידים: {result.StudentsProcessed}, " +
                            $"קושרו: {result.TotalLinked}, קיימים: {result.TotalSkipped}" +
                            (result.ErrorCount > 0 ? $", שגיאות: {result.ErrorCount}" : ""));
                    }
                }
                catch (Exception ex)
                {
                    totalErrors++;
                    _councilLinkLog.Add($"✗ {school.Name} — שגיאה: {ex.Message}");
                }

                schoolsProcessed++;
                StateHasChanged();
            }

            _councilLinkSuccess = totalErrors == 0;
            _councilLinkSummary =
                $"הסתיים — {schoolsProcessed} בתי ספר, {totalStudents} תלמידים, " +
                $"{totalLinked} קישורים נוספו, {totalSkipped} קיימים" +
                (totalErrors > 0 ? $", {totalErrors} שגיאות" : "");
        }
        catch (Exception ex)
        {
            _councilLinkSuccess = false;
            _councilLinkSummary = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isLinkingCouncilDocs = false;
            StateHasChanged();
        }
    }

