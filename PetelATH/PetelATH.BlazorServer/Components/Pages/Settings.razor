@page "/settings"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@inject ApiService ApiService

<div class="school-title-section">
    <h1 class="page-title">הגדרות מערכת</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="settings_add" ScreenName="@PageName" FunctionName="ShowAddModal"
                      OnClick="ShowAddModal" CssClass="context-btn" HideIfNoAccess="true">
            <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural" style="width: 15px; height: 15px; margin-left: 5px;" />
            הוסף רשומה
        </SecureButton>
        <SecureButton ActionName="settings_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                      OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <div class="context-spacer"></div>
        <SecureButton ActionName="settings_back" ScreenName="@PageName" FunctionName="NavigateBack"
                      OnClick="NavigateBack" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
    </div>

    <div class="students-content">
        <div class="content-card">
            <div class="tabs-header settings-tabs">
                @foreach (var tab in Tabs)
                {
                    <button type="button"
                            class="tab-button @(_activeTab == tab.Key ? "active" : "")"
                            @onclick="() => SwitchTab(tab.Key)">
                        @tab.Label
                    </button>
                }
            </div>

            <div class="tab-content">
                @if (_isLoading)
                {
                    <div class="loading-spinner">טוען נתונים...</div>
                }
                else if (_errorMessage != null)
                {
                    <div class="error-message">
                        <p>שגיאה בטעינת הטבלה</p>
                        <p>@_errorMessage</p>
                        <button class="btn-secondary" @onclick="RefreshData">נסה שוב</button>
                    </div>
                }
                else
                {
                    <div class="filter-bar">
                        <input type="text" class="form-control" @bind="_filterText" @bind:event="oninput"
                               placeholder="סנן לפי שם..." />
                    </div>

                    @if (FilteredItems.Count == 0)
                    {
                        <div class="no-data-message">אין רשומות להצגה</div>
                    }
                    else
                    {
                        <TableExcelExport>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>פעולות</th>
                                        <th @onclick='() => SortTable("Id")' style="cursor: pointer;">
                                            מזהה @GetSortArrow("Id")
                                        </th>
                                        <th @onclick='() => SortTable("Name")' style="cursor: pointer;">
                                            שם @GetSortArrow("Name")
                                        </th>
                                        @if (CurrentTab.HasObject)
                                        {
                                            <th>אובייקט</th>
                                        }
                                        @if (CurrentTab.HasDescription)
                                        {
                                            <th>תיאור</th>
                                        }
                                        @if (CurrentTab.HasSortOrder)
                                        {
                                            <th @onclick='() => SortTable("SortOrder")' style="cursor: pointer;">
                                                סדר @GetSortArrow("SortOrder")
                                            </th>
                                        }
                                        @if (CurrentTab.HasIsCredit)
                                        {
                                            <th>זיכוי</th>
                                        }
                                        <th @onclick='() => SortTable("IsActive")' style="cursor: pointer;">
                                            פעיל @GetSortArrow("IsActive")
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in FilteredItems)
                                    {
                                        <tr class="@(item.IsActive ? "" : "inactive-row")">
                                            <td>
                                                <SecureButton ActionName="settings_edit" ScreenName="@PageName" FunctionName="ShowEditModal"
                                                              OnClick="@(() => ShowEditModal(item))" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                                    <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural" />
                                                </SecureButton>
                                                @if (item.IsActive)
                                                {
                                                    <SecureButton ActionName="settings_delete" ScreenName="@PageName" FunctionName="SoftDelete"
                                                                  OnClick="@(() => SoftDelete(item))" CssClass="btn-icon" Title="הסר" HideIfNoAccess="true">
                                                        <img src="/images/delete_icon.png" alt="הסר" class="action-icon-natural" />
                                                    </SecureButton>
                                                }
                                            </td>
                                            <td>@item.Id</td>
                                            <td>@(item.Name ?? "-")</td>
                                            @if (CurrentTab.HasObject)
                                            {
                                                <td>@(item.Object ?? "-")</td>
                                            }
                                            @if (CurrentTab.HasDescription)
                                            {
                                                <td>@(item.Description ?? "-")</td>
                                            }
                                            @if (CurrentTab.HasSortOrder)
                                            {
                                                <td>@(item.SortOrder?.ToString() ?? "-")</td>
                                            }
                                            @if (CurrentTab.HasIsCredit)
                                            {
                                                <td>@(item.IsCredit == true ? "כן" : "לא")</td>
                                            }
                                            <td>@(item.IsActive ? "כן" : "לא")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        </TableExcelExport>
                    }
                }
            </div>
        </div>
    </div>
</div>

@if (_showModal)
{
    <div class="modal-overlay" style="display: flex;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>@_modalTitle</h3>
                <button type="button" class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>שם: <span style="color: red;">*</span></label>
                    <input type="text" class="form-control" @bind="_form.Name" maxlength="100" />
                </div>
                @if (CurrentTab.HasObject)
                {
                    <div class="form-group">
                        <label>אובייקט:</label>
                        <input type="text" class="form-control" @bind="_form.Object" maxlength="25" />
                    </div>
                }
                @if (CurrentTab.HasDescription)
                {
                    <div class="form-group">
                        <label>תיאור:</label>
                        <input type="text" class="form-control" @bind="_form.Description" maxlength="200" />
                    </div>
                }
                @if (CurrentTab.HasSortOrder)
                {
                    <div class="form-group">
                        <label>סדר תצוגה:</label>
                        <input type="number" class="form-control" @bind="_form.SortOrder" />
                    </div>
                }
                @if (CurrentTab.HasIsCredit)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_formIsCredit" />
                            זיכוי
                        </label>
                    </div>
                }
                @if (_isEditMode)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_formIsActive" />
                            פעיל
                        </label>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="error-message" style="margin-top: 10px;">@_modalError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-primary" @onclick="SaveRow" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
                <button class="btn-secondary" @onclick="CloseModal" disabled="@_isSaving">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "settings";

    private static readonly LookupTab[] Tabs =
    {
        new("statuses", "סטטוסים", HasObject: true, HasSortOrder: true),
        new("entity-types", "סוגי ישויות"),
        new("council-types", "סוגי רשויות", HasSortOrder: true),
        new("districts", "מחוזות", HasSortOrder: true),
        new("transaction-account-types", "סוגי חשבונות", HasDescription: true, HasSortOrder: true),
        new("transaction-types", "סוגי תנועות", HasDescription: true, HasIsCredit: true),
        new("transaction-detail-types", "סוגי פירוט", HasDescription: true),
        new("alert-types", "סוגי התראות", HasDescription: true),
        new("alert-statuses", "סטטוסי התראות", HasDescription: true),
        new("alert-levels", "רמות התראות", HasDescription: true),
        new("document-status-types", "סטטוסי מסמכים"),
        new("special-needs-characterizations", "אפיוני חינוך מיוחד")
    };

    private string _activeTab = Tabs[0].Key;
    private List<LookupItemDto> _items = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private string _filterText = "";
    private string _sortColumn = "Id";
    private bool _sortAscending = true;

    private bool _showModal;
    private bool _isEditMode;
    private bool _isSaving;
    private string _modalTitle = "";
    private string? _modalError;
    private int _editingId;
    private LookupSaveRequest _form = new();
    private bool _formIsCredit;
    private bool _formIsActive = true;

    private LookupTab CurrentTab => Tabs.FirstOrDefault(t => t.Key == _activeTab) ?? Tabs[0];

    private List<LookupItemDto> FilteredItems
    {
        get
        {
            IEnumerable<LookupItemDto> query = _items;
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                query = query.Where(i =>
                    (i.Name?.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.Description?.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (i.Object?.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            query = _sortColumn switch
            {
                "Name" => _sortAscending ? query.OrderBy(i => i.Name) : query.OrderByDescending(i => i.Name),
                "SortOrder" => _sortAscending ? query.OrderBy(i => i.SortOrder ?? int.MaxValue) : query.OrderByDescending(i => i.SortOrder ?? int.MinValue),
                "IsActive" => _sortAscending ? query.OrderBy(i => i.IsActive) : query.OrderByDescending(i => i.IsActive),
                _ => _sortAscending ? query.OrderBy(i => i.Id) : query.OrderByDescending(i => i.Id)
            };

            return query.ToList();
        }
    }

    protected override async Task OnPageInitializedAsync()
    {
        await LoadTabData();
    }

    private async Task SwitchTab(string key)
    {
        if (_activeTab == key)
            return;

        _activeTab = key;
        _filterText = "";
        _sortColumn = "Id";
        _sortAscending = true;
        await LoadTabData();
    }

    private async Task RefreshData() => await LoadTabData();

    private async Task LoadTabData()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            _items = await ApiService.GetAsync<List<LookupItemDto>>($"lookups/{_activeTab}") ?? new();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _items = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddModal()
    {
        _isEditMode = false;
        _editingId = 0;
        _modalTitle = $"הוסף — {CurrentTab.Label}";
        _form = new LookupSaveRequest();
        _formIsCredit = false;
        _formIsActive = true;
        _modalError = null;
        _showModal = true;
    }

    private void ShowEditModal(LookupItemDto item)
    {
        _isEditMode = true;
        _editingId = item.Id;
        _modalTitle = $"ערוך — {CurrentTab.Label}";
        _form = new LookupSaveRequest
        {
            Name = item.Name,
            Description = item.Description,
            Object = item.Object,
            SortOrder = item.SortOrder,
            IsCredit = item.IsCredit,
            IsActive = item.IsActive
        };
        _formIsCredit = item.IsCredit == true;
        _formIsActive = item.IsActive;
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _modalError = null;
    }

    private async Task SaveRow()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _modalError = "שם הוא שדה חובה";
            return;
        }

        _form.IsCredit = CurrentTab.HasIsCredit ? _formIsCredit : null;
        _form.IsActive = _isEditMode ? _formIsActive : true;

        _isSaving = true;
        StateHasChanged();

        try
        {
            LookupApiResponse? response;
            if (_isEditMode)
            {
                response = await ApiService.PutAsync<LookupSaveRequest, LookupApiResponse>(
                    $"lookups/{_activeTab}/{_editingId}", _form);
            }
            else
            {
                response = await ApiService.PostAsync<LookupSaveRequest, LookupApiResponse>(
                    $"lookups/{_activeTab}", _form);
            }

            if (response?.Success == true)
            {
                CloseModal();
                await LoadTabData();
            }
            else
            {
                _modalError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        catch (HttpStatusException ex)
        {
            _modalError = ExtractApiMessage(ex) ?? ex.Message;
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SoftDelete(LookupItemDto item)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"להסיר את \"{item.Name}\"? הרשומה תישאר במערכת אך לא תופיע ברשימות בחירה.");
        if (!confirmed)
            return;

        try
        {
            var response = await ApiService.DeleteAsync<LookupApiResponse>($"lookups/{_activeTab}/{item.Id}");
            if (response?.Success != true)
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהסרת הרשומה");
                return;
            }

            await LoadTabData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בהסרת הרשומה: {ex.Message}");
        }
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/maindashboard");
    }

    private static string? ExtractApiMessage(HttpStatusException ex)
    {
        if (string.IsNullOrWhiteSpace(ex.ResponseContent))
            return null;

        try
        {
            var parsed = System.Text.Json.JsonSerializer.Deserialize<LookupApiResponse>(
                ex.ResponseContent,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            return parsed?.Message;
        }
        catch
        {
            return null;
        }
    }

    private sealed record LookupTab(
        string Key,
        string Label,
        bool HasObject = false,
        bool HasDescription = false,
        bool HasSortOrder = false,
        bool HasIsCredit = false);
}

<style>
    .settings-tabs {
        flex-wrap: wrap;
    }

    .inactive-row {
        opacity: 0.55;
        background: #f8f9fa;
    }

    .filter-bar {
        margin-bottom: 12px;
        max-width: 360px;
    }
</style>
