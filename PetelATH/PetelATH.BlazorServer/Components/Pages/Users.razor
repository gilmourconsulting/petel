    private void CloseManageRolesDialog()
    {
        _showManageRolesDialog = false;
        _manageRolesUserId = 0;
        _manageRolesUserName = string.Empty;
        _userCurrentRoles.Clear();
        _availableRoles.Clear();
        _filteredAvailableRoles.Clear();
        _selectedRolesToAdd.Clear();
        _availableRolesSearchTerm = string.Empty;
    }

    private async Task LoadUserRoles()
    {
        try
        {
            // Load user's current roles
            var currentRolesResponse = await ApiService.GetAsync<ApiResponse<List<RoleDto>>>($"users/{_manageRolesUserId}/roles");
            if (currentRolesResponse?.Data != null)
            {
                _userCurrentRoles = currentRolesResponse.Data;
            }
            else
            {
                _userCurrentRoles = new List<RoleDto>();
            }

            // Load all available roles (roles user doesn't have)
            var availableRolesResponse = await ApiService.GetAsync<ApiResponse<List<RoleDto>>>("roles");
            if (availableRolesResponse?.Data != null)
            {
                // Filter out roles the user already has
                _availableRoles = availableRolesResponse.Data
                    .Where(r => !_userCurrentRoles.Any(ur => ur.Id == r.Id))
                    .ToList();
                _filteredAvailableRoles = _availableRoles;
            }
            else
            {
                _availableRoles = new List<RoleDto>();
                _filteredAvailableRoles = new List<RoleDto>();
            }

            _selectedRolesToAdd.Clear();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
            throw;
        }
    }

    private void SelectRole(RoleDto role)
    {
        if (!_selectedRolesToAdd.Any(r => r.Id == role.Id))
        {
            _selectedRolesToAdd.Add(role);
            FilterAvailableRoles(); // Re-filter to remove from available list
        }
    }

    private void DeselectRole(RoleDto role)
    {
        _selectedRolesToAdd.RemoveAll(r => r.Id == role.Id);
        FilterAvailableRoles(); // Re-filter to add back to available list
    }

    private void FilterAvailableRoles()
    {
        var searchTerm = _availableRolesSearchTerm?.ToLower() ?? string.Empty;
        
        _filteredAvailableRoles = _availableRoles
            .Where(r => !_selectedRolesToAdd.Any(s => s.Id == r.Id)) // Exclude selected
            .Where(r => string.IsNullOrEmpty(searchTerm) ||
                       r.Name.ToLower().Contains(searchTerm))
            .ToList();
    }

    private async Task RemoveRoleFromUser(int roleId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם אתה בטוח שברצונך להסיר תפקיד זה מהמשתמש?");
        
        if (!confirmed) return;

        try
        {
            var success = await ApiService.DeleteAsync($"roles/{roleId}/users/{_manageRolesUserId}");
            
            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "התפקיד הוסר בהצלחה");
                await LoadUserRoles(); // Reload roles
                await LoadUsersData(); // Refresh user list
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה בהסרת התפקיד");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing role: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בהסרת התפקיד");
        }
    }

    private async Task SubmitRoleChanges()
    {
        if (_selectedRolesToAdd.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אנא בחר לפחות תפקיד אחד");
            return;
        }

        try
        {
            int successCount = 0;
            int failCount = 0;
            var errors = new List<string>();

            foreach (var role in _selectedRolesToAdd)
            {
                try
                {
                    var response = await ApiService.PostAsync<object, object>(
                        $"roles/{role.Id}/users", 
                        new { userId = _manageRolesUserId });
                    
                    if (response != null)
                    {
                        successCount++;
                    }
                    else
                    {
                        failCount++;
                        errors.Add($"{role.Name}: שגיאה");
                    }
                }
                catch (Exception ex)
                {
                    failCount++;
                    errors.Add($"{role.Name}: {ex.Message}");
                }
            }

            var message = "";
            if (successCount > 0)
            {
                message += $"✅ {successCount} תפקידים נוספו בהצלחה\n";
            }
            if (failCount > 0)
            {
                message += $"❌ {failCount} תפקידים נכשלו";
            }

            await JSRuntime.InvokeVoidAsync("alert", message);

            if (successCount > 0)
            {
                CloseManageRolesDialog();
                await LoadUsersData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding roles: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה כללית בהוספת התפקידים");
        }
    }

