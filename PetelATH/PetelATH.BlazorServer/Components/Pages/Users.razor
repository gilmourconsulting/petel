@page "/users"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Services
@inject ApiService ApiService
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<Users> Logger

<div class="school-title-section">
    <h1 class="page-title">ניהול משתמשים</h1>
</div>

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="users_refresh" ScreenName="@PageName" FunctionName="RefreshData" OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <SecureButton ActionName="users_create" ScreenName="@PageName" FunctionName="ShowCreateUserDialog" OnClick="ShowCreateUserDialog" CssClass="context-btn">
            הוסף משתמש חדש
        </SecureButton>
        <SecureButton ActionName="users_maindashboard" ScreenName="@PageName" FunctionName="NavigateToMainDashboard" OnClick="NavigateToMainDashboard" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
        <SecureButton ActionName="users_roles" ScreenName="@PageName" FunctionName="NavigateToRoles" OnClick="NavigateToRoles" CssClass="context-btn">
            ניהול תפקידים
        </SecureButton>
        <SecureButton ActionName="users_refreshcache" ScreenName="@PageName" FunctionName="RefreshSecurityCache" OnClick="RefreshSecurityCache" CssClass="context-btn">
            רענן מטמון אבטחה
        </SecureButton>
    </div>

    <!-- Main content area -->
    <div class="students-content">
        <div class="content-card">
            <h2 class="page-title">ניהול משתמשים</h2>

            <!-- Users summary info -->
            <div class="users-summary">
                <div class="summary-grid">
                    <div class="summary-card">
                        <div class="summary-icon">👥</div>
                        <div class="summary-info">
                            <div class="summary-value">@_summary.TotalUsers</div>
                            <div class="summary-label">סה"כ משתמשים</div>
                        </div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon">✅</div>
                        <div class="summary-info">
                            <div class="summary-value">@_summary.ActiveUsers</div>
                            <div class="summary-label">משתמשים פעילים</div>
                        </div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon">🚫</div>
                        <div class="summary-info">
                            <div class="summary-value">@_summary.InactiveUsers</div>
                            <div class="summary-label">משתמשים לא פעילים</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users table -->
            <div class="users-table-section">
                <h3>רשימת משתמשים</h3>
                @if (_isLoading)
                {
                    <div class="loading-spinner">טוען נתוני משתמשים...</div>
                }
                else if (_users.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו משתמשים</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>פעולות</th>
                                    <th @onclick="() => SortTable(nameof(UserDto.Username))" style="cursor: pointer;">
                                        שם משתמש @GetSortArrow(nameof(UserDto.Username))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.EntityName))" style="cursor: pointer;">
                                        ישות @GetSortArrow(nameof(UserDto.EntityName))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.FullName))" style="cursor: pointer;">
                                        שם מלא @GetSortArrow(nameof(UserDto.FullName))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.Email))" style="cursor: pointer;">
                                        אימייל @GetSortArrow(nameof(UserDto.Email))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.Phone))" style="cursor: pointer;">
                                        טלפון @GetSortArrow(nameof(UserDto.Phone))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.IsActive))" style="cursor: pointer;">
                                        סטטוס @GetSortArrow(nameof(UserDto.IsActive))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.LastLogin))" style="cursor: pointer;">
                                        כניסה אחרונה @GetSortArrow(nameof(UserDto.LastLogin))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.FailedPasswordAttempts))" style="cursor: pointer;">
                                        נסיונות סיסמה כושלים @GetSortArrow(nameof(UserDto.FailedPasswordAttempts))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.FailedOtpAttempts))" style="cursor: pointer;">
                                        נסיונות OTP כושלים @GetSortArrow(nameof(UserDto.FailedOtpAttempts))
                                    </th>
                                    <th @onclick="() => SortTable(nameof(UserDto.OtpVerified))" style="cursor: pointer;">
                                        OTP מאומת @GetSortArrow(nameof(UserDto.OtpVerified))
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in _users)
                                {
                                    <tr>
                                        <td>
                                            <SecureButton ActionName="users_edit" ScreenName="@PageName" FunctionName="EditUser" OnClick="() => EditUser(user)" CssClass="btn-icon" Title="ערוך משתמש">
                                                <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                            </SecureButton>
                                            <SecureButton ActionName="users_changepassword" ScreenName="@PageName" FunctionName="ShowChangePasswordDialog" OnClick="() => ShowChangePasswordDialog(user)" CssClass="btn-icon" Title="שנה סיסמה">
                                                <img src="/images/change_password.png" alt="שנה סיסמה" class="action-icon-natural">
                                            </SecureButton>
                                            <SecureButton ActionName="users_manageroles" ScreenName="@PageName" FunctionName="ManageUserRoles" OnClick="() => ManageUserRoles(user)" CssClass="btn-icon" Title="נהל תפקידים">
                                                <img src="/images/stats_icon.png" alt="תפקידים" class="action-icon-natural">
                                            </SecureButton>
                                            @if (user.IsLocked)
                                            {
                                                <SecureButton ActionName="users_unlock" ScreenName="@PageName" FunctionName="UnlockUser" OnClick="() => UnlockUser(user)" CssClass="btn-icon" Title="בטל נעילה">
                                                    <img src="/images/unlock_icon.png" alt="בטל נעילה" class="action-icon-natural">
                                                </SecureButton>
                                            }
                                            else
                                            {
                                                <SecureButton ActionName="users_lock" ScreenName="@PageName" FunctionName="LockUser" OnClick="() => LockUser(user)" CssClass="btn-icon" Title="נעל משתמש">
                                                    <img src="/images/lock_icon.png" alt="נעל" class="action-icon-natural">
                                                </SecureButton>
                                            }
                                            <SecureButton ActionName="users_resetotp" ScreenName="@PageName" FunctionName="ResetOtpVerification" OnClick="() => ResetOtpVerification(user)" CssClass="btn-icon" Title="אפס אימות דו-שלבי">
                                                <img src="/images/reset_icon.png" alt="אפס OTP" class="action-icon-natural">
                                            </SecureButton>
                                            <SecureButton ActionName="users_resetfailedattempts" ScreenName="@PageName" FunctionName="ResetFailedAttempts" OnClick="() => ResetFailedAttempts(user)" CssClass="btn-icon" Title="אפס נסיונות כושלים">
                                                <img src="/images/unlock_icon.png" alt="אפס נסיונות" class="action-icon-natural">
                                            </SecureButton>
                                        </td>
                                        <td>@user.Username</td>
                                        <td>@user.EntityName</td>
                                        <td>@user.FullName</td>
                                        <td>@user.Email</td>
                                        <td>@(user.Phone ?? "")</td>
                                        <td>
                                            <span class="status-badge @(user.IsActive ? "active" : "inactive")">
                                                @(user.IsActive ? "פעיל" : "לא פעיל")
                                            </span>
                                            @if (user.IsLocked)
                                            {
                                                <span class="status-badge locked" title="@(user.LockReasonName ?? "נעול")">
                                                    נעול — @(user.LockReasonName ?? "סיבה לא ידועה")
                                                </span>
                                            }
                                        </td>
                                        <td>@(user.LastLogin?.ToString("dd/MM/yyyy HH:mm") ?? "אף פעם")</td>
                                        <td style="text-align: center;">@(user.FailedPasswordAttempts > 0 ? user.FailedPasswordAttempts.ToString() : "-")</td>
                                        <td style="text-align: center;">@(user.FailedOtpAttempts > 0 ? user.FailedOtpAttempts.ToString() : "-")</td>
                                        <td style="text-align: center;">
                                            <span class="status-badge @(user.OtpVerified ? "active" : "inactive")">
                                                @(user.OtpVerified ? "כן" : "לא")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit User Dialog -->
@if (_showUserDialog)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3>@(_isEditMode ? "ערוך משתמש" : "משתמש חדש")</h3>
                <button class="modal-close" @onclick="CloseUserDialog">&times;</button>
            </div>
            <div class="modal-body">
                <EditForm Model="_userForm" OnValidSubmit="HandleUserSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label for="username">שם משתמש *</label>
                        <InputText id="username" @bind-Value="_userForm.Username" class="form-control" />
                        <ValidationMessage For="() => _userForm.Username" />
                    </div>

                    <div class="form-group">
                        <label for="email">אימייל *</label>
                        <InputText id="email" @bind-Value="_userForm.Email" class="form-control" type="email" />
                        <ValidationMessage For="() => _userForm.Email" />
                    </div>

                    <div class="form-group">
                        <label for="entity">ישות *</label>
                        <InputSelect id="entity" @bind-Value="_userForm.EntityId" class="form-control">
                            <option value="0">-- בחר ישות --</option>
                            @foreach (var entity in _entities)
                            {
                                <option value="@entity.Id">@entity.EntityName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _userForm.EntityId" />
                    </div>

                    <div style="display: flex; gap: 15px;">
                        <div class="form-group" style="flex: 1;">
                            <label for="firstName">שם פרטי *</label>
                            <InputText id="firstName" @bind-Value="_userForm.FirstName" class="form-control" />
                            <ValidationMessage For="() => _userForm.FirstName" />
                        </div>
                        <div class="form-group" style="flex: 1;">
                            <label for="lastName">שם משפחה *</label>
                            <InputText id="lastName" @bind-Value="_userForm.LastName" class="form-control" />
                            <ValidationMessage For="() => _userForm.LastName" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="phone">טלפון</label>
                        <InputText id="phone" @bind-Value="_userForm.Phone" class="form-control" />
                        <ValidationMessage For="() => _userForm.Phone" />
                    </div>

                    @if (!_isEditMode)
                    {
                        <div class="form-group">
                            <label for="password">סיסמה *</label>
                            <InputText id="password" @bind-Value="_userForm.Password" class="form-control" type="password" />
                            <ValidationMessage For="() => _userForm.Password" />
                        </div>
                    }

                    <div class="form-group">
                        <label class="checkbox-label">
                            <InputCheckbox @bind-Value="_userForm.IsActive" />
                            משתמש פעיל
                        </label>
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            <InputCheckbox @bind-Value="_userForm.PasswordChangeRequired" />
                            דרוש שינוי סיסמה בכניסה הבאה
                        </label>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseUserDialog">ביטול</button>
                        <button type="submit" class="btn-primary">@(_isEditMode ? "שמור" : "צור משתמש")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Change Password Dialog -->
@if (_showChangePasswordDialog)
{
    <div class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <h3>שינוי סיסמה למשתמש: @_changePasswordUserName</h3>
                <button class="modal-close" @onclick="CloseChangePasswordDialog">&times;</button>
            </div>
            <div class="modal-body">
                <EditForm Model="_changePasswordForm" OnValidSubmit="HandleChangePasswordSubmit">
                    <DataAnnotationsValidator />
                    
                    <div class="form-group">
                        <label for="newPassword">סיסמה חדשה *</label>
                        <InputText id="newPassword" @bind-Value="_changePasswordForm.NewPassword" class="form-control" type="password" />
                        <ValidationMessage For="() => _changePasswordForm.NewPassword" />
                        <small style="color: #666; font-size: 12px; margin-top: 4px; display: block;">
                            סיסמה חייבת להכיל לפחות 6 תווים
                        </small>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword">אימות סיסמה חדשה *</label>
                        <InputText id="confirmPassword" @bind-Value="_changePasswordForm.ConfirmPassword" class="form-control" type="password" />
                        <ValidationMessage For="() => _changePasswordForm.ConfirmPassword" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn-secondary" @onclick="CloseChangePasswordDialog">ביטול</button>
                        <button type="submit" class="btn-primary">שנה סיסמה</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Lock Reason Dialog -->
@if (_showLockReasonDialog && _lockTargetUser != null)
{
    <div class="modal-overlay" @onclick="CloseLockReasonDialog">
        <div class="modal-content" style="max-width: 450px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>נעילת משתמש: @_lockTargetUser.FullName</h3>
                <button class="modal-close" @onclick="CloseLockReasonDialog">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">סיבת הנעילה:</label>
                    @if (_lockReasons.Count == 0)
                    {
                        <p style="color: #6c757d;">טוען סיבות נעילה...</p>
                    }
                    else
                    {
                        @foreach (var reason in _lockReasons)
                        {
                            <div style="margin-bottom: 10px;">
                                <label style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;">
                                    <input type="radio"
                                           name="lockReason"
                                           value="@reason.Id"
                                           checked="@(_selectedLockReasonId == reason.Id)"
                                           @onchange="() => _selectedLockReasonId = reason.Id"
                                           style="margin-top: 3px;" />
                                    <span>
                                        <strong>@reason.Name</strong>
                                        @if (!string.IsNullOrEmpty(reason.Description))
                                        {
                                            <br /><small style="color: #6c757d;">@reason.Description</small>
                                        }
                                        @if (!reason.AllowForgotPassword)
                                        {
                                            <br /><small style="color: #dc3545;">⚠ שחזור סיסמה לא יהיה זמין למשתמש זה</small>
                                        }
                                    </span>
                                </label>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="CloseLockReasonDialog">ביטול</button>
                <button type="button" class="btn-danger" @onclick="ConfirmLockUser" disabled="@(_selectedLockReasonId == null)">
                    נעל משתמש
                </button>
            </div>
        </div>
    </div>
}

<!-- Manage Roles Dialog -->
@if (_showManageRolesDialog)
{
    <div class="modal-overlay" @onclick="CloseManageRolesDialog">
        <div class="modal-content" style="min-width: 800px; max-width: 90%;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>ניהול תפקידים עבור: @_manageRolesUserName</h3>
                <button class="modal-close" @onclick="CloseManageRolesDialog">&times;</button>
            </div>
            <div class="modal-body">
                <!-- Current Roles Section -->
                @if (_userCurrentRoles.Count > 0)
                {
                    <div style="margin-bottom: 20px;">
                        <h4 style="margin-bottom: 10px; font-size: 16px; font-weight: 600;">תפקידים נוכחיים (@_userCurrentRoles.Count)</h4>
                        <div style="border: 1px solid #dee2e6; border-radius: 8px; padding: 10px; background-color: #f8f9fa; max-height: 200px; overflow-y: auto;">
                            @foreach (var role in _userCurrentRoles)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 8px; margin-bottom: 8px; background-color: white; border: 1px solid #dee2e6; border-radius: 4px;">
                                    <span style="font-weight: 500;">@role.Name</span>
                                    <button type="button" class="btn-icon" @onclick="() => RemoveRoleFromUser(role.Id)" title="הסר תפקיד">
                                        <img src="images/delete_icon.png" alt="הסר" class="action-icon-natural">
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Add Roles Section (Two-Column Pattern) -->
                <h4 style="margin-bottom: 10px; font-size: 16px; font-weight: 600;">הוסף תפקידים</h4>
                <div style="display: flex; gap: 20px; direction: rtl;">
                    <!-- Available Roles -->
                    <div style="flex: 1;">
                        <h4 style="margin-bottom: 10px; font-size: 16px; font-weight: 600;">תפקידים זמינים</h4>
                        <input type="text" @bind="_availableRolesSearchTerm" @bind:event="oninput" @onkeyup="FilterAvailableRoles"
                               placeholder="חיפוש תפקיד..."
                               style="width: 100%; padding: 8px; margin-bottom: 10px; border: 1px solid #dee2e6; border-radius: 4px; direction: rtl;">
                        <div style="border: 2px dashed #dee2e6; border-radius: 8px; min-height: 300px; max-height: 300px; overflow-y: auto; padding: 10px; background-color: #f8f9fa;">
                            @if (_filteredAvailableRoles == null || _filteredAvailableRoles.Count == 0)
                            {
                                <p style="text-align: center; color: #6c757d; padding: 20px;">אין תפקידים זמינים</p>
                            }
                            else
                            {
                                @foreach (var role in _filteredAvailableRoles)
                                {
                                    <div class="action-item" @onclick="() => SelectRole(role)">
                                        <div class="action-item-name">@role.Name</div>
                                    </div>
                                }
                            }
                        </div>
                        <small style="display: block; margin-top: 5px; color: #6c757d;">
                            לחץ על תפקיד כדי לבחור
                        </small>
                    </div>

                    <!-- Selected Roles to Add -->
                    <div style="flex: 1;">
                        <h4 style="margin-bottom: 10px; font-size: 16px; font-weight: 600;">תפקידים נבחרים (@_selectedRolesToAdd.Count)</h4>
                        <div style="height: 34px; margin-bottom: 10px;"></div>
                        <div style="border: 2px solid #28a745; border-radius: 8px; min-height: 300px; max-height: 300px; overflow-y: auto; padding: 10px; background-color: #f8f9fa;">
                            @if (_selectedRolesToAdd.Count == 0)
                            {
                                <p style="text-align: center; color: #6c757d; padding: 20px;">בחר תפקידים</p>
                            }
                            else
                            {
                                @foreach (var role in _selectedRolesToAdd)
                                {
                                    <div class="action-item" @onclick="() => DeselectRole(role)">
                                        <div class="action-item-name">@role.Name</div>
                                    </div>
                                }
                            }
                        </div>
                        <small style="display: block; margin-top: 5px; color: #6c757d;">
                            לחץ על תפקיד כדי להסיר
                        </small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" @onclick="CloseManageRolesDialog">ביטול</button>
                <button type="button" class="btn-primary" @onclick="SubmitRoleChanges" 
                        disabled="@(_selectedRolesToAdd.Count == 0)">
                    הוסף תפקידים (@_selectedRolesToAdd.Count)
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "users";

    private List<UserDto> _users = new();
    private List<UserDto> _filteredUsers = new();
    private bool _isLoading = true;
    private UserSummaryDto _summary = new();
    private List<EntityDto> _entities = new();

    private string _sortColumn = nameof(UserDto.FullName);
    private bool _sortAscending = true;

    // Dialog states
    private bool _showUserDialog = false;
    private bool _isEditMode = false;
    private UserFormModel _userForm = new();
    private int _editingUserId = 0;

    // Change password dialog states
    private bool _showChangePasswordDialog = false;
    private ChangePasswordFormModel _changePasswordForm = new();
    private int _changePasswordUserId = 0;
    private string _changePasswordUserName = string.Empty;

    // Role management dialog states
    private bool _showManageRolesDialog = false;
    private int _manageRolesUserId = 0;
    private string _manageRolesUserName = string.Empty;
    private List<RoleDto> _userCurrentRoles = new();
    private List<RoleDto> _availableRoles = new();
    private List<RoleDto> _filteredAvailableRoles = new();
    private List<RoleDto> _selectedRolesToAdd = new();
    private string _availableRolesSearchTerm = string.Empty;

    // Lock reason dialog states
    private bool _showLockReasonDialog = false;
    private UserDto? _lockTargetUser = null;
    private int? _selectedLockReasonId = null;
    private List<LockReasonDto> _lockReasons = new();

    protected override async Task OnPageInitializedAsync()
    {
        await LoadEntities();
        await LoadLockReasons();
        await LoadUsersData();
    }

    private async Task LoadEntities()
    {
        try
        {
            // Use the login endpoint which returns all active entities
            var response = await ApiService.GetAsync<List<EntityDto>>("entities/login");

            if (response != null)
            {
                _entities = response;
                Console.WriteLine($"✅ Loaded {_entities.Count} entities");
            }
            else
            {
                _entities = new List<EntityDto>();
                Console.WriteLine("⚠️ No entities returned from API");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading entities: {ex.Message}");
            _entities = new List<EntityDto>();
        }
    }

    private async Task LoadLockReasons()
    {
        try
        {
            var response = await ApiService.GetAsync<LockReasonsResponse>("users/lock-reasons");
            if (response?.Success == true && response.Data != null)
            {
                _lockReasons = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading lock reasons: {ex.Message}");
        }
    }

    private async Task LoadUsersData()
    {
        try
        {
            _isLoading = true;

            var response = await ApiService.GetAsync<UsersResponse>("users");

            if (response?.Success == true && response.Data != null)
            {
                _users = response.Data;
                UpdateSummary();
                ApplySort();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה בטעינת נתוני המשתמשים");
                _users = new List<UserDto>();
            }
        }
        catch (Exception ex)
        {
