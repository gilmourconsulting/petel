                    Email = _userForm.Email,
                    Phone = _userForm.Phone,
                    FirstName = _userForm.FirstName,
                    LastName = _userForm.LastName,
                    IsActive = _userForm.IsActive,
                    PasswordChangeRequired = _userForm.PasswordChangeRequired,
                    EntityId = _userForm.EntityId
                };

                var response = await ApiService.PutAsync<UpdateUserRequest, object>($"users/{_editingUserId}", updateRequest);
                
                if (response != null)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "המשתמש עודכן בהצלחה");
                    CloseUserDialog();
                    await LoadUsersData();
                }
            }
            else
            {
                var createRequest = new CreateUserRequest
                {
                    Username = _userForm.Username,
                    Email = _userForm.Email,
                    Phone = _userForm.Phone,
                    FirstName = _userForm.FirstName,
                    LastName = _userForm.LastName,
                    Password = _userForm.Password,
                    IsActive = _userForm.IsActive,
                    PasswordChangeRequired = _userForm.PasswordChangeRequired,
                    EntityId = _userForm.EntityId
                };

                var response = await ApiService.PostAsync<CreateUserRequest, object>("users", createRequest);
                
                if (response != null)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "המשתמש נוצר בהצלחה");
                    CloseUserDialog();
                    await LoadUsersData();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת המשתמש: {ex.Message}");
        }
    }

