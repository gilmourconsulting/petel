@page "/student"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Services
@using PetelATH.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionStateService

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="student_calculatePricing" ScreenName="@PageName"
            FunctionName="CalculateStudentPricing" OnClick="CalculateStudentPricing" CssClass="context-btn">
            חשב רכיבי תמחור לתלמיד
        </SecureButton>
        <SecureButton ActionName="student_generateDocuments" ScreenName="@PageName" FunctionName="GenerateDocuments"
            OnClick="GenerateDocuments" CssClass="context-btn">
            עדכן רשימת מסמכים לתלמיד
        </SecureButton>
        @if (_student != null)
        {
            <button class="context-btn @(_student.StatusId == 7 ? "context-btn-restore" : "context-btn-warning")"
                @onclick="ShowNoPermitModal">
                @(_student.StatusId == 7 ? "יש אישור לימודי חוץ" : "אין אישור לימודי חוץ")
            </button>
        }
        <div class="context-spacer"></div>
        @if (_isFromTransactionDetails)
        {
            <button class="context-navigation-btn" @onclick="NavigateBackToTransaction">
                חזרה לתנועה
            </button>
        }
        <SecureButton ActionName="student_backToSource" ScreenName="@PageName" FunctionName="NavigateBackToSource"
            OnClick="NavigateBackToSource" CssClass="context-navigation-btn">
            חזרה לרשימה
        </SecureButton>
        <SecureButton ActionName="student_schoolDashboard" ScreenName="@PageName"
            FunctionName="NavigateToSchoolDashboard" OnClick="NavigateToSchoolDashboard"
            CssClass="context-navigation-btn">
            לדף בית הספר
        </SecureButton>
        <button class="context-navigation-btn" @onclick="NavigateToSchoolList">
            רשימת בתי ספר
        </button>
    </div>

    <!-- Main content area -->
    <div class="students-content">
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">@_pageTitle</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>

            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else if (_student == null)
            {
                <div class="no-data-message">תלמיד לא נמצא</div>
            }
            else
            {
                <!-- Student Details -->
                <div class="content-card">
                    <div class="detail-card expanded">
                        <div class="detail-card-header">
                            <div class="detail-card-title">פרטי תלמיד</div>
                        </div>
                        <div class="detail-card-content">
                            @if (_student.StatusId == 7)
                            {
                                <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 8px 14px; margin-bottom: 14px; color: #856404; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                                    <span>⚠️</span>
                                    <span>תלמיד ללא אישור לימודי חוץ</span>
                                </div>
                            }
                            <div class="detail-fields-grid">
                                <!-- Personal Information Section -->
                                <div class="detail-section">
                                    <h4 class="detail-section-title">פרטים אישיים</h4>
                                    <div>
                                        <p class="detail-field">
                                            <span class="detail-field-label">ת.ז:</span>
                                            <span class="detail-field-value">@(_student.IdNumber ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">שם פרטי:</span>
                                            <span class="detail-field-value">@(_student.FirstName ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">שם משפחה:</span>
                                            <span class="detail-field-value">@(_student.LastName ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">כיתה:</span>
                                            <span class="detail-field-value">@(_student.ClassName ?? "לא זמין")</span>
                                        </p>
                                    </div>
                                </div>

                                <!-- Address Section -->
                                <div class="detail-section">
                                    <h4 class="detail-section-title">כתובת</h4>
                                    <div>
                                        <p class="detail-field">
                                            <span class="detail-field-label">רחוב:</span>
                                            <span class="detail-field-value">@(_student.Street ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">מספר בית:</span>
                                            <span class="detail-field-value">@(_student.HouseNumber ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">עיר:</span>
                                            <span class="detail-field-value">@(_student.City ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">מיקוד:</span>
                                            <span class="detail-field-value">@(_student.PostCode?.ToString() ?? "לא                                            זמין")</span>
                                        </p>
                                    </div>
                                </div>

                                <!-- Additional Information Section -->
                                <div class="detail-section">
                                    <h4 class="detail-section-title">נתוני אג"ח</h4>
                                    <div>
                                        <p class="detail-field">
                                            <span class="detail-field-label">רשות שולחת:</span>
                                            <span class="detail-field-value">@(_student.CouncilName ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">סטטוס:</span>
                                            <span class="detail-field-value">@(_student.Status ?? "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">עלות:</span>
                                            <span class="detail-field-value">
                                                @if (_pricingPeriods.Count > 1)
                                                {
                                                    <span>סה״כ @FormatTotalCost() ₪</span>
                                                    <span style="font-weight: 500; color: #555;">
                                                        (@FormatCouncilCostSplit())
                                                    </span>
                                                }
                                                else
                                                {
                                                    @(_student.Cost?.ToString("N2") + " ₪" ?? "לא זמין")
                                                }
                                            </span>
                                        </p>
                                    </div>
                                    </div>
                                    <div class="detail-section">
                                        <h4 class="detail-section-title">פרטים נוספים</h4>
                                        <div>
                                        <p class="detail-field">
                                            <span class="detail-field-label">קטגוריית נכות:</span>
                                            <span class="detail-field-value">@(_student.DisabilityCategory?.ToString() ??
                                                                                            "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">תאריך התחלה:</span>
                                            <span class="detail-field-value">@(_student.StartDate?.ToString("dd/MM/yyyy") ??
                                                                                            "לא זמין")</span>
                                        </p>
                                        <p class="detail-field">
                                            <span class="detail-field-label">תאריך סיום:</span>
                                            <span class="detail-field-value">@(_student.EndDate?.ToString("dd/MM/yyyy") ??
                                                                                            "לא זמין")</span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabs Container -->
                <div class="content-card">
                    <!-- Tab Headers -->
                    <div class="tabs-header">
                        <button class="tab-button @(_activeTab == "documents" ? "active" : "")"
                            @onclick='() => SwitchTab("documents")'>
                            מסמכים
                        </button>
                        <button class="tab-button @(_activeTab == "pricing" ? "active" : "")"
                            @onclick='() => SwitchTab("pricing")'>
                            רכיבי תמחור
                        </button>
                        <button class="tab-button @(_activeTab == "history" ? "active" : "")"
                            @onclick='() => SwitchTab("history")'>
                            היסטוריה
                        </button>
                    </div>

                    <!-- Tab Content - Documents -->
                    <div class="tab-content" style="display: @(_activeTab == "documents" ? "block" : "none");">
                        <!-- Student Documents Section -->
                        <div class="detail-card @(_studentDocsExpanded ? "expanded" : "collapsed")"
                            style="margin-bottom: 20px;">
                            <div class="detail-card-header" @onclick="() => _studentDocsExpanded = !_studentDocsExpanded">
                                <div class="detail-card-title">מסמכי תלמיד</div>
                                <div class="card-header-actions">
                                    <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                        @(_studentDocsExpanded ? "×" : "+")
                                    </button>
                                </div>
                            </div>
                            <div class="detail-card-content">
                                @if (_studentDocsExpanded && _student != null && _schoolId.HasValue && _yearId.HasValue)
                                {
                                    <DocumentsTable @ref="_studentDocsTable" EntityType="student" EntityId="@_student.Id"
                                        YearId="@_yearId" AllowDownload="true" AllowUpload="true" AllowDelete="true" />
                                }
                            </div>
                        </div>

                        <!-- School Documents Section -->
                        <div class="detail-card @(_schoolDocsExpanded ? "expanded" : "collapsed")"
                            style="margin-bottom: 20px;">
                            <div class="detail-card-header" @onclick="() => _schoolDocsExpanded = !_schoolDocsExpanded">
                                <div class="detail-card-title">מסמכי בית ספר</div>
                                <div class="card-header-actions">
                                    <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                        @(_schoolDocsExpanded ? "×" : "+")
                                    </button>
                                </div>
                            </div>
                            <div class="detail-card-content">
                                @if (_schoolDocsExpanded && _schoolId.HasValue && _yearId.HasValue)
                                {
                                    <DocumentsTable @ref="_schoolDocsTable" EntityType="school" EntityId="@_schoolId"
                                        YearId="@_yearId" AllowDownload="true" AllowUpload="false" AllowDelete="false" />
                                }
                            </div>
                        </div>

                        <!-- Entity Documents Section -->
                        <div class="detail-card @(_entityDocsExpanded ? "expanded" : "collapsed")">
                            <div class="detail-card-header" @onclick="() => _entityDocsExpanded = !_entityDocsExpanded">
                                <div class="detail-card-title">מסמכי הרשת</div>
                                <div class="card-header-actions">
                                    <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                        @(_entityDocsExpanded ? "×" : "+")
                                    </button>
                                </div>
                            </div>
                            <div class="detail-card-content">
                                @if (_entityDocsExpanded && _entityId.HasValue && _yearId.HasValue)
                                {
                                    <DocumentsTable @ref="_entityDocsTable" EntityType="entity" EntityId="@_entityId"
                                        YearId="@_yearId" AllowDownload="true" AllowUpload="false" AllowDelete="false" />
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Tab Content - Pricing -->
                    <div class="tab-content" style="display: @(_activeTab == "pricing" ? "block" : "none");">
                        <div class="detail-card @(_pricingExpanded ? "expanded" : "collapsed")" >
                            <div class="detail-card-header" @onclick="() => _pricingExpanded = !_pricingExpanded">
                                <div class="detail-card-title">רכיבי תמחור</div>
                                <div class="card-header-actions">
                                    <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                        @(_pricingExpanded ? "×" : "+")
                                    </button>
                                </div>
                            </div>
                            <div class="detail-card-content">
                                @if (_pricingExpanded)
                                {
                                    @if (_pricingLoading)
                                    {
                                        <div class="loading-spinner">טוען רכיבי תמחור...</div>
                                    }
                                    else if (!HasAnyPricingElements())
                                    {
                                        <div style="text-align: center; color: #666; padding: 20px;">
                                            אין רכיבי תמחור להצגה. לחץ על "חשב רכיבי תמחור לתלמיד" למעלה.
                                        </div>
                                    }
                                    else if (_pricingPeriods.Count > 1)
                                    {
                                        <div style="background: #f8f9fa; padding: 10px; border-radius: 10px; margin-bottom: 12px;">
                                            <span style="font-size: 0.9em; color: #666;">סה"כ לכל הרשויות:</span>
                                            <span style="font-size: 1.2em; font-weight: 700; color: #048f17;">
                                                @_pricingTotalCost.ToString("N2") ₪
                                            </span>
                                        </div>
                                        @foreach (var period in _pricingPeriods)
                                        {
                                            <div style="margin-bottom: 18px;">
                                                <div style="font-weight: 600; margin-bottom: 6px; color: #2c3e50;">
                                                    @(period.CouncilName ?? "ללא רשות")
                                                    <span style="font-weight: 400; color: #666; font-size: 0.9em;">
                                                        (@(period.StartDate?.ToString("dd/MM/yyyy") ?? "—") – @(period.EndDate?.ToString("dd/MM/yyyy") ?? "—"))
                                                    </span>
                                                </div>
                                                <div style="background: #f8f9fa; padding: 8px 10px; border-radius: 8px; margin-bottom: 5px;">
                                                    <span style="font-size: 0.9em; color: #666;">סה"כ רכיבים:</span>
                                                    <span style="font-size: 1.05em; font-weight: 500; color: #2c3e50;">
                                                        @period.ElementsTotal.ToString("N2") ₪
                                                    </span>
                                                    &nbsp;&nbsp;
                                                    <span style="font-size: 0.9em; color: #666;">חודשי רישום:</span>
                                                    <span style="font-size: 1.05em; font-weight: 500; color: #2c3e50;">
                                                        @(period.EnrollmentMonths ?? 0)
                                                    </span>
                                                    &nbsp;&nbsp;
                                                    <span style="font-size: 0.9em; color: #666;">עלות:</span>
                                                    <span style="font-size: 1.1em; font-weight: 700; color: #048f17;">
                                                        @period.Cost.ToString("N2") ₪
                                                    </span>
                                                </div>
                                                @if (period.Elements == null || period.Elements.Count == 0)
                                                {
                                                    <div style="text-align: center; color: #666; padding: 10px;">אין רכיבי תמחור לתקופה זו</div>
                                                }
                                                else
                                                {
                                                    <div class="table-container">
                                                        <table class="data-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>שם רכיב</th>
                                                                    <th>מחיר מלא</th>
                                                                    <th>מחיר מחושב</th>
                                                                    <th>גורם משפיע</th>
                                                                    <th>שעות</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var element in period.Elements)
                                                                {
                                                                    <tr>
                                                                        <td>@element.PricingElementName</td>
                                                                        <td>@element.FullPrice.ToString("N2") ₪</td>
                                                                        <td>@element.Price.ToString("N2") ₪</td>
                                                                        <td>@element.DeterminingFactor</td>
                                                                        <td>@element.Hours?.ToString("N2")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <!-- Pricing Summary -->

                                        <div style="background: #f8f9fa; padding: 10px; border-radius: 10px; margin-bottom: 5px;">
                                            <div>

                                                <span style="font-size: 0.9em; color: #666;">סה"כ רכיבים:</span>
                                                <span style="font-size: 1.1em; font-weight: 500; color: #2c3e50;">
                                                    @_pricingSummary.ElementsTotal.ToString("N2") ₪ </span>
                                                &nbsp;&nbsp;

                                                <span style="font-size: 0.9em; color: #666;">חודשי רישום:</span>
                                                <span style="font-size: 1.1em; font-weight: 500; color: #2c3e50;">
                                                    @_pricingSummary.EnrollmentMonths </span>
                                                &nbsp;&nbsp;

                                                <span style="font-size: 0.9em; color: #666;">עלות תלמיד:</span>
                                                <span style="font-size: 1.2em; font-weight: 700; color: #048f17;">
                                                    @_pricingSummary.StudentCost.ToString("N2") ₪ </span>
                                                <span></span>
                                            </div>
                                        </div>


                                        <!-- Pricing Elements Table -->
                                        <div class="table-container">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th>שם רכיב</th>
                                                        <th>מחיר מלא</th>
                                                        <th>מחיר מחושב</th>
                                                        <th>גורם משפיע</th>
                                                        <th>שעות</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var element in _pricingElements)
                                                    {
                                                        <tr>

                                                            <td>@element.PricingElementName</td>
                                                            <td>@element.FullPrice.ToString("N2") ₪</td>
                                                            <td>@element.Price.ToString("N2") ₪</td>
                                                            <td>@element.DeterminingFactor</td>
                                                            <td>@element.Hours?.ToString("N2")</td>

                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Tab Content - History -->
                    <div class="tab-content" style="display: @(_activeTab == "history" ? "block" : "none");">
                        <div class="detail-card @(_historyExpanded ? "expanded" : "collapsed")">
                            <div class="detail-card-header" @onclick="() => _historyExpanded = !_historyExpanded">
                                <div class="detail-card-title">היסטוריה</div>
                                <div class="card-header-actions">
                                    <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                        @(_historyExpanded ? "×" : "+")
                                    </button>
                                </div>
                            </div>
                            <div class="detail-card-content">
                                @if (_historyExpanded)
                                {
                                    @if (_historyLoading)
                                    {
                                        <div class="loading-spinner">טוען היסטוריה...</div>
                                    }
                                    else if (_history == null || _history.Count == 0)
                                    {
                                        <div style="text-align: center; color: #666; padding: 20px;">
                                            אין היסטוריה להצגה
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="table-container">
                                            <table class="data-table">
                                                <thead>
                                                    <tr>
                                                        <th>גרסה</th>
                                                        <th>שם פרטי</th>
                                                        <th>שם משפחה</th>
                                                        <th>כיתה</th>
                                                        <th>רשות שולחת</th>
                                                        <th>סטטוס</th>
                                                        <th>תאריך התחלה</th>
                                                        <th>תאריך סיום</th>
                                                        <th>תאריך יצירה</th>
                                                        <th>משתמש</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var version in _history)
                                                    {
                                                        <tr style="@(version.IsLastVersion ? "background: #e7f3ff;" : "")">
                                                            <td>@version.Version</td>
                                                            <td>@(version.FirstName ?? "לא זמין")</td>
                                                            <td>@(version.LastName ?? "לא זמין")</td>
                                                            <td>@(version.ClassName ?? "לא זמין")</td>
                                                            <td>@(version.CouncilName ?? "לא זמין")</td>
                                                            <td>@(version.Status ?? "לא זמין")</td>
                                                            <td>@(version.StartDate?.ToString("dd/MM/yyyy") ?? "לא זמין")</td>
                                                            <td>@(version.EndDate?.ToString("dd/MM/yyyy") ?? "לא זמין")</td>
                                                            <td>@(version.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "לא זמין")</td>
                                                            <td>@(string.IsNullOrWhiteSpace(version.CreatedUserName) ? "לא זמין" : version.CreatedUserName)</td>
                                                            <td>
                                                                @if (version.IsLastVersion)
                                                                {
                                                                    <span style="background: #28a745; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85em;">גרסה נוכחית</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- No External Permit Status Modal -->
@if (_showNoPermitModal && _student != null)
{
    <div class="modal-overlay" @onclick="() => _showNoPermitModal = false">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>@(_student.StatusId == 7 ? "ביטול סטטוס אין אישור לימודי חוץ" : "הגדרת סטטוס אין אישור לימודי חוץ")</div>
            </div>
            <div class="modal-body">
                @if (_student.StatusId == 7)
                {
                    <p>האם לבטל את סטטוס "אין אישור לימודי חוץ" עבור <strong>@_student.FirstName @_student.LastName</strong>?</p>
                    <p>הסטטוס יחזור ל: <strong>@(_student.PreviousVersionStatusName ?? "ללא סטטוס")</strong></p>
                }
                else
                {
                    <p>האם לקבוע סטטוס "אין אישור לימודי חוץ" עבור <strong>@_student.FirstName @_student.LastName</strong>?</p>
                }
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="ConfirmToggleNoPermitStatus" disabled="@_togglingStatus">
                    @(_togglingStatus ? "מעדכן..." : "אישור")
                </button>
                <button class="dialog-btn cancel" @onclick="() => _showNoPermitModal = false">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    private StudentDto? _student;
    private List<PricingElementDto> _pricingElements = new();
    private PricingSummaryDto _pricingSummary = new();
    private List<PricingPeriodDto> _pricingPeriods = new();
    private decimal _pricingTotalCost = 0;
    private List<StudentHistoryDto> _history = new();
    private bool _isLoading = true;
    private bool _pricingLoading = false;
    private bool _historyLoading = false;
    private string _pageTitle = "פרטי התלמיד";
    private string _yearDisplay = string.Empty;
    private string _activeTab = "documents";
    private bool _isFromTransactionDetails = false;

    // Document context IDs
    private int? _schoolId;
    private int? _entityId;
    private int? _yearId;
    private string _schoolName = string.Empty;

    // Document table references
    private DocumentsTable? _studentDocsTable;
    private DocumentsTable? _schoolDocsTable;
    private DocumentsTable? _entityDocsTable;

    // Collapsible card states
    private bool _studentDocsExpanded = true;
