    private async Task LoadStudentData()
    {
        try
        {
            _isLoading = true;

            // Get student ID from session
            var studentIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            $"session/property/SelectedStudentId");

            if (studentIdResponse == null || !studentIdResponse.TryGetValue("value", out var studentIdStr))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נבחר תלמיד");
                Navigation.NavigateTo("/students");
                return;
            }

            var studentId = int.Parse(studentIdStr);

            // Get school year ID from session
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            $"session/property/SelectedSchoolYearId");

            if (schoolYearIdResponse == null || !schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נבחרה שנת לימודים");
                Navigation.NavigateTo("/students");
                return;
            }

            var schoolYearId = int.Parse(schoolYearIdStr);

            // Load student data
            var studentsResponse = await ApiService.GetAsync<ApiResponse<List<StudentDto>>>(
            $"students?schoolYearId={schoolYearId}");

            if (studentsResponse?.Success == true && studentsResponse.Data != null)
            {
                _student = studentsResponse.Data.FirstOrDefault(s => s.Id == studentId);
            }

            // If student not found in current school year, check if it's an old version
            if (_student == null)
            {
                Console.WriteLine($"Student {studentId} not found in school year {schoolYearId}. Checking for old version...");
                
                try
                {
                    // Get the student record to find master_student_id
                    var oldStudentResponse = await ApiService.GetAsync<Dictionary<string, object>>($"students/{studentId}");
                    
                    if (oldStudentResponse != null && oldStudentResponse.ContainsKey("masterStudentId"))
                    {
                        var masterStudentIdObj = oldStudentResponse["masterStudentId"];
                        int masterStudentId;
                        
                        // Handle both int and JsonElement cases
                        if (masterStudentIdObj is int intValue)
                        {
                            masterStudentId = intValue;
                        }
                        else if (masterStudentIdObj is System.Text.Json.JsonElement jsonElement && jsonElement.TryGetInt32(out var parsedValue))
                        {
                            masterStudentId = parsedValue;
                        }
                        else
                        {
                            throw new Exception("Unable to parse master_student_id");
                        }
                        
                        Console.WriteLine($"Found master_student_id: {masterStudentId}. Looking for last version in school year {schoolYearId}...");
                        
                        // Find the last version of this master_student_id in the current school year
                        _student = studentsResponse?.Data?
                            .Where(s => s.MasterStudentId == masterStudentId)
                            .OrderByDescending(s => s.Version)
                            .FirstOrDefault();
                        
                        if (_student != null)
                        {
                            Console.WriteLine($"✅ Found last version: Student ID {_student.Id}, Version {_student.Version}");
                            
                            // Update session with the correct (last version) student ID
                            await ApiService.PostAsync("session/property", 
                                new { key = "SelectedStudentId", value = _student.Id.ToString() });
                            
                            studentId = _student.Id; // Update local variable
                        }
                        else
                        {
                            Console.WriteLine($"❌ No version of master_student_id {masterStudentId} found in school year {schoolYearId}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking for old version: {ex.Message}");
                }
            }

            // Final check - if still not found, show error
            if (_student == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "תלמיד לא נמצא");
                Navigation.NavigateTo("/students");
                return;
            }

            // Update page title (school name appended after LoadSchoolAndEntityIds)
            _pageTitle = $"פרטי התלמיד - {_student.FirstName} {_student.LastName}";

            // Get year display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            $"session/property/SelectedYearValue");

            if (yearValueResponse != null && yearValueResponse.TryGetValue("value", out var yearValue))
            {
                _yearDisplay = $"שנת לימודים: {yearValue}";
            }

            // Get YearId from session for documents
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            $"session/property/SelectedYearId");

            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                _yearId = int.Parse(yearIdStr);
            }

            // Check navigation source to show appropriate back button (with fallback for missing property)
            try
            {
                var navigationSourceResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                $"session/property/NavigationSource");

                if (navigationSourceResponse != null && navigationSourceResponse.TryGetValue("value", out var navSource))
                {
                    _isFromTransactionDetails = navSource == "transactiondetails";
                    Console.WriteLine($"Navigation source: {navSource}, Show transaction button: {_isFromTransactionDetails}");
                }
            }
            catch (HttpStatusException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // Property not set - use default behavior (not from transaction details)
                _isFromTransactionDetails = false;
                Console.WriteLine("NavigationSource property not found, using default: students");
            }

            // Get school and entity IDs from school_year
            await LoadSchoolAndEntityIds(schoolYearId);

            // Append school name to page title now that LoadSchoolAndEntityIds has run
            if (!string.IsNullOrEmpty(_schoolName))
                _pageTitle = $"{_pageTitle} - {_schoolName}";

            // Load pricing elements if available
            await LoadPricingElements();

            await LoadStudentHistory();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading student data: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתונים: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSchoolAndEntityIds(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<SchoolInfoDto>>(
            $"school/by-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                // School documents use the school's EntityId
                _schoolId = response.Data.EntityId;
                // Entity documents use the owner's EntityId (parent entity)
                _entityId = response.Data.OwnerId;
                _schoolName = response.Data.Name;
                Console.WriteLine($"✅ School Entity ID: {_schoolId}, Owner Entity ID: {_entityId}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading school and entity IDs: {ex.Message}");
        }
    }

    private async Task LoadPricingElements()
    {
        if (_student == null) return;

        try
        {
            _pricingLoading = true;

            var response = await ApiService.GetAsync<PricingResponse>(
            $"studentpricing/{_student.Id}");

            if (response?.Success == true && response.Data != null)
            {
                _pricingElements = response.Data;

                if (response.Summary != null)
                {
                    _pricingSummary = new PricingSummaryDto
                    {
                        ElementsTotal = response.Summary.ElementsTotal,
                        StudentCost = response.Summary.StudentCost,
                        EnrollmentMonths = response.Summary.EnrollmentMonths ?? 0
                    };
                }

                _pricingPeriods = response.Periods ?? new();
                _pricingTotalCost = response.Totals?.TotalCost
                    ?? (_pricingPeriods.Count > 0 ? _pricingPeriods.Sum(p => p.Cost) : (_student.Cost ?? 0));
            }
            else
            {
                _pricingPeriods = new();
                _pricingTotalCost = _student.Cost ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pricing elements: {ex.Message}");
            // Don't show error - pricing may not be calculated yet
        }
        finally
        {
            _pricingLoading = false;
        }
    }

    private async Task LoadStudentHistory()
    {
        if (_student == null) return;

        try
        {
            _historyLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<StudentHistoryDto>>>(
                $"students/history/{_student.MasterStudentId}");

            if (response?.Success == true && response.Data != null)
            {
                _history = response.Data;
                ApplyStatus4DisplayIfNeeded();
            }
            else
            {
                _history = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading student history: {ex.Message}");
            _history = new();
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private void ApplyStatus4DisplayIfNeeded()
    {
        if (_student == null || _student.StatusId != 9 || _history == null || _history.Count == 0)
            return;

        var status4 = _history
            .Where(v => v.StatusId == 4)
            .OrderByDescending(v => v.Version)
            .FirstOrDefault();

        if (status4 == null)
            return;

        _student.FirstName = status4.FirstName;
        _student.LastName = status4.LastName;
        _student.ClassName = status4.ClassName;
        _student.Street = status4.Street;
        _student.HouseNumber = status4.HouseNumber;
        _student.City = status4.City;
        _student.PostCode = status4.PostCode;
        _student.SendingCouncil = status4.SendingCouncil;
        _student.CouncilName = status4.CouncilName;
        _student.DisabilityCategory = status4.DisabilityCategory;
        _student.StartDate = status4.StartDate;
        _student.EndDate = status4.EndDate;
        _student.Cost = status4.Cost;

        _pageTitle = $"פרטי התלמיד - {_student.FirstName} {_student.LastName}";
        if (!string.IsNullOrEmpty(_schoolName))
            _pageTitle = $"{_pageTitle} - {_schoolName}";
    }

