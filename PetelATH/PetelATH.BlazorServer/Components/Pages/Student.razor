    private async Task ConfirmToggleNoPermitStatus()
    {
        if (_student == null) return;

        try
        {
            _togglingStatus = true;
            StateHasChanged();

            var response = await ApiService.PostAsync<object, ToggleNoPermitStatusResponse>(
                $"students/{_student.Id}/toggle-no-permit-status",
                new { });

            if (response?.Success == true)
            {
                _showNoPermitModal = false;

                // Update session to track the new student version
                await ApiService.PostAsync("session/property",
                    new { key = "SelectedStudentId", value = response.NewStudentId.ToString() });

                // Reload to reflect the new version
                await LoadStudentData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה בעדכון סטאטוס התלמיד");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error toggling no-permit status: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בעדכון סטאטוס: {ex.Message}");
        }
        finally
        {
            _togglingStatus = false;
        }
    }
