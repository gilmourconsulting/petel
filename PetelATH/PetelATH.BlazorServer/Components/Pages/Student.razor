    private async Task CalculateStudentPricing()
    {
        if (_student == null) return;

        // Block pricing for students with no external permit
        if (_student.StatusId == 7)
        {
            await JSRuntime.InvokeVoidAsync("alert", "לא ניתן לחשב תמחור לתלמיד ללא אישור לימודי חוץ");
            return;
        }

        try
        {
            var studentName = $"{_student.FirstName} {_student.LastName}";
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"האם לחשב רכיבי תמחור עבור {studentName}?\n\nפעולה זו תחליף את רכיבי התמחור הקיימים.");

            if (!confirmed) return;

            _pricingLoading = true;
            StateHasChanged();

            var response = await ApiService.PostAsync<PricingCalculationResponse, ApiResponse<PricingCalculationResponse>>(
            $"studentpricing/calculate/{_student.Id}?save=true",
            new PricingCalculationResponse());

            if (response?.Success == true)
            {
                var data = response.Data;
                string message;

                // Check if no changes were detected
                if (data?.NoChangeDetected == true)
                {
                    message = "✅ חישוב התמחור הושלם בהצלחה!\n\n";
                    message += "ℹ️ לא התגלו שינויים ברכיבי התמחור\n";

                    if (data.ElementsCount.HasValue)
                    {
                        message += $"📊 {data.ElementsCount.Value} רכיבי תמחור תקפים\n";
                    }

                    if (data.TotalPrice.HasValue)
                    {
                        message += $"💰 סכום כולל: ₪{data.TotalPrice.Value:N2}\n";
                    }

                    message += "\nהנתונים הקיימים עדיין תקפים - לא נוצרה גרסה חדשה.";
                }
                else
                {
                    // Changes detected - new version created
                    message = "✅ חישוב התמחור הושלם בהצלחה!\n\n";

                    if (data?.ElementsCount.HasValue == true)
                    {
                        message += $"📊 {data.ElementsCount.Value} רכיבי תמחור חושבו\n";
                    }

                    if (data?.TotalPrice.HasValue == true)
                    {
                        message += $"💰 סכום כולל: ₪{data.TotalPrice.Value:N2}\n";
                    }

                    if (data?.Warnings != null && data.Warnings.Count > 0)
                    {
                        message += "\n⚠️ אזהרות:\n";
                        var warningsToShow = data.Warnings.Take(3);
                        foreach (var warning in warningsToShow)
                        {
                            message += $"  • {warning}\n";
                        }
                        if (data.Warnings.Count > 3)
                        {
                            message += $"  ... ו-{data.Warnings.Count - 3} אזהרות נוספות\n";
                        }
                    }

                    // Update student ID if new version was created
                    if (data?.NewStudentId.HasValue == true)
                    {
                        await ApiService.PostAsync($"session/property/SelectedStudentId", 
                            new { value = data.NewStudentId.Value.ToString() });
                        
                        // Reload student data with new version BEFORE showing message
                        await LoadStudentData();
                    }
                }

                await JSRuntime.InvokeVoidAsync("alert", message);

                // Reload pricing elements
                await LoadPricingElements();

                // If no new version was created, just reload to get updated cost
                if (data?.NewStudentId.HasValue != true)
                {
                    await LoadStudentData();
                }

                // Switch to pricing tab
                _activeTab = "pricing";
                _pricingExpanded = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בחישוב תמחור: {response?.Message ?? "שגיאה לא ידועה"}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error calculating pricing: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בחישוב תמחור: {ex.Message}");
        }
        finally
        {
            _pricingLoading = false;
        }
    }

    private async Task GenerateDocuments()
    {
        if (_student == null || !_yearId.HasValue) return;

        try
        {
            var response = await ApiService.PostAsync<DocumentGenerationResponse, DocumentGenerationResponse>(
            $"documents/generate-student-documents?studentId={_student.Id}&yearId={_yearId.Value}",
            new DocumentGenerationResponse());

            if (response != null)
            {
                var message = $"{response.Message}\n\n" +
                    $"נוצרו: {response.AddedCount} מסמכים\n" +
                    $"קיימים (דולגו): {response.SkippedCount} מסמכים\n" +
                    $"לא רלוונטיים: {response.NotRequiredCount} מסמכים\n" +
                    $"סה\"כ סוגי מסמכים: {response.TotalTypes}";

                await JSRuntime.InvokeVoidAsync("alert", message);

                // Reload all document tables
                if (_studentDocsTable != null)
                    await _studentDocsTable.Reload();
                if (_schoolDocsTable != null)
                    await _schoolDocsTable.Reload();
                if (_entityDocsTable != null)
                    await _entityDocsTable.Reload();

                // Switch to documents tab and expand student docs
                _activeTab = "documents";
                _studentDocsExpanded = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה בעדכון מסמכים: לא התקבלה תשובה מהשרת");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating documents: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בעדכון מסמכים: {ex.Message}");
        }
    }


    private async Task NavigateBackToSource()
    {
        // Check if we came from students page
        try
        {
            var sourcePageResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            $"session/property/SourcePage");

            if (sourcePageResponse != null && sourcePageResponse.TryGetValue("value", out var sourcePage)
            && !string.IsNullOrEmpty(sourcePage))
            {
                Navigation.NavigateTo(sourcePage);
                return;
            }
        }
        catch
        {
            // If error, default to students page
        }

        Navigation.NavigateTo("/students");
    }

