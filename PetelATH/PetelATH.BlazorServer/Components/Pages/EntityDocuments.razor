@page "/entitydocuments"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="entitydocuments_generateDocuments" ScreenName="@PageName" FunctionName="GenerateDocumentsForEntity" 
                      OnClick="GenerateDocumentsForEntity" CssClass="context-btn" Title="עדכן רשימת מסמכים לישות">
            עדכן רשימת מסמכים לישות
        </SecureButton>
        <div class="context-spacer"></div>
        <SecureButton ActionName="entitydocuments_backToSchoolList" ScreenName="@PageName" FunctionName="NavigateBackToSchoolList" 
                      OnClick="NavigateBackToSchoolList" CssClass="context-navigation-btn" Title="חזרה לרשימת בתי הספר">
            חזרה לרשימת בתי הספר
        </SecureButton>
    </div>

    <!-- Main content -->
    <div class="students-content">
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">@_pageTitle</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
            <div class="content-card">
                <!-- Info message about what documents are shown -->
                <div class="info-message" style="margin-bottom: 20px; padding: 15px; background-color: #e7f3ff; border-radius: 8px; direction: rtl;">
                    <p style="margin: 0; color: #0066cc;">
                        <strong>הערה:</strong> מסך זה מציג מסמכים של הישות שלך וכל הישויות הבנות (למעט בתי ספר).
                        מסמכי בתי ספר ניתן לצפות במסך "מסמכים בית ספריים" של כל בית ספר.
                    </p>
                </div>

                <!-- Documents table component -->
                <div id="entityDocumentsContainer">
                    @if (_entityId.HasValue && _yearId.HasValue)
                    {
                        <DocumentsTable @ref="_documentsTable"
                                        EntityType="entity-hierarchy"
                                        EntityId="_entityId"
                                        YearId="_yearId"
                                        AllowDownload="true"
                                        AllowUpload="true"
                                        AllowDelete="false"
                                        ShowEntityName="true"
                                        OnDocumentsChanged="OnDocumentsChanged" />
                    }
                    else
                    {
                        <div class="loading-spinner">טוען...</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DocumentsTable? _documentsTable;
    private int? _entityId;
    private int? _yearId;
    private string _pageTitle = "מסמכי ישות";
    private string _yearDisplay = "";

    // REQUIRED by SecurePageBase
    protected override string PageName => "entitydocuments";

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        try
        {
            // Get session data
            var session = await SessionState.GetSessionAsync();
            if (session == null)
            {
                Console.WriteLine("❌ No session available");
                return;
            }

            // Get entity ID from session
            _entityId = int.TryParse(session.EntityId, out var eid) ? eid : null;

            // Get year ID for documents
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            var yearIdStr = yearIdResponse?["value"];
            _yearId = int.TryParse(yearIdStr, out var yid) ? yid : null;

            // Get year value for display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearValue");
            _yearDisplay = yearValueResponse?["value"] ?? "";

            // Build page title with entity name
            var entityName = session.EntityName ?? "ישות";
            _pageTitle = $"מסמכי ישות - {entityName}";

            Console.WriteLine($"🏢 Entity documents context: EntityId={_entityId}, YearId={_yearId}, EntityName={entityName}");

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading page data: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בטעינת נתוני העמוד");
        }
    }

    private async Task GenerateDocumentsForEntity()
    {
        if (!_entityId.HasValue || !_yearId.HasValue)
        {
            await JSRuntime.InvokeVoidAsync("alert", "לא נמצאה ישות או שנת לימודים");
            return;
        }

        try
        {
            Console.WriteLine($"📄 Generating documents for entity {_entityId} in year {_yearId}");

            // Show loading message
            await JSRuntime.InvokeVoidAsync("BlazorHelpers.showLoadingOverlay", 
                "entityDocumentGenerationLoading", 
                "מייצר מסמכים חסרים לישות...", 
                "אנא המתן");

            // Call the generate documents API endpoint
            var result = await ApiService.PostAsync<object, Dictionary<string, object>>(
                $"documents/generate-entity-documents?entityId={_entityId}&yearId={_yearId}",
                new { }
            );

            // Remove loading message
            await JSRuntime.InvokeVoidAsync("BlazorHelpers.removeElement", "entityDocumentGenerationLoading");

            if (result != null)
            {
                var message = result.GetValueOrDefault("message", "מסמכים נוצרו בהצלחה").ToString();
                var addedCount = result.GetValueOrDefault("addedCount", 0);
                var skippedCount = result.GetValueOrDefault("skippedCount", 0);

                await JSRuntime.InvokeVoidAsync("alert", 
                    $"{message}\n\nנוספו: {addedCount} מסמכים\nקיימים (דולגו): {skippedCount} מסמכים");

                Console.WriteLine("✅ Entity document generation complete");

                // Refresh documents table
                if (_documentsTable != null)
                {
                    await _documentsTable.Reload();
                    Console.WriteLine("✅ Documents list refreshed");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה ביצירת מסמכים לישות");
            }
        }
        catch (Exception ex)
        {
            // Remove loading message on error
            await JSRuntime.InvokeVoidAsync("BlazorHelpers.removeElement", "entityDocumentGenerationLoading");

            Console.WriteLine($"❌ Error generating entity documents: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה ביצירת מסמכים לישות: {ex.Message}");
        }
    }

    private void NavigateBackToSchoolList()
    {
        Console.WriteLine("⬅️ Navigating back to school list...");
        Navigation.NavigateTo("/schoollist");
    }

    private async Task OnDocumentsChanged()
    {
        Console.WriteLine("🔄 Documents changed event received");
        StateHasChanged();
    }
}
