@page "/students"
@layout MainLayout
@inherits SecurePageBase
@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Services
@using PetelATH.BlazorServer.Components.Shared
@using PetelATH.BlazorServer.Components.Modals
@inject ApiService ApiService
@inject SessionStateService SessionStateService

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton
            ActionName="students_uploadFile"
            ScreenName="@PageName"
            FunctionName="ShowUploadDialog"
            OnClick="ShowUploadDialog"
            CssClass="context-btn">
            העלה קובץ תלמידים
        </SecureButton>
        
        <SecureButton
            ActionName="students_bulkPricing"
            ScreenName="@PageName"
            FunctionName="ShowBulkPricingDialog"
            OnClick="ShowBulkPricingDialog"
            CssClass="context-btn">
            תמחור לכל לתלמידים
        </SecureButton>
        
        <SecureButton
            ActionName="students_generateDocuments"
            ScreenName="@PageName"
            FunctionName="ShowGenerateDocumentsDialog"
            OnClick="ShowGenerateDocumentsDialog"
            CssClass="context-btn">
            עדכן מסמכים לכל התלמידים
        </SecureButton>
        
        <div class="context-spacer"></div>
        
        <SecureButton
            ActionName="students_backToSchool"
            ScreenName="@PageName"
            FunctionName="NavigateToSchoolDashboard"
            OnClick="NavigateToSchoolDashboard"
            CssClass="context-navigation-btn">
            חזרה למסך בית הספר
        </SecureButton>
    </div>

    <!-- Students content -->
    <div class="students-content">
        <!-- School Title Section -->
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">@_pageTitle</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="dashboard-cards-wrapper" style="margin-bottom: 20px;">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <!-- Total Students Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">👥</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_summary.TotalStudents</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">סה"כ תלמידים</div>
                    </div>
                </div>

                <!-- Active Students Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">⚙</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_summary.ActiveStudents</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">תלמידים פעילים</div>
                    </div>
                </div>

                <!-- Finished Students Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">✅</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_summary.FinishedStudents</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">תלמידים שסיימו</div>
                    </div>
                </div>

                <!-- Councils Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">📚</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_summary.CouncilCount</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">רשויות</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="content-card" style="margin-bottom: 20px;">
            <div style="padding: 15px 20px;">
                <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: flex-end;">
                    <div style="flex: 1; min-width: 130px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">ת.ז</label>
                        <input type="text" @bind="_filterIdNumber" @bind:event="oninput"
                            placeholder="סנן לפי ת.ז..."
                            style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                    </div>
                    <div style="flex: 2; min-width: 180px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">שם</label>
                        <input type="text" @bind="_filterName" @bind:event="oninput"
                            placeholder="סנן לפי שם..."
                            style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                    </div>
                    <div style="flex: 1; min-width: 130px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">כיתה</label>
                        <input type="text" @bind="_filterClass" @bind:event="oninput"
                            placeholder="סנן לפי כיתה..."
                            style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                    </div>
                    <div style="flex: 2; min-width: 180px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">רשות שולחת</label>
                        <input type="text" @bind="_filterCouncil" @bind:event="oninput"
                            placeholder="סנן לפי רשות..."
                            style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; box-sizing: border-box;" />
                    </div>
                    <div style="flex: 1; min-width: 140px;">
                        <label style="display: block; font-weight: 600; margin-bottom: 5px; font-size: 0.88em;">סטטוס</label>
                        <select @bind="_filterStatus"
                            style="width: 100%; padding: 7px 10px; border: 1px solid #dee2e6; border-radius: 6px; font-size: 0.9em; background: white; box-sizing: border-box;">
                            <option value="">הכל</option>
                            @foreach (var status in _distinctStatuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div style="padding-bottom: 1px;">
                        <button @onclick="ClearFilters"
                            style="padding: 7px 16px; background: #6c757d; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.9em; white-space: nowrap;">
                            נקה סינון
                        </button>
                    </div>
                </div>
                @if (HasActiveFilters)
                {
                    <div style="margin-top: 10px; font-size: 0.85em; color: #555;">
                        מציג <strong>@FilteredStudents.Count()</strong> תלמידים מתוך <strong>@_students.Count</strong>
                    </div>
                }
            </div>
        </div>

        <!-- Students Table Section -->
        <div class="content-card">
            <div class="detail-card expanded">
                <div class="detail-card-header">
                    <h2 class="detail-card-title">רשימת תלמידים</h2>
                    <div class="card-header-actions">
                        <SecureButton
                            ActionName="students_refreshData"
                            ScreenName="@PageName"
                            FunctionName="RefreshData"
                            OnClick="RefreshData"
                            CssClass="btn-icon"
                            title="רענן נתונים">
                            <span style="font-size: 2em;">🔄</span>
                        </SecureButton>
                    </div>
                </div>
                <div class="detail-card-content" style="min-height: 400px; max-height: none;">
                    @if (_isLoading)
                    {
                        <div class="loading-spinner">טוען נתונים...</div>
                    }
                    else if (_students == null || _students.Count == 0)
                    {
                        <div class="no-data-message">אין תלמידים להצגה</div>
                    }
                    else
                    {
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.IdNumber))" style="cursor: pointer;">
                                            ת.ז @GetSortArrow(nameof(StudentDto.IdNumber))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.FirstName))" style="cursor: pointer;">
                                            שם פרטי @GetSortArrow(nameof(StudentDto.FirstName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.LastName))" style="cursor: pointer;">
                                            שם משפחה @GetSortArrow(nameof(StudentDto.LastName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.Gender))" style="cursor: pointer;">
                                            מגדר @GetSortArrow(nameof(StudentDto.Gender))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.ClassName))" style="cursor: pointer;">
                                            כיתה @GetSortArrow(nameof(StudentDto.ClassName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.Status))" style="cursor: pointer;">
                                            סטטוס @GetSortArrow(nameof(StudentDto.Status))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.City))" style="cursor: pointer;">
                                            עיר @GetSortArrow(nameof(StudentDto.City))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(StudentDto.CouncilName))" style="cursor: pointer;">
                                            רשות שולחת @GetSortArrow(nameof(StudentDto.CouncilName))
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var filtered = FilteredStudents.ToList(); }
                                    @if (filtered.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="9" style="text-align: center; padding: 20px; color: #666;">אין תלמידים התואמים לסינון</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var student in filtered)
                                        {
                                            <tr>
                                                <td>
                                                    <SecureButton
                                                        ActionName="students_viewStudent"
                                                        ScreenName="@PageName"
                                                        FunctionName="ViewStudent"
                                                        ActionParams="@($"studentId={student.Id},name={student.FirstName} {student.LastName}")"
                                                        OnClick="() => ViewStudent(student.Id)"
                                                        CssClass="btn-icon"
                                                        HideIfNoAccess="true">
                                                        <img src="/images/view_icon.png" alt="צפייה" class="action-icon-natural">
                                                    </SecureButton>
                                                </td>
                                                <td>@student.IdNumber</td>
                                                <td>@student.FirstName</td>
                                                <td>@student.LastName</td>
                                                <td>@GetGenderDisplay(student.Gender)</td>
                                                <td>@student.ClassName</td>
                                                <td>@student.Status</td>
                                                <td>@student.City</td>
                                                <td>@student.CouncilName</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Student Upload Modal -->
<StudentUploadModal @ref="_uploadModal" OnUploadComplete="RefreshData" />

<!-- Bulk Pricing Progress Modal -->
@if (_showBulkPricingProgress)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; direction: rtl;">
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); min-width: 400px; max-width: 90%;">
            <h3 style="margin: 0 0 20px 0; text-align: center; color: #333;">מחשב תמחור לכל התלמידים</h3>
            
            <div style="margin-bottom: 20px; font-size: 14px; color: #666; direction: rtl;">
                <div style="text-align: center;">
                    <div>עובד: @_bulkPricingProcessed / @_bulkPricingTotal</div>
                    <div style="color: #28a745;">✅ הצליחו: @_bulkPricingSuccess</div>
                    <div style="color: #dc3545;">❌ נכשלו: @_bulkPricingFailed</div>
                </div>
            </div>
            
            <div style="width: 100%; height: 30px; background: #e9ecef; border-radius: 15px; overflow: hidden; margin-bottom: 10px;">
                <div style="width: @(GetPercentage(_bulkPricingProcessed, _bulkPricingTotal))%; height: 100%; background: linear-gradient(90deg, #28a745, #20c997); transition: width 0.3s ease; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                    <span>@(GetPercentage(_bulkPricingProcessed, _bulkPricingTotal))%</span>
                </div>
            </div>
            
            <div style="text-align: center; color: #666; font-size: 12px;">אנא המתן... הפעולה עשויה לקחת מספר דקות</div>
        </div>
    </div>
}

<!-- Bulk Pricing Summary Modal -->
@if (_showBulkPricingSummary)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; direction: rtl;">
        <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); min-width: 500px; max-width: 90%;">
            <h2 style="margin: 0 0 20px 0; text-align: center; color: #333;">🎉 סיכום חישוב תמחור</h2>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                <div style="padding: 15px; background: #e7f3ff; border-radius: 8px; text-align: center;">
                    <div style="font-size: 32px; font-weight: bold; color: #0066cc;">@_bulkPricingTotal</div>
                    <div style="font-size: 14px; color: #666;">סה"כ תלמידים</div>
                </div>
                <div style="padding: 15px; background: #d4edda; border-radius: 8px; text-align: center;">
                    <div style="font-size: 32px; font-weight: bold; color: #28a745;">@_bulkPricingSuccess</div>
                    <div style="font-size: 14px; color: #666;">הצליחו</div>
                </div>
                <div style="padding: 15px; background: #f8d7da; border-radius: 8px; text-align: center;">
                    <div style="font-size: 32px; font-weight: bold; color: #dc3545;">@_bulkPricingFailed</div>
                    <div style="font-size: 14px; color: #666;">נכשלו</div>
                </div>
            </div>

            @if (_bulkPricingErrors.Count > 0)
            {
                <div style="margin-top: 20px; padding: 15px; background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; max-height: 200px; overflow-y: auto;">
                    <h4 style="margin: 0 0 10px 0; color: #721c24;">שגיאות (@_bulkPricingErrors.Count):</h4>
                    <ul style="margin: 0; padding-right: 20px; color: #721c24; font-size: 13px;">
                        @foreach (var error in _bulkPricingErrors.Take(10))
                        {
                            <li>@error</li>
                        }
                    </ul>
                    @if (_bulkPricingErrors.Count > 10)
                    {
                        <div style="margin-top: 10px; font-style: italic;">...ו-@(_bulkPricingErrors.Count - 10) שגיאות נוספות</div>
                    }
                </div>
            }

            <div style="text-align: center; margin-top: 25px;">
                <button @onclick="() => _showBulkPricingSummary = false" style="padding: 10px 30px; background: #2196F3; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px;">סגור</button>
            </div>
        </div>
    </div>
}

<!-- Document Generation Progress Modal -->
@if (_showDocumentProgress)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; direction: rtl;">
        <div style="background: white; padding: 30px; border-radius: 8px; min-width: 400px; text-align: center;">
            <h3 style="margin: 0 0 20px 0;">מעדכן רשימת מסמכים</h3>
            <div style="font-size: 16px; margin-bottom: 15px;">מעבד תלמיד @_documentProgressCurrent מתוך @_documentProgressTotal</div>
            <div style="font-size: 14px; color: #666; margin-bottom: 20px;">@_documentProgressCurrentStudent</div>
            <div style="background: #f0f0f0; height: 30px; border-radius: 15px; overflow: hidden;">
                <div style="background: linear-gradient(90deg, #4CAF50, #45a049); height: 100%; width: @(GetPercentage(_documentProgressCurrent, _documentProgressTotal))%; transition: width 0.3s;"></div>
            </div>
        </div>
    </div>
}

<!-- Document Generation Summary Modal -->
@if (_showDocumentSummary)
{
    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; direction: rtl;">
        <div style="background: white; padding: 30px; border-radius: 8px; min-width: 450px;">
            <h3 style="margin: 0 0 20px 0; text-align: center;">סיכום יצירת מסמכים</h3>
            <div style="font-size: 16px; line-height: 2;">
                <div><strong>סה"כ תלמידים:</strong> @_documentProgressTotal</div>
                <div style="color: #4CAF50;"><strong>מסמכים שנוצרו:</strong> @_documentProgressTotalAdded</div>
                <div style="color: #666;"><strong>מסמכים קיימים (דולגו):</strong> @_documentProgressTotalSkipped</div>
                @if (_documentProgressTotalErrors > 0)
                {
                    <div style="color: #f44336;"><strong>שגיאות:</strong> @_documentProgressTotalErrors</div>
                }
            </div>

            @if (_documentProgressErrors.Count > 0)
            {
                <div style="margin-top: 20px; padding: 15px; background: #fff3cd; border-radius: 4px; max-height: 200px; overflow-y: auto; text-align: right;">
                    <strong>שגיאות:</strong><br>
                    @foreach (var error in _documentProgressErrors.Take(10))
                    {
                        <div>• @error</div>
                    }
                    @if (_documentProgressErrors.Count > 10)
                    {
                        <div>ו-@(_documentProgressErrors.Count - 10) שגיאות נוספות...</div>
                    }
                </div>
            }

            <div style="text-align: center; margin-top: 25px;">
                <button @onclick="() => _showDocumentSummary = false" style="padding: 10px 30px; background: #2196F3; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px;">סגור</button>
            </div>
        </div>
    </div>
}

@code {
    private List<StudentDto> _students = new();
    private StudentSummaryDto _summary = new();
    private bool _isLoading = true;
    private string _pageTitle = "תלמידים";
    private string _yearDisplay = string.Empty;

    private string _sortColumn = nameof(StudentDto.LastName);
    private bool _sortAscending = true;

    // Filter state
    private string _filterIdNumber = string.Empty;
    private string _filterName = string.Empty;
    private string _filterClass = string.Empty;
    private string _filterCouncil = string.Empty;
    private string _filterStatus = string.Empty;

    private List<string> _distinctStatuses => _students
        .Where(s => !string.IsNullOrEmpty(s.Status))
        .Select(s => s.Status!)
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    // Normalizes Hebrew gershayim ״ (U+05F4) to regular " (U+0022) so both match
    private static string NormalizeQuotes(string s) =>
        s.Replace('\u05F4', '"').Replace('\u05F3', '\'');

    private IEnumerable<StudentDto> FilteredStudents => _students.Where(s =>
        (string.IsNullOrEmpty(_filterIdNumber) || (s.IdNumber ?? "").Contains(_filterIdNumber, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterName) || $"{s.FirstName} {s.LastName}".Contains(_filterName, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterClass) || NormalizeQuotes(s.ClassName ?? "").Contains(NormalizeQuotes(_filterClass), StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterCouncil) || (s.CouncilName ?? "").Contains(_filterCouncil, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrEmpty(_filterStatus) || s.Status == _filterStatus)
    );

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterIdNumber) ||
        !string.IsNullOrEmpty(_filterName) ||
        !string.IsNullOrEmpty(_filterClass) ||
        !string.IsNullOrEmpty(_filterCouncil) ||
        !string.IsNullOrEmpty(_filterStatus);

    private void ClearFilters()
    {
        _filterIdNumber = string.Empty;
        _filterName = string.Empty;
        _filterClass = string.Empty;
        _filterCouncil = string.Empty;
        _filterStatus = string.Empty;
    }

    // Upload modal reference
    private StudentUploadModal? _uploadModal;

    // Bulk pricing progress
    private bool _showBulkPricingProgress = false;
    private bool _showBulkPricingSummary = false;
    private int _bulkPricingTotal = 0;
    private int _bulkPricingProcessed = 0;
    private int _bulkPricingSuccess = 0;
    private int _bulkPricingFailed = 0;
    private List<string> _bulkPricingErrors = new();

    // Document generation progress
    private bool _showDocumentProgress = false;
    private bool _showDocumentSummary = false;
    private int _documentProgressTotal = 0;
    private int _documentProgressCurrent = 0;
    private int _documentProgressTotalAdded = 0;
    private int _documentProgressTotalSkipped = 0;
    private int _documentProgressTotalErrors = 0;
    private string _documentProgressCurrentStudent = "";
    private List<string> _documentProgressErrors = new();

    // REQUIRED by SecurePageBase
    protected override string PageName => "students";

    // Override page initialization after security check
    protected override async Task OnPageInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            // Get school year from session
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                $"session/property/SelectedSchoolYearId");
            
            if (schoolYearIdResponse == null || !schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נבחרה שנת לימודים");
                return;
            }

            var schoolYearId = int.Parse(schoolYearIdStr);

            // Get school name for title
            var schoolNameResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                $"session/property/SelectedSchoolName");
            
            if (schoolNameResponse != null && schoolNameResponse.TryGetValue("value", out var schoolName))
            {
                _pageTitle = $"תלמידים - {schoolName}";
            }

            // Get year display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                $"session/property/SelectedYearValue");
            
            if (yearValueResponse != null && yearValueResponse.TryGetValue("value", out var yearValue))
            {
                _yearDisplay = $"שנת לימודים: {yearValue}";
            }

            // Load students data (API returns wrapped response)
            var studentsResponse = await ApiService.GetAsync<ApiResponse<List<StudentDto>>>(
                $"students?schoolYearId={schoolYearId}");
            
            if (studentsResponse?.Success == true && studentsResponse.Data != null)
            {
                _students = studentsResponse.Data;
            }
            else
            {
                _students = new List<StudentDto>();
            }

            // Calculate summary from loaded students
            _summary = new StudentSummaryDto
            {
                TotalStudents = _students.Count,
                ActiveStudents = _students.Count(s => s.Status == "פעיל" || string.IsNullOrEmpty(s.Status)),
                FinishedStudents = _students.Count(s => s.Status == "הסתיים"),
                CouncilCount = _students.Where(s => !string.IsNullOrEmpty(s.CouncilName)).Select(s => s.CouncilName).Distinct().Count()
            };

            // Apply current sort
            ApplySort();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading students: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתונים: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SortTable(string columnName)
    {
        if (_sortColumn == columnName)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = columnName;
            _sortAscending = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        if (_students == null || _students.Count == 0) return;

        _students = _sortColumn switch
        {
            nameof(StudentDto.IdNumber) => _sortAscending
                ? _students.OrderBy(s => s.IdNumber).ToList()
                : _students.OrderByDescending(s => s.IdNumber).ToList(),
            nameof(StudentDto.FirstName) => _sortAscending
                ? _students.OrderBy(s => s.FirstName).ToList()
                : _students.OrderByDescending(s => s.FirstName).ToList(),
            nameof(StudentDto.LastName) => _sortAscending
                ? _students.OrderBy(s => s.LastName).ToList()
                : _students.OrderByDescending(s => s.LastName).ToList(),
            nameof(StudentDto.Gender) => _sortAscending
                ? _students.OrderBy(s => s.Gender).ToList()
                : _students.OrderByDescending(s => s.Gender).ToList(),
            nameof(StudentDto.ClassName) => _sortAscending
                ? _students.OrderBy(s => s.ClassName).ToList()
                : _students.OrderByDescending(s => s.ClassName).ToList(),
            nameof(StudentDto.Status) => _sortAscending
                ? _students.OrderBy(s => s.Status).ToList()
                : _students.OrderByDescending(s => s.Status).ToList(),
            nameof(StudentDto.City) => _sortAscending
                ? _students.OrderBy(s => s.City).ToList()
                : _students.OrderByDescending(s => s.City).ToList(),
            nameof(StudentDto.CouncilName) => _sortAscending
                ? _students.OrderBy(s => s.CouncilName).ToList()
                : _students.OrderByDescending(s => s.CouncilName).ToList(),
            _ => _students
        };
    }

    private string GetSortArrow(string columnName)
    {
        if (_sortColumn != columnName) return string.Empty;
        return _sortAscending ? "▲" : "▼";
    }

