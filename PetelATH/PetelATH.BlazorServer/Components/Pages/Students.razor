    private async Task ShowBulkPricingDialog()
    {
        if (_students == null || _students.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אין תלמידים לחישוב תמחור");
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"⚠️ אזהרה: חישוב תמחור לכל התלמידים\n\n" +
            $"פעולה זו תחשב רכיבי תמחור עבור {_students.Count} תלמידים.\n" +
            $"רכיבי התמחור הקיימים יוחלפו.\n\n" +
            $"הפעולה עשויה לקחת מספר דקות.\n\n" +
            $"האם להמשיך?");

        if (!confirmed) return;

        _showBulkPricingProgress = true;
        _bulkPricingTotal = _students.Count;
        _bulkPricingProcessed = 0;
        _bulkPricingSuccess = 0;
        _bulkPricingFailed = 0;
        _bulkPricingErrors.Clear();
        StateHasChanged();

        try
        {
            foreach (var student in _students)
            {
                try
                {
                    var response = await ApiService.PostAsync<object, ApiResponse<object>>(
                        $"studentpricing/calculate/{student.Id}?save=true",
                        new { });

                    if (response?.Success == true)
                    {
                        _bulkPricingSuccess++;
                    }
                    else
                    {
                        _bulkPricingFailed++;
                        _bulkPricingErrors.Add($"{student.FirstName} {student.LastName} ({student.IdNumber}): {response?.Message ?? "חישוב נכשל"}");
                    }
                }
                catch (Exception ex)
                {
                    _bulkPricingFailed++;
                    _bulkPricingErrors.Add($"{student.FirstName} {student.LastName} ({student.IdNumber}): {ex.Message}");
                }

                _bulkPricingProcessed++;
                StateHasChanged();

                // Small delay to prevent overwhelming the server
                await Task.Delay(100);
            }

            // Show summary and close progress
            _showBulkPricingProgress = false;
            _showBulkPricingSummary = true;
            StateHasChanged();

            // Refresh data after 2 seconds
            if (_bulkPricingSuccess > 0)
            {
                await Task.Delay(2000);
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            _showBulkPricingProgress = false;
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("alert", $"❌ שגיאה בחישוב תמחור המוני:\n{ex.Message}");
        }
    }

    private async Task ShowGenerateDocumentsDialog()
    {
        if (_students == null || _students.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אין תלמידים");
            return;
        }

        // Get year ID from session
        var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
        if (yearIdResponse == null || !yearIdResponse.TryGetValue("value", out var yearIdStr))
        {
            await JSRuntime.InvokeVoidAsync("alert", "לא נמצאה שנת לימודים נבחרת");
            return;
        }

        var yearId = int.Parse(yearIdStr);

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"האם ברצונך לעדכן רשימת מסמכים עבור {_students.Count} תלמידים?\n\n" +
            "פעולה זו עשויה לקחת זמן.");

        if (!confirmed) return;

        _showDocumentProgress = true;
        _documentProgressTotal = _students.Count;
        _documentProgressCurrent = 0;
        _documentProgressTotalAdded = 0;
        _documentProgressTotalSkipped = 0;
        _documentProgressTotalErrors = 0;
        _documentProgressErrors.Clear();
        StateHasChanged();

        try
        {
            foreach (var student in _students)
            {
                _documentProgressCurrentStudent = $"{student.FirstName} {student.LastName}";
                StateHasChanged();

                try
                {
                    var response = await ApiService.PostAsync<object, DocumentGenerationResponse>(
                        $"documents/generate-student-documents?studentId={student.Id}&yearId={yearId}",
                        new { });

                    if (response != null)
                    {
                        _documentProgressTotalAdded += response.AddedCount;
                        _documentProgressTotalSkipped += response.SkippedCount;
                    }
                }
                catch (Exception ex)
                {
                    _documentProgressTotalErrors++;
                    _documentProgressErrors.Add($"{student.FirstName} {student.LastName}: {ex.Message}");
                }

                _documentProgressCurrent++;
                StateHasChanged();

                // Small delay to prevent overwhelming the server
                await Task.Delay(100);
            }

            // Show summary
            _showDocumentProgress = false;
            _showDocumentSummary = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _showDocumentProgress = false;
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה ביצירת מסמכים: {ex.Message}");
        }
    }

