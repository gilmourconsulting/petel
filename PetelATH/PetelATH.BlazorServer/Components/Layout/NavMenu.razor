@inject ApiService ApiService
@inject NavigationManager Navigation
@implements IDisposable

<nav class="side-menu @(_isCollapsed ? "collapsed" : "")">
    <div class="menu-header">
        <button class="menu-toggle" @onclick="ToggleMenu" type="button">☰</button>
    </div>
    
    <div class="menu-items">
        @if (_menuItems == null)
        {
            <div class="loading-menu">טוען תפריט...</div>
        }
        else if (_menuItems.Count == 0)
        {
            <div class="error-menu">לא נמצאו פריטי תפריט</div>
        }
        else
        {
            @foreach (var item in _menuItems)
            {
                <a href="@GetMenuPath(item.Reference)" 
                   class="menu-item @(IsActive(item) ? "active" : "")"
                   @onclick="() => HandleMenuClick(item)"
                   @onclick:preventDefault="true">
                    <span class="menu-item-text">@item.Text</span>
                </a>
            }
        }
    </div>
</nav>

@code {
    private List<MenuItemDto>? _menuItems;
    private string _currentPath = "/";
    private bool _isCollapsed = true;
    private bool _isLoading = false;
    private bool _loadingFailed = false;

    protected override async Task OnInitializedAsync()
    {
        _currentPath = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.LocationChanged += OnLocationChanged;
        
        // Only load menu items if not on login page
        if (!_currentPath.Contains("/login"))
        {
            await LoadMenuItems();
        }
        else
        {
            _menuItems = new List<MenuItemDto>(); // Empty list for login page
        }
    }

    private async Task LoadMenuItems()
    {
        // Prevent multiple concurrent calls
        if (_isLoading || _loadingFailed)
        {
            return;
        }

        try
        {
            _isLoading = true;
            _menuItems = await ApiService.GetAsync<List<MenuItemDto>>("menu");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading menu: {ex.Message}");
            _loadingFailed = true; // Prevent retry until page refresh
            _menuItems = new List<MenuItemDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _currentPath = new Uri(e.Location).AbsolutePath;
        
        // Reset failed state when navigating away from login
        if (!_currentPath.Contains("/login"))
        {
            _loadingFailed = false;
        }
        
        // Reload menu items if navigating away from login page and not already loading/failed
        if (!_currentPath.Contains("/login") && 
            (_menuItems == null || _menuItems.Count == 0) && 
            !_isLoading && 
            !_loadingFailed)
        {
            await LoadMenuItems();
        }
        
        StateHasChanged();
    }

    private string GetMenuPath(string reference)
    {
        return reference.StartsWith("#") ? reference.Substring(1) : reference;
    }

    private bool IsActive(MenuItemDto item)
    {
        var path = GetMenuPath(item.Reference);
        return _currentPath.Equals($"/{path}", StringComparison.OrdinalIgnoreCase);
    }

    private void HandleMenuClick(MenuItemDto item)
    {
        var path = GetMenuPath(item.Reference);
        Navigation.NavigateTo($"/{path}");
    }

    private void ToggleMenu()
    {
        _isCollapsed = !_isCollapsed;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private class MenuItemDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Reference { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public int SortOrder { get; set; }
    }
}

