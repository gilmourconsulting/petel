@using PetelATH.BlazorServer.DTOs
@using PetelATH.BlazorServer.Services
@using PetelATH.BlazorServer.Models
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@inject ApiService ApiService
@inject IJSRuntime JSRuntime
@inject IOptions<ApiSettings> ApiSettings
@inject TokenService TokenService
@inject ActionSecurityService SecurityService

<div class="documents-table-wrapper">
    @if (!_isLoading)
    {
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 8px; flex-wrap: wrap;">
            <div>
                @if (AllowUpload)
                {
                    <button class="btn-secondary" @onclick="ShowAddDocumentTypeModal" title="הוסף סוג מסמך מרשימת הסוגים">
                        <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural" style="vertical-align: middle; margin-left: 4px;">
                        הוסף סוג מסמך
                    </button>
                }
            </div>
            <div>
                @if (AllowDownload && HasDownloadableDocuments)
                {
                    @if (!_isMultiSelectMode)
                    {
                        <button class="btn-secondary" @onclick="EnableMultiSelectMode" title="בחר מסמכים להורדה מרוכזת">
                            <img src="/images/download_icon.png" alt="הורדה" class="action-icon-natural" style="vertical-align: middle; margin-left: 4px;">
                            הורדת מסמכים
                        </button>
                    }
                    else
                    {
                        <button class="btn-primary" @onclick="DownloadSelectedDocuments" disabled="@(_selectedDocumentIds.Count == 0)">
                            <img src="/images/download_icon.png" alt="הורדה" class="action-icon-natural" style="vertical-align: middle; margin-left: 4px;">
                            הורד נבחרים (@_selectedDocumentIds.Count)
                        </button>
                        <button class="btn-secondary" @onclick="CancelMultiSelectMode" style="margin-right: 8px;">
                            ביטול
                        </button>
                    }
                }
            </div>
        </div>
    }
    @if (_isLoading)
    {
        <div class="loading-spinner">טוען מסמכים...</div>
    }
    else if (_documents == null || _documents.Count == 0)
    {
        <div style="text-align: center; color: #666; padding: 20px;">
            אין מסמכים להצגה
        </div>
    }
    else
    {
        @if (YearId == 102)
        {
            <div style="background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; padding: 12px 15px; margin-bottom: 15px; color: #856404; direction: rtl; text-align: right;">
                <strong>⚠️ הבהרה:</strong>  חילול מסמכים מהמערכת יתאפשר לאחר פרסום הפורמטים המעודכנים לשנת הלימודים על ידי משרד החינוך
            </div>
        }
        <div class="filter-bar" style="margin-bottom: 12px;">
            <input type="text"
                   @bind="_filterText"
                   @bind:event="oninput"
                   placeholder="חיפוש לפי סוג מסמך, תיאור או סטטוס..."
                   style="padding: 6px 10px; border: 1px solid #dee2e6; border-radius: 4px; width: 300px;" />
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        @if (_isMultiSelectMode)
                        {
                            <th>בחירה</th>
                        }
                        <th></th>
                        <th @onclick='() => SortTable("DocumentType")' style="cursor:pointer">סוג מסמך @GetSortArrow("DocumentType")</th>
                        <th>תיאור</th>
                        <th @onclick='() => SortTable("StatusName")' style="cursor:pointer">סטטוס @GetSortArrow("StatusName")</th>
                        @if (ShowEntityName)
                        {
                            <th @onclick='() => SortTable("EntityName")' style="cursor:pointer">שם ישות @GetSortArrow("EntityName")</th>
                        }
                        <th @onclick='() => SortTable("Username")' style="cursor:pointer">משתמש @GetSortArrow("Username")</th>
                        <th @onclick='() => SortTable("CreatedAt")' style="cursor:pointer">עדכון אחרון @GetSortArrow("CreatedAt")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in FilteredAndSortedDocuments)
                    {
                        <tr>
                            @if (_isMultiSelectMode)
                            {
                                <td>
                                    <input type="checkbox"
                                           checked="@_selectedDocumentIds.Contains(doc.Id)"
                                           disabled="@(doc.FileSize <= 0)"
                                           @onchange="(e => ToggleDocumentSelection(doc.Id, e))"
                                           title="@(doc.FileSize > 0 ? "בחר מסמך" : "אין קובץ זמין")" />
                                </td>
                            }
                            <td>
                                @if (AllowDownload && doc.FileSize > 0)
                                {
                                    <button class="btn-icon" @onclick="() => ViewDocument(doc.Id)" title="צפה במסמך">
                                        <img src="/images/view_icon.png" alt="צפייה" class="action-icon-natural">
                                    </button>
                                }
                                @if (AllowUpload)
                                {
                                    <button class="btn-icon" @onclick="() => ShowUploadModal(doc)" title="העלה מסמך">
                                        <img src="/images/upload_icon.png" alt="העלאה" class="action-icon-natural">
                                    </button>
                                }
                                @if (AllowApprove && doc.StatusId != 1 && doc.StatusId != 3)
                                {
                                    <SecureButton 
                                        ActionName="@($"{ScreenName}_approveDocument")"
                                        ScreenName="@ScreenName"
                                        FunctionName="ApproveDocument"
                                        ActionParams="@($"documentId={doc.Id}")"
                                        OnClick="() => ApproveDocument(doc.Id)"
                                        CssClass="btn-icon"
                                        Title="אשר מסמך">
                                        <img src="/images/approve_icon.png" alt="אישור" class="action-icon-natural">
                                    </SecureButton>
                                }
                                @if (AllowDelete && doc.FileSize > 0)
                                {
                                    <button class="btn-icon" @onclick="() => DeleteDocument(doc.Id)" title="מחק מסמך">
                                        <img src="/images/delete_icon.png" alt="מחיקה" class="action-icon-natural">
                                    </button>
                                }
                            </td>
                            <td>@doc.DocumentType</td>
                            <td>@doc.Description</td>
                            <td>@doc.StatusName</td>
                            @if (ShowEntityName)
                            {
                                <td>@doc.EntityName</td>
                            }
                            <td>@(doc.Username ?? "")</td>
                            <td>@doc.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Upload Modal -->
@if (_showUploadModal && _selectedDocument != null)
{
    <div class="modal-overlay" @onclick="CloseUploadModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 500px; direction: rtl;">
            <div class="modal-header">
                <h3>העלאת מסמך</h3>
                <button class="modal-close" @onclick="CloseUploadModal">&times;</button>
            </div>
            <div class="modal-body">
                <div style="margin-bottom: 15px; padding: 10px; background-color: #f0f8ff; border-radius: 4px;">
                    <strong>סוג מסמך:</strong> @_selectedDocument.DocumentType<br/>
                    <strong>תיאור:</strong> @_selectedDocument.Description
                </div>

                <div class="form-group" style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">
                        בחר קובץ <span style="color: red;">*</span>
                    </label>
                    <InputFile OnChange="HandleFileSelected" style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px;" />
                    @if (!string.IsNullOrEmpty(_selectedFileName))
                    {
                        <small style="display: block; margin-top: 5px; color: #666;">
                            קובץ נבחר: @_selectedFileName (@_selectedFileSize)
                        </small>
                    }
                </div>

                <div class="form-group" style="margin-bottom: 15px;">
                    <label style="display: block; margin-bottom: 5px; font-weight: 600;">
                        סטטוס <span style="color: red;">*</span>
                    </label>
                    <select @bind="_selectedStatusId" style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px;">
                        <option value="0">-- בחר סטטוס --</option>
                        @foreach (var status in _documentStatusTypes)
                        {
                            <option value="@status.Id">@status.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-primary" @onclick="ProcessUpload" disabled="@_isUploading">
                    @if (_isUploading)
                    {
                        <span>מעלה...</span>
                    }
                    else
                    {
                        <span>
                            <img src="/images/upload_icon.png" alt="העלאה" class="action-icon-natural" style="vertical-align: middle;">
                            העלה מסמך
                        </span>
                    }
                </button>
                <button class="btn-secondary" @onclick="CloseUploadModal" disabled="@_isUploading">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Add Document Type Modal -->
@if (_showAddDocumentTypeModal)
{
    <div class="modal-overlay" @onclick="CloseAddDocumentTypeModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 500px; direction: rtl;">
            <div class="modal-header">
                <h3>הוסף סוג מסמך</h3>
                <button class="modal-close" @onclick="CloseAddDocumentTypeModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_isLoadingAvailableTypes)
                {
                    <div class="loading-spinner">טוען סוגי מסמכים...</div>
                }
                else if (_availableDocumentTypes.Count == 0)
                {
                    <div style="text-align: center; color: #666; padding: 20px;">
                        כל סוגי המסמכים כבר קיימים ברשימה
                    </div>
                }
                else
                {
                    <div class="form-group" style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">
                            בחר סוג מסמך <span style="color: red;">*</span>
                        </label>
                        <select @bind="_selectedDocumentTypeIdToAdd" style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px;">
                            <option value="0">-- בחר סוג מסמך --</option>
                            @foreach (var docType in _availableDocumentTypes)
                            {
                                <option value="@docType.Id">@docType.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (_availableDocumentTypes.Count > 0)
                {
                    <button class="btn-primary" @onclick="SubmitAddDocumentType"
                            disabled="@(_selectedDocumentTypeIdToAdd == 0 || _isAddingDocumentType)">
                        @if (_isAddingDocumentType)
                        {
                            <span>מוסיף...</span>
                        }
                        else
                        {
                            <span>
                                <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural" style="vertical-align: middle; margin-left: 4px;">
                                הוסף
                            </span>
                        }
                    </button>
                }
                <button class="btn-secondary" @onclick="CloseAddDocumentTypeModal">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string EntityType { get; set; } = "student"; // 'student', 'school', 'entity', 'entity-hierarchy'
    [Parameter] public int? EntityId { get; set; }
    [Parameter] public int? YearId { get; set; }
    [Parameter] public string ScreenName { get; set; } = "documents"; // Screen name for security context
    [Parameter] public bool AllowDownload { get; set; } = true;
    [Parameter] public bool AllowUpload { get; set; } = true;
    [Parameter] public bool AllowApprove { get; set; } = true;
    [Parameter] public bool AllowDelete { get; set; } = true;
    [Parameter] public bool ShowEntityName { get; set; } = false;
    [Parameter] public EventCallback OnDocumentsChanged { get; set; }
    /// <summary>Extra query-string parameters appended to the fetch endpoint (e.g. "ownerEntityId=42").</summary>
    [Parameter] public string? AdditionalQueryParams { get; set; }

    private List<DocumentDto> _documents = new();
    private bool _isLoading = true;
    private bool _showUploadModal = false;
    private bool _isUploading = false;
    private DocumentDto? _selectedDocument = null;
    private IBrowserFile? _selectedFile = null;
    private string _selectedFileName = string.Empty;
    private string _selectedFileSize = string.Empty;
    private int _selectedStatusId = 0;
    private List<DocumentStatusTypeDto> _documentStatusTypes = new();
    private bool _isMultiSelectMode = false;
    private HashSet<long> _selectedDocumentIds = new();

    // Add document type modal state
    private bool _showAddDocumentTypeModal = false;
    private bool _isLoadingAvailableTypes = false;
    private bool _isAddingDocumentType = false;
    private List<DocumentTypeItemDto> _availableDocumentTypes = new();
    private int _selectedDocumentTypeIdToAdd = 0;

    private bool HasDownloadableDocuments => _documents.Any(d => d.FileSize > 0);

    private string _filterText = "";
    private string _sortColumn = "";
    private bool _sortAscending = true;

    private IEnumerable<DocumentDto> FilteredAndSortedDocuments
    {
        get
        {
            var items = (_documents ?? new()).AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var f = _filterText;
                items = items.Where(d =>
                    (d.DocumentType?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Description?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.StatusName?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (d.Username?.Contains(f, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            items = _sortColumn switch
            {
                "DocumentType" => _sortAscending ? items.OrderBy(d => d.DocumentType)  : items.OrderByDescending(d => d.DocumentType),
                "StatusName"   => _sortAscending ? items.OrderBy(d => d.StatusName)    : items.OrderByDescending(d => d.StatusName),
                "EntityName"   => _sortAscending ? items.OrderBy(d => d.EntityName)    : items.OrderByDescending(d => d.EntityName),
                "Username"     => _sortAscending ? items.OrderBy(d => d.Username)      : items.OrderByDescending(d => d.Username),
                "CreatedAt"    => _sortAscending ? items.OrderBy(d => d.CreatedAt)     : items.OrderByDescending(d => d.CreatedAt),
                _              => items
            };

            return items;
        }
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? " ▲" : " ▼";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId.HasValue)
        {
            await LoadDocuments();
        }
    }

    public async Task Reload()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            string endpoint = EntityType switch
            {
                "student" => $"documents/by-student-id?studentId={EntityId}&yearId={YearId}",
                "school" => $"documents/by-entity?entityId={EntityId}&yearId={YearId}{(string.IsNullOrEmpty(AdditionalQueryParams) ? "" : "&" + AdditionalQueryParams)}",
                "entity" => $"documents/by-entity?entityId={EntityId}&yearId={YearId}{(string.IsNullOrEmpty(AdditionalQueryParams) ? "" : "&" + AdditionalQueryParams)}",
                "entity-hierarchy" => $"documents/by-entity-hierarchy?entityId={EntityId}&yearId={YearId}",
                _ => throw new ArgumentException($"Invalid EntityType: {EntityType}")
            };

            _documents = await ApiService.GetAsync<List<DocumentDto>>(endpoint) ?? new();

            Console.WriteLine($"✅ Loaded {_documents.Count} documents for {EntityType} {EntityId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading documents: {ex.Message}");
            _documents = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewDocument(long documentId)
    {
        try
        {
            Console.WriteLine($"👁️ Viewing document: {documentId}");

            var token = await TokenService.GetTokenAsync();
            if (string.IsNullOrEmpty(token))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נמצא אסימון אימות. אנא התחבר מחדש.");
                return;
            }

            // ✅ Use document proxy endpoint (server-side call to API)
            var downloadUrl = $"/api/documents/{documentId}/proxy";

            Console.WriteLine($"👁️ Opening document via proxy: {downloadUrl}");

            // Use CSP-compliant helper function
            await JSRuntime.InvokeVoidAsync("BlazorHelpers.viewFileWithAuth", downloadUrl, token);
            
            Console.WriteLine("✅ Document view initiated");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error initiating document view: {ex.Message}");
            // Don't try to show alert if circuit is disconnected
            if (ex is not Microsoft.JSInterop.JSDisconnectedException)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("alert", "שגיאה בפתיחת המסמך");
                }
                catch
                {
                    // Ignore JS interop failures during cleanup
                }
            }
        }
    }

    private void EnableMultiSelectMode()
    {
        _isMultiSelectMode = true;
        _selectedDocumentIds.Clear();
        StateHasChanged();
    }

    private void CancelMultiSelectMode()
    {
        _isMultiSelectMode = false;
        _selectedDocumentIds.Clear();
        StateHasChanged();
    }

    private void ToggleDocumentSelection(long documentId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool b && b;
        if (isChecked)
        {
            _selectedDocumentIds.Add(documentId);
        }
        else
        {
            _selectedDocumentIds.Remove(documentId);
        }
    }

    private async Task DownloadSelectedDocuments()
    {
        try
        {
            if (_selectedDocumentIds.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "יש לבחור לפחות מסמך אחד להורדה");
                return;
            }

            var token = await TokenService.GetTokenAsync();
            if (string.IsNullOrWhiteSpace(token))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נמצא אסימון אימות. אנא התחבר מחדש.");
                return;
            }

            var idList = string.Join(",", _selectedDocumentIds);
            var apiBaseUrl = ApiSettings.Value.BaseUrl.TrimEnd('/');
            var downloadUrl = $"{apiBaseUrl}/documents/bulk-export/selected?ids={Uri.EscapeDataString(idList)}";

            await JSRuntime.InvokeVoidAsync("BlazorHelpers.downloadFileWithAuth", downloadUrl, token, "documents.zip");

            CancelMultiSelectMode();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error downloading selected documents: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בהורדת המסמכים הנבחרים");
        }
    }

    private async Task ShowUploadModal(DocumentDto document)
    {
        try
        {
            Console.WriteLine($"📤 Showing upload modal for document: {document.Id}");

            _selectedDocument = document;
            _selectedFile = null;
            _selectedFileName = string.Empty;
            _selectedFileSize = string.Empty;
            _selectedStatusId = document.DocumentStatusId ?? 2; // Default to "התקבל" (ID: 2)

            // Load document status types
            await LoadDocumentStatusTypes();

            _showUploadModal = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error showing upload modal: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בפתיחת חלון העלאה");
        }
    }

    private void CloseUploadModal()
    {
        _showUploadModal = false;
        _selectedDocument = null;
        _selectedFile = null;
        _selectedFileName = string.Empty;
        _selectedFileSize = string.Empty;
        _selectedStatusId = 0;
        StateHasChanged();
    }

    private async Task ShowAddDocumentTypeModal()
    {
        _showAddDocumentTypeModal = true;
        _selectedDocumentTypeIdToAdd = 0;
        _availableDocumentTypes = new();
        _isLoadingAvailableTypes = true;
        StateHasChanged();
        await LoadAvailableDocumentTypes();
    }

    private async Task LoadAvailableDocumentTypes()
    {
        try
        {
            var endpoint = $"documents/available-document-types?entityType={EntityType}&entityId={EntityId}&yearId={YearId}";
            _availableDocumentTypes = await ApiService.GetAsync<List<DocumentTypeItemDto>>(endpoint) ?? new();
            Console.WriteLine($"✅ Loaded {_availableDocumentTypes.Count} available document types");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading available document types: {ex.Message}");
            _availableDocumentTypes = new();
        }
        finally
        {
            _isLoadingAvailableTypes = false;
            StateHasChanged();
        }
    }

    private async Task SubmitAddDocumentType()
    {
        if (_selectedDocumentTypeIdToAdd == 0) return;

        try
        {
            _isAddingDocumentType = true;
            StateHasChanged();

            var response = await ApiService.PostAsync<object, Dictionary<string, object>>(
                "documents/add-document-type",
                new { entityType = EntityType, entityId = EntityId, documentTypeId = _selectedDocumentTypeIdToAdd }
            );

            if (response != null && response.ContainsKey("success"))
            {
                var successValue = response["success"];
                bool isSuccess = successValue is System.Text.Json.JsonElement jsonElem
                    ? jsonElem.GetBoolean()
                    : Convert.ToBoolean(successValue);

                if (isSuccess)
                {
                    var message = response.ContainsKey("message") ? response["message"]?.ToString() : "סוג המסמך נוסף בהצלחה";
                    Console.WriteLine($"✅ {message}");
                    CloseAddDocumentTypeModal();
                    await LoadDocuments();
                    await OnDocumentsChanged.InvokeAsync();
                }
                else
                {
                    var errorMsg = response.ContainsKey("message") ? response["message"]?.ToString() : "שגיאה בהוספת סוג מסמך";
                    await JSRuntime.InvokeVoidAsync("alert", errorMsg);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה בהוספת סוג מסמך");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error adding document type: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בהוספת סוג מסמך: {ex.Message}");
        }
        finally
        {
            _isAddingDocumentType = false;
            StateHasChanged();
        }
    }

    private void CloseAddDocumentTypeModal()
    {
        _showAddDocumentTypeModal = false;
        _selectedDocumentTypeIdToAdd = 0;
        _availableDocumentTypes = new();
        StateHasChanged();
    }

    private async Task LoadDocumentStatusTypes()
    {
        try
        {
            _documentStatusTypes = await ApiService.GetAsync<List<DocumentStatusTypeDto>>("documents/status-types") ?? new();
            Console.WriteLine($"✅ Loaded {_documentStatusTypes.Count} document status types");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading document status types: {ex.Message}");
            _documentStatusTypes = new();
        }
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File.Name;
        _selectedFileSize = FormatFileSize(e.File.Size);
        StateHasChanged();
    }

    private async Task ProcessUpload()
    {
        if (_selectedFile == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אנא בחר קובץ להעלאה");
            return;
        }

        if (_selectedStatusId == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "אנא בחר סטטוס");
            return;
        }

        if (_selectedDocument == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה: מסמך לא נבחר");
            return;
        }

        try
        {
            _isUploading = true;
            StateHasChanged();

            Console.WriteLine($"📤 Uploading file to document {_selectedDocument.Id}");

            // Create multipart form data
            using var content = new MultipartFormDataContent();

            // Add file
            var fileContent = new StreamContent(_selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024)); // 10MB limit
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_selectedFile.ContentType);
            content.Add(fileContent, "file", _selectedFile.Name);

            // Add status ID
            content.Add(new StringContent(_selectedStatusId.ToString()), "statusId");

            // Add existing document ID for replacement
            content.Add(new StringContent(_selectedDocument.Id.ToString()), "existingDocumentId");

            // Add document type ID (required by API validation even though it's not used for replacement)
            content.Add(new StringContent(_selectedDocument.DocumentTypeId.ToString()), "documentTypeId");

            // Upload to API (note: endpoint is just "documents/upload", not "documents/{id}/upload")
            var response = await ApiService.PostMultipartAsync<Dictionary<string, object>>(
                "documents/upload",
                content
            );

            if (response != null && response.ContainsKey("id"))
            {
                // Success - API returns object with id, description, version, etc.
                var message = response.ContainsKey("message") ? response["message"].ToString() : "הקובץ הועלה בהצלחה";
                await JSRuntime.InvokeVoidAsync("alert", message);
                Console.WriteLine("✅ File uploaded successfully");

                CloseUploadModal();
                await LoadDocuments();
                await OnDocumentsChanged.InvokeAsync();
            }
            else
            {
                // Error - API returns object with error property
                var message = response?.ContainsKey("error") == true 
                    ? response["error"].ToString() 
                    : "שגיאה בהעלאת הקובץ";
                await JSRuntime.InvokeVoidAsync("alert", message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error uploading file: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בהעלאת הקובץ: {ex.Message}");
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes == 0) return "0 B";
        
        string[] sizes = { "B", "KB", "MB", "GB" };
        int i = 0;
        double size = bytes;
        
        while (size >= 1024 && i < sizes.Length - 1)
        {
            size /= 1024;
            i++;
        }
        
        return $"{Math.Round(size, 2)} {sizes[i]}";
    }

    private async Task DeleteDocument(long documentId)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם אתה בטוח שברצונך למחוק את הקובץ? הרשומה תישאר עם סטטוס 'לא קיים'");
            if (!confirmed) return;

            Console.WriteLine($"🗑️ Deleting file for document: {documentId}");

            // Call endpoint to delete file blob and update status to "לא קיים" (1)
            var response = await ApiService.PostAsync<object, Dictionary<string, object>>(
                $"documents/{documentId}/delete-file",
                new { }
            );

            if (response != null && response.ContainsKey("success"))
            {
                // Handle JsonElement for success field
                var successValue = response["success"];
                bool isSuccess = successValue is System.Text.Json.JsonElement jsonElement 
                    ? jsonElement.GetBoolean() 
                    : Convert.ToBoolean(successValue);

                if (isSuccess)
                {
                    var message = response.ContainsKey("message") ? response["message"].ToString() : "הקובץ נמחק בהצלחה";
                    await JSRuntime.InvokeVoidAsync("alert", message);
                    Console.WriteLine("✅ File deleted successfully");

                    await LoadDocuments();
                    await OnDocumentsChanged.InvokeAsync();
                }
                else
                {
                    var message = response.ContainsKey("error") ? response["error"].ToString() : "שגיאה במחיקת הקובץ";
                    await JSRuntime.InvokeVoidAsync("alert", message);
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה במחיקת הקובץ");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error deleting document file: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה במחיקת הקובץ: {ex.Message}");
        }
    }

