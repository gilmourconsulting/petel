@using PetelATH.BlazorServer.DTOs
@inject IJSRuntime JSRuntime

@if (_isVisible)
{
    <div class="dialog-overlay" @onclick="Cancel">
        <div class="dialog-box" style="min-width: 500px;" @onclick:stopPropagation="true">
            <h3 class="dialog-title">עריכת כתובת</h3>
            <div style="margin: 20px 0;">
                <div style="margin-bottom: 15px;">
                    <label for="addressStreet" style="display: block; margin-bottom: 5px; font-weight: 600;">רחוב:</label>
                    <input type="text"
                           id="addressStreet"
                           @bind="_street"
                           placeholder="הזן שם רחוב"
                           style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 14px; direction: rtl;">
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="addressHouseNumber" style="display: block; margin-bottom: 5px; font-weight: 600;">מספר בית:</label>
                    <input type="text"
                           id="addressHouseNumber"
                           @bind="_houseNumber"
                           placeholder="הזן מספר בית"
                           style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 14px; direction: ltr; text-align: left;">
                </div>

                <div style="margin-bottom: 15px; position: relative;">
                    <label for="addressCity" style="display: block; margin-bottom: 5px; font-weight: 600;">עיר (רשות):</label>
                    <input type="text"
                           id="addressCity"
                           value="@_citySearchText"
                           @oninput="OnCitySearchInput"
                           @onfocus="OnCityFocus"
                           placeholder="הקלד לחיפוש..."
                           autocomplete="off"
                           style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 14px; direction: rtl;">

                    @if (_showCitySuggestions && _filteredCouncils.Any())
                    {
                        <div @onmousedown:preventDefault="true"
                             style="position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 4px 4px; max-height: 200px; overflow-y: auto; z-index: 1000; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                            @foreach (var council in _filteredCouncils)
                            {
                                <div @onclick="() => SelectCouncil(council)"
                                     @onmouseover="@(() => _hoveredCouncilId = council.Id)"
                                     @onmouseout="@(() => _hoveredCouncilId = null)"
                                     style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0; direction: rtl; background-color: @((_hoveredCouncilId == council.Id) ? "#f8f9fa" : "white");">
                                    @council.CouncilName
                                </div>
                            }
                        </div>
                    }
                    else if (_showCitySuggestions && !_filteredCouncils.Any() && !string.IsNullOrWhiteSpace(_citySearchText))
                    {
                        <div style="position: absolute; top: 100%; left: 0; right: 0; background: white; border: 1px solid #dee2e6; border-top: none; border-radius: 0 0 4px 4px; z-index: 1000; box-shadow: 0 4px 6px rgba(0,0,0,0.1); padding: 12px; color: #999; direction: rtl;">
                            לא נמצאו תוצאות
                        </div>
                    }
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="addressPostCode" style="display: block; margin-bottom: 5px; font-weight: 600;">מיקוד:</label>
                    <input type="text"
                           id="addressPostCode"
                           @bind="_postalCode"
                           placeholder="הזן מיקוד"
                           maxlength="10"
                           style="width: 100%; padding: 8px; border: 1px solid #dee2e6; border-radius: 4px; font-size: 14px; direction: ltr; text-align: left;">
                </div>
            </div>
            <div class="dialog-buttons">
                <button class="dialog-btn save" @onclick="SaveAddress">אישור</button>
                <button class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public List<CouncilDto> Councils { get; set; } = new();

    private bool _isVisible = false;
    private TaskCompletionSource<AddressInfo?>? _tcs;

    // Form fields
    private string _street = "";
    private string _houseNumber = "";
    private string _citySearchText = "";
    private string _postalCode = "";
    private int? _selectedCouncilId = null;

    // City autocomplete state
    private bool _showCitySuggestions = false;
    private List<CouncilDto> _filteredCouncils = new();
    private int? _hoveredCouncilId = null;

    public class AddressInfo
    {
        public string Street { get; set; } = "";
        public string HouseNumber { get; set; } = "";
        public string City { get; set; } = "";
        public int? CouncilId { get; set; }
        public string PostalCode { get; set; } = "";
        public string FormattedAddress { get; set; } = "";
    }

    public async Task<AddressInfo?> ShowAsync(AddressInfo? currentAddress)
    {
        Console.WriteLine("📍 Opening address editor modal");

        _tcs = new TaskCompletionSource<AddressInfo?>();
        _isVisible = true;

        // Populate form with current values
        if (currentAddress != null)
        {
            _street = currentAddress.Street ?? "";
            _houseNumber = currentAddress.HouseNumber ?? "";
            _postalCode = currentAddress.PostalCode ?? "";
            _selectedCouncilId = currentAddress.CouncilId;

            // Find council by ID to get the name
            var matchingCouncil = Councils.FirstOrDefault(c => c.Id == currentAddress.CouncilId);
            if (matchingCouncil != null)
            {
                _citySearchText = matchingCouncil.CouncilName;
                Console.WriteLine($"✅ Pre-selected council: {matchingCouncil.CouncilName} (ID: {matchingCouncil.Id})");
            }
            else if (!string.IsNullOrEmpty(currentAddress.City))
            {
                _citySearchText = currentAddress.City;
                // Try to match by name
                matchingCouncil = Councils.FirstOrDefault(c => c.CouncilName == currentAddress.City);
                if (matchingCouncil != null)
                {
                    _selectedCouncilId = matchingCouncil.Id;
                }
            }
        }
        else
        {
            // Reset form
            _street = "";
            _houseNumber = "";
            _citySearchText = "";
            _postalCode = "";
            _selectedCouncilId = null;
        }

        StateHasChanged();

        // Focus the street input after render
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("BlazorHelpers.focusElement", "addressStreet");

        return await _tcs.Task;
    }

    private void FilterCouncils()
    {
        if (string.IsNullOrWhiteSpace(_citySearchText))
        {
            _filteredCouncils = Councils.Take(10).ToList();
        }
        else
        {
            _filteredCouncils = Councils
                .Where(c => c.CouncilName.Contains(_citySearchText, StringComparison.OrdinalIgnoreCase))
                .Take(10)
                .ToList();
        }
    }

    private void OnCitySearchInput(ChangeEventArgs e)
    {
        _citySearchText = e.Value?.ToString() ?? "";
        FilterCouncils();
        _showCitySuggestions = true;
    }

    private void OnCityFocus()
    {
        FilterCouncils();
        _showCitySuggestions = true;
    }

    private void SelectCouncil(CouncilDto council)
    {
        _citySearchText = council.CouncilName;
        _selectedCouncilId = council.Id;
        _showCitySuggestions = false;
        Console.WriteLine($"✅ Council selected: {council.CouncilName} (ID: {council.Id})");
    }

    private void SaveAddress()
    {
        Console.WriteLine("📝 Validating address form data");

        // Validate required fields
        if (string.IsNullOrWhiteSpace(_street))
        {
            _ = JSRuntime.InvokeVoidAsync("alert", "נא להזין שם רחוב");
            return;
        }

        if (string.IsNullOrWhiteSpace(_citySearchText) || _selectedCouncilId == null)
        {
            _ = JSRuntime.InvokeVoidAsync("alert", "נא לבחור עיר מהרשימה");
            return;
        }

        // Build formatted address
        var formattedAddress = _street;
        if (!string.IsNullOrWhiteSpace(_houseNumber))
        {
            formattedAddress += " " + _houseNumber;
        }
        formattedAddress += ", " + _citySearchText;
        if (!string.IsNullOrWhiteSpace(_postalCode) && _postalCode != "0000000" && _postalCode != "0")
        {
            formattedAddress += ", " + _postalCode;
        }

        Console.WriteLine($"✅ Formatted address: {formattedAddress}");

        var result = new AddressInfo
        {
            Street = _street,
            HouseNumber = _houseNumber,
            City = _citySearchText,
            CouncilId = _selectedCouncilId,
            PostalCode = _postalCode,
            FormattedAddress = formattedAddress
        };

        _isVisible = false;
        _tcs?.SetResult(result);
        StateHasChanged();
    }

    private void Cancel()
    {
        Console.WriteLine("❌ Address edit cancelled");
        _isVisible = false;
        _tcs?.SetResult(null);
        StateHasChanged();
    }
}
