@inject ApiService ApiService

@if (_isLoading)
{
    <div class="loading-spinner">טוען...</div>
}
else
{
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>פעולות</th>
                    <th>אחוז</th>
                    <th>סדר תצוגה</th>
                    <th>סטטוס</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr class="@(item.IsActive ? "" : "row-inactive")">
                        <td>
                            <SecureButton ActionName="system_data_ministry_options_edit" ScreenName="@ScreenName" FunctionName="Edit"
                                          OnClick="() => ShowEditDialog(item)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                            </SecureButton>
                        </td>
                        <td>@item.Percentage.ToString("0.##")%</td>
                        <td>@item.DisplayOrder</td>
                        <td>@(item.IsActive ? "פעיל" : "לא פעיל")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editItem == null ? "הוספת אחוז השתתפות" : "עריכת אחוז השתתפות")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>אחוז <span class="required">*</span></label>
                    <InputNumber class="form-control" @bind-Value="_formPercentage" />
                </div>
                <div class="form-group">
                    <label>סדר תצוגה</label>
                    <InputNumber class="form-control" @bind-Value="_formDisplayOrder" />
                </div>
                @if (_editItem != null)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_formIsActive" /> פעיל
                        </label>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@_isSaving">@(_isSaving ? "שומר..." : "שמור")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ScreenName { get; set; } = "system_data";

    private List<MinistryParticipationOptionDto> _items = new();
    private bool _isLoading = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private MinistryParticipationOptionDto? _editItem;
    private decimal _formPercentage;
    private int _formDisplayOrder;
    private bool _formIsActive = true;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    public async Task RefreshAsync() => await LoadDataAsync();

    public void ShowCreateDialog()
    {
        _editItem = null;
        _formPercentage = 0;
        _formDisplayOrder = 0;
        _formError = string.Empty;
        _showFormDialog = true;
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        var response = await ApiService.GetAsync<ApiResponse<List<MinistryParticipationOptionDto>>>(
            "ministry-participation-options?includeInactive=true");
        _items = response?.Data ?? new();
        _isLoading = false;
        StateHasChanged();
    }

    private void ShowEditDialog(MinistryParticipationOptionDto item)
    {
        _editItem = item;
        _formPercentage = item.Percentage;
        _formDisplayOrder = item.DisplayOrder;
        _formIsActive = item.IsActive;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog() => _showFormDialog = false;

    private async Task Save()
    {
        _isSaving = true;
        _formError = string.Empty;
        try
        {
            ApiResponse<object>? response;
            if (_editItem == null)
            {
                response = await ApiService.PostAsync<CreateMinistryParticipationOptionRequest, ApiResponse<object>>(
                    "ministry-participation-options",
                    new CreateMinistryParticipationOptionRequest
                    {
                        Percentage = _formPercentage,
                        DisplayOrder = _formDisplayOrder
                    });
            }
            else
            {
                response = await ApiService.PutAsync<UpdateMinistryParticipationOptionRequest, ApiResponse<object>>(
                    $"ministry-participation-options/{_editItem.Id}",
                    new UpdateMinistryParticipationOptionRequest
                    {
                        Percentage = _formPercentage,
                        DisplayOrder = _formDisplayOrder,
                        IsActive = _formIsActive
                    });
            }

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }
}
