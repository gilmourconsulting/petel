    private async Task RecheckMucarimEntitlementMatches()
    {
        _isMatchRechecking = true;
        _matchRecheckError = "";
        _matchRecheckResult = null;
        try
        {
            var response = await ApiService.PostAsync<object, ApiResponse<MeitarMucarimEntitlementMatchResultDto>>(
                $"meitar-mucarim-entitlement-matches/recheck?year={_filterYear}&month={_filterMonth}", new { });
            _matchRecheckResult = response?.Data;
            await LoadDataAsync(showSpinner: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rechecking mucarim entitlement matches: {ex.Message}");
            _matchRecheckError = "שגיאה בבדיקת התאמות הזכאות. נסה שוב.";
        }
        finally
        {
            _isMatchRechecking = false;
            _showMatchRecheckSummary = true;
        }
    }

    private void CloseMatchRecheckSummary() => _showMatchRecheckSummary = false;

    private async Task ShowMucarimMatches(MeitarMucarimListItemDto item)
    {
        _selectedMucarimForMatches = item;
        _showMucarimMatchesModal = true;
        _isLoadingMucarimMatches = true;
        _mucarimMatchRows = new();
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<MeitarMucarimEntitlementMatchListItemDto>>>(
                $"meitar-mucarim-entitlement-matches?year={item.PeriodYear}&month={item.PeriodMonth}");
            _mucarimMatchRows = (response?.Data ?? new())
                .Where(m => m.MeitarMucarimId == item.Id)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading mucarim entitlement matches: {ex.Message}");
            _mucarimMatchRows = new();
        }
        finally
        {
            _isLoadingMucarimMatches = false;
        }
    }

    private void CloseMucarimMatchesModal()
    {
        _showMucarimMatchesModal = false;
        _selectedMucarimForMatches = null;
        _mucarimMatchRows = new();
    }

    private void ClearClientFilters()
    {
        _filterTopic = "";
        _filterNonZeroDifference = false;
    }

    private void NavigateBack()
    {
        if (_returnGregorianYear.HasValue)
            Navigation.NavigateTo($"/gregorian/{_returnGregorianYear.Value}");
        else if (_returnYearId.HasValue)
            Navigation.NavigateTo($"/year/{_returnYearId.Value}");
        else
            Navigation.NavigateTo("/maindashboard");
    }

    private void NavigateToMonthSummary()
    {
        var qs = $"year={_filterYear}&month={_filterMonth}&yearId={_selectedYearId}";
        if (_returnGregorianYear.HasValue)
            qs += $"&fromGregorianYear={_returnGregorianYear.Value}";
        else if (_returnYearId.HasValue)
            qs += $"&fromYear={_returnYearId.Value}";
        Navigation.NavigateTo($"/meitar-data/month-summary?{qs}");
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

