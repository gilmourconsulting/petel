    private static string GetSortArrow(string column, string currentSortColumn, bool ascending)
    {
        if (currentSortColumn != column) return "";
        return ascending ? "▲" : "▼";
    }

    private static string GetMonthName(int month) =>
        month is >= 1 and <= 12 ? MonthNames[month] : month.ToString();
