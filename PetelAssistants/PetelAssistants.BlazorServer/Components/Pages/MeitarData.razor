    private async Task LoadDataAsync(bool showSpinner = true)
    {
        if (showSpinner)
            _isLoading = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<MeitarMutavimListItemDto>>>(
                $"meitardata?year={_filterYear}&month={_filterMonth}&dateField={_dateField}");
            _items = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading meitar data: {ex.Message}");
            _items = new();
        }

        try
        {
            var mucarimResponse = await ApiService.GetAsync<ApiResponse<List<MeitarMucarimListItemDto>>>(
                $"meitardata/mucarim?year={_filterYear}&month={_filterMonth}&dateField={_dateField}");
            _mucarimItems = mucarimResponse?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading meitar mucarim data: {ex.Message}");
            _mucarimItems = new();
        }

        try
        {
            var sharatimResponse = await ApiService.GetAsync<ApiResponse<List<MeitarSharatimListItemDto>>>(
                $"meitardata/sharatim?year={_filterYear}&month={_filterMonth}&dateField={_dateField}");
            _sharatimItems = sharatimResponse?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading meitar sharatim data: {ex.Message}");
            _sharatimItems = new();
        }

        try
        {
            var cheshbonitResponse = await ApiService.GetAsync<ApiResponse<List<MeitarCheshbonitListItemDto>>>(
                $"meitardata/cheshbonit?year={_filterYear}&month={_filterMonth}&dateField={_dateField}");
            _cheshbonitItems = cheshbonitResponse?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading meitar cheshbonit data: {ex.Message}");
            _cheshbonitItems = new();
        }
        finally
        {
            if (showSpinner)
                _isLoading = false;
        }
    }

