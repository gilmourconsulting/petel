    protected override async Task OnPageInitializedAsync()
    {
        _returnYearId = FromYear;
        _returnGregorianYear = FromGregorianYear;
        await LoadSchoolYearAsync();
        RebuildMonths();
        PickDefaultMonth();
        if (_returnYearId.HasValue || _returnGregorianYear.HasValue)
            _dateField = "calc";
        await LoadDataAsync();
    }

    private async Task LoadSchoolYearAsync()
    {
        if (_returnGregorianYear.HasValue)
            return;

        try
        {
            if (_returnYearId.HasValue)
            {
                var year = await ApiService.GetAsync<YearDto>($"years/{_returnYearId.Value}");
                if (year != null)
                {
                    _years = new List<YearDto> { year };
                    _selectedYearId = year.Id;
                }
            }
            else
            {
                var context = await ApiService.GetAsync<YearContextDto>("years/context");
                _years = context?.AllYears ?? new();
                _selectedYearId = context?.CurrentYear?.Id ?? _years.FirstOrDefault()?.Id ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school year: {ex.Message}");
            _years = new();
        }
    }

    private YearDto? SelectedYear => _years.FirstOrDefault(y => y.Id == _selectedYearId);

    private void RebuildMonths()
    {
        _schoolMonths = new();
        if (_returnGregorianYear.HasValue)
        {
            var y = _returnGregorianYear.Value;
            for (var m = 1; m <= 12; m++)
                _schoolMonths.Add((y, m));
            return;
        }

        var year = SelectedYear;
        if (year?.StartDate is null || year.EndDate is null)
            return;

        var start = new DateOnly(year.StartDate.Value.Year, year.StartDate.Value.Month, 1);
        var end = new DateOnly(year.EndDate.Value.Year, year.EndDate.Value.Month, 1);
        if (end < start)
            return;

        for (var cursor = start; cursor <= end; cursor = cursor.AddMonths(1))
            _schoolMonths.Add((cursor.Year, cursor.Month));
    }

    private void PickDefaultMonth()
    {
        if (_schoolMonths.Count == 0)
            return;

        var previous = DateTime.Today.AddMonths(-1);
        foreach (var month in _schoolMonths)
        {
            if (month.Year == previous.Year && month.Month == previous.Month)
            {
                _filterYear = month.Year;
                _filterMonth = month.Month;
                return;
            }
        }

        var todayKey = DateTime.Today.Year * 12 + DateTime.Today.Month;
        var last = _schoolMonths[^1];
        if (last.Year * 12 + last.Month < todayKey)
        {
            _filterYear = last.Year;
            _filterMonth = last.Month;
        }
        else
        {
            _filterYear = _schoolMonths[0].Year;
            _filterMonth = _schoolMonths[0].Month;
        }
    }

    private async Task OnSchoolYearChanged()
    {
        RebuildMonths();
        PickDefaultMonth();
        await LoadDataAsync();
    }

    private async Task SelectMonth(int year, int month)
    {
        if (_filterYear == year && _filterMonth == month)
            return;
        _filterYear = year;
        _filterMonth = month;
        await LoadDataAsync(showSpinner: false);
    }

    private async Task OnPeriodChanged()
    {
        await LoadDataAsync();
