@page "/meitar-data"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    @if (_returnYearId.HasValue)
    {
        <SecureButton ActionName="yearmanagement_meitar_retrieve" ScreenName="@PageName" FunctionName="ShowMeitarRetrieveDialog"
                      OnClick="ShowMeitarRetrieveDialog" CssClass="context-btn" HideIfNoAccess="true">
            שליפת נתוני מיתר
        </SecureButton>
    }
    else
    {
        <SecureButton ActionName="maindashboard_meitar_retrieve" ScreenName="@PageName" FunctionName="ShowMeitarRetrieveDialog"
                      OnClick="ShowMeitarRetrieveDialog" CssClass="context-btn" HideIfNoAccess="true">
            שליפת נתוני מיתר
        </SecureButton>
    }
    <SecureButton ActionName="meitardata_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    @if (_activeTab == DataTab.Mucarim)
    {
        <SecureButton ActionName="meitardata_mucarim_entitlement_recheck" ScreenName="@PageName" FunctionName="RecheckMucarimEntitlementMatches"
                      OnClick="RecheckMucarimEntitlementMatches" CssClass="context-btn" Disabled="_isMatchRechecking" HideIfNoAccess="true">
            @(_isMatchRechecking ? "בודק..." : "בדיקת התאמות זכאות מחדש")
        </SecureButton>
    }
    <SecureButton ActionName="meitardata_month_summary" ScreenName="@PageName" FunctionName="NavigateToMonthSummary"
                  OnClick="NavigateToMonthSummary" CssClass="context-btn" HideIfNoAccess="true">
        סיכום מול תקציב
    </SecureButton>
    <SecureButton ActionName="meitardata_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        @(_returnYearId.HasValue ? "חזרה לניהול שנה" : _returnGregorianYear.HasValue ? "חזרה לניהול שנה לועזית" : "חזרה לדף הבית")
    </SecureButton>
</div>

<MeitarRetrieveModal @ref="_meitarRetrieveModal" YearId="_selectedYearId" />

@if (_showMatchRecheckSummary)
{
    <div class="modal-overlay" @onclick="CloseMatchRecheckSummary">
        <div class="modal-content" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>סיכום התאמות זכאות</h3>
                <button class="modal-close" @onclick="CloseMatchRecheckSummary">&times;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_matchRecheckError))
                {
                    <div class="alert alert-danger">@_matchRecheckError</div>
                }
                else if (_matchRecheckResult != null)
                {
                    <p>הותאמו מחדש שורות מוכרים לתקופה @_filterMonth/@_filterYear.</p>
                    <ul>
                        <li>התאמות ישנות שבוטלו: @_matchRecheckResult.DisabledCount</li>
                        <li>התאמות חדשות: @_matchRecheckResult.MatchedCount</li>
                        <li>שורות ללא התאמה: @_matchRecheckResult.UnmatchedLineCount</li>
                    </ul>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseMatchRecheckSummary">סגור</button>
            </div>
        </div>
    </div>
}

@if (_showMucarimMatchesModal)
{
    <div class="modal-overlay" @onclick="CloseMucarimMatchesModal">
        <div class="modal-content" style="max-width: 720px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>זכאויות מקושרות</h3>
                <button class="modal-close" @onclick="CloseMucarimMatchesModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_selectedMucarimForMatches != null)
                {
                    <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                        מוסד: @(_selectedMucarimForMatches.InstitutionCode ?? "—")
                        · נושא: @(_selectedMucarimForMatches.TopicCode ?? "—")
                        · תחולה: @(_selectedMucarimForMatches.EffectiveDate?.ToString("dd/MM/yyyy") ?? "—")
                        · הפרש (שולם): @(_selectedMucarimForMatches.CalculatedDifference?.ToString("N2") ?? "—")
                    </div>
                }
                @if (_isLoadingMucarimMatches)
                {
                    <div class="loading-spinner">טוען...</div>
                }
                else if (_mucarimMatchRows.Count == 0)
                {
                    <div class="no-data-message">אין התאמות פעילות לשורה זו</div>
                }
                else
                {
                    <TableExcelExport>
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>סוג סייעת</th>
                                        <th>מוסד</th>
                                        <th>כיתה</th>
                                        <th>שעות</th>
                                        <th>תאריכים</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _mucarimMatchRows)
                                    {
                                        <tr>
                                            <td>@(row.AssistantTypeName ?? "—")</td>
                                            <td>@(row.EntitlementInstitutionName ?? "—")</td>
                                            <td>@(row.ClassName ?? "—")</td>
                                            <td>@row.Hours.ToString("0.##")</td>
                                            <td>@row.StartDate.ToString("dd/MM/yyyy") – @row.EndDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div></TableExcelExport>

                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseMucarimMatchesModal">סגור</button>
            </div>
        </div>
    </div>
}

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">נתוני מיתר</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <div class="tabs-bar" style="display: flex; gap: 8px; margin-bottom: 16px;">
                    <button type="button" class="btn @(_activeTab == DataTab.Mutavim ? "btn-primary" : "btn-secondary")"
                            @onclick='() => SetTab(DataTab.Mutavim)'>
                        מוטבים (MUTAVIM)
                    </button>
                    <button type="button" class="btn @(_activeTab == DataTab.Mucarim ? "btn-primary" : "btn-secondary")"
                            @onclick='() => SetTab(DataTab.Mucarim)'>
                        מוכרים (MUCARIM)
                    </button>
                    <button type="button" class="btn @(_activeTab == DataTab.Sharatim ? "btn-primary" : "btn-secondary")"
                            @onclick='() => SetTab(DataTab.Sharatim)'>
                        שרתים (SHARATIM)
                    </button>
                    <button type="button" class="btn @(_activeTab == DataTab.Cheshbonit ? "btn-primary" : "btn-secondary")"
                            @onclick='() => SetTab(DataTab.Cheshbonit)'>
                        חשבונית (CHESHBONIT)
                    </button>
                </div>

                <div class="filter-bar" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
                    @if (!_returnYearId.HasValue && !_returnGregorianYear.HasValue && _years.Count > 0)
                    {
                        <div style="display: flex; flex-direction: column; gap: 4px; align-self: flex-start;">
                            <label style="font-size: 0.82em; font-weight: 600;">שנת לימודים</label>
                            <select class="form-control" style="min-width: 180px;"
                                    @bind="_selectedYearId" @bind:event="onchange" @bind:after="OnSchoolYearChanged">
                                @foreach (var year in _years)
                                {
                                    <option value="@year.Id">@year.YearName</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="salary-month-buttons">
                        @foreach (var period in _schoolMonths)
                        {
                            var year = period.Year;
                            var month = period.Month;
                            <button type="button"
                                    class="salary-month-btn @(_filterYear == year && _filterMonth == month ? "active" : null)"
                                    @onclick="() => SelectMonth(year, month)">
                                <span class="month-name">@GetMonthName(month)</span>
                            </button>
                        }
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end;">
                    @if (!_returnYearId.HasValue && !_returnGregorianYear.HasValue)
                    {
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <label style="font-size: 0.82em; font-weight: 600;">סינון לפי</label>
                            <select class="form-control" style="min-width: 140px;"
                                    @bind="_dateField" @bind:event="onchange" @bind:after="OnPeriodChanged">
                                <option value="calc">תאריך חישוב</option>
                                <option value="effective">תאריך תחולה</option>
                            </select>
                        </div>
                    }
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">נושא</label>
                        <input type="text" class="form-control" style="min-width: 160px;"
                               @bind="_filterTopic" @bind:event="oninput"
                               placeholder="קוד או תיאור נושא..." />
                    </div>
                    @if (_activeTab is DataTab.Mutavim or DataTab.Mucarim)
                    {
                        <label style="display: flex; align-items: center; gap: 6px; align-self: flex-end; margin: 0; font-size: 0.9em; white-space: nowrap;">
                            <input type="checkbox" @bind="_filterNonZeroDifference" />
                            רק הפרש ≠ 0
                        </label>
                    }
                    @if (HasActiveClientFilters)
                    {
                        <button class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearClientFilters">נקה סינון</button>
                    }
                    </div>
                </div>

                @if (_activeTab == DataTab.Mutavim)
                {
                    @if (_items.Count > 0)
                    {
                        <div class="summary-grid" style="margin-bottom: 16px;">
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_items.Count</div>
                                    <div class="summary-label">סה"כ רשומות</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_items.Sum(i => i.CalculatedAmount).ToString("N0")</div>
                                    <div class="summary-label">סה"כ סכום מחושב (₪)</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_items.Select(i => i.TopicCode).Distinct().Count()</div>
                                    <div class="summary-label">נושאים ייחודיים</div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_items.Count > 0)
                    {
                        <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                            מציג @FilteredItems.Count מתוך @_items.Count רשומות
                            · סה״כ סכום מחושב: @FilteredItems.Sum(i => i.CalculatedAmount).ToString("N2")
                        </div>
                    }

                    @if (FilteredItems.Count == 0)
                    {
                        <div class="no-data-message">לא נמצאו נתוני מיתר לתקופה זו</div>
                    }
                    else
                    {
                        <TableExcelExport>
                            <div class="table-container">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th @onclick='() => SortTable("CalcDate")' style="cursor:pointer">
                                                תאריך חישוב @GetSortArrow("CalcDate", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("EffectiveDate")' style="cursor:pointer">
                                                תאריך תחולה @GetSortArrow("EffectiveDate", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("TopicCode")' style="cursor:pointer">
                                                קוד נושא @GetSortArrow("TopicCode", _sortColumn, _sortAscending)
                                            </th>
                                            <th>תיאור נושא</th>
                                            <th @onclick='() => SortTable("UnitCount")' style="cursor:pointer">
                                                מספר יחידות @GetSortArrow("UnitCount", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("Cost")' style="cursor:pointer">
                                                עלות @GetSortArrow("Cost", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("ParticipationPercent")' style="cursor:pointer">
                                                אחוז השתתפות @GetSortArrow("ParticipationPercent", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("CalculatedAmount")' style="cursor:pointer">
                                                סכום מחושב @GetSortArrow("CalculatedAmount", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("PreviousCalculatedAmount")' style="cursor:pointer">
                                                סכום קודם @GetSortArrow("PreviousCalculatedAmount", _sortColumn, _sortAscending)
                                            </th>
                                            <th @onclick='() => SortTable("CalculatedDifference")' style="cursor:pointer">
                                                הפרש @GetSortArrow("CalculatedDifference", _sortColumn, _sortAscending)
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredItems)
                                        {
                                            <tr>
                                                <td>@item.CalcDate.ToString("dd/MM/yyyy")</td>
                                                <td>@(item.EffectiveDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td>@(item.TopicCode ?? "—")</td>
                                                <td>@(item.TopicDescription ?? "—")</td>
                                                <td>@(item.UnitCount?.ToString("0.##") ?? "—")</td>
                                                <td>@(item.Cost?.ToString("N2") ?? "—")</td>
                                                <td>@(item.ParticipationPercent is not null ? $"{item.ParticipationPercent:0.##}%" : "—")</td>
                                                <td>@item.CalculatedAmount.ToString("N2")</td>
                                                <td>@(item.PreviousCalculatedAmount?.ToString("N2") ?? "—")</td>
                                                <td>@(item.CalculatedDifference?.ToString("N2") ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div></TableExcelExport>

                    }
                }
                else if (_activeTab == DataTab.Mucarim)
                {
                    @if (_mucarimItems.Count > 0)
                    {
                        <div class="summary-grid" style="margin-bottom: 16px;">
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_mucarimItems.Count</div>
                                    <div class="summary-label">סה"כ רשומות</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_mucarimItems.Sum(i => i.CalculatedAmount).ToString("N0")</div>
                                    <div class="summary-label">סה"כ סכום מחושב (₪)</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_mucarimItems.Sum(i => i.CalculatedDifference ?? 0).ToString("N0")</div>
                                    <div class="summary-label">סה"כ הפרש / שולם (₪)</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_mucarimItems.Select(i => i.InstitutionCode).Distinct().Count()</div>
                                    <div class="summary-label">מוסדות ייחודיים</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_mucarimItems.Count(i => i.ActiveMatchCount > 0)</div>
                                    <div class="summary-label">שורות עם התאמת זכאות</div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_mucarimItems.Count > 0)
                    {
                        <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                            מציג @FilteredMucarimItems.Count מתוך @_mucarimItems.Count רשומות
                            · סה״כ סכום מחושב: @FilteredMucarimItems.Sum(i => i.CalculatedAmount).ToString("N2")
                            · סה״כ הפרש: @FilteredMucarimItems.Sum(i => i.CalculatedDifference ?? 0).ToString("N2")
                        </div>
                    }

                    @if (FilteredMucarimItems.Count == 0)
                    {
                        <div class="no-data-message">לא נמצאו נתוני מוכרים לתקופה זו</div>
                    }
                    else
                    {
                        <TableExcelExport>
                            <div class="table-container">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>זכאויות</th>
                                            <th @onclick='() => SortMucarimTable("CalcDate")' style="cursor:pointer">
                                                תאריך חישוב @GetSortArrow("CalcDate", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("EffectiveDate")' style="cursor:pointer">
                                                תאריך תחולה @GetSortArrow("EffectiveDate", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("InstitutionCode")' style="cursor:pointer">
                                                סמל מוסד @GetSortArrow("InstitutionCode", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th>שם מוסד</th>
                                            <th @onclick='() => SortMucarimTable("TopicCode")' style="cursor:pointer">
                                                קוד נושא @GetSortArrow("TopicCode", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th>נושא</th>
                                            <th>סטטוס</th>
                                            <th @onclick='() => SortMucarimTable("UnitCount")' style="cursor:pointer">
                                                מספר יחידות @GetSortArrow("UnitCount", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("Percent")' style="cursor:pointer">
                                                אחוז @GetSortArrow("Percent", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("Cost")' style="cursor:pointer">
                                                עלות @GetSortArrow("Cost", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("CalculatedAmount")' style="cursor:pointer">
                                                סכום מחושב @GetSortArrow("CalculatedAmount", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("PreviousCalculatedAmount")' style="cursor:pointer">
                                                סכום קודם @GetSortArrow("PreviousCalculatedAmount", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th @onclick='() => SortMucarimTable("CalculatedDifference")' style="cursor:pointer">
                                                הפרש @GetSortArrow("CalculatedDifference", _mucarimSortColumn, _mucarimSortAscending)
                                            </th>
                                            <th>תאור יחידה</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in FilteredMucarimItems)
                                        {
                                            <tr>
                                                <td>
                                                    @if (item.ActiveMatchCount > 0)
                                                    {
                                                        <button type="button" class="btn btn-secondary" style="padding: 2px 8px;"
                                                                @onclick="() => ShowMucarimMatches(item)">
                                                            @item.ActiveMatchCount
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span style="color: var(--text-muted);">0</span>
                                                    }
                                                </td>
                                                <td>@item.CalcDate.ToString("dd/MM/yyyy")</td>
                                                <td>@(item.EffectiveDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td>@(item.InstitutionCode ?? "—")</td>
                                                <td>@(item.InstitutionName ?? "—")</td>
                                                <td>@(item.TopicCode ?? "—")</td>
                                                <td>@(item.TopicDescription ?? "—")</td>
                                                <td>@(item.Status ?? "—")</td>
                                                <td>@(item.UnitCount?.ToString("0.##") ?? "—")</td>
                                                <td>@(item.Percent is not null ? $"{item.Percent:0.##}%" : "—")</td>
                                                <td>@(item.Cost?.ToString("N2") ?? "—")</td>
                                                <td>@item.CalculatedAmount.ToString("N2")</td>
                                                <td>@(item.PreviousCalculatedAmount?.ToString("N2") ?? "—")</td>
                                                <td>@(item.CalculatedDifference?.ToString("N2") ?? "—")</td>
                                                <td>@(item.UnitDescription ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div></TableExcelExport>

                    }
                }
                else if (_activeTab == DataTab.Sharatim)
                {
                    @if (_sharatimItems.Count > 0)
                    {
                        <div class="summary-grid" style="margin-bottom: 16px;">
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_sharatimItems.Count</div>
                                    <div class="summary-label">סה"כ רשומות</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_sharatimItems.Select(i => i.InstitutionCode).Distinct().Count()</div>
                                    <div class="summary-label">מוסדות ייחודיים</div>
                                </div>
                            </div>
                            <div class="summary-card">
                                <div class="summary-info">
                                    <div class="summary-value">@_sharatimItems.Sum(i => i.ClassCount)</div>
                                    <div class="summary-label">סה"כ כיתות</div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (_sharatimItems.Count > 0)
                    {
                        <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                            מציג @FilteredSharatimItems.Count מתוך @_sharatimItems.Count רשומות
                            · סה״כ כיתות: @FilteredSharatimItems.Sum(i => i.ClassCount)
                        </div>
                    }

                    @if (FilteredSharatimItems.Count == 0)
                    {
                        <div class="no-data-message">לא נמצאו נתוני שרתים לתקופה זו</div>
                    }
                    else
                    {
                        <TableExcelExport>
                            <div class="table-container">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th @onclick='() => SortSharatimTable("CalcDate")' style="cursor:pointer">
                                                תאריך חישוב @GetSortArrow("CalcDate", _sharatimSortColumn, _sharatimSortAscending)
                                            </th>
                                            <th @onclick='() => SortSharatimTable("EffectiveDate")' style="cursor:pointer">
                                                תאריך תחולה @GetSortArrow("EffectiveDate", _sharatimSortColumn, _sharatimSortAscending)
                                            </th>
                                            <th @onclick='() => SortSharatimTable("InstitutionCode")' style="cursor:pointer">
                                                סמל מוסד @GetSortArrow("InstitutionCode", _sharatimSortColumn, _sharatimSortAscending)
                                            </th>
