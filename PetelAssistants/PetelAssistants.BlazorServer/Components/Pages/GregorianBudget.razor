@page "/gregorian/{Year:int}/budget"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="gregorian_budget" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן
    </SecureButton>

    <SecureButton ActionName="gregorian_budget" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה לועזית
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">תקציב שנתי — @Year</h1>
        </div>

        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען...</div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-message">@_error</div>
            }
            else if (_budget == null)
            {
                <div style="color: var(--text-muted);">אין נתוני תקציב לשנה זו.</div>
            }
            else
            {
                <div style="margin-bottom: 16px;">
                    @if (_budget.Sources.Count == 0)
                    {
                        <p style="color: var(--text-muted);">אין שנות לימודים החופפות לשנה לועזית זו.</p>
                    }
                    else
                    {
                        <p style="margin-bottom: 8px;">
                            מחושב מחלקי תקציבי שנות הלימודים (לקריאה בלבד):
                        </p>
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            @foreach (var source in _budget.Sources)
                            {
                                <button type="button" class="context-btn" style="min-width: auto;"
                                        @onclick="() => OpenSchoolBudget(source.HebrewYearId)">
                                    @source.HebrewYearName
                                    (@GetMonthLabel(source.FromMonth)–@GetMonthLabel(source.ToMonth))
                                    @if (!source.HasBudget)
                                    {
                                        <span> · אין תקציב</span>
                                    }
                                    else if (!source.IsLocked)
                                    {
                                        <span> · טרם ננעל</span>
                                    }
                                    else
                                    {
                                        <span> · גרסה @source.Version</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                <h2 style="font-size: 1.15em; margin-bottom: 12px;">פירוט שנתי (ינואר–דצמבר)</h2>
                @if (_budget.Details.Count == 0)
                {
                    <div style="color: var(--text-muted);">אין שורות תקציב לחודשי שנה זו.</div>
                }
                else
                {
                    <div class="yearly-budget-year-scroll">
                        <table class="data-table yearly-budget-year-table">
                            <thead>
                                <tr>
                                    <th>סוג סייעת</th>
                                    <th>משרות</th>
                                    <th>שעות</th>
                                    <th>סכום</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in _budget.Details)
                                {
                                    <tr>
                                        <td>@detail.AssistantTypeName</td>
                                        <td>@detail.Fte.ToString("N2")</td>
                                        <td>@detail.Hours.ToString("N2")</td>
                                        <td>@detail.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h2 style="font-size: 1.15em; margin: 28px 0 12px;">פירוט חודשי</h2>
                @if (MonthColumns.Count == 0 || AssistantTypeRows.Count == 0)
                {
                    <div>אין נתונים חודשיים.</div>
                }
                else
                {
                    <div class="table-container monthly-budget-scroll">
                        <table class="data-table monthly-budget-matrix">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="monthly-budget-sticky">סוג סייעת</th>
                                    @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                    {
                                        var month = MonthColumns[mi];
                                        <th colspan="3" class="@(mi > 0 ? "month-separator" : null)" style="text-align: center; white-space: nowrap;">
                                            @GetMonthLabel(month.PeriodMonth)
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                    {
                                        <th class="metric-header @(mi > 0 ? "month-separator" : null)">משרות</th>
                                        <th class="metric-header">שעות</th>
                                        <th class="metric-header">סכום</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var type in AssistantTypeRows)
                                {
                                    <tr>
                                        <td class="monthly-budget-sticky type-name">@type.AssistantTypeName</td>
                                        @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                        {
                                            var month = MonthColumns[mi];
                                            var cell = GetMonthCell(type.AssistantTypeId, month.PeriodYear, month.PeriodMonth);
                                            var sep = mi > 0 ? "month-separator" : null;
                                            @if (cell != null)
                                            {
                                                <td class="@sep" style="text-align: center; white-space: nowrap;">@cell.Fte.ToString("N2")</td>
                                                <td style="text-align: center; white-space: nowrap;">@cell.Hours.ToString("N2")</td>
                                                <td style="text-align: center; white-space: nowrap;">@cell.Amount.ToString("N2")</td>
                                            }
                                            else
                                            {
                                                <td class="@sep" style="text-align: center; color: var(--text-muted);">—</td>
                                                <td style="text-align: center; color: var(--text-muted);">—</td>
                                                <td style="text-align: center; color: var(--text-muted);">—</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .monthly-budget-scroll {
        overflow-x: auto;
        overflow-y: visible;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    .monthly-budget-matrix {
        width: max-content;
        min-width: 100%;
        font-size: 1em !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .monthly-budget-matrix th,
    .monthly-budget-matrix td {
        padding: 12px 14px !important;
        font-size: 1em !important;
        line-height: 1.35 !important;
    }

    .monthly-budget-matrix .metric-header {
        text-align: center;
        font-weight: 500;
        font-size: 0.95em !important;
        white-space: nowrap;
        min-width: 88px;
    }

    .monthly-budget-matrix .month-separator {
        border-inline-start: 2px solid var(--border-color, #c8c8c8) !important;
    }

    .monthly-budget-matrix thead .month-separator {
        border-inline-start: 2px solid rgba(255, 255, 255, 0.45) !important;
    }

    .monthly-budget-matrix .monthly-budget-sticky {
        position: sticky;
        inset-inline-start: 0;
        z-index: 2;
        min-width: 160px;
        vertical-align: middle;
        background: var(--table-header-background, #fff);
    }

    .monthly-budget-matrix tbody .monthly-budget-sticky {
        background: #fff;
        z-index: 1;
        box-shadow: -2px 0 4px rgba(0, 0, 0, 0.04);
    }

    .monthly-budget-matrix tbody tr:hover .monthly-budget-sticky {
        background: var(--hover-background, #f5f5f5);
    }

    .monthly-budget-matrix .type-name {
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public int Year { get; set; }

    protected override string PageName => "gregorian";

    private bool _isLoading = true;
    private string _error = "";
    private GregorianBudgetDto? _budget;

    private List<(int PeriodYear, int PeriodMonth)> MonthColumns =>
        Enumerable.Range(1, 12).Select(m => (Year, m)).ToList();

    private List<(int AssistantTypeId, string AssistantTypeName)> AssistantTypeRows =>
        (_budget?.MonthDetails ?? new List<YearlyBudgetMonthDetailDto>())
            .GroupBy(m => new { m.AssistantTypeId, m.AssistantTypeName })
            .OrderBy(g => g.Key.AssistantTypeName)
            .Select(g => (g.Key.AssistantTypeId, g.Key.AssistantTypeName))
            .ToList();

    private YearlyBudgetMonthDetailDto? GetMonthCell(int assistantTypeId, int periodYear, int periodMonth) =>
        _budget?.MonthDetails.FirstOrDefault(m =>
            m.AssistantTypeId == assistantTypeId &&
            m.PeriodYear == periodYear &&
            m.PeriodMonth == periodMonth);

    protected override async Task OnPageInitializedAsync() => await LoadAsync();

    private async Task RefreshData() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = "";
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<GregorianBudgetDto>>(
                $"gregorian-years/{Year}/budget");
            _budget = response?.Data;
        }
        catch (Exception ex)
        {
            _error = "שגיאה בטעינת התקציב";
            Console.WriteLine($"Error loading gregorian budget: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo($"/gregorian/{Year}");
    private void OpenSchoolBudget(int hebrewYearId) => Navigation.NavigateTo($"/year/{hebrewYearId}/yearly-budget");

    private static string GetMonthLabel(int month) => month switch
    {
        1 => "ינואר",
        2 => "פברואר",
        3 => "מרץ",
        4 => "אפריל",
        5 => "מאי",
        6 => "יוני",
        7 => "יולי",
        8 => "אוגוסט",
        9 => "ספטמבר",
        10 => "אוקטובר",
        11 => "נובמבר",
        12 => "דצמבר",
        _ => month.ToString()
    };
}
