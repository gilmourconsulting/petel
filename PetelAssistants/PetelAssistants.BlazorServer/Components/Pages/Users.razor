    // ── Manage roles ───────────────────────────────────────────────────────────

    private async Task ManageUserRoles(UserDto user)
    {
        try
        {
            _manageRolesUserId = user.Id;
            _manageRolesUserName = user.FullName;
            await LoadUserRoles();
            _showManageRolesDialog = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user roles: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בטעינת תפקידי המשתמש");
        }
    }

    private void CloseManageRolesDialog()
    {
        _showManageRolesDialog = false;
        _manageRolesUserId = 0;
        _manageRolesUserName = string.Empty;
        _userCurrentRoles.Clear();
        _availableRoles.Clear();
        _filteredAvailableRoles.Clear();
        _selectedRolesToAdd.Clear();
        _availableRolesSearchTerm = string.Empty;
    }

    private async Task LoadUserRoles()
    {
        var currentResponse = await ApiService.GetAsync<ApiResponse<List<RoleSummaryDto>>>($"users/{_manageRolesUserId}/roles");
        _userCurrentRoles = currentResponse?.Data ?? new();

        var allResponse = await ApiService.GetAsync<ApiResponse<List<RoleSummaryDto>>>("roles");
        if (allResponse?.Data != null)
        {
            _availableRoles = allResponse.Data
                .Where(r => !_userCurrentRoles.Any(ur => ur.Id == r.Id))
                .ToList();
        }
        else
        {
            _availableRoles = new();
        }

        _filteredAvailableRoles = _availableRoles;
        _selectedRolesToAdd.Clear();
    }

    private void SelectRole(RoleSummaryDto role)
    {
        if (!_selectedRolesToAdd.Any(r => r.Id == role.Id))
        {
            _selectedRolesToAdd.Add(role);
            FilterAvailableRoles();
        }
    }

    private void DeselectRole(RoleSummaryDto role)
    {
        _selectedRolesToAdd.RemoveAll(r => r.Id == role.Id);
        FilterAvailableRoles();
    }

    private void FilterAvailableRoles()
    {
        var term = _availableRolesSearchTerm?.ToLower() ?? string.Empty;
        _filteredAvailableRoles = _availableRoles
            .Where(r => !_selectedRolesToAdd.Any(s => s.Id == r.Id))
            .Where(r => string.IsNullOrEmpty(term) || r.Name.ToLower().Contains(term))
            .ToList();
    }

    private async Task RemoveRoleFromUser(int roleId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "האם אתה בטוח שברצונך להסיר תפקיד זה מהמשתמש?"))
            return;
        try
        {
            var response = await ApiService.DeleteAsync<ApiResponse<object>>($"roles/{roleId}/users/{_manageRolesUserId}");
            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "התפקיד הוסר בהצלחה");
                await LoadUserRoles();
                await LoadUsersData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהסרת התפקיד");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בהסרת התפקיד: {ex.Message}");
        }
    }

    private async Task SubmitRoleChanges()
    {
        if (_selectedRolesToAdd.Count == 0) { await JSRuntime.InvokeVoidAsync("alert", "אנא בחר לפחות תפקיד אחד"); return; }
        int ok = 0, fail = 0;
        foreach (var role in _selectedRolesToAdd)
        {
            try
            {
                var r = await ApiService.PostAsync<object, ApiResponse<object>>($"roles/{role.Id}/users", new { userId = _manageRolesUserId });
                if (r?.Success == true) ok++; else fail++;
            }
            catch { fail++; }
        }
        await JSRuntime.InvokeVoidAsync("alert", $"✅ {ok} תפקידים נוספו{(fail > 0 ? $"\n❌ {fail} נכשלו" : "")}");
        if (ok > 0) { CloseManageRolesDialog(); await LoadUsersData(); }
    }

