@page "/meitar-data/month-summary"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="meitar_month_summary_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="meitar_month_summary_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לנתוני מיתר
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">סיכום מיתר מול תקציב</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <div class="filter-bar" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">שנה</label>
                        <input type="number" class="form-control" style="width: 100px;"
                               @bind="_filterYear" @bind:event="onchange" @bind:after="OnPeriodChanged"
                               min="2000" max="2100" />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">חודש</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterMonth" @bind:event="onchange" @bind:after="OnPeriodChanged">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@GetMonthLabel(m)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!_summary.HasBudget)
                {
                    <p style="margin-bottom: 12px;">אין תקציב נעול לשנה העברית של התקופה — מוצגת הכנסת מיתר בלבד.</p>
                }

                @if (_summary.Lines.Count == 0)
                {
                    <p>אין סיכום מיתר לתקופה זו. יש לשלוף נתוני מיתר מחדש.</p>
                }
                else
                {
                    <div class="summary-grid" style="margin-bottom: 16px;">
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_summary.Lines.Sum(l => l.RowCount)</div>
                                <div class="summary-label">רשומות מיתר</div>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_summary.Lines.Sum(l => l.Amount).ToString("N0")</div>
                                <div class="summary-label">סה"כ מיתר (₪)</div>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_summary.Lines.Sum(l => l.BudgetAmount ?? 0).ToString("N0")</div>
                                <div class="summary-label">תקציב נעול (₪)</div>
                            </div>
                        </div>
                    </div>

                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>סוג סייעת</th>
                                    <th>רשומות</th>
                                    <th>יחידות / שעות</th>
                                    <th>סכום מיתר</th>
                                    <th>שעות תקציב</th>
                                    <th>סכום תקציב</th>
                                    <th>הפרש סכום</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in _summary.Lines)
                                {
                                    <tr>
                                        <td>@line.AssistantTypeName</td>
                                        <td>@line.RowCount</td>
                                        <td>@line.Hours.ToString("N2")</td>
                                        <td>@line.Amount.ToString("N2")</td>
                                        <td>@(line.HasBudget ? line.BudgetHours?.ToString("N2") : "—")</td>
                                        <td>@(line.HasBudget ? line.BudgetAmount?.ToString("N2") : "—")</td>
                                        <td>@(line.HasBudget ? line.AmountVariance.ToString("N2") : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    protected override string PageName => "meitar_month_summary";

    [SupplyParameterFromQuery(Name = "fromYear")]
    public int? FromYear { get; set; }

    [SupplyParameterFromQuery(Name = "fromGregorianYear")]
    public int? FromGregorianYear { get; set; }

    [SupplyParameterFromQuery(Name = "year")]
    public int? Year { get; set; }

    [SupplyParameterFromQuery(Name = "month")]
    public int? Month { get; set; }

    private bool _isLoading = true;
    private int _filterYear;
    private int _filterMonth;
    private MonthSummaryResponse _summary = new();

    private static readonly string[] MonthNames =
    {
        "", "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני",
        "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר"
    };

    protected override async Task OnPageInitializedAsync()
    {
        if (Year.HasValue && Month.HasValue)
        {
            _filterYear = Year.Value;
            _filterMonth = Month.Value;
        }
        else if (FromGregorianYear.HasValue)
        {
            var previous = DateTime.Today.AddMonths(-1);
            _filterYear = FromGregorianYear.Value;
            _filterMonth = previous.Year == FromGregorianYear.Value ? previous.Month : 1;
        }
        else
        {
            var previous = DateTime.Today.AddMonths(-1);
            _filterYear = previous.Year;
            _filterMonth = previous.Month;
        }
        await LoadDataAsync();
    }

    private async Task OnPeriodChanged() => await LoadDataAsync();
    private async Task RefreshData() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<MonthSummaryResponse>>(
                $"meitar-month-summaries?year={_filterYear}&month={_filterMonth}");
            _summary = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Meitar month summary: {ex.Message}");
            _summary = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateBack()
    {
        if (FromGregorianYear.HasValue)
            Navigation.NavigateTo($"/meitar-data?fromGregorianYear={FromGregorianYear.Value}");
        else
        {
            var qs = FromYear.HasValue ? $"?fromYear={FromYear.Value}" : "";
            Navigation.NavigateTo($"/meitar-data{qs}");
        }
    }

    private static string GetMonthLabel(int month) =>
        month is >= 1 and <= 12 ? $"{month} - {MonthNames[month]}" : month.ToString();
}
