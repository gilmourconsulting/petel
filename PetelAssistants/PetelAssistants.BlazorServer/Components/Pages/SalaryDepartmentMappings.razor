@page "/salary-department-mappings"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="salary_dept_map_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="salary_dept_map_save" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                  OnClick="ShowCreateDialog" CssClass="context-btn" HideIfNoAccess="true">
        הוספת מיפוי
    </SecureButton>
    <SecureButton ActionName="salary_dept_map_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        @(_returnYearId.HasValue ? "חזרה לניהול שנה" : "חזרה לדף הבית")
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">מיפוי מחלקות שכר</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                @if (_unmapped.Count > 0)
                {
                    <p style="margin-bottom: 12px; font-weight: 600;">מחלקות מהקובץ שעדיין לא ממופות</p>
                    <div class="table-container" style="margin-bottom: 24px;">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>פעולות</th>
                                    <th>מזהה מחלקה</th>
                                    <th>שם מחלקה</th>
                                    <th>רשומות</th>
                                    <th>סה"כ שכר</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _unmapped)
                                {
                                    <tr>
                                        <td>
                                            <SecureButton ActionName="salary_dept_map_save" ScreenName="@PageName" FunctionName="MapUnmapped"
                                                          OnClick="() => ShowCreateDialog(item)" CssClass="btn-icon" Title="מפה" HideIfNoAccess="true">
                                                מפה
                                            </SecureButton>
                                        </td>
                                        <td>@item.DepartmentId</td>
                                        <td>@(item.DepartmentName ?? "—")</td>
                                        <td>@item.RowCount</td>
                                        <td>@item.TotalSalary.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th>מזהה מחלקה</th>
                                <th>שם מחלקה</th>
                                <th>סוג סייעת</th>
                                <th>סטטוס</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr class="@(item.IsActive ? "" : "row-inactive")">
                                    <td>
                                        <SecureButton ActionName="salary_dept_map_save" ScreenName="@PageName" FunctionName="Edit"
                                                      OnClick="() => ShowEditDialog(item)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                            <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                        </SecureButton>
                                    </td>
                                    <td>@item.DepartmentId</td>
                                    <td>@(item.DepartmentName ?? "—")</td>
                                    <td>@item.AssistantTypeName</td>
                                    <td>@(item.IsActive ? "פעיל" : "לא פעיל")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editItem == null ? "הוספת מיפוי מחלקה" : "עריכת מיפוי מחלקה")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>מזהה מחלקה <span class="required">*</span></label>
                    <input class="form-control" @bind="_formDepartmentId" />
                </div>
                <div class="form-group">
                    <label>שם מחלקה</label>
                    <input class="form-control" @bind="_formDepartmentName" />
                </div>
                <div class="form-group">
                    <label>סוג סייעת <span class="required">*</span></label>
                    <select class="form-control" @bind="_formAssistantTypeId">
                        <option value="0">—</option>
                        @foreach (var type in _assistantTypes)
                        {
                            <option value="@type.Id">@type.DisplayName</option>
                        }
                    </select>
                </div>
                @if (_editItem != null)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_formIsActive" /> פעיל
                        </label>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@_isSaving">@(_isSaving ? "שומר..." : "שמור")</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "salary_dept_map";

    [SupplyParameterFromQuery(Name = "fromYear")]
    public int? FromYear { get; set; }

    private int? _returnYearId;
    private bool _isLoading = true;
    private List<SalaryDepartmentMappingDto> _items = new();
    private List<UnmappedSalaryDepartmentDto> _unmapped = new();
    private List<AssistantTypeDto> _assistantTypes = new();

    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private SalaryDepartmentMappingDto? _editItem;
    private string _formDepartmentId = string.Empty;
    private string? _formDepartmentName;
    private int _formAssistantTypeId;
    private bool _formIsActive = true;

    protected override async Task OnPageInitializedAsync()
    {
        _returnYearId = FromYear;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var mappingsTask = ApiService.GetAsync<ApiResponse<List<SalaryDepartmentMappingDto>>>("salary-department-mappings");
            var unmappedTask = ApiService.GetAsync<ApiResponse<List<UnmappedSalaryDepartmentDto>>>("salary-department-mappings/unmapped");
            var typesTask = ApiService.GetAsync<ApiResponse<List<AssistantTypeDto>>>("assistant-types");
            await Task.WhenAll(mappingsTask, unmappedTask, typesTask);
            _items = mappingsTask.Result?.Data ?? new();
            _unmapped = unmappedTask.Result?.Data ?? new();
            _assistantTypes = typesTask.Result?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading department mappings: {ex.Message}");
            _items = new();
            _unmapped = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    private void ShowCreateDialog() => ShowCreateDialog(null);

    private void ShowCreateDialog(UnmappedSalaryDepartmentDto? unmapped)
    {
        _editItem = null;
        _formDepartmentId = unmapped?.DepartmentId ?? string.Empty;
        _formDepartmentName = unmapped?.DepartmentName;
        _formAssistantTypeId = 0;
        _formIsActive = true;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void ShowEditDialog(SalaryDepartmentMappingDto item)
    {
        _editItem = item;
        _formDepartmentId = item.DepartmentId;
        _formDepartmentName = item.DepartmentName;
        _formAssistantTypeId = item.AssistantTypeId;
        _formIsActive = item.IsActive;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog() => _showFormDialog = false;

    private async Task Save()
    {
        _isSaving = true;
        _formError = string.Empty;
        try
        {
            if (string.IsNullOrWhiteSpace(_formDepartmentId) || _formAssistantTypeId <= 0)
            {
                _formError = "מזהה מחלקה וסוג סייעת הם שדות חובה";
                return;
            }

            var body = new SaveSalaryDepartmentMappingRequest
            {
                DepartmentId = _formDepartmentId,
                DepartmentName = _formDepartmentName,
                AssistantTypeId = _formAssistantTypeId,
                IsActive = _formIsActive
            };

            ApiResponse<object>? response;
            if (_editItem == null)
                response = await ApiService.PostAsync<SaveSalaryDepartmentMappingRequest, ApiResponse<object>>("salary-department-mappings", body);
            else
                response = await ApiService.PutAsync<SaveSalaryDepartmentMappingRequest, ApiResponse<object>>($"salary-department-mappings/{_editItem.Id}", body);

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack()
    {
        if (_returnYearId.HasValue)
            Navigation.NavigateTo($"/year/{_returnYearId.Value}");
        else
            Navigation.NavigateTo("/maindashboard");
    }
}
