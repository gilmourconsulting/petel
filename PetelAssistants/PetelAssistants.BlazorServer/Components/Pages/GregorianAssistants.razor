@page "/gregorian/{Year:int}/assistants"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="gregorian_assistants" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="gregorian_assistants" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה לועזית
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">סייעות — @Year</h1>
            <p class="text-muted" style="margin-top: 8px;">סייעות עם הקצאה פעילה שחופפת לינואר–דצמבר @Year. עריכה מתבצעת במסך שנת הלימודים.</p>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <div class="summary-grid" style="margin-bottom: 16px;">
                    <div class="summary-card">
                        <div class="summary-info">
                            <div class="summary-value">@_items.Count</div>
                            <div class="summary-label">סייעות עם הקצאה</div>
                        </div>
                    </div>
                </div>

                <div class="filter-bar" style="margin-bottom: 16px;">
                    <input type="text" class="form-control" @bind="_filterText" @bind:event="oninput"
                           placeholder="סנן לפי שם, ת״ז או שנת לימודים..." />
                </div>

                @if (FilteredItems.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו סייעות עם הקצאה בשנה זו</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>מזהה</th>
                                    <th>מספר זהות</th>
                                    <th>שם מלא</th>
                                    <th>טלפונים</th>
                                    <th>שנת לימודים</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr>
                                        <td>
                                            <EntityFocusLink Screen="@EntityFocus.AssistantsScreen"
                                                             YearId="@item.HebrewYearId" Id="@item.Id">
                                                @item.Id
                                            </EntityFocusLink>
                                        </td>
                                        <td>@item.IdNumber</td>
                                        <td>@item.FullName</td>
                                        <td>@(item.PhoneSummary ?? "—")</td>
                                        <td>@(string.IsNullOrEmpty(item.HebrewYearName) ? "—" : item.HebrewYearName)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Year { get; set; }

    protected override string PageName => "gregorian";

    private bool _isLoading = true;
    private string _filterText = "";
    private List<GregorianAssistantDto> _items = new();

    private List<GregorianAssistantDto> FilteredItems
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_filterText))
                return _items;
            var term = _filterText.Trim();
            return _items.Where(i =>
                i.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                i.IdNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrEmpty(i.HebrewYearName) && i.HebrewYearName.Contains(term, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
    }

    protected override async Task OnPageInitializedAsync() => await LoadAsync();

    private async Task RefreshData() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<GregorianAssistantDto>>>(
                $"gregorian-years/{Year}/assistants");
            _items = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading gregorian assistants: {ex.Message}");
            _items = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo($"/gregorian/{Year}");
}
