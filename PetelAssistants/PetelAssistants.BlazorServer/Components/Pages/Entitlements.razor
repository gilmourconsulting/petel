@page "/year/{YearId:int}/entitlements"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="entitlements_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="entitlements_add" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                  OnClick="ShowCreateDialog" CssClass="context-btn">
        הוסף זכאות
    </SecureButton>
    <SecureButton ActionName="entitlements_add_allocation" ScreenName="@PageName" FunctionName="ShowAddAllocationDialog"
                  OnClick="ShowAddAllocationDialog" CssClass="context-btn">
        הוסף הקצאה
    </SecureButton>
    <SecureButton ActionName="entitlements_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="school-title-section">
            <h1 class="page-title">זכאויות @(_yearName != "" ? $"- {_yearName}" : "")</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <!-- Filter bar -->
                <div class="filter-bar" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סוג</label>
                        <select class="form-control" style="min-width: 130px;" @bind="_filterKind" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="personal">אישי</option>
                            <option value="institutional">מוסדי</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">מוסד</label>
                        <select class="form-control" style="min-width: 160px;" @bind="_filterSchoolId" @bind:event="onchange">
                            <option value="0">הכל</option>
                            @foreach (var unit in _orgUnits.Where(u => u.IsActive))
                            {
                                <option value="@unit.Id">@unit.Name</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סוג סייעת</label>
                        <select class="form-control" style="min-width: 160px;" @bind="_filterAssistantTypeId" @bind:event="onchange">
                            <option value="0">הכל</option>
                            @foreach (var t in _assistantTypes)
                            {
                                <option value="@t.Id">@t.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סטטוס</label>
                        <select class="form-control" style="min-width: 120px;" @bind="_filterActiveOnly" @bind:event="onchange">
                            <option value="true">פעיל בלבד</option>
                            <option value="false">הכל</option>
                        </select>
                    </div>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearFilters">נקה סינון</button>
                    }
                </div>

                @if (FilteredItems.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו זכאויות</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>פעולות</th>
                                    <th>סוג</th>
                                    <th>מוסד</th>
                                    <th>שם תלמיד</th>
                                    <th>ת"ז</th>
                                    <th>כיתה</th>
                                    <th>סוג סייעת</th>
                                    <th>שעות</th>
                                    <th>השתתפות משרד (%)</th>
                                    <th>תאריכים</th>
                                    <th>הקצאה</th>
                                    <th>סטטוס</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    bool isPersonal = IsPersonalLevel(item.AssistantTypeLevel);
                                    bool isSelected = _selectedEntitlement?.Id == item.Id;
                                    <tr class="@(item.IsActive ? "" : "row-inactive") @(isSelected ? "row-selected" : "")"
                                        style="cursor: pointer;"
                                        @onclick="() => SelectEntitlement(item)">
                                        <td @onclick:stopPropagation="true">
                                            <SecureButton ActionName="entitlements_edit" ScreenName="@PageName" FunctionName="EditItem"
                                                          OnClick="() => ShowEditDialog(item)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                                <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                            </SecureButton>
                                            @if (item.IsActive)
                                            {
                                                <SecureButton ActionName="entitlements_deactivate" ScreenName="@PageName" FunctionName="DeactivateItem"
                                                              OnClick="() => DeactivateItem(item)" CssClass="btn-icon btn-danger" Title="השבת" HideIfNoAccess="true">
                                                    <img src="/images/deactivate_icon.png" alt="השבת" class="action-icon-natural">
                                                </SecureButton>
                                            }
                                        </td>
                                        <td>
                                            <span class="status-badge @(isPersonal ? "status-personal" : "status-institutional")">
                                                @(isPersonal ? "אישי" : "מוסדי")
                                            </span>
                                        </td>
                                        <td>@(item.SchoolName ?? "—")</td>
                                        <td>
                                            @if (isPersonal && (!string.IsNullOrEmpty(item.PupilFirstName) || !string.IsNullOrEmpty(item.PupilLastName)))
                                            {
                                                @($"{item.PupilFirstName} {item.PupilLastName}".Trim())
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>@(isPersonal ? (item.PupilIdNumber ?? "—") : "—")</td>
                                        <td>@(item.ClassName ?? "—")</td>
                                        <td>@item.AssistantTypeName</td>
                                        <td>@item.Hours @GetHoursUnitLabel(item.HoursUnit)</td>
                                        <td>@item.MinistryParticipationPct.ToString("0.##")%</td>
                                        <td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="status-badge @GetAllocationStatusCss(item.AllocationStatus)">
                                                @GetAllocationStatusLabel(item.AllocationStatus)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-badge @(item.IsActive ? "status-active" : "status-inactive")">
                                                @(item.IsActive ? "פעיל" : "לא פעיל")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <!-- Allocations panel — shown when an entitlement row is selected -->
                @if (_selectedEntitlement != null)
                {
                    <AllocationsPanel ViewMode="AllocationsViewMode.ByEntitlement"
                                      Allocations="_allocations"
                                      IsLoading="_isLoadingAllocations"
                                      ShowAddButton="true"
                                      SecurityScreenName="entitlements"
                                      OnClose="ClearSelectedEntitlement"
                                      OnAddAllocation="ShowAddAllocationDialog"
                                      OnDeactivateAllocation="DeactivateAllocation">
                        <HeaderTitle>
                            @_selectedEntitlement.AssistantTypeName
                            @(_selectedEntitlement.SchoolName != null ? $" — {_selectedEntitlement.SchoolName}" : "")
                            (@_selectedEntitlement.Hours @GetHoursUnitLabel(_selectedEntitlement.HoursUnit))
                        </HeaderTitle>
                    </AllocationsPanel>
                }
            }
        </div>
    </div>
</div>

<!-- Entitlement form dialog -->
@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editItem == null ? "הוספת זכאות" : "עריכת זכאות")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">

                <!-- Assistant type — drives field visibility -->
                <div class="form-group">
                    <label>סוג סייעת <span class="required">*</span></label>
                    <select class="form-control" value="@_formAssistantTypeId" @onchange="OnAssistantTypeChanged">
                        <option value="0">— בחר סוג —</option>
                        @foreach (var type in _assistantTypes)
                        {
                            <option value="@type.Id">@type.DisplayName</option>
                        }
                    </select>
                </div>

                <!-- DEBUG — remove after confirming pupil fields appear -->
                <div style="font-size:0.78em; color:#888; margin-bottom:8px;">
                    debug: typeId=@_formAssistantTypeId &nbsp;|&nbsp;
                    level=<strong>@(_assistantTypes.FirstOrDefault(t => t.Id == _formAssistantTypeId)?.Level ?? "—")</strong> &nbsp;|&nbsp;
                    isPersonal=<strong>@_formIsPersonal</strong>
                </div>

                <!-- Personal-only fields — shown above school when assistant type level is personal -->
                @if (_formIsPersonal)
                {
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>שם פרטי תלמיד <span class="required">*</span></label>
                            <input class="form-control" @bind="_formPupilFirstName" placeholder="שם פרטי" />
                        </div>
                        <div class="form-group">
                            <label>שם משפחה תלמיד <span class="required">*</span></label>
                            <input class="form-control" @bind="_formPupilLastName" placeholder="שם משפחה" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>תעודת זהות תלמיד <span class="required">*</span></label>
                        <input class="form-control" @bind="_formPupilIdNumber"
                               placeholder="9 ספרות" maxlength="9"
                               inputmode="numeric" pattern="[0-9]{9}" />
                        <small class="form-text text-muted">9 ספרות בדיוק, ספרה מובילה 0 מותרת</small>
                    </div>
                }

                <!-- School + class on the same row -->
                <div class="form-row" style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>מוסד (בית ספר / גן) <span class="required">*</span></label>
                        <select class="form-control" @bind="_formInstitutionId">
                            <option value="0">— בחר מוסד —</option>
                            @foreach (var unit in _orgUnits.Where(u => u.IsActive))
                            {
                                <option value="@unit.Id">@unit.Name (@GetOrgUnitTypeLabel(unit.OrgUnitType))</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>כיתה</label>
                        <input class="form-control" @bind="_formClassName" placeholder="לדוגמה: כיתה א׳" />
                    </div>
                </div>

                <!-- Hours + unit + ministry % on the same row -->
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>שעות <span class="required">*</span></label>
                        <InputNumber class="form-control" @bind-Value="_formHours" />
                    </div>
                    <div class="form-group">
                        <label>יחידת שעות <span class="required">*</span></label>
                        <select class="form-control" @bind="_formHoursUnit">
                            <option value="weekly">שבועי</option>
                            <option value="monthly">חודשי</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>השתתפות משרד (%)<span class="required">*</span></label>
                        <select class="form-control" @bind="_formMinistryPct">
                            <option value="0">— בחר —</option>
                            @foreach (var opt in _ministryOptions)
                            {
                                <option value="@opt.Percentage">@opt.Percentage.ToString("0.##")%</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Dates -->
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>תאריך התחלה <span class="required">*</span></label>
                        <InputDate class="form-control" @bind-Value="_formStartDate" />
                    </div>
                    <div class="form-group">
                        <label>תאריך סיום <span class="required">*</span></label>
                        <InputDate class="form-control" @bind-Value="_formEndDate" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveItem" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

<!-- Add allocation modal -->
@if (_showAllocationDialog)
{
    <div class="modal-overlay" @onclick="CloseAllocationDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>הוספת הקצאה</h3>
                <button class="modal-close" @onclick="CloseAllocationDialog">✕</button>
            </div>
            <div class="modal-body">

                @if (_allocSelectedPerson == null)
                {
                    <!-- Step 1: Person search -->
                    <div class="form-group">
                        <label>חיפוש סייעת <span class="required">*</span></label>
                        <input class="form-control" value="@_allocPersonSearchTerm"
                               @oninput="OnPersonSearchInput"
                               placeholder="הקלד שם או מספר זהות לחיפוש..." />
                    </div>

                    @if (_isSearchingPersons)
                    {
                        <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 8px;">מחפש...</div>
                    }
                    else if (_personSearchResults.Count > 0)
                    {
                        <div style="border: 1px solid #dee2e6; border-radius: 4px; max-height: 200px; overflow-y: auto; margin-bottom: 12px;">
                            @foreach (var person in _personSearchResults)
                            {
                                <div style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0;"
                                     @onclick="() => SelectPerson(person)"
                                     class="person-search-result">
                                    <strong>@person.FullName</strong>
                                    <span style="color: #6c757d; font-size: 0.85em; margin-right: 8px;">@person.IdNumber</span>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_allocPersonSearchTerm) && _allocPersonSearchTerm.Length >= 2 && !_isSearchingPersons)
                    {
                        <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 8px;">לא נמצאו תוצאות</div>
                    }

                    <!-- Add new person inline -->
                    @if (!_showAddPersonForm)
                    {
                        <button class="btn btn-secondary" style="margin-top: 8px;" @onclick="() => _showAddPersonForm = true">
                            + הוסף אדם חדש
                        </button>
                    }
                    else
                    {
                        <div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 16px; margin-top: 12px; background: #f8f9fa;">
                            <h5 style="margin-top: 0; margin-bottom: 12px;">פרטי אדם חדש</h5>
                            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div class="form-group">
                                    <label>שם פרטי <span class="required">*</span></label>
                                    <input class="form-control" @bind="_newPersonFirstName" placeholder="שם פרטי" />
                                </div>
                                <div class="form-group">
                                    <label>שם משפחה <span class="required">*</span></label>
                                    <input class="form-control" @bind="_newPersonLastName" placeholder="שם משפחה" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>מספר זהות <span class="required">*</span></label>
                                <input class="form-control" @bind="_newPersonIdNumber" placeholder="9 ספרות" maxlength="9" inputmode="numeric" />
                            </div>
                            @if (!string.IsNullOrEmpty(_addPersonError))
                            {
                                <div class="error-message">@_addPersonError</div>
                            }
                            <div style="display: flex; gap: 8px; margin-top: 8px;">
                                <button class="btn btn-primary" @onclick="CreateNewPerson" disabled="@_isAddingPerson">
                                    @(_isAddingPerson ? "שומר..." : "צור ובחר")
                                </button>
                                <button class="btn btn-secondary" @onclick="() => { _showAddPersonForm = false; _addPersonError = string.Empty; }">ביטול</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Step 2: Allocation details after person is selected -->
                    <div style="background: #e8f4f8; border-radius: 4px; padding: 10px 14px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                        <span><strong>סייעת נבחרה:</strong> @_allocSelectedPerson.FullName</span>
                        <button class="btn btn-secondary btn-sm" @onclick="ClearSelectedPerson">שנה</button>
                    </div>

                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>שעות <span class="required">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_allocHours" />
                        </div>
                        <div class="form-group">
                            <label>יחידת שעות <span class="required">*</span></label>
                            <select class="form-control" @bind="_allocHoursUnit">
                                <option value="weekly">שבועי</option>
                                <option value="monthly">חודשי</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>תאריך התחלה <span class="required">*</span></label>
                            <InputDate class="form-control" @bind-Value="_allocStartDate" />
                        </div>
                        <div class="form-group">
                            <label>תאריך סיום <span class="required">*</span></label>
                            <InputDate class="form-control" @bind-Value="_allocEndDate" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_allocError))
                {
                    <div class="error-message">@_allocError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAllocationDialog">ביטול</button>
                @if (_allocSelectedPerson != null)
                {
                    <button class="btn btn-primary" @onclick="SaveAllocation" disabled="@_isSavingAllocation">
                        @(_isSavingAllocation ? "שומר..." : "שמור הקצאה")
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
    .row-selected {
        background-color: #e3f2fd !important;
    }
    .person-search-result:hover {
        background-color: #f0f7ff;
    }
</style>

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "entitlements";

    private string _yearName = "";
    private YearDto? _year;
    private List<EntitlementListItemDto> _items = new();
    private List<AssistantTypeDto> _assistantTypes = new();
    private List<OrgUnitDto> _orgUnits = new();
    private List<MinistryParticipationOptionDto> _ministryOptions = new();
    private bool _isLoading = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private EntitlementListItemDto? _editItem;

    // Filter state
    private string _filterKind = "";
    private int _filterSchoolId;
    private int _filterAssistantTypeId;
    private string _filterActiveOnly = "true";

    // Entitlement form state
    private int _formAssistantTypeId;
    private bool _formIsPersonal;
    private int _formInstitutionId;
    private string? _formClassName;
    private string _formPupilIdNumber = string.Empty;
    private string _formPupilFirstName = string.Empty;
    private string _formPupilLastName = string.Empty;
    private decimal _formHours = 1;
    private string _formHoursUnit = "weekly";
    private decimal _formMinistryPct;
    private DateTime? _formStartDate;
    private DateTime? _formEndDate;

    // Allocation panel state
    private EntitlementListItemDto? _selectedEntitlement;
    private List<EntitlementAllocationDto> _allocations = new();
    private bool _isLoadingAllocations;

    // Add allocation modal state
    private bool _showAllocationDialog;
    private bool _isSavingAllocation;
    private string _allocError = string.Empty;
    private string _allocPersonSearchTerm = string.Empty;
    private List<PersonListItemDto> _personSearchResults = new();
    private bool _isSearchingPersons;
    private PersonListItemDto? _allocSelectedPerson;
    private decimal _allocHours;
    private string _allocHoursUnit = "weekly";
    private DateTime? _allocStartDate;
    private DateTime? _allocEndDate;

    // Add new person inline
    private bool _showAddPersonForm;
    private string _newPersonFirstName = string.Empty;
    private string _newPersonLastName = string.Empty;
    private string _newPersonIdNumber = string.Empty;
    private string _addPersonError = string.Empty;
    private bool _isAddingPerson;

    // Search debounce
    private CancellationTokenSource? _searchCts;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await LoadLookupsAsync();
            await LoadDataAsync();
        }
    }

    private async Task LoadLookupsAsync()
    {
        _year = await ApiService.GetAsync<YearDto>($"years/{YearId}");
        _yearName = _year?.YearName ?? "";

        var typesResponse = await ApiService.GetAsync<ApiResponse<List<AssistantTypeDto>>>("assistant-types");
        _assistantTypes = typesResponse?.Data ?? new();

        var orgResponse = await ApiService.GetAsync<ApiResponse<List<OrgUnitDto>>>("org-units");
        _orgUnits = orgResponse?.Data ?? new();

        var ministryResponse = await ApiService.GetAsync<ApiResponse<List<MinistryParticipationOptionDto>>>("ministry-participation-options");
        _ministryOptions = ministryResponse?.Data ?? new();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<EntitlementListItemDto>>>(
                $"entitlements?yearId={YearId}");
            _items = response?.Data ?? new();

            // Refresh allocation panel if an entitlement is still selected
            if (_selectedEntitlement != null)
            {
                var updated = _items.FirstOrDefault(i => i.Id == _selectedEntitlement.Id);
                if (updated != null)
                {
                    _selectedEntitlement = updated;
                    await LoadAllocationsAsync(_selectedEntitlement.Id);
                }
                else
                {
                    _selectedEntitlement = null;
                    _allocations = new();
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתונים: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAllocationsAsync(int entitlementId)
    {
        _isLoadingAllocations = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<EntitlementAllocationDto>>>(
                $"entitlements/{entitlementId}/allocations");
            _allocations = response?.Data ?? new();
        }
        catch
        {
            _allocations = new();
        }
        finally
        {
            _isLoadingAllocations = false;
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    // ─── Entitlement row selection ─────────────────────────────────────────────

    private async Task SelectEntitlement(EntitlementListItemDto item)
    {
        if (_selectedEntitlement?.Id == item.Id)
        {
            _selectedEntitlement = null;
            _allocations = new();
            return;
        }

        _selectedEntitlement = item;
        _allocations = new();
        await LoadAllocationsAsync(item.Id);
    }

    private void ClearSelectedEntitlement()
    {
        _selectedEntitlement = null;
        _allocations = new();
    }

    // ─── Allocation modal ─────────────────────────────────────────────────────

    private async Task ShowAddAllocationDialog()
    {
        if (_selectedEntitlement == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "יש לבחור זכאות מהטבלה לפני הוספת הקצאה");
            return;
        }

        _allocPersonSearchTerm = string.Empty;
        _personSearchResults = new();
        _allocSelectedPerson = null;
        _allocError = string.Empty;
        _showAddPersonForm = false;
        _newPersonFirstName = string.Empty;
        _newPersonLastName = string.Empty;
        _newPersonIdNumber = string.Empty;
        _addPersonError = string.Empty;

        // Default values from the entitlement
        _allocHours = _selectedEntitlement.Hours;
        _allocHoursUnit = _selectedEntitlement.HoursUnit;
        _allocStartDate = _selectedEntitlement.StartDate.ToDateTime(TimeOnly.MinValue);
        _allocEndDate   = _selectedEntitlement.EndDate.ToDateTime(TimeOnly.MinValue);

        _showAllocationDialog = true;
    }

    private void CloseAllocationDialog()
    {
        _showAllocationDialog = false;
        _allocError = string.Empty;
        _searchCts?.Cancel();
    }

    private async Task OnPersonSearchInput(ChangeEventArgs e)
    {
        _allocPersonSearchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();

        if (_allocPersonSearchTerm.Length < 2)
        {
            _personSearchResults = new();
            return;
        }

        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);

            _isSearchingPersons = true;
            StateHasChanged();

            var response = await ApiService.GetAsync<ApiResponse<List<PersonListItemDto>>>(
                $"persons/search?term={Uri.EscapeDataString(_allocPersonSearchTerm)}");
            _personSearchResults = response?.Data ?? new();
        }
        catch (TaskCanceledException)
        {
            // debounce cancellation — ignore
        }
        catch
        {
            _personSearchResults = new();
        }
        finally
        {
            _isSearchingPersons = false;
            StateHasChanged();
        }
    }

    private void SelectPerson(PersonListItemDto person)
    {
        _allocSelectedPerson = person;
        _personSearchResults = new();
        _allocPersonSearchTerm = string.Empty;
    }

    private void ClearSelectedPerson()
    {
        _allocSelectedPerson = null;
        _allocPersonSearchTerm = string.Empty;
        _personSearchResults = new();
    }

    private async Task CreateNewPerson()
    {
        _addPersonError = string.Empty;

        if (string.IsNullOrWhiteSpace(_newPersonFirstName))
        {
            _addPersonError = "שם פרטי נדרש";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPersonLastName))
        {
            _addPersonError = "שם משפחה נדרש";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPersonIdNumber))
        {
            _addPersonError = "מספר זהות נדרש";
            return;
        }

        _isAddingPerson = true;
        try
        {
            var request = new CreatePersonRequest
            {
                IdNumber  = _newPersonIdNumber.Trim(),
                IdType    = 1,
                FirstName = _newPersonFirstName.Trim(),
                LastName  = _newPersonLastName.Trim()
            };

            var response = await ApiService.PostAsync<CreatePersonRequest, ApiResponse<PersonSnapshotDto>>(
                "persons", request);

            if (response?.Success == true && response.Data != null)
            {
                // Auto-select the newly created person
                _allocSelectedPerson = new PersonListItemDto
                {
                    Id        = response.Data.Id,
                    IdNumber  = response.Data.IdNumber,
                    FirstName = response.Data.FirstName,
                    LastName  = response.Data.LastName,
                    FullName  = response.Data.FullName
                };
                _showAddPersonForm = false;
            }
            else
            {
                _addPersonError = response?.Message ?? "שגיאה ביצירת האדם";
            }
        }
        catch (Exception ex)
        {
            _addPersonError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isAddingPerson = false;
        }
    }

    private async Task SaveAllocation()
    {
        _allocError = string.Empty;

        if (_selectedEntitlement == null) return;
        if (_allocSelectedPerson == null)
        {
            _allocError = "יש לבחור סייעת";
            return;
        }
        if (_allocHours <= 0)
        {
            _allocError = "מספר שעות חייב להיות גדול מאפס";
            return;
        }
        if (!_allocStartDate.HasValue || !_allocEndDate.HasValue)
        {
            _allocError = "יש למלא תאריכי התחלה וסיום";
            return;
        }

        _isSavingAllocation = true;
        try
        {
            var request = new CreateEntitlementAllocationRequest
            {
                PersonId  = _allocSelectedPerson.Id,
                Hours     = _allocHours,
                HoursUnit = _allocHoursUnit,
                StartDate = DateOnly.FromDateTime(_allocStartDate.Value),
                EndDate   = DateOnly.FromDateTime(_allocEndDate.Value)
            };

            var response = await ApiService.PostAsync<CreateEntitlementAllocationRequest, ApiResponse<object>>(
                $"entitlements/{_selectedEntitlement.Id}/allocations", request);

            if (response?.Success == true)
            {
                CloseAllocationDialog();
                await LoadDataAsync();
            }
            else
            {
                _allocError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        catch (Exception ex)
        {
            _allocError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSavingAllocation = false;
        }
    }

    private async Task DeactivateAllocation(EntitlementAllocationDto alloc)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "האם להשבית הקצאה זו?"))
            return;

        if (_selectedEntitlement == null) return;

        var response = await ApiService.PutAsync<object, ApiResponse<object>>(
            $"entitlements/{_selectedEntitlement.Id}/allocations/{alloc.Id}/deactivate", new { });

        if (response?.Success == true)
            await LoadDataAsync();
        else
            await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהשבתה");
    }

    // ─── Filtering ────────────────────────────────────────────────────────────

    private List<EntitlementListItemDto> FilteredItems => _items.Where(item =>
    {
        bool activeOnly = _filterActiveOnly != "false";
        if (activeOnly && !item.IsActive) return false;

        if (!string.IsNullOrEmpty(_filterKind))
        {
            bool isPersonal = IsPersonalLevel(item.AssistantTypeLevel);
            if (_filterKind == "personal" && !isPersonal) return false;
            if (_filterKind == "institutional" && isPersonal) return false;
        }

        if (_filterSchoolId > 0 && item.InstitutionId != _filterSchoolId) return false;
        if (_filterAssistantTypeId > 0 && item.AssistantTypeId != _filterAssistantTypeId) return false;

        return true;
    }).ToList();

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterKind) ||
        _filterSchoolId > 0 ||
        _filterAssistantTypeId > 0 ||
        _filterActiveOnly == "false";

    private void ClearFilters()
    {
        _filterKind = "";
        _filterSchoolId = 0;
        _filterAssistantTypeId = 0;
        _filterActiveOnly = "true";
    }

    // ─── Entitlement form helpers ─────────────────────────────────────────────

    private async Task OnAssistantTypeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            _formAssistantTypeId = id;
            var atype = _assistantTypes.FirstOrDefault(t => t.Id == id);
            _formIsPersonal = IsPersonalLevel(atype?.Level);

            await JSRuntime.InvokeVoidAsync("console.log",
                $"[Entitlements] AssistantType selected: id={id}, level='{atype?.Level}', isPersonal={_formIsPersonal}, totalTypes={_assistantTypes.Count}");

            if (!_formIsPersonal)
            {
                _formPupilIdNumber = string.Empty;
                _formPupilFirstName = string.Empty;
                _formPupilLastName = string.Empty;
            }
        }
    }

    private void ResetFormDefaults()
    {
        _formAssistantTypeId = 0;
        _formIsPersonal = false;
        _formInstitutionId = 0;
        _formClassName = null;
        _formPupilIdNumber = string.Empty;
        _formPupilFirstName = string.Empty;
        _formPupilLastName = string.Empty;
        _formHours = 1;
        _formHoursUnit = "weekly";
        _formMinistryPct = _ministryOptions.FirstOrDefault()?.Percentage ?? 0;
        _formStartDate = _year?.StartDate?.ToDateTime(TimeOnly.MinValue);
        _formEndDate = _year?.EndDate?.ToDateTime(TimeOnly.MinValue);
        _formError = string.Empty;
    }

    private void ShowCreateDialog()
    {
        _editItem = null;
        ResetFormDefaults();
        _showFormDialog = true;
    }

    private void ShowEditDialog(EntitlementListItemDto item)
    {
        _editItem = item;
        _formAssistantTypeId = item.AssistantTypeId;
        _formIsPersonal = IsPersonalLevel(item.AssistantTypeLevel);
        _formInstitutionId = item.InstitutionId ?? 0;
        _formClassName = item.ClassName;
        _formPupilIdNumber = item.PupilIdNumber ?? string.Empty;
        _formPupilFirstName = item.PupilFirstName ?? string.Empty;
        _formPupilLastName = item.PupilLastName ?? string.Empty;
        _formHours = item.Hours;
        _formHoursUnit = item.HoursUnit;
