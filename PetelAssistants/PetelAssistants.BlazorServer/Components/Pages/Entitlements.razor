        if (_resolveItem == null)
            return;

        if (string.IsNullOrWhiteSpace(_resolveReason))
        {
            _resolveError = "יש להזין סיבת אישור";
            return;
        }

        _isSavingResolve = true;
        _resolveError = string.Empty;
        try
        {
            var response = await ApiService.PutAsync<ResolveEntitlementValidityRequest, ApiResponse<object>>(
                $"entitlements/{_resolveItem.Id}/resolve-validity",
                new ResolveEntitlementValidityRequest
                {
                    Reason = _resolveReason.Trim(),
                    PupilIdNumber = _resolvePupilId,
                    ApproveInvalidPupilId = _resolveApprovePupilId,
                    ApproveSupportCode = _resolveApproveSupportCode,
                    InstitutionId = _resolveInstitutionId > 0 ? _resolveInstitutionId : null
                });

            if (response?.Success == true)
            {
                CloseResolveDialog();
                await LoadDataAsync();
            }
            else
            {
                _resolveError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        catch (HttpStatusException ex)
        {
            _resolveError = TryReadApiMessage(ex.ResponseContent) ?? ex.Message;
        }
        catch (Exception ex)
        {
            _resolveError = TryReadApiMessage(ex.Message) ?? $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSavingResolve = false;
        }
    }

