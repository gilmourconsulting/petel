</style>

@code {
    [Parameter] public int YearId { get; set; }

    [SupplyParameterFromQuery(Name = "personId")]
    public int? FromPersonId { get; set; }

    protected override string PageName => "entitlements";

    private string _yearName = "";
    private YearDto? _year;
    private List<EntitlementListItemDto> _items = new();
    private List<AssistantTypeDto> _assistantTypes = new();
    private List<OrgUnitDto> _orgUnits = new();
    private List<MinistryParticipationOptionDto> _ministryOptions = new();
    private List<ClassClassificationDto> _classClassifications = new();
    private bool _isLoading = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private EntitlementListItemDto? _editItem;
    private PersonalEntitlementUploadModal? _personalEntitlementUploadModal;

    // Filter state
    private string _filterKind = "";
    private int _filterSchoolId;
    private int _filterAssistantTypeId;
    private string _filterActiveOnly = "true";
    private string _filterAllocation = "";
    private string _filterValidity = "";

    // Sort state
    private string _sortColumn = "SchoolName";
    private bool _sortAscending = true;

    // Entitlement form state
    private int _formAssistantTypeId;
    private bool _formIsPersonal;
    private int _formInstitutionId;
    private string? _formClassName;
    private int _formClassClassificationId;
    private string _formPupilIdNumber = string.Empty;
    private string _formPupilFirstName = string.Empty;
    private string _formPupilLastName = string.Empty;
    private decimal _formHours = 1;
    private string _formHoursUnit = "weekly";
    private decimal _formMinistryPct;
    private DateTime? _formStartDate;
    private DateTime? _formEndDate;

    // Allocation / history dock state
    private EntitlementListItemDto? _selectedEntitlement;
    private List<EntitlementAllocationDto> _allocations = new();
    private bool _isLoadingAllocations;
    private string _dockTab = "allocations";
    private List<EntitlementListItemDto> _entitlementHistory = new();
    private bool _isLoadingHistory;

    private bool _showResolveDialog;
    private bool _isSavingResolve;
    private string _resolveError = string.Empty;
    private EntitlementListItemDto? _resolveItem;
    private string _resolveReason = string.Empty;
    private string _resolvePupilId = string.Empty;
    private bool _resolveApprovePupilId;
    private bool _resolveApproveSupportCode;
    private int _resolveInstitutionId;

    private bool HasEntitlementHistory => _entitlementHistory.Count > 1;

    // Add allocation modal state
    private bool _showAllocationDialog;
    private bool _isSavingAllocation;
    private string _allocError = string.Empty;
    private string _allocPersonSearchTerm = string.Empty;
    private List<PersonListItemDto> _personSearchResults = new();
    private bool _isSearchingPersons;
    private PersonListItemDto? _allocSelectedPerson;
    private PersonListItemDto? _defaultPerson;
    private decimal _allocHours;
    private string _allocHoursUnit = "weekly";
    private DateTime? _allocStartDate;
    private DateTime? _allocEndDate;

    // Add new person inline
    private bool _showAddPersonForm;
    private string _newPersonFirstName = string.Empty;
    private string _newPersonLastName = string.Empty;
    private string _newPersonIdNumber = string.Empty;
    private string _addPersonError = string.Empty;
    private bool _isAddingPerson;

    // Search debounce
    private CancellationTokenSource? _searchCts;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadDataAsync();
        await LoadDefaultPersonAsync();
    }

    private async Task LoadDefaultPersonAsync()
    {
        if (!FromPersonId.HasValue) return;

        try
        {
            var response = await ApiService.GetAsync<ApiResponse<PersonSnapshotDto>>($"persons/{FromPersonId.Value}");
            if (response?.Data != null)
            {
                _defaultPerson = new PersonListItemDto
                {
                    Id        = response.Data.Id,
                    IdNumber  = response.Data.IdNumber,
                    FirstName = response.Data.FirstName,
                    LastName  = response.Data.LastName,
                    FullName  = response.Data.FullName
                };
            }
        }
        catch
        {
            _defaultPerson = null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await LoadLookupsAsync();
            await LoadDataAsync();
        }
    }

    private async Task LoadLookupsAsync()
    {
        _year = await ApiService.GetAsync<YearDto>($"years/{YearId}");
        _yearName = _year?.YearName ?? "";

        var typesResponse = await ApiService.GetAsync<ApiResponse<List<AssistantTypeDto>>>("assistant-types");
        _assistantTypes = typesResponse?.Data ?? new();

        var orgResponse = await ApiService.GetAsync<ApiResponse<List<OrgUnitDto>>>("org-units");
        _orgUnits = orgResponse?.Data ?? new();

        var ministryResponse = await ApiService.GetAsync<ApiResponse<List<MinistryParticipationOptionDto>>>("ministry-participation-options");
        _ministryOptions = ministryResponse?.Data ?? new();

        var classificationsResponse = await ApiService.GetAsync<ApiResponse<List<ClassClassificationDto>>>("class-classifications");
        _classClassifications = classificationsResponse?.Data ?? new();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<EntitlementListItemDto>>>(
                $"entitlements?yearId={YearId}");
            _items = response?.Data ?? new();

            // Refresh allocation panel if an entitlement is still selected (resolve by master after versioning)
            if (_selectedEntitlement != null)
            {
                var updated = _items.FirstOrDefault(i => i.MasterEntitlementId == _selectedEntitlement.MasterEntitlementId)
                              ?? _items.FirstOrDefault(i => i.Id == _selectedEntitlement.Id);
                if (updated != null && !updated.IsCancelled)
                {
                    _selectedEntitlement = updated;
                    await LoadAllocationsAsync(_selectedEntitlement.Id);
                    await LoadEntitlementHistoryAsync(_selectedEntitlement.MasterEntitlementId);
                    if (!HasEntitlementHistory)
                        _dockTab = "allocations";
                }
                else
                {
                    _selectedEntitlement = null;
                    _allocations = new();
                    _entitlementHistory = new();
                    _dockTab = "allocations";
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתונים: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAllocationsAsync(int entitlementId)
    {
        _isLoadingAllocations = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<EntitlementAllocationDto>>>(
                $"entitlements/{entitlementId}/allocations");
            _allocations = response?.Data ?? new();
        }
        catch
        {
            _allocations = new();
        }
        finally
        {
            _isLoadingAllocations = false;
        }
    }

    private async Task LoadEntitlementHistoryAsync(int masterEntitlementId)
    {
        _isLoadingHistory = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<EntitlementListItemDto>>>(
                $"entitlements/history/{masterEntitlementId}");
            _entitlementHistory = response?.Data ?? new();
        }
        catch
        {
            _entitlementHistory = new();
        }
        finally
        {
            _isLoadingHistory = false;
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    // ─── Entitlement row selection ─────────────────────────────────────────────

    private async Task SelectEntitlement(EntitlementListItemDto item)
    {
        if (_selectedEntitlement?.Id == item.Id)
        {
            _selectedEntitlement = null;
            _allocations = new();
            _entitlementHistory = new();
            _dockTab = "allocations";
            return;
        }

        _selectedEntitlement = item;
        _allocations = new();
        _entitlementHistory = new();
        _dockTab = "allocations";
        await LoadAllocationsAsync(item.Id);
        await LoadEntitlementHistoryAsync(item.MasterEntitlementId);
    }

    private void ClearSelectedEntitlement()
    {
        _selectedEntitlement = null;
        _allocations = new();
        _entitlementHistory = new();
        _dockTab = "allocations";
    }

    // ─── Allocation modal ─────────────────────────────────────────────────────

    private async Task ShowAddAllocationDialog()
    {
        if (_selectedEntitlement == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", "יש לבחור זכאות מהטבלה לפני הוספת הקצאה");
            return;
        }

        if (!_selectedEntitlement.IsValid)
        {
            await JSRuntime.InvokeVoidAsync("alert", "לא ניתן להקצות לזכאות שאינה תקינה");
            return;
        }

        _allocPersonSearchTerm = string.Empty;
        _personSearchResults = new();
        _allocSelectedPerson = _defaultPerson;
        _allocError = string.Empty;
        _showAddPersonForm = false;
        _newPersonFirstName = string.Empty;
        _newPersonLastName = string.Empty;
        _newPersonIdNumber = string.Empty;
        _addPersonError = string.Empty;

        // Default values from the entitlement
        _allocHours = _selectedEntitlement.Hours;
        _allocHoursUnit = _selectedEntitlement.HoursUnit;
        _allocStartDate = _selectedEntitlement.StartDate.ToDateTime(TimeOnly.MinValue);
        _allocEndDate   = _selectedEntitlement.EndDate.ToDateTime(TimeOnly.MinValue);

        _showAllocationDialog = true;
    }

    private void CloseAllocationDialog()
    {
        _showAllocationDialog = false;
        _allocError = string.Empty;
        _searchCts?.Cancel();
    }

    private async Task OnPersonSearchInput(ChangeEventArgs e)
    {
        _allocPersonSearchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();

        if (_allocPersonSearchTerm.Length < 2)
        {
            _personSearchResults = new();
            return;
        }

        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(300, token);

            _isSearchingPersons = true;
            StateHasChanged();

            var response = await ApiService.GetAsync<ApiResponse<List<PersonListItemDto>>>(
                $"persons/search?term={Uri.EscapeDataString(_allocPersonSearchTerm)}");
            _personSearchResults = response?.Data ?? new();
        }
        catch (TaskCanceledException)
        {
            // debounce cancellation — ignore
        }
        catch
        {
            _personSearchResults = new();
        }
        finally
        {
            _isSearchingPersons = false;
            StateHasChanged();
        }
    }

    private void SelectPerson(PersonListItemDto person)
    {
        _allocSelectedPerson = person;
        _personSearchResults = new();
        _allocPersonSearchTerm = string.Empty;
    }

    private void ClearSelectedPerson()
    {
        _allocSelectedPerson = null;
        _allocPersonSearchTerm = string.Empty;
        _personSearchResults = new();
    }

    private async Task CreateNewPerson()
    {
        _addPersonError = string.Empty;

        if (string.IsNullOrWhiteSpace(_newPersonFirstName))
        {
            _addPersonError = "שם פרטי נדרש";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPersonLastName))
        {
            _addPersonError = "שם משפחה נדרש";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPersonIdNumber))
        {
            _addPersonError = "מספר זהות נדרש";
            return;
        }

        _isAddingPerson = true;
        try
        {
            var request = new CreatePersonRequest
            {
                IdNumber  = _newPersonIdNumber.Trim(),
                IdType    = 1,
                FirstName = _newPersonFirstName.Trim(),
                LastName  = _newPersonLastName.Trim()
            };

            var response = await ApiService.PostAsync<CreatePersonRequest, ApiResponse<PersonSnapshotDto>>(
                "persons", request);

            if (response?.Success == true && response.Data != null)
            {
                // Auto-select the newly created person
                _allocSelectedPerson = new PersonListItemDto
                {
                    Id        = response.Data.Id,
                    IdNumber  = response.Data.IdNumber,
                    FirstName = response.Data.FirstName,
                    LastName  = response.Data.LastName,
                    FullName  = response.Data.FullName
                };
                _showAddPersonForm = false;
            }
            else
            {
                _addPersonError = response?.Message ?? "שגיאה ביצירת האדם";
            }
        }
        catch (Exception ex)
        {
            _addPersonError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isAddingPerson = false;
        }
    }

    private async Task SaveAllocation()
    {
        _allocError = string.Empty;

        if (_selectedEntitlement == null) return;
        if (_allocSelectedPerson == null)
        {
            _allocError = "יש לבחור סייעת";
            return;
        }
        if (_allocHours <= 0)
        {
            _allocError = "מספר שעות חייב להיות גדול מאפס";
            return;
        }
        if (!_allocStartDate.HasValue || !_allocEndDate.HasValue)
        {
            _allocError = "יש למלא תאריכי התחלה וסיום";
            return;
        }

        _isSavingAllocation = true;
        try
        {
            var request = new CreateEntitlementAllocationRequest
            {
                PersonId  = _allocSelectedPerson.Id,
                Hours     = _allocHours,
                HoursUnit = _allocHoursUnit,
                StartDate = DateOnly.FromDateTime(_allocStartDate.Value),
                EndDate   = DateOnly.FromDateTime(_allocEndDate.Value)
            };

            var response = await ApiService.PostAsync<CreateEntitlementAllocationRequest, ApiResponse<object>>(
                $"entitlements/{_selectedEntitlement.Id}/allocations", request);

            if (response?.Success == true)
            {
                CloseAllocationDialog();
                await LoadDataAsync();
            }
            else
            {
                _allocError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        catch (Exception ex)
        {
            _allocError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSavingAllocation = false;
        }
    }

