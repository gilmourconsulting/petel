@page "/year/{YearId:int}/entitlements"
@layout MainLayout
@inherits SecurePageBase

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "institutional_entitlements";

    protected override Task OnPageInitializedAsync()
    {
        Navigation.NavigateTo($"/year/{YearId}/entitlements/institutional", replace: true);
        return Task.CompletedTask;
    }
}
