    private async Task SaveItem()
    {
        _formError = string.Empty;

        var selectedType = _assistantTypes.FirstOrDefault(t => t.Id == _formAssistantTypeId);
        var isClassHelp = string.Equals(selectedType?.Name, "class_help", StringComparison.OrdinalIgnoreCase);

        if (_editItem == null && _formAssistantTypeId <= 0)
        {
            _formError = "יש לבחור סוג סייעת";
            return;
        }
        if (_editItem == null && _formInstitutionId <= 0)
        {
            _formError = "יש לבחור מוסד";
            return;
        }
        if (_editItem == null && isClassHelp && string.IsNullOrWhiteSpace(_formClassName))
        {
            _formError = "שם כיתה נדרש לזכאות מסוג סייעת כיתתית";
            return;
        }
        if (_formIsPersonal)
        {
            if (string.IsNullOrWhiteSpace(_formPupilFirstName))
            {
                _formError = "שם פרטי תלמיד נדרש";
                return;
            }
            if (string.IsNullOrWhiteSpace(_formPupilLastName))
            {
                _formError = "שם משפחה תלמיד נדרש";
                return;
            }
            if (_editItem == null &&
                (string.IsNullOrWhiteSpace(_formPupilIdNumber) || _formPupilIdNumber.Length != 9 || !_formPupilIdNumber.All(char.IsDigit)))
            {
                _formError = "תעודת זהות חייבת להכיל בדיוק 9 ספרות";
                return;
            }
        }
        if (_formMinistryPct <= 0)
        {
            _formError = "יש לבחור אחוז השתתפות משרד החינוך";
            return;
        }
        if (!_formStartDate.HasValue || !_formEndDate.HasValue)
        {
            _formError = "יש למלא תאריכי התחלה וסיום";
            return;
        }

        var startDate = DateOnly.FromDateTime(_formStartDate.Value);
        var endDate = DateOnly.FromDateTime(_formEndDate.Value);
        if (startDate > endDate)
        {
            _formError = "תאריך התחלה חייב להיות לפני תאריך סיום";
            return;
        }
        if (_year?.StartDate is DateOnly yearStart && startDate < yearStart)
        {
            _formError = "תאריך התחלה חייב להיות בתוך שנת הלימודים";
            return;
        }
        if (_year?.EndDate is DateOnly yearEnd && endDate > yearEnd)
        {
            _formError = "תאריך סיום חייב להיות בתוך שנת הלימודים";
            return;
        }
        if (_year?.StartDate is DateOnly yearStart2 && endDate < yearStart2)
        {
            _formError = "תאריך סיום חייב להיות בתוך שנת הלימודים";
            return;
        }
        if (_year?.EndDate is DateOnly yearEnd2 && startDate > yearEnd2)
        {
            _formError = "תאריך התחלה חייב להיות בתוך שנת הלימודים";
            return;
        }

        _isSaving = true;

        try
        {
            ApiResponse<object>? response;
            int? classificationId = _formClassClassificationId > 0 ? _formClassClassificationId : null;

            if (_editItem == null)
            {
                response = await ApiService.PostAsync<CreateEntitlementRequest, ApiResponse<object>>(
                    "entitlements",
                    new CreateEntitlementRequest
                    {
                        HebrewYearId             = YearId,
                        AssistantTypeId          = _formAssistantTypeId,
                        StartDate                = startDate,
                        EndDate                  = endDate,
                        Hours                    = _formHours,
                        HoursUnit                = _formHoursUnit,
                        MinistryParticipationPct = _formMinistryPct,
                        InstitutionId            = _formInstitutionId,
                        ClassName                = _formClassName,
                        ClassClassificationId    = classificationId,
                        PupilIdNumber            = _formIsPersonal ? _formPupilIdNumber : null,
                        PupilFirstName           = _formIsPersonal ? _formPupilFirstName : null,
                        PupilLastName            = _formIsPersonal ? _formPupilLastName : null
                    });
            }
            else
            {
                response = await ApiService.PutAsync<UpdateEntitlementRequest, ApiResponse<object>>(
                    $"entitlements/{_editItem.Id}",
                    new UpdateEntitlementRequest
                    {
                        StartDate                = startDate,
                        EndDate                  = endDate,
                        MinistryParticipationPct = _formMinistryPct,
                        ClassClassificationId    = classificationId,
                        PupilFirstName           = _formIsPersonal ? _formPupilFirstName : null,
                        PupilLastName            = _formIsPersonal ? _formPupilLastName : null
                    });
            }

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        catch (HttpStatusException ex)
        {
            _formError = TryReadApiMessage(ex.ResponseContent) ?? ex.Message;
        }
        catch (Exception ex)
        {
            _formError = TryReadApiMessage(ex.Message) ?? $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string? TryReadApiMessage(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return null;

        var json = text;
        const string marker = "Details: ";
        var idx = text.IndexOf(marker, StringComparison.Ordinal);
        if (idx >= 0)
            json = text[(idx + marker.Length)..].Trim();

        var brace = json.IndexOf('{');
        if (brace >= 0)
            json = json[brace..];

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("message", out var msg) &&
                msg.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                return msg.GetString();
            }
        }
        catch
        {
            // not JSON
        }

        return null;
    }

    private static bool HasInvalidReason(EntitlementListItemDto item, string code)
        => !string.IsNullOrEmpty(item.InvalidReasons) &&
           item.InvalidReasons.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
               .Contains(code, StringComparer.Ordinal);

