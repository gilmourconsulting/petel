    }

    // ─── Summary dashboard ────────────────────────────────────────────────────

    private List<EntitlementListItemDto> ActiveItems => _items.Where(i => i.IsActive).ToList();

    private decimal AllocatedPercent => ComputeAllocatedPercent(ActiveItems);

    private IEnumerable<(string TypeName, int Count, decimal AllocatedPercent)> TypeSummaries =>
        ActiveItems
            .GroupBy(i => i.AssistantTypeName)
            .Select(g => (TypeName: g.Key, Count: g.Count(), AllocatedPercent: ComputeAllocatedPercent(g.ToList())))
            .OrderByDescending(t => t.Count)
            .ThenBy(t => t.TypeName);

    private static decimal ComputeAllocatedPercent(List<EntitlementListItemDto> items)
    {
        var totalHours = items.Sum(i => i.Hours);
        if (totalHours <= 0) return 0;
        var allocatedHours = items.Sum(i => Math.Min(i.AllocatedHours, i.Hours));
        return Math.Round(allocatedHours / totalHours * 100, 1);
    }

    // ─── Filtering ────────────────────────────────────────────────────────────

    private List<EntitlementListItemDto> FilteredItems
    {
        get
        {
            IEnumerable<EntitlementListItemDto> query = _items.Where(item =>
            {
                bool activeOnly = _filterActiveOnly != "false";
                if (activeOnly && !item.IsActive) return false;

                if (!string.IsNullOrEmpty(_filterKind))
                {
                    bool isPersonal = IsPersonalLevel(item.AssistantTypeLevel);
                    if (_filterKind == "personal" && !isPersonal) return false;
                    if (_filterKind == "institutional" && isPersonal) return false;
                }

                if (_filterSchoolId > 0 && item.InstitutionId != _filterSchoolId) return false;
                if (_filterAssistantTypeId > 0 && item.AssistantTypeId != _filterAssistantTypeId) return false;
                if (!string.IsNullOrEmpty(_filterAllocation) && item.AllocationStatus != _filterAllocation) return false;
                if (_filterValidity == "valid" && !item.IsValid) return false;
                if (_filterValidity == "invalid" && item.IsValid) return false;

                return true;
            });

            query = _sortColumn switch
            {
                "Kind" => _sortAscending
                    ? query.OrderBy(i => IsPersonalLevel(i.AssistantTypeLevel) ? 0 : 1)
                    : query.OrderByDescending(i => IsPersonalLevel(i.AssistantTypeLevel) ? 0 : 1),
                "SchoolName" => _sortAscending
                    ? query.OrderBy(i => i.SchoolName ?? "")
                    : query.OrderByDescending(i => i.SchoolName ?? ""),
                "PupilName" => _sortAscending
                    ? query.OrderBy(i => i.PupilLastName ?? "").ThenBy(i => i.PupilFirstName ?? "")
                    : query.OrderByDescending(i => i.PupilLastName ?? "").ThenByDescending(i => i.PupilFirstName ?? ""),
                "PupilIdNumber" => _sortAscending
                    ? query.OrderBy(i => i.PupilIdNumber ?? "")
                    : query.OrderByDescending(i => i.PupilIdNumber ?? ""),
                "ClassName" => _sortAscending
                    ? query.OrderBy(i => i.ClassName ?? "")
                    : query.OrderByDescending(i => i.ClassName ?? ""),
                "ClassClassificationName" => _sortAscending
                    ? query.OrderBy(i => i.ClassClassificationName ?? "")
                    : query.OrderByDescending(i => i.ClassClassificationName ?? ""),
                "AssistantTypeName" => _sortAscending
                    ? query.OrderBy(i => i.AssistantTypeName)
                    : query.OrderByDescending(i => i.AssistantTypeName),
                "Hours" => _sortAscending
                    ? query.OrderBy(i => i.Hours)
                    : query.OrderByDescending(i => i.Hours),
                "MinistryParticipationPct" => _sortAscending
                    ? query.OrderBy(i => i.MinistryParticipationPct)
                    : query.OrderByDescending(i => i.MinistryParticipationPct),
                "StartDate" => _sortAscending
                    ? query.OrderBy(i => i.StartDate).ThenBy(i => i.EndDate)
                    : query.OrderByDescending(i => i.StartDate).ThenByDescending(i => i.EndDate),
                "AllocationStatus" => _sortAscending
                    ? query.OrderBy(i => i.AllocationStatus)
                    : query.OrderByDescending(i => i.AllocationStatus),
                "Status" => _sortAscending
                    ? query.OrderBy(i => i.IsCancelled).ThenBy(i => i.IsActive)
                    : query.OrderByDescending(i => i.IsCancelled).ThenByDescending(i => i.IsActive),
                _ => query
            };

            return query.ToList();
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterKind) ||
        _filterSchoolId > 0 ||
        _filterAssistantTypeId > 0 ||
        _filterActiveOnly == "false" ||
        !string.IsNullOrEmpty(_filterAllocation) ||
        !string.IsNullOrEmpty(_filterValidity);

    private void ClearFilters()
    {
        _filterKind = "";
        _filterSchoolId = 0;
        _filterAssistantTypeId = 0;
        _filterActiveOnly = "true";
        _filterAllocation = "";
        _filterValidity = "";
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

