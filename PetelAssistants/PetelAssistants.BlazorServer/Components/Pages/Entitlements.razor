@page "/year/{YearId:int}/entitlements"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="entitlements_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="entitlements_add" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                  OnClick="ShowCreateDialog" CssClass="context-btn">
        הוסף זכאות
    </SecureButton>
    <SecureButton ActionName="entitlements_add_allocation" ScreenName="@PageName" FunctionName="ShowAddAllocationDialog"
                  OnClick="ShowAddAllocationDialog" CssClass="context-btn">
        הוסף הקצאה
    </SecureButton>
    @if (_selectedEntitlement is { IsValid: false, IsCancelled: false })
    {
        <SecureButton ActionName="entitlements_resolve_invalid" ScreenName="@PageName" FunctionName="ShowResolveValidityDialog"
                      OnClick="() => ShowResolveValidityDialog(_selectedEntitlement)" CssClass="context-btn">
            טיפול בזכאות לא תקינה
        </SecureButton>
    }
    <SecureButton ActionName="entitlements_personal_upload" ScreenName="@PageName" FunctionName="ShowPersonalEntitlementUploadDialog"
                  OnClick="ShowPersonalEntitlementUploadDialog" CssClass="context-btn">
        העלאת זכאויות אישיות
    </SecureButton>
    <SecureButton ActionName="entitlements_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה
    </SecureButton>
</div>

<PersonalEntitlementUploadModal @ref="_personalEntitlementUploadModal"
                                YearId="YearId"
                                YearName="@_yearName"
                                OnUploadComplete="RefreshData" />

<div class="main-container entitlements-main">
    <div class="students-content entitlements-page">
        <div class="school-title-section">
            <h1 class="page-title">זכאויות @(_yearName != "" ? $"- {_yearName}" : "")</h1>
        </div>
        <div class="content-card entitlements-list-panel">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <!-- Summary dashboard -->
                <div class="summary-grid" style="margin-bottom: 16px; flex-shrink: 0;">
                    <div class="summary-card">
                        <div class="summary-icon">📋</div>
                        <div class="summary-info">
                            <div class="summary-value">@ActiveItems.Count</div>
                            <div class="summary-label">סה"כ זכאויות</div>
                        </div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-icon">📊</div>
                        <div class="summary-info">
                            <div class="summary-value">@AllocatedPercent.ToString("0.#")%</div>
                            <div class="summary-label">אחוז מוקצה (שעות)</div>
                            <div class="summary-extra">@ActiveItems.Count(i => i.AllocationStatus == "full") מלא · @ActiveItems.Count(i => i.AllocationStatus == "partial") חלקי · @ActiveItems.Count(i => i.AllocationStatus == "none") ללא</div>
                        </div>
                    </div>
                    @foreach (var type in TypeSummaries)
                    {
                        <div class="summary-card">
                            <div class="summary-icon">🏷️</div>
                            <div class="summary-info">
                                <div class="summary-value">@type.Count</div>
                                <div class="summary-label">@type.TypeName</div>
                                <div class="summary-extra">@type.AllocatedPercent.ToString("0.#")% מוקצה</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Filter bar -->
                <div class="filter-bar" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: flex-end; flex-shrink: 0;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סוג</label>
                        <select class="form-control" style="min-width: 130px;" @bind="_filterKind" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="personal">אישי</option>
                            <option value="institutional">מוסדי</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">מוסד</label>
                        <select class="form-control" style="min-width: 160px;" @bind="_filterSchoolId" @bind:event="onchange">
                            <option value="0">הכל</option>
                            @foreach (var unit in _orgUnits.Where(u => u.IsActive))
                            {
                                <option value="@unit.Id">@unit.Name</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סוג סייעת</label>
                        <select class="form-control" style="min-width: 160px;" @bind="_filterAssistantTypeId" @bind:event="onchange">
                            <option value="0">הכל</option>
                            @foreach (var t in _assistantTypes)
                            {
                                <option value="@t.Id">@t.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סטטוס</label>
                        <select class="form-control" style="min-width: 120px;" @bind="_filterActiveOnly" @bind:event="onchange">
                            <option value="true">פעיל בלבד</option>
                            <option value="false">הכל</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">הקצאה</label>
                        <select class="form-control" style="min-width: 140px;" @bind="_filterAllocation" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="none">לא מוקצה</option>
                            <option value="partial">מוקצה חלקית</option>
                            <option value="full">מוקצה במלואו</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">תקינות</label>
                        <select class="form-control" style="min-width: 130px;" @bind="_filterValidity" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="valid">תקינות</option>
                            <option value="invalid">לא תקינות</option>
                        </select>
                    </div>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearFilters">נקה סינון</button>
                    }
                </div>

                @if (FilteredItems.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו זכאויות</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>פעולות</th>
                                    <th @onclick='() => SortTable("Kind")' style="cursor: pointer;">
                                        סוג @GetSortArrow("Kind")
                                    </th>
                                    <th @onclick='() => SortTable("SchoolName")' style="cursor: pointer;">
                                        מוסד @GetSortArrow("SchoolName")
                                    </th>
                                    <th @onclick='() => SortTable("PupilName")' style="cursor: pointer;">
                                        שם תלמיד @GetSortArrow("PupilName")
                                    </th>
                                    <th @onclick='() => SortTable("PupilIdNumber")' style="cursor: pointer;">
                                        ת"ז @GetSortArrow("PupilIdNumber")
                                    </th>
                                    <th @onclick='() => SortTable("ClassName")' style="cursor: pointer;">
                                        כיתה @GetSortArrow("ClassName")
                                    </th>
                                    <th @onclick='() => SortTable("ClassClassificationName")' style="cursor: pointer;">
                                        סיווג כיתה @GetSortArrow("ClassClassificationName")
                                    </th>
                                    <th @onclick='() => SortTable("AssistantTypeName")' style="cursor: pointer;">
                                        סוג סייעת @GetSortArrow("AssistantTypeName")
                                    </th>
                                    <th @onclick='() => SortTable("Hours")' style="cursor: pointer;">
                                        שעות @GetSortArrow("Hours")
                                    </th>
                                    <th @onclick='() => SortTable("MinistryParticipationPct")' style="cursor: pointer;">
                                        השתתפות משרד (%) @GetSortArrow("MinistryParticipationPct")
                                    </th>
                                    <th @onclick='() => SortTable("StartDate")' style="cursor: pointer;">
                                        תאריכים @GetSortArrow("StartDate")
                                    </th>
                                    <th @onclick='() => SortTable("AllocationStatus")' style="cursor: pointer;">
                                        הקצאה @GetSortArrow("AllocationStatus")
                                    </th>
                                    <th @onclick='() => SortTable("Status")' style="cursor: pointer;">
                                        סטטוס @GetSortArrow("Status")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    bool isPersonal = IsPersonalLevel(item.AssistantTypeLevel);
                                    bool isSelected = _selectedEntitlement?.Id == item.Id;
                                    <tr class="@(item.IsActive ? "" : "row-inactive") @(isSelected ? "row-selected" : "")"
                                        style="cursor: pointer;"
                                        @onclick="() => SelectEntitlement(item)">
                                        <td @onclick:stopPropagation="true">
                                            @if (!item.IsCancelled)
                                            {
                                                <SecureButton ActionName="entitlements_edit" ScreenName="@PageName" FunctionName="EditItem"
                                                              OnClick="() => ShowEditDialog(item)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                                    <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                                </SecureButton>
                                                @if (!item.IsValid)
                                                {
                                                    <SecureButton ActionName="entitlements_resolve_invalid" ScreenName="@PageName" FunctionName="ResolveInvalid"
                                                                  OnClick="() => ShowResolveValidityDialog(item)" CssClass="btn-icon" Title="טיפול בזכאות לא תקינה" HideIfNoAccess="true">
                                                        <span class="status-badge status-invalid">לא תקינה</span>
                                                    </SecureButton>
                                                }
                                            }
                                            @if (item.IsActive && !item.IsCancelled)
                                            {
                                                <SecureButton ActionName="entitlements_deactivate" ScreenName="@PageName" FunctionName="DeactivateItem"
                                                              OnClick="() => DeactivateItem(item)" CssClass="btn-icon btn-danger" Title="ביטול זכאות" HideIfNoAccess="true">
                                                    <img src="/images/deactivate_icon.png" alt="ביטול" class="action-icon-natural">
                                                </SecureButton>
                                            }
                                        </td>
                                        <td>
                                            <span class="status-badge @(isPersonal ? "status-personal" : "status-institutional")">
                                                @(isPersonal ? "אישי" : "מוסדי")
                                            </span>
                                        </td>
                                        <td>@(item.SchoolName ?? (string.IsNullOrEmpty(item.SourceInstitutionSymbol) ? "—" : $"סמל {item.SourceInstitutionSymbol}"))</td>
                                        <td>
                                            @if (isPersonal && (!string.IsNullOrEmpty(item.PupilFirstName) || !string.IsNullOrEmpty(item.PupilLastName)))
                                            {
                                                @($"{item.PupilFirstName} {item.PupilLastName}".Trim())
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                        <td>@(isPersonal ? (item.PupilIdNumber ?? "—") : "—")</td>
                                        <td>@(item.ClassName ?? "—")</td>
                                        <td>@(item.ClassClassificationName ?? "—")</td>
                                        <td>@item.AssistantTypeName</td>
                                        <td>@item.Hours @GetHoursUnitLabel(item.HoursUnit)</td>
                                        <td>@item.MinistryParticipationPct.ToString("0.##")%</td>
                                        <td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="status-badge @GetAllocationStatusCss(item.AllocationStatus)">
                                                @GetAllocationStatusLabel(item.AllocationStatus)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-badge @(item.IsCancelled ? "status-inactive" : item.IsActive ? "status-active" : "status-inactive")">
                                                @(item.IsCancelled ? "בוטל" : item.IsActive ? "פעיל" : "לא פעיל")
                                            </span>
                                            @if (!item.IsValid && !item.IsCancelled)
                                            {
                                                <span class="status-badge status-invalid" title="@item.InvalidReasonsDisplay">לא תקינה</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>

        @if (_selectedEntitlement != null)
        {
            <div class="entitlements-allocations-dock">
                <div class="content-card allocations-panel-docked">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <h3 style="margin: 0; font-size: 1.1em;">
                            @(_dockTab == "history" && HasEntitlementHistory ? "היסטוריית זכאות:" : "הקצאות לזכאות:")
                            <span style="font-weight: 400;">
                                @_selectedEntitlement.AssistantTypeName
                                @(_selectedEntitlement.SchoolName != null ? $" — {_selectedEntitlement.SchoolName}" : "")
                                (@_selectedEntitlement.Hours @GetHoursUnitLabel(_selectedEntitlement.HoursUnit))
                            </span>
                        </h3>
                        <div style="display: flex; gap: 8px; align-items: center;">
                            @if (_dockTab == "allocations" && _isLoadingAllocations)
                            {
                                <span style="font-size: 0.85em; color: #6c757d;">טוען...</span>
                            }
                            @if (_dockTab == "history" && _isLoadingHistory)
                            {
                                <span style="font-size: 0.85em; color: #6c757d;">טוען...</span>
                            }
                            @if (_dockTab == "allocations")
                            {
                                <button class="btn btn-primary btn-sm" @onclick="ShowAddAllocationDialog">+ הוסף הקצאה</button>
                            }
                            <button class="btn btn-secondary btn-sm" @onclick="ClearSelectedEntitlement" title="סגור">✕</button>
                        </div>
                    </div>

                    @if (HasEntitlementHistory)
                    {
                        <div class="tabs-header" style="margin-bottom: 12px; padding: 0;">
                            <button type="button"
                                    class="tab-button @(_dockTab == "allocations" ? "active" : "")"
                                    @onclick='() => _dockTab = "allocations"'>
                                הקצאות
                            </button>
                            <button type="button"
                                    class="tab-button @(_dockTab == "history" ? "active" : "")"
                                    @onclick='() => _dockTab = "history"'>
                                היסטוריה
                            </button>
                        </div>
                    }

                    @if (_dockTab == "allocations" || !HasEntitlementHistory)
                    {
                        <AllocationsPanel ViewMode="AllocationsViewMode.ByEntitlement"
                                          Allocations="_allocations"
                                          IsLoading="_isLoadingAllocations"
                                          ShowAddButton="true"
                                          ShowChrome="false"
                                          SecurityScreenName="entitlements"
                                          OnAddAllocation="ShowAddAllocationDialog"
                                          OnDeactivateAllocation="DeactivateAllocation" />
                    }
                    else
                    {
                        @if (_isLoadingHistory)
                        {
                            <div class="loading-spinner">טוען היסטוריה...</div>
                        }
                        else if (_entitlementHistory.Count == 0)
                        {
                            <div class="no-data-message" style="padding: 12px 0;">אין היסטוריה</div>
                        }
                        else
                        {
                            <div class="table-container">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>גרסה</th>
                                            <th>תאריכים</th>
                                            <th>שעות</th>
                                            <th>השתתפות משרד (%)</th>
                                            <th>סיווג כיתה</th>
                                            <th>שם תלמיד</th>
                                            <th>סטטוס</th>
                                            <th>סיבת אישור</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _entitlementHistory.OrderByDescending(h => h.Version))
                                        {
                                            bool isPersonal = IsPersonalLevel(row.AssistantTypeLevel);
                                            bool isCurrent = row.Id == _selectedEntitlement.Id;
                                            <tr class="@(isCurrent ? "row-selected" : row.IsActive ? "" : "row-inactive")">
                                                <td>
                                                    @row.Version
                                                    @if (isCurrent)
                                                    {
                                                        <span class="status-badge status-personal" style="margin-right: 6px;">נוכחית</span>
                                                    }
                                                </td>
                                                <td>@row.StartDate.ToString("dd/MM/yyyy") – @row.EndDate.ToString("dd/MM/yyyy")</td>
                                                <td>@row.Hours @GetHoursUnitLabel(row.HoursUnit)</td>
                                                <td>@row.MinistryParticipationPct.ToString("0.##")%</td>
                                                <td>@(row.ClassClassificationName ?? "—")</td>
                                                <td>
                                                    @if (isPersonal && (!string.IsNullOrEmpty(row.PupilFirstName) || !string.IsNullOrEmpty(row.PupilLastName)))
                                                    {
                                                        @($"{row.PupilFirstName} {row.PupilLastName}".Trim())
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="status-badge @(row.IsCancelled ? "status-inactive" : row.IsActive ? "status-active" : "status-inactive")">
                                                        @(row.IsCancelled ? "בוטל" : row.IsActive ? "פעיל" : "לא פעיל")
                                                    </span>
                                                    @if (!row.IsValid && !row.IsCancelled)
                                                    {
                                                        <span class="status-badge status-invalid" title="@row.InvalidReasonsDisplay">לא תקינה</span>
                                                    }
                                                </td>
                                                <td>@(row.ValidityResolvedReason ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Entitlement form dialog -->
@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editItem == null ? "הוספת זכאות" : "עריכת זכאות")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                @{
                    var isEdit = _editItem != null;
                    var selectedType = _assistantTypes.FirstOrDefault(t => t.Id == _formAssistantTypeId);
                    var isClassHelp = string.Equals(selectedType?.Name, "class_help", StringComparison.OrdinalIgnoreCase);
                }

                <!-- Assistant type — immutable after create -->
                <div class="form-group">
                    <label>סוג סייעת <span class="required">*</span></label>
                    @if (isEdit)
                    {
                        <input class="form-control" value="@(selectedType?.DisplayName ?? _editItem!.AssistantTypeName)" disabled />
                    }
                    else
                    {
                        <select class="form-control" value="@_formAssistantTypeId" @onchange="OnAssistantTypeChanged">
                            <option value="0">— בחר סוג —</option>
                            @foreach (var type in _assistantTypes)
                            {
                                <option value="@type.Id">@type.DisplayName</option>
                            }
                        </select>
                    }
                </div>

                <!-- Personal-only fields -->
                @if (_formIsPersonal)
                {
                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>שם פרטי תלמיד <span class="required">*</span></label>
                            <input class="form-control" @bind="_formPupilFirstName" placeholder="שם פרטי" />
                        </div>
                        <div class="form-group">
                            <label>שם משפחה תלמיד <span class="required">*</span></label>
                            <input class="form-control" @bind="_formPupilLastName" placeholder="שם משפחה" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>תעודת זהות תלמיד <span class="required">*</span></label>
                        <input class="form-control" @bind="_formPupilIdNumber"
                               placeholder="9 ספרות" maxlength="9"
                               inputmode="numeric" pattern="[0-9]{9}"
                               disabled="@isEdit" />
                        <small class="form-text text-muted">9 ספרות בדיוק, ספרה מובילה 0 מותרת@(isEdit ? " (לא ניתן לשינוי)" : "")</small>
                    </div>
                }

                <!-- School + class — immutable after create -->
                <div class="form-row" style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>מוסד (בית ספר / גן) <span class="required">*</span></label>
                        @if (isEdit)
                        {
                            <input class="form-control" value="@(_editItem!.SchoolName ?? "—")" disabled />
                        }
                        else
                        {
                            <select class="form-control" @bind="_formInstitutionId">
                                <option value="0">— בחר מוסד —</option>
                                @foreach (var unit in _orgUnits.Where(u => u.IsActive))
                                {
                                    <option value="@unit.Id">@unit.Name (@GetOrgUnitTypeLabel(unit.OrgUnitType))</option>
                                }
                            </select>
                        }
                    </div>
                    <div class="form-group">
                        <label>כיתה @if (isClassHelp) { <span class="required">*</span> }</label>
                        @if (isEdit)
                        {
                            <input class="form-control" value="@(_formClassName ?? "—")" disabled />
                        }
                        else
                        {
                            <input class="form-control" @bind="_formClassName" placeholder="לדוגמה: כיתה א׳" />
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label>סיווג כיתה</label>
                    <select class="form-control" @bind="_formClassClassificationId">
                        <option value="0">— ללא —</option>
                        @foreach (var c in _classClassifications)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <!-- Hours (immutable on edit) + ministry % -->
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>שעות <span class="required">*</span></label>
                        @if (isEdit)
                        {
                            <input class="form-control" value="@_formHours" disabled />
                        }
                        else
                        {
                            <InputNumber class="form-control" @bind-Value="_formHours" />
                        }
                    </div>
                    <div class="form-group">
                        <label>יחידת שעות <span class="required">*</span></label>
                        @if (isEdit)
                        {
                            <input class="form-control" value="@GetHoursUnitLabel(_formHoursUnit)" disabled />
                        }
                        else
                        {
                            <select class="form-control" @bind="_formHoursUnit">
                                <option value="weekly">שבועי</option>
                                <option value="monthly">חודשי</option>
                            </select>
                        }
                    </div>
                    <div class="form-group">
                        <label>השתתפות משרד (%)<span class="required">*</span></label>
                        <select class="form-control" @bind="_formMinistryPct">
                            <option value="0">— בחר —</option>
                            @foreach (var opt in _ministryOptions)
                            {
                                <option value="@opt.Percentage">@opt.Percentage.ToString("0.##")%</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Dates — always editable -->
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>תאריך התחלה <span class="required">*</span></label>
                        <InputDate class="form-control" @bind-Value="_formStartDate" />
                    </div>
                    <div class="form-group">
                        <label>תאריך סיום <span class="required">*</span></label>
                        <InputDate class="form-control" @bind-Value="_formEndDate" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-alert" role="alert">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveItem" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

<!-- Add allocation modal -->
@if (_showAllocationDialog)
{
    <div class="modal-overlay" @onclick="CloseAllocationDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>הוספת הקצאה</h3>
                <button class="modal-close" @onclick="CloseAllocationDialog">✕</button>
            </div>
            <div class="modal-body">

                @if (_allocSelectedPerson == null)
                {
                    <!-- Step 1: Person search -->
                    <div class="form-group">
                        <label>חיפוש סייעת <span class="required">*</span></label>
                        <input class="form-control" value="@_allocPersonSearchTerm"
                               @oninput="OnPersonSearchInput"
                               placeholder="הקלד שם או מספר זהות לחיפוש..." />
                    </div>

                    @if (_isSearchingPersons)
                    {
                        <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 8px;">מחפש...</div>
                    }
                    else if (_personSearchResults.Count > 0)
                    {
                        <div style="border: 1px solid #dee2e6; border-radius: 4px; max-height: 200px; overflow-y: auto; margin-bottom: 12px;">
                            @foreach (var person in _personSearchResults)
                            {
                                <div style="padding: 8px 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0;"
                                     @onclick="() => SelectPerson(person)"
                                     class="person-search-result">
                                    <strong>@person.FullName</strong>
                                    <span style="color: #6c757d; font-size: 0.85em; margin-right: 8px;">@person.IdNumber</span>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_allocPersonSearchTerm) && _allocPersonSearchTerm.Length >= 2 && !_isSearchingPersons)
                    {
                        <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 8px;">לא נמצאו תוצאות</div>
                    }

                    <!-- Add new person inline -->
                    @if (!_showAddPersonForm)
                    {
                        <button class="btn btn-secondary" style="margin-top: 8px;" @onclick="() => _showAddPersonForm = true">
                            + הוסף אדם חדש
                        </button>
                    }
                    else
                    {
                        <div style="border: 1px solid #dee2e6; border-radius: 4px; padding: 16px; margin-top: 12px; background: #f8f9fa;">
                            <h5 style="margin-top: 0; margin-bottom: 12px;">פרטי אדם חדש</h5>
                            <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div class="form-group">
                                    <label>שם פרטי <span class="required">*</span></label>
                                    <input class="form-control" @bind="_newPersonFirstName" placeholder="שם פרטי" />
                                </div>
                                <div class="form-group">
                                    <label>שם משפחה <span class="required">*</span></label>
                                    <input class="form-control" @bind="_newPersonLastName" placeholder="שם משפחה" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>מספר זהות <span class="required">*</span></label>
                                <input class="form-control" @bind="_newPersonIdNumber" placeholder="9 ספרות" maxlength="9" inputmode="numeric" />
                            </div>
                            @if (!string.IsNullOrEmpty(_addPersonError))
                            {
                                <div class="error-alert" role="alert">@_addPersonError</div>
                            }
                            <div style="display: flex; gap: 8px; margin-top: 8px;">
                                <button class="btn btn-primary" @onclick="CreateNewPerson" disabled="@_isAddingPerson">
                                    @(_isAddingPerson ? "שומר..." : "צור ובחר")
                                </button>
                                <button class="btn btn-secondary" @onclick="() => { _showAddPersonForm = false; _addPersonError = string.Empty; }">ביטול</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Step 2: Allocation details after person is selected -->
                    <div style="background: #e8f4f8; border-radius: 4px; padding: 10px 14px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
                        <span><strong>סייעת נבחרה:</strong> @_allocSelectedPerson.FullName</span>
                        <button class="btn btn-secondary btn-sm" @onclick="ClearSelectedPerson">שנה</button>
                    </div>

                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>שעות <span class="required">*</span></label>
                            <InputNumber class="form-control" @bind-Value="_allocHours" />
                        </div>
                        <div class="form-group">
                            <label>יחידת שעות <span class="required">*</span></label>
                            <select class="form-control" @bind="_allocHoursUnit">
                                <option value="weekly">שבועי</option>
                                <option value="monthly">חודשי</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <div class="form-group">
                            <label>תאריך התחלה <span class="required">*</span></label>
                            <InputDate class="form-control" @bind-Value="_allocStartDate" />
                        </div>
                        <div class="form-group">
                            <label>תאריך סיום <span class="required">*</span></label>
                            <InputDate class="form-control" @bind-Value="_allocEndDate" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_allocError))
                {
                    <div class="error-alert" role="alert">@_allocError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAllocationDialog">ביטול</button>
                @if (_allocSelectedPerson != null)
                {
                    <button class="btn btn-primary" @onclick="SaveAllocation" disabled="@_isSavingAllocation">
                        @(_isSavingAllocation ? "שומר..." : "שמור הקצאה")
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showResolveDialog && _resolveItem != null)
{
    <div class="modal-overlay" @onclick="CloseResolveDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>טיפול בזכאות לא תקינה</h3>
                <button class="modal-close" @onclick="CloseResolveDialog">✕</button>
            </div>
            <div class="modal-body">
                <p style="margin-top: 0;">
                    סיבות: <strong>@(_resolveItem.InvalidReasonsDisplay ?? "—")</strong>
                </p>

                @if (HasInvalidReason(_resolveItem, "invalid_pupil_id"))
                {
                    <div class="form-group">
                        <label>תעודת זהות תלמיד</label>
                        <input class="form-control" @bind="_resolvePupilId" maxlength="9" inputmode="numeric" placeholder="9 ספרות" />
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_resolveApprovePupilId" />
                            אשר בכל זאת (9 ספרות)
                        </label>
                    </div>
                }

                @if (HasInvalidReason(_resolveItem, "invalid_support_code"))
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_resolveApproveSupportCode" />
                            אשר קוד תומכת חינוך
                            @if (!string.IsNullOrEmpty(_resolveItem.SourceSupportCode))
                            {
                                <span>(קוד בקובץ: @_resolveItem.SourceSupportCode)</span>
                            }
                        </label>
                    </div>
                }

                @if (HasInvalidReason(_resolveItem, "missing_institution"))
                {
                    <div class="form-group">
                        <label>מוסד <span class="required">*</span></label>
                        @if (!string.IsNullOrEmpty(_resolveItem.SourceInstitutionSymbol))
                        {
                            <small class="form-text text-muted">סמל מהקובץ: @_resolveItem.SourceInstitutionSymbol</small>
                        }
                        <select class="form-control" @bind="_resolveInstitutionId">
                            <option value="0">— בחר מוסד —</option>
                            @foreach (var unit in _orgUnits.Where(u => u.IsActive))
                            {
                                <option value="@unit.Id">@unit.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label>סיבת אישור <span class="required">*</span></label>
                    <textarea class="form-control" @bind="_resolveReason" rows="3" maxlength="500" placeholder="חובה"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(_resolveError))
                {
                    <div class="error-alert" role="alert">@_resolveError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseResolveDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveResolveValidity" disabled="@_isSavingResolve">
                    @(_isSavingResolve ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

