@page "/roledetails/{RoleId:int}"
@layout MainLayout
@inherits SecurePageBase
@inject ApiService ApiService

<div class="school-title-section">
    <h1 class="page-title">פרטי תפקיד</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="roledetails_back" ScreenName="@PageName" FunctionName="NavigateBack" OnClick="NavigateBack" CssClass="context-navigation-btn">
            חזרה לרשימת תפקידים
        </SecureButton>
    </div>

    @if (_isLoading)
    {
        <div class="loading-spinner">טוען פרטי תפקיד...</div>
    }
    else if (_role == null)
    {
        <div class="no-data-message">תפקיד לא נמצא</div>
    }
    else
    {
        <div class="content-card">
            <div class="role-header">
                <h2>@_role.Name</h2>
                @if (!string.IsNullOrEmpty(_role.Description))
                {
                    <p class="role-description">@_role.Description</p>
                }
                <div class="role-meta">
                    <span>נוצר: @_role.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="row-two-columns">
            @* ── Users in role ──────────────────────────────────────────────── *@
            <div class="content-card half-card">
                <div class="card-header-row">
                    <h3>משתמשים בתפקיד (@_role.Users.Count)</h3>
                </div>

                @if (_role.Users.Count == 0)
                {
                    <p class="no-data-message">לא שויכו משתמשים לתפקיד זה</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th>שם משתמש</th>
                                <th>שם מלא</th>
                                <th>סטטוס</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in _role.Users)
                            {
                                <tr class="@(user.IsActive ? "" : "row-inactive")">
                                    <td>
                                        <SecureButton ActionName="roledetails_removeuser" ScreenName="@PageName" FunctionName="RemoveUserFromRole"
                                                      ActionParams="@($"roleId={RoleId},userId={user.UserId}")"
                                                      OnClick="() => RemoveUser(user.UserId)" CssClass="btn-icon btn-danger" Title="הסר מתפקיד" HideIfNoAccess="true">
                                            <img src="/images/remove_icon.png" alt="הסר" class="action-icon-natural" />
                                        </SecureButton>
                                    </td>
                                    <td>@user.Username</td>
                                    <td>@user.FullName</td>
                                    <td>
                                        <span class="status-badge @(user.IsActive ? "status-active" : "status-inactive")">
                                            @(user.IsActive ? "פעיל" : "לא פעיל")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="add-item-row">
                    <h4>הוסף משתמש לתפקיד</h4>
                    <div class="inline-form">
                        <select class="form-control" @bind="_userToAdd">
                            <option value="0">— בחר משתמש —</option>
                            @foreach (var user in _availableUsers)
                            {
                                <option value="@user.UserId">@user.Username (@user.FullName)</option>
                            }
                        </select>
                        <SecureButton ActionName="roledetails_adduser" ScreenName="@PageName" FunctionName="AddUserToRole"
                                      OnClick="AddUser" CssClass="btn btn-primary" Disabled="@(_userToAdd == 0)">
                            הוסף
                        </SecureButton>
                    </div>
                </div>
            </div>

            @* ── Actions in role ────────────────────────────────────────────── *@
            <div class="content-card half-card">
                <div class="card-header-row">
                    <h3>הרשאות בתפקיד (@_role.Actions.Count)</h3>
                </div>

                @if (_role.Actions.Count == 0)
                {
                    <p class="no-data-message">לא הוגדרו הרשאות לתפקיד זה</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th>שם הרשאה</th>
                                <th>תיאור</th>
                                <th>מסך</th>
                                <th>סוג</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var action in _role.Actions.OrderBy(a => a.ActionReference).ThenBy(a => a.ActionName))
                            {
                                <tr>
                                    <td>
                                        <SecureButton ActionName="roledetails_removeaction" ScreenName="@PageName" FunctionName="RemoveActionFromRole"
                                                      ActionParams="@($"roleId={RoleId},actionId={action.ActionId}")"
                                                      OnClick="() => RemoveAction(action.ActionId)" CssClass="btn-icon btn-danger" Title="הסר הרשאה" HideIfNoAccess="true">
                                            <img src="/images/remove_icon.png" alt="הסר" class="action-icon-natural" />
                                        </SecureButton>
                                    </td>
                                    <td><code>@action.ActionName</code></td>
                                    <td>@action.ActionDisplayName</td>
                                    <td>@(action.ActionReference ?? "—")</td>
                                    <td>@action.ActionTypeName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <div class="add-item-row">
                    <h4>הוסף הרשאה לתפקיד</h4>
                    <div class="form-group">
                        <input type="text" class="form-control" @bind="_actionFilter" @bind:event="oninput" placeholder="חיפוש הרשאה..." />
                    </div>
                    <div class="inline-form">
                        <select class="form-control" size="6" @bind="_actionToAdd" style="height: 150px;">
                            @foreach (var action in FilteredAvailableActions)
                            {
                                <option value="@action.Id">[@action.ActionTypeName] @action.Name — @action.DisplayName</option>
                            }
                        </select>
                        <SecureButton ActionName="roledetails_addaction" ScreenName="@PageName" FunctionName="AddActionToRole"
                                      OnClick="AddAction" CssClass="btn btn-primary" Disabled="@(_actionToAdd == 0)">
                            הוסף
                        </SecureButton>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int RoleId { get; set; }

    protected override string PageName => "roledetails";

    private RoleDetailsDto? _role;
    private bool _isLoading = true;

    // Users
    private int _userToAdd = 0;
    private List<RoleUserDto> _availableUsers = new();

    // Actions
    private int _actionToAdd = 0;
    private List<AvailableActionDto> _availableActions = new();
    private string _actionFilter = string.Empty;

    private IEnumerable<AvailableActionDto> FilteredAvailableActions =>
        string.IsNullOrWhiteSpace(_actionFilter)
            ? _availableActions
            : _availableActions.Where(a =>
                a.Name.Contains(_actionFilter, StringComparison.OrdinalIgnoreCase) ||
                a.DisplayName.Contains(_actionFilter, StringComparison.OrdinalIgnoreCase) ||
                (a.Reference?.Contains(_actionFilter, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnPageInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
            await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            await Task.WhenAll(LoadRoleDetailsAsync(), LoadAvailableUsersAsync(), LoadAvailableActionsAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadRoleDetailsAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<RoleDetailsDto>>($"roles/{RoleId}");
            _role = response?.Data;
        }
        catch (Exception ex) { Console.WriteLine($"Error loading role: {ex.Message}"); }
    }

    private async Task LoadAvailableUsersAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<RoleUserDto>>>($"roles/available-users?roleId={RoleId}");
            _availableUsers = response?.Data ?? new();
        }
        catch (Exception ex) { Console.WriteLine($"Error loading available users: {ex.Message}"); }
    }

    private async Task LoadAvailableActionsAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<AvailableActionDto>>>($"roles/available-actions?roleId={RoleId}");
            _availableActions = (response?.Data ?? new()).Where(a => !a.IsAssigned).ToList();
        }
        catch (Exception ex) { Console.WriteLine($"Error loading available actions: {ex.Message}"); }
    }

    private async Task RemoveUser(int userId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "להסיר את המשתמש מהתפקיד?"))
            return;
        try
        {
            var response = await ApiService.DeleteAsync<ApiResponse<object>>($"roles/{RoleId}/users/{userId}");
            if (response?.Success == true) await LoadDataAsync();
            else await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}"); }
    }

    private async Task AddUser()
    {
        if (_userToAdd == 0) return;
        try
        {
            var response = await ApiService.PostAsync<object, ApiResponse<object>>(
                $"roles/{RoleId}/users", new { userId = _userToAdd });
            if (response?.Success == true) { _userToAdd = 0; await LoadDataAsync(); }
            else await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}"); }
    }

    private async Task RemoveAction(int actionId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "להסיר את ההרשאה מהתפקיד?"))
            return;
        try
        {
            var response = await ApiService.DeleteAsync<ApiResponse<object>>($"roles/{RoleId}/actions/{actionId}");
            if (response?.Success == true) await LoadDataAsync();
            else await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}"); }
    }

    private async Task AddAction()
    {
        if (_actionToAdd == 0) return;
        try
        {
            var response = await ApiService.PostAsync<object, ApiResponse<object>>(
                $"roles/{RoleId}/actions", new { actionId = _actionToAdd });
            if (response?.Success == true) { _actionToAdd = 0; await LoadDataAsync(); }
            else await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}"); }
    }

    private void NavigateBack() => Navigation.NavigateTo("/roles");
}
