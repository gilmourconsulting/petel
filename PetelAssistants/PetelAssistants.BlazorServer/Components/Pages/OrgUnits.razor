@page "/org-units"
@page "/year/{YearId:int}/org-units"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@using PetelAssistants.BlazorServer.Components.Modals
@inject ApiService ApiService

<div class="page-title-section">
    <h1 class="page-title">בתי ספר וגנים @(_yearName != "" ? $"- {_yearName}" : "")</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="org_units_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                      OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        @if (_effectiveYearId > 0 && _orgUnits.Count > 0)
        {
            <SecureButton ActionName="org_units_add" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                          OnClick="ShowCreateDialog" CssClass="context-btn">
                הוסף מוסד
            </SecureButton>
        }
        <SecureButton ActionName="org_units_back" ScreenName="@PageName" FunctionName="NavigateBack"
                      OnClick="NavigateBack" CssClass="context-navigation-btn">
            חזרה לניהול שנה
        </SecureButton>
    </div>

    <div class="students-content">
        <div class="content-card">
            <h2 class="page-title">רשימת מוסדות לשנה</h2>

            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else if (_effectiveYearId <= 0)
            {
                <div class="no-data-message">יש לבחור שנת לימודים</div>
            }
            else if (_orgUnits.Count == 0)
            {
                <div class="no-data-message" style="margin-bottom: 16px;">
                    אין מוסדות לשנה זו. ניתן להעתיק משנה קודמת או להעלות מקובץ בפעם הראשונה.
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
                    @if (_copyStatus?.CanCopy == true)
                    {
                        <SecureButton ActionName="org_units_copy_from_previous" ScreenName="@PageName" FunctionName="CopyFromPrevious"
                                      OnClick="CopyFromPrevious" CssClass="context-btn" HideIfNoAccess="true">
                            העתק משנת @_copyStatus.PreviousYearName
                        </SecureButton>
                    }
                    <SecureButton ActionName="org_units_upload" ScreenName="@PageName" FunctionName="ShowUpload"
                                  OnClick="ShowUpload" CssClass="context-btn" HideIfNoAccess="true">
                        העלאה מקובץ
                    </SecureButton>
                    <SecureButton ActionName="org_units_add" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                                  OnClick="ShowCreateDialog" CssClass="context-btn" HideIfNoAccess="true">
                        הוסף מוסד ידנית
                    </SecureButton>
                </div>
            }
            else
            {
                <div class="filter-bar" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: flex-end;">
                    <div class="form-group" style="margin-bottom: 0; flex: 1; min-width: 220px; max-width: 320px;">
                        <label style="font-size: 0.82em; font-weight: 600;">חיפוש לפי שם או סמל</label>
                        <input type="text" class="form-control" @bind="_filterText" @bind:event="oninput" placeholder="חיפוש..." />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">סוג</label>
                        <select class="form-control" style="min-width: 140px;" @bind="_filterType">
                            <option value="">הכל</option>
                            <option value="school">בית ספר</option>
                            <option value="kindergarten">גן ילדים</option>
                        </select>
                    </div>
                    @if (HasActiveFilters)
                    {
                        <button type="button" class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearFilters">נקה סינון</button>
                    }
                </div>

                @if (FilteredOrgUnits.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו מוסדות התואמים לסינון</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>פעולות</th>
                                    <th @onclick='() => SortTable(nameof(OrgUnitDto.Symbol))' style="cursor: pointer;">
                                        סמל מוסד @GetSortArrow(nameof(OrgUnitDto.Symbol))
                                    </th>
                                    <th @onclick='() => SortTable(nameof(OrgUnitDto.Name))' style="cursor: pointer;">
                                        שם @GetSortArrow(nameof(OrgUnitDto.Name))
                                    </th>
                                    <th @onclick='() => SortTable(nameof(OrgUnitDto.OrgUnitType))' style="cursor: pointer;">
                                        סוג @GetSortArrow(nameof(OrgUnitDto.OrgUnitType))
                                    </th>
                                    <th @onclick='() => SortTable(nameof(OrgUnitDto.SchoolLevel))' style="cursor: pointer;">
                                        רמה @GetSortArrow(nameof(OrgUnitDto.SchoolLevel))
                                    </th>
                                    <th>חינוך מיוחד</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unit in FilteredOrgUnits)
                                {
                                    <tr>
                                        <td class="actions-cell">
                                            <SecureButton ActionName="org_units_edit" ScreenName="@PageName" FunctionName="EditOrgUnit"
                                                          OnClick="() => ShowEditDialog(unit)" CssClass="btn-icon" Title="עריכה" HideIfNoAccess="true">
                                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural" />
                                            </SecureButton>
                                            <SecureButton ActionName="org_units_deactivate" ScreenName="@PageName" FunctionName="RemoveFromYear"
                                                          OnClick="() => RemoveFromYear(unit)" CssClass="btn-icon btn-danger" Title="הסר מהשנה" HideIfNoAccess="true">
                                                <img src="/images/deactivate_icon.png" alt="הסר" class="action-icon-natural" />
                                            </SecureButton>
                                        </td>
                                        <td>@(unit.Symbol ?? "—")</td>
                                        <td>@unit.Name</td>
                                        <td>@GetOrgUnitTypeLabel(unit.OrgUnitType)</td>
                                        <td>@SchoolLevelLabels.GetDisplayName(unit.SchoolLevel, unit.OrgUnitType)</td>
                                        <td>@(unit.IsSpecialEducation ? "כן" : "לא")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editUnit == null ? "הוספת מוסד לשנה" : "עריכת מוסד לשנה")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>סוג מוסד <span class="required">*</span></label>
                    <select class="form-control" @bind="_formOrgUnitType" @bind:after="OnTypeChanged">
                        <option value="school">בית ספר</option>
                        <option value="kindergarten">גן ילדים</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>סמל מוסד</label>
                    <input type="text" class="form-control" @bind="_formSymbol" placeholder="סמל מוסד" maxlength="20" />
                </div>
                <div class="form-group">
                    <label>שם <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="_formName" placeholder="שם המוסד" />
                </div>
                @if (_formOrgUnitType == "school")
                {
                    <div class="form-group">
                        <label>רמת בית ספר <span class="required">*</span></label>
                        <select class="form-control" @bind="_formSchoolLevel">
                            <option value="elementary">@SchoolLevelLabels.ElementaryDisplay</option>
                            <option value="high_school">@SchoolLevelLabels.HighSchoolDisplay</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    <label>
                        <input type="checkbox" @bind="_formIsSpecialEducation" />
                        חינוך מיוחד
                    </label>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveOrgUnit" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

<InstitutionRosterUploadModal @ref="_uploadModal" OnUploadCompleted="OnUploadCompleted" />

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "org_units";

    private int _effectiveYearId;
    private string _yearName = "";
    private List<OrgUnitDto> _orgUnits = new();
    private OrgUnitCopyStatusDto? _copyStatus;
    private bool _isLoading = true;
    private string _filterText = "";
    private string _filterType = "";
    private string _sortColumn = nameof(OrgUnitDto.Name);
    private bool _sortAscending = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private OrgUnitDto? _editUnit;
    private string _formName = string.Empty;
    private string _formSymbol = string.Empty;
    private string _formOrgUnitType = "school";
    private string _formSchoolLevel = "elementary";
    private bool _formIsSpecialEducation;
    private InstitutionRosterUploadModal? _uploadModal;

    protected override async Task OnPageInitializedAsync()
    {
        await ResolveYearAsync();
        if (_effectiveYearId > 0)
            await LoadDataAsync();
        else
            _isLoading = false;
    }

    private async Task ResolveYearAsync()
    {
        if (YearId > 0)
        {
            _effectiveYearId = YearId;
            await LoadYearNameAsync(_effectiveYearId);
            return;
        }

        try
        {
            var context = await ApiService.GetAsync<YearContextDto>("years/context");
            var currentId = context?.CurrentYear?.Id ?? 0;
            if (currentId > 0)
            {
                Navigation.NavigateTo($"/year/{currentId}/org-units", replace: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resolving current year: {ex.Message}");
        }

        _effectiveYearId = 0;
    }

    private async Task LoadYearNameAsync(int yearId)
    {
        try
        {
            var year = await ApiService.GetAsync<YearDto>($"years/{yearId}");
            _yearName = year?.YearName ?? "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading year name: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var listTask = ApiService.GetAsync<ApiResponse<List<OrgUnitDto>>>($"org-units?yearId={_effectiveYearId}");
            var copyTask = ApiService.GetAsync<ApiResponse<OrgUnitCopyStatusDto>>($"org-units/copy-status?yearId={_effectiveYearId}");
            await Task.WhenAll(listTask, copyTask);

            _orgUnits = listTask.Result?.Data ?? new();
            _copyStatus = copyTask.Result?.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading org units: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    private async Task OnUploadCompleted() => await LoadDataAsync();

    private void ShowUpload() => _uploadModal?.Show(_effectiveYearId, _yearName);

    private async Task CopyFromPrevious()
    {
        if (_copyStatus?.CanCopy != true)
            return;

        if (!await JSRuntime.InvokeAsync<bool>("confirm",
                $"להעתיק את רשימת המוסדות משנת {_copyStatus.PreviousYearName}?"))
            return;

        try
        {
            var response = await ApiService.PostAsync<object?, ApiResponse<object>>(
                $"org-units/copy-from-previous?yearId={_effectiveYearId}", null);
            if (response?.Success == true)
                await LoadDataAsync();
            else
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "העתקה נכשלה");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}");
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_filterText) ||
        !string.IsNullOrEmpty(_filterType);

    private void ClearFilters()
    {
        _filterText = "";
        _filterType = "";
    }

    private List<OrgUnitDto> FilteredOrgUnits
    {
        get
        {
            IEnumerable<OrgUnitDto> query = _orgUnits.Where(u =>
                (string.IsNullOrWhiteSpace(_filterText) ||
                 u.Name.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                 (u.Symbol?.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ?? false)) &&
                (string.IsNullOrEmpty(_filterType) || u.OrgUnitType == _filterType));

            query = _sortColumn switch
            {
                nameof(OrgUnitDto.Symbol) => _sortAscending
                    ? query.OrderBy(u => u.Symbol)
                    : query.OrderByDescending(u => u.Symbol),
                nameof(OrgUnitDto.OrgUnitType) => _sortAscending
                    ? query.OrderBy(u => u.OrgUnitType)
                    : query.OrderByDescending(u => u.OrgUnitType),
                nameof(OrgUnitDto.SchoolLevel) => _sortAscending
                    ? query.OrderBy(u => SchoolLevelLabels.GetDisplayName(u.SchoolLevel, u.OrgUnitType))
                    : query.OrderByDescending(u => SchoolLevelLabels.GetDisplayName(u.SchoolLevel, u.OrgUnitType)),
                _ => _sortAscending
                    ? query.OrderBy(u => u.Name)
                    : query.OrderByDescending(u => u.Name)
            };

            return query.ToList();
        }
    }

    private void SortTable(string columnName)
    {
        if (_sortColumn == columnName)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = columnName;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string columnName)
    {
        if (_sortColumn != columnName) return string.Empty;
        return _sortAscending ? "▲" : "▼";
    }

    private void ShowCreateDialog()
    {
        _editUnit = null;
        _formName = string.Empty;
        _formSymbol = string.Empty;
        _formOrgUnitType = "school";
        _formSchoolLevel = "elementary";
        _formIsSpecialEducation = false;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void ShowEditDialog(OrgUnitDto unit)
    {
        _editUnit = unit;
        _formName = unit.Name;
        _formSymbol = unit.Symbol ?? string.Empty;
        _formOrgUnitType = unit.OrgUnitType;
        _formSchoolLevel = unit.SchoolLevel ?? "elementary";
        _formIsSpecialEducation = unit.IsSpecialEducation;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void OnTypeChanged()
    {
        if (_formOrgUnitType != "school")
            _formSchoolLevel = "elementary";
    }

    private void CloseDialog()
    {
        _showFormDialog = false;
        _formError = string.Empty;
    }

    private async Task SaveOrgUnit()
    {
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "שם מוסד הוא שדה חובה";
            return;
        }

        if (_formOrgUnitType == "school" && string.IsNullOrWhiteSpace(_formSchoolLevel))
        {
            _formError = "יש לבחור רמת בית ספר";
            return;
        }

        _isSaving = true;
        _formError = string.Empty;

        try
        {
            ApiResponse<object>? response;

            if (_editUnit == null)
            {
                response = await ApiService.PostAsync<CreateOrgUnitRequest, ApiResponse<object>>(
                    $"org-units?yearId={_effectiveYearId}",
                    new CreateOrgUnitRequest
                    {
                        Name = _formName,
                        Symbol = string.IsNullOrWhiteSpace(_formSymbol) ? null : _formSymbol.Trim(),
                        OrgUnitType = _formOrgUnitType,
                        SchoolLevel = _formOrgUnitType == "school" ? _formSchoolLevel : null,
                        IsSpecialEducation = _formIsSpecialEducation
                    });
            }
            else
            {
                response = await ApiService.PutAsync<UpdateOrgUnitRequest, ApiResponse<object>>(
                    $"org-units/{_editUnit.Id}?yearId={_effectiveYearId}",
                    new UpdateOrgUnitRequest
                    {
                        Name = _formName,
                        Symbol = string.IsNullOrWhiteSpace(_formSymbol) ? null : _formSymbol.Trim(),
                        OrgUnitType = _formOrgUnitType,
                        SchoolLevel = _formOrgUnitType == "school" ? _formSchoolLevel : null,
                        IsSpecialEducation = _formIsSpecialEducation
                    });
            }

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירת המוסד";
            }
        }
        catch (Exception ex)
        {
            _formError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RemoveFromYear(OrgUnitDto unit)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"האם להסיר את '{unit.Name}' מרשימת השנה?"))
            return;

        var response = await ApiService.PutAsync<object, ApiResponse<object>>(
            $"org-units/{unit.Id}/remove-from-year?yearId={_effectiveYearId}", new { });
        if (response?.Success == true)
            await LoadDataAsync();
        else
            await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהסרת המוסד");
    }

    private static string GetOrgUnitTypeLabel(string type) => type switch
    {
        "school" => "בית ספר",
        "kindergarten" => "גן ילדים",
        _ => type
    };

    private void NavigateBack() =>
        Navigation.NavigateTo(_effectiveYearId > 0 ? $"/year/{_effectiveYearId}" : "/maindashboard");
}
