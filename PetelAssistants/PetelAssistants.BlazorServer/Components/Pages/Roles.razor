@page "/roles"
@layout MainLayout
@inherits SecurePageBase
@inject ApiService ApiService

<div class="school-title-section">
    <h1 class="page-title">ניהול תפקידים</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="roles_refresh" ScreenName="@PageName" FunctionName="RefreshData" OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <SecureButton ActionName="roles_create" ScreenName="@PageName" FunctionName="ShowCreateDialog" OnClick="ShowCreateDialog" CssClass="context-btn">
            הוסף תפקיד חדש
        </SecureButton>
        <SecureButton ActionName="roles_users" ScreenName="@PageName" FunctionName="NavigateToUsers" OnClick="NavigateToUsers" CssClass="context-navigation-btn">
            ניהול משתמשים
        </SecureButton>
        <SecureButton ActionName="roles_maindashboard" ScreenName="@PageName" FunctionName="NavigateToMainDashboard" OnClick="NavigateToMainDashboard" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
    </div>

    <div class="students-content">
        <TenantSelector TenantChanged="OnTenantChanged" />

        <div class="content-card">
            <h2 class="page-title">רשימת תפקידים</h2>

            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתוני תפקידים...</div>
            }
            else if (_roles.Count == 0)
            {
                <div class="no-data-message">לא נמצאו תפקידים ברשות זו</div>
            }
            else
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th @onclick="() => SortTable(nameof(RoleDto.Name))" style="cursor: pointer;">
                                    שם תפקיד @GetSortArrow(nameof(RoleDto.Name))
                                </th>
                                <th @onclick="() => SortTable(nameof(RoleDto.Description))" style="cursor: pointer;">
                                    תיאור @GetSortArrow(nameof(RoleDto.Description))
                                </th>
                                <th @onclick="() => SortTable(nameof(RoleDto.UserCount))" style="cursor: pointer;">
                                    משתמשים @GetSortArrow(nameof(RoleDto.UserCount))
                                </th>
                                <th @onclick="() => SortTable(nameof(RoleDto.ActionCount))" style="cursor: pointer;">
                                    הרשאות @GetSortArrow(nameof(RoleDto.ActionCount))
                                </th>
                                <th @onclick="() => SortTable(nameof(RoleDto.CreatedAt))" style="cursor: pointer;">
                                    נוצר @GetSortArrow(nameof(RoleDto.CreatedAt))
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in _roles)
                            {
                                <tr>
                                    <td class="actions-cell">
                                        <SecureButton ActionName="roles_viewdetails" ScreenName="@PageName" FunctionName="ViewRoleDetails"
                                                      ActionParams="@($"roleId={role.Id}")"
                                                      OnClick="() => ViewRoleDetails(role.Id)" CssClass="btn-icon" Title="פרטי תפקיד">
                                            <img src="/images/view_icon.png" alt="פרטים" class="action-icon-natural" />
                                        </SecureButton>
                                        <SecureButton ActionName="roles_edit" ScreenName="@PageName" FunctionName="EditRole"
                                                      ActionParams="@($"roleId={role.Id}")"
                                                      OnClick="() => ShowEditDialog(role)" CssClass="btn-icon" Title="עריכה">
                                            <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural" />
                                        </SecureButton>
                                        <SecureButton ActionName="roles_manageusers" ScreenName="@PageName" FunctionName="ManageRoleUsers"
                                                      ActionParams="@($"roleId={role.Id}")"
                                                      OnClick="() => ManageRoleUsers(role.Id)" CssClass="btn-icon" Title="נהל משתמשים">
                                            <img src="/images/stats_icon.png" alt="משתמשים" class="action-icon-natural" />
                                        </SecureButton>
                                        <SecureButton ActionName="roles_delete" ScreenName="@PageName" FunctionName="DeleteRole"
                                                      ActionParams="@($"roleId={role.Id}")"
                                                      OnClick="() => DeleteRole(role)" CssClass="btn-icon btn-danger" Title="מחיקה">
                                            <img src="/images/delete_icon.png" alt="מחיקה" class="action-icon-natural" />
                                        </SecureButton>
                                    </td>
                                    <td>@role.Name</td>
                                    <td>@(role.Description ?? "—")</td>
                                    <td>@role.UserCount</td>
                                    <td>@role.ActionCount</td>
                                    <td>@role.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────── *@
@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editRole == null ? "הוספת תפקיד חדש" : "עריכת תפקיד")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>שם תפקיד <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="_formName" placeholder="שם תפקיד" />
                </div>
                <div class="form-group">
                    <label>תיאור</label>
                    <textarea class="form-control" @bind="_formDescription" rows="3" placeholder="תיאור אופציונלי"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveRole" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "roles";

    private List<RoleDto> _roles = new();
    private bool _isLoading = true;
    private bool _showFormDialog = false;
    private bool _isSaving = false;
    private string _formError = string.Empty;
    private RoleDto? _editRole;
    private string _formName = string.Empty;
    private string? _formDescription;

    private string _sortColumn = nameof(RoleDto.Name);
    private bool _sortAscending = true;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<RoleDto>>>("roles");
            _roles = response?.Data ?? new();
            ApplySort();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading roles: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SortTable(string columnName)
    {
        if (_sortColumn == columnName)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = columnName;
            _sortAscending = true;
        }
        ApplySort();
    }

    private void ApplySort()
    {
        _roles = _sortColumn switch
        {
            nameof(RoleDto.Name) => _sortAscending
                ? _roles.OrderBy(r => r.Name).ToList()
                : _roles.OrderByDescending(r => r.Name).ToList(),
            nameof(RoleDto.Description) => _sortAscending
                ? _roles.OrderBy(r => r.Description ?? "").ToList()
                : _roles.OrderByDescending(r => r.Description ?? "").ToList(),
            nameof(RoleDto.UserCount) => _sortAscending
                ? _roles.OrderBy(r => r.UserCount).ToList()
                : _roles.OrderByDescending(r => r.UserCount).ToList(),
            nameof(RoleDto.ActionCount) => _sortAscending
                ? _roles.OrderBy(r => r.ActionCount).ToList()
                : _roles.OrderByDescending(r => r.ActionCount).ToList(),
            nameof(RoleDto.CreatedAt) => _sortAscending
                ? _roles.OrderBy(r => r.CreatedAt).ToList()
                : _roles.OrderByDescending(r => r.CreatedAt).ToList(),
            _ => _roles
        };
    }

    private string GetSortArrow(string columnName)
    {
        if (_sortColumn != columnName) return string.Empty;
        return _sortAscending ? "▲" : "▼";
    }

    private async Task RefreshData() => await LoadDataAsync();

    private async Task OnTenantChanged(int tenantId) => await LoadDataAsync();

    private void ShowCreateDialog()
    {
        _editRole = null;
        _formName = string.Empty;
        _formDescription = null;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void ShowEditDialog(RoleDto role)
    {
        _editRole = role;
        _formName = role.Name;
        _formDescription = role.Description;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog() { _showFormDialog = false; _formError = string.Empty; }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "שם תפקיד הוא שדה חובה"; return; }
        _isSaving = true; _formError = string.Empty;
        try
        {
            ApiResponse<object>? response;
            if (_editRole == null)
                response = await ApiService.PostAsync<CreateRoleRequest, ApiResponse<object>>(
                    "roles", new CreateRoleRequest { Name = _formName, Description = _formDescription });
            else
                response = await ApiService.PutAsync<UpdateRoleRequest, ApiResponse<object>>(
                    $"roles/{_editRole.Id}", new UpdateRoleRequest { Name = _formName, Description = _formDescription });

            if (response?.Success == true) { CloseDialog(); await LoadDataAsync(); }
            else _formError = response?.Message ?? "שגיאה בשמירת התפקיד";
        }
        catch (Exception ex) { _formError = $"שגיאה: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private async Task DeleteRole(RoleDto role)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"למחוק את התפקיד '{role.Name}'?"))
            return;
        try
        {
            var response = await ApiService.DeleteAsync<ApiResponse<object>>($"roles/{role.Id}");
            if (response?.Success == true) await LoadDataAsync();
            else await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה במחיקת התפקיד");
        }
        catch (Exception ex) { await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}"); }
    }

    private void ViewRoleDetails(int roleId) => Navigation.NavigateTo($"/roledetails/{roleId}");
    private void ManageRoleUsers(int roleId) => Navigation.NavigateTo($"/roledetails/{roleId}");
    private void NavigateToUsers() => Navigation.NavigateTo("/users");
    private void NavigateToMainDashboard() => Navigation.NavigateTo("/maindashboard");
}
