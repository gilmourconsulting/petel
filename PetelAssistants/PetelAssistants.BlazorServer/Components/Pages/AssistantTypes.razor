@page "/assistant-types"
@layout MainLayout
@inherits SecurePageBase

@code {
    protected override string PageName => "system_data";
    protected override bool EnforcePageAccess => false;

    protected override Task OnPageInitializedAsync()
    {
        Navigation.NavigateTo("/system-data?tab=assistant-types", replace: true);
        return Task.CompletedTask;
    }
}
