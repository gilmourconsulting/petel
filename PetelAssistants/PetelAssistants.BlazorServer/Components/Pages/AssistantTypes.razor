@page "/assistant-types"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="school-title-section">
    <h1 class="page-title">ניהול סוגי סייעות</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="assistant_types_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                      OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <SecureButton ActionName="assistant_types_add" ScreenName="@PageName" FunctionName="ShowCreateDialog"
                      OnClick="ShowCreateDialog" CssClass="context-btn">
            הוסף סוג
        </SecureButton>
        <SecureButton ActionName="assistant_types_back" ScreenName="@PageName" FunctionName="NavigateBack"
                      OnClick="NavigateBack" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
    </div>

    <div class="content-card">
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען...</div>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>פעולות</th>
                            <th>שם תצוגה</th>
                            <th>קוד</th>
                            <th>סדר</th>
                            <th>סטטוס</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in _types)
                        {
                            <tr class="@(type.IsActive ? "" : "row-inactive")">
                                <td>
                                    <SecureButton ActionName="assistant_types_edit" ScreenName="@PageName" FunctionName="EditType"
                                                  OnClick="() => ShowEditDialog(type)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                        <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                    </SecureButton>
                                </td>
                                <td>@type.DisplayName</td>
                                <td>@type.Name</td>
                                <td>@type.SortOrder</td>
                                <td>@(type.IsActive ? "פעיל" : "לא פעיל")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editType == null ? "הוספת סוג סייעת" : "עריכת סוג סייעת")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                @if (_editType == null)
                {
                    <div class="form-group">
                        <label>קוד (אנגלית) <span class="required">*</span></label>
                        <input class="form-control" @bind="_formName" placeholder="class_help" />
                    </div>
                }
                <div class="form-group">
                    <label>שם תצוגה <span class="required">*</span></label>
                    <input class="form-control" @bind="_formDisplayName" />
                </div>
                <div class="form-group">
                    <label>תיאור</label>
                    <input class="form-control" @bind="_formDescription" />
                </div>
                <div class="form-group">
                    <label>סדר</label>
                    <InputNumber class="form-control" @bind-Value="_formSortOrder" />
                </div>
                @if (_editType != null)
                {
                    <div class="form-group">
                        <label>
                            <input type="checkbox" @bind="_formIsActive" /> פעיל
                        </label>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveType" disabled="@_isSaving">@(_isSaving ? "שומר..." : "שמור")</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "assistant_types";

    private List<AssistantTypeDto> _types = new();
    private bool _isLoading = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private AssistantTypeDto? _editType;
    private string _formName = string.Empty;
    private string _formDisplayName = string.Empty;
    private string? _formDescription;
    private int _formSortOrder;
    private bool _formIsActive = true;

    protected override async Task OnPageInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        var response = await ApiService.GetAsync<ApiResponse<List<AssistantTypeDto>>>("assistant-types?includeInactive=true");
        _types = response?.Data ?? new();
        _isLoading = false;
    }

    private async Task RefreshData() => await LoadDataAsync();

    private void ShowCreateDialog()
    {
        _editType = null;
        _formName = string.Empty;
        _formDisplayName = string.Empty;
        _formDescription = null;
        _formSortOrder = 0;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void ShowEditDialog(AssistantTypeDto type)
    {
        _editType = type;
        _formDisplayName = type.DisplayName;
        _formDescription = type.Description;
        _formSortOrder = type.SortOrder;
        _formIsActive = type.IsActive;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog() => _showFormDialog = false;

    private async Task SaveType()
    {
        _isSaving = true;
        _formError = string.Empty;

        try
        {
            ApiResponse<object>? response;

            if (_editType == null)
            {
                response = await ApiService.PostAsync<CreateAssistantTypeRequest, ApiResponse<object>>(
                    "assistant-types",
                    new CreateAssistantTypeRequest
                    {
                        Name = _formName,
                        DisplayName = _formDisplayName,
                        Description = _formDescription,
                        SortOrder = _formSortOrder
                    });
            }
            else
            {
                response = await ApiService.PutAsync<UpdateAssistantTypeRequest, ApiResponse<object>>(
                    $"assistant-types/{_editType.Id}",
                    new UpdateAssistantTypeRequest
                    {
                        DisplayName = _formDisplayName,
                        Description = _formDescription,
                        SortOrder = _formSortOrder,
                        IsActive = _formIsActive
                    });
            }

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo("/maindashboard");
}
