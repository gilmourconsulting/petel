@page "/year/{YearId:int}/yearly-budget"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="yearly_budget_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן
    </SecureButton>

    @if (_budget?.CanEdit == true)
    {
        <SecureButton ActionName="yearly_budget_calculate" ScreenName="@PageName" FunctionName="CalculateBudget"
                      OnClick="CalculateBudget" CssClass="context-btn" HideIfNoAccess="true">
            חשב תקציב
        </SecureButton>
        <SecureButton ActionName="yearly_budget_save" ScreenName="@PageName" FunctionName="SaveBudget"
                      OnClick="SaveBudget" CssClass="context-btn" HideIfNoAccess="true">
            שמור
        </SecureButton>
        <SecureButton ActionName="yearly_budget_lock" ScreenName="@PageName" FunctionName="LockBudget"
                      OnClick="LockBudget" CssClass="context-btn" HideIfNoAccess="true">
            נעילה
        </SecureButton>

        @if (MissingAssistantTypes.Count > 0)
        {
            <SecureButton ActionName="yearly_budget_add_types" ScreenName="@PageName" FunctionName="ShowAddAssistantTypesModal"
                          OnClick="ShowAddAssistantTypesModal" CssClass="context-btn" HideIfNoAccess="true">
                הוסף סוג סייעת
            </SecureButton>
        }
    }

    @if (_budget?.CanCreateNewVersion == true)
    {
        <SecureButton ActionName="yearly_budget_new_version" ScreenName="@PageName" FunctionName="CreateNewVersion"
                      OnClick="CreateNewVersion" CssClass="context-btn" HideIfNoAccess="true">
            גרסה חדשה
        </SecureButton>
    }

    @if (_budget?.CanDelete == true)
    {
        <SecureButton ActionName="yearly_budget_delete" ScreenName="@PageName" FunctionName="DeleteBudget"
                      OnClick="DeleteBudget" CssClass="context-btn" HideIfNoAccess="true">
            מחיקה
        </SecureButton>
    }

    <SecureButton ActionName="yearly_budget_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">תקציב שנתי@(!string.IsNullOrEmpty(_yearName) ? $" — {_yearName}" : "")</h1>
        </div>

        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען...</div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-message">@_error</div>
            }
            else if (_budget != null && _budget.Id == 0)
            {
                <div style="color: var(--text-muted);">
                    אין עדיין גרסת תקציב לשנה זו. לחץ על <strong>גרסה חדשה</strong> ליצירת גרסה 0.
                </div>
            }
            else if (_budget != null)
            {
                <div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; margin-bottom: 20px;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">גרסה</label>
                        <select class="form-control" style="min-width: 220px;"
                                value="@_budget.Id"
                                @onchange="OnVersionChanged">
                            @foreach (var v in _budget.Versions)
                            {
                                <option value="@v.Id">@FormatVersionOption(v)</option>
                            }
                        </select>
                    </div>
                    <div style="padding-bottom: 6px;">
                        <span style="font-weight: 600;">סטטוס:</span> @StatusLabel(_budget.Status)
                        @if (_budget.IsLastVersion)
                        {
                            <span style="color: var(--text-muted); margin-inline-start: 8px;">(אחרונה)</span>
                        }
                    </div>
                </div>

                <h2 style="font-size: 1.15em; margin-bottom: 12px;">פירוט שנתי</h2>
                <div class="yearly-budget-year-scroll">
                    <table class="data-table yearly-budget-year-table">
                        <thead>
                            <tr>
                                <th>סוג סייעת</th>
                                <th>משרות</th>
                                <th>שעות</th>
                                <th>סכום</th>
                                <th>הערות</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in _editDetails)
                            {
                                <tr>
                                    <td>@detail.AssistantTypeName</td>
                                    @if (_budget.CanEdit)
                                    {
                                        <td>
                                            <input type="number" class="form-control" step="0.01" min="0"
                                                   @bind="detail.Fte" @bind:event="onchange" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control" step="0.01" min="0"
                                                   @bind="detail.Hours" @bind:event="onchange" />
                                        </td>
                                        <td>
                                            <input type="number" class="form-control" step="0.01" min="0"
                                                   @bind="detail.Amount" @bind:event="onchange" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control remarks-input"
                                                   @bind="detail.Remarks" @bind:event="onchange" />
                                        </td>
                                    }
                                    else
                                    {
                                        <td>@detail.Fte.ToString("N2")</td>
                                        <td>@detail.Hours.ToString("N2")</td>
                                        <td>@detail.Amount.ToString("N2")</td>
                                        <td>@(detail.Remarks ?? "—")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h2 style="font-size: 1.15em; margin: 28px 0 12px;">פירוט חודשי</h2>
                <p style="color: var(--text-muted); font-size: 0.9em; margin-bottom: 12px;">
                    ערכי החודשים מחולקים באופן שווה לפי חודשי השנה העברית (לקריאה בלבד).
                </p>

                @if (MonthColumns.Count == 0 || AssistantTypeRows.Count == 0)
                {
                    <div>אין נתונים חודשיים.</div>
                }
                else
                {
                    <div class="table-container monthly-budget-scroll">
                        <table class="data-table monthly-budget-matrix">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="monthly-budget-sticky">סוג סייעת</th>
                                    @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                    {
                                        var month = MonthColumns[mi];
                                        <th colspan="3" class="@(mi > 0 ? "month-separator" : null)" style="text-align: center; white-space: nowrap;">
                                            @GetMonthLabel(month.PeriodMonth)
                                            <span class="month-year"> @month.PeriodYear</span>
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                    {
                                        <th class="metric-header @(mi > 0 ? "month-separator" : null)">משרות</th>
                                        <th class="metric-header">שעות</th>
                                        <th class="metric-header">סכום</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var type in AssistantTypeRows)
                                {
                                    <tr>
                                        <td class="monthly-budget-sticky type-name">@type.AssistantTypeName</td>
                                        @for (var mi = 0; mi < MonthColumns.Count; mi++)
                                        {
                                            var month = MonthColumns[mi];
                                            var cell = GetMonthCell(type.AssistantTypeId, month.PeriodYear, month.PeriodMonth);
                                            var sep = mi > 0 ? "month-separator" : null;
                                            @if (cell != null)
                                            {
                                                <td class="@sep" style="text-align: center; white-space: nowrap;" title="@(cell.Remarks ?? "")">@cell.Fte.ToString("N2")</td>
                                                <td style="text-align: center; white-space: nowrap;" title="@(cell.Remarks ?? "")">@cell.Hours.ToString("N2")</td>
                                                <td style="text-align: center; white-space: nowrap;" title="@(cell.Remarks ?? "")">@cell.Amount.ToString("N2")</td>
                                            }
                                            else
                                            {
                                                <td class="@sep" style="text-align: center; color: var(--text-muted);">—</td>
                                                <td style="text-align: center; color: var(--text-muted);">—</td>
                                                <td style="text-align: center; color: var(--text-muted);">—</td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (_showCalculateResult)
{
    <div class="modal-overlay" @onclick="CloseCalculateResult">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 720px;">
            <div class="modal-header">
                <h3>תוצאות חישוב תקציב</h3>
                <button class="modal-close" @onclick="CloseCalculateResult">✕</button>
            </div>
            <div class="modal-body">
                @if (_calculateResult != null)
                {
                    <p>
                        זכאויות שנבדקו: @_calculateResult.EntitlementCount |
                        חושבו בהצלחה: @_calculateResult.SuccessCount |
                        שעות תקציב: @_calculateResult.TotalHours.ToString("N2") |
                        סכום: @_calculateResult.TotalAmount.ToString("N2") ₪
                    </p>

                    @if (_calculateResult.Failures.Count == 0)
                    {
                        <div style="color: var(--text-muted);">כל הזכאויות חושבו בהצלחה.</div>
                    }
                    else
                    {
                        <h4 style="margin: 16px 0 8px;">כשלונות חישוב (@_calculateResult.Failures.Count)</h4>
                        <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>מזהה זכאות</th>
                                        <th>מוסד</th>
                                        <th>כיתה</th>
                                        <th>סיבה</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var failure in _calculateResult.Failures)
                                    {
                                        <tr>
                                            <td>@failure.EntitlementId</td>
                                            <td>@(failure.InstitutionName ?? "—")</td>
                                            <td>@(failure.ClassName ?? "—")</td>
                                            <td>@failure.Reason</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="CloseCalculateResult">סגור</button>
            </div>
        </div>
    </div>
}

@if (_showAddTypesModal)
{
    <div class="modal-overlay" @onclick="CloseAddTypesModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>הוספת סוגי סייעת לתקציב</h3>
                <button class="modal-close" @onclick="CloseAddTypesModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (MissingAssistantTypes.Count == 0)
                {
                    <div style="color: var(--text-muted);">כל סוגי הסייעת הפעילים כבר כלולים בתקציב.</div>
                }
                else
                {
                    @foreach (var type in MissingAssistantTypes)
                    {
                        <div class="form-group" style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="@("addtype_" + type.Id)"
                                   checked="@_selectedTypeIdsToAdd.Contains(type.Id)"
                                   @onchange="e => ToggleTypeSelection(type.Id, (bool)(e.Value ?? false))" />
                            <label for="@("addtype_" + type.Id)">@type.DisplayName</label>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAddTypesModal">ביטול</button>
                <button class="btn btn-primary" @onclick="ConfirmAddAssistantTypes" disabled="@(_selectedTypeIdsToAdd.Count == 0)">הוסף</button>
            </div>
        </div>
    </div>
}

<style>
    .monthly-budget-scroll {
        overflow-x: auto;
        overflow-y: visible;
        max-width: 100%;
        -webkit-overflow-scrolling: touch;
    }

    .monthly-budget-matrix {
        width: max-content;
        min-width: 100%;
        font-size: 1em !important;
        border-collapse: separate;
        border-spacing: 0;
    }

    .monthly-budget-matrix th,
    .monthly-budget-matrix td {
        padding: 12px 14px !important;
        font-size: 1em !important;
        line-height: 1.35 !important;
    }

    .monthly-budget-matrix .metric-header {
        text-align: center;
        font-weight: 500;
        font-size: 0.95em !important;
        white-space: nowrap;
        min-width: 88px;
    }

    .monthly-budget-matrix .month-year {
        font-weight: 400;
        font-size: 0.9em;
        color: var(--text-muted);
    }

    .monthly-budget-matrix .month-separator {
        border-inline-start: 2px solid var(--border-color, #c8c8c8) !important;
    }

    .monthly-budget-matrix thead .month-separator {
        border-inline-start: 2px solid rgba(255, 255, 255, 0.45) !important;
    }

    .monthly-budget-matrix .monthly-budget-sticky {
        position: sticky;
        inset-inline-start: 0;
        z-index: 2;
        min-width: 160px;
        vertical-align: middle;
        background: var(--table-header-background, #fff);
    }

    .monthly-budget-matrix tbody .monthly-budget-sticky {
        background: #fff;
        z-index: 1;
        box-shadow: -2px 0 4px rgba(0, 0, 0, 0.04);
    }

    .monthly-budget-matrix tbody tr:hover .monthly-budget-sticky {
        background: var(--hover-background, #f5f5f5);
    }

    .monthly-budget-matrix .type-name {
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "yearly_budget";

    private bool _isLoading = true;
    private string _error = "";
    private string _yearName = "";
    private YearlyBudgetDto? _budget;
    private List<YearlyBudgetDetailDto> _editDetails = new();
    private bool _showCalculateResult;
    private CalculateYearlyBudgetResultDto? _calculateResult;
    private List<AssistantTypeDto> _assistantTypes = new();
    private bool _showAddTypesModal;
    private HashSet<int> _selectedTypeIdsToAdd = new();

    private List<AssistantTypeDto> MissingAssistantTypes =>
        _assistantTypes.Where(t => !_editDetails.Any(d => d.AssistantTypeId == t.Id)).ToList();

    private List<(int PeriodYear, int PeriodMonth)> MonthColumns =>
        (_budget?.MonthDetails ?? new List<YearlyBudgetMonthDetailDto>())
            .Select(m => (m.PeriodYear, m.PeriodMonth))
            .Distinct()
            .OrderBy(m => m.PeriodYear)
            .ThenBy(m => m.PeriodMonth)
            .ToList();

    private List<(int AssistantTypeId, string AssistantTypeName)> AssistantTypeRows =>
        (_budget?.MonthDetails ?? new List<YearlyBudgetMonthDetailDto>())
            .GroupBy(m => new { m.AssistantTypeId, m.AssistantTypeName })
            .OrderBy(g => g.Key.AssistantTypeName)
            .Select(g => (g.Key.AssistantTypeId, g.Key.AssistantTypeName))
            .ToList();

    private YearlyBudgetMonthDetailDto? GetMonthCell(int assistantTypeId, int periodYear, int periodMonth) =>
        _budget?.MonthDetails.FirstOrDefault(m =>
            m.AssistantTypeId == assistantTypeId &&
            m.PeriodYear == periodYear &&
            m.PeriodMonth == periodMonth);

    protected override async Task OnPageInitializedAsync()
    {
        await LoadYearNameAsync();
        await LoadAssistantTypesAsync();
        await LoadLastBudgetAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await LoadYearNameAsync();
            await LoadLastBudgetAsync();
        }
    }

    private async Task RefreshData()
    {
        if (_budget != null)
            await LoadBudgetByIdAsync(_budget.Id);
        else
            await LoadLastBudgetAsync();
    }

    private async Task LoadYearNameAsync()
    {
        try
        {
            var year = await ApiService.GetAsync<YearDto>($"years/{YearId}");
            _yearName = year?.YearName ?? "";
        }
        catch
        {
            _yearName = "";
        }
    }

    private async Task LoadAssistantTypesAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<AssistantTypeDto>>>("assistant-types");
            _assistantTypes = response?.Data ?? new();
        }
        catch
        {
            _assistantTypes = new();
        }
    }

    private void ShowAddAssistantTypesModal()
    {
        _selectedTypeIdsToAdd = new();
        _showAddTypesModal = true;
    }

    private void CloseAddTypesModal()
    {
        _showAddTypesModal = false;
    }

    private void ToggleTypeSelection(int typeId, bool isChecked)
    {
        if (isChecked)
            _selectedTypeIdsToAdd.Add(typeId);
        else
            _selectedTypeIdsToAdd.Remove(typeId);
    }

    private void ConfirmAddAssistantTypes()
    {
        foreach (var typeId in _selectedTypeIdsToAdd)
        {
            var type = _assistantTypes.FirstOrDefault(t => t.Id == typeId);
            if (type == null || _editDetails.Any(d => d.AssistantTypeId == typeId))
                continue;

            _editDetails.Add(new YearlyBudgetDetailDto
            {
                AssistantTypeId = type.Id,
                AssistantTypeName = type.DisplayName,
                Fte = 0,
                Hours = 0,
                Amount = 0,
                Remarks = null
            });
        }

        var sortOrder = _assistantTypes.ToDictionary(t => t.Id, t => t.SortOrder);
        _editDetails = _editDetails
            .OrderBy(d => sortOrder.TryGetValue(d.AssistantTypeId, out var order) ? order : int.MaxValue)
            .ThenBy(d => d.AssistantTypeName)
            .ToList();

        _showAddTypesModal = false;
    }

    private async Task LoadLastBudgetAsync()
    {
        _isLoading = true;
        _error = "";
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets?yearId={YearId}");
            if (response?.Success == true && response.Data != null)
            {
                ApplyBudget(response.Data);
            }
            else
            {
                _budget = null;
                _editDetails = new();
                _error = response?.Message ?? "שגיאה בטעינת התקציב";
            }
        }
        catch (Exception ex)
        {
            _budget = null;
            _editDetails = new();
            _error = $"שגיאה בטעינת התקציב: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadBudgetByIdAsync(int id)
    {
        _isLoading = true;
        _error = "";
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets/{id}");
            if (response?.Success == true && response.Data != null)
            {
                ApplyBudget(response.Data);
            }
            else
            {
                _error = response?.Message ?? "שגיאה בטעינת הגרסה";
            }
        }
        catch (Exception ex)
        {
            _error = $"שגיאה בטעינת הגרסה: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyBudget(YearlyBudgetDto data)
    {
        _budget = data;
        _editDetails = data.Details.Select(d => new YearlyBudgetDetailDto
        {
            Id = d.Id,
            AssistantTypeId = d.AssistantTypeId,
            AssistantTypeName = d.AssistantTypeName,
            Fte = d.Fte,
            Hours = d.Hours,
            Amount = d.Amount,
            Remarks = d.Remarks
        }).ToList();
    }

    private async Task OnVersionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
            await LoadBudgetByIdAsync(id);
    }

    private async Task SaveBudget()
    {
        if (_budget == null || !_budget.CanEdit)
            return;

        try
        {
            var request = new UpdateYearlyBudgetRequest
            {
                Details = _editDetails.Select(d => new UpdateYearlyBudgetDetailRequest
                {
                    AssistantTypeId = d.AssistantTypeId,
                    Fte = d.Fte,
                    Hours = d.Hours,
                    Amount = d.Amount,
                    Remarks = d.Remarks
                }).ToList()
            };

            var response = await ApiService.PutAsync<UpdateYearlyBudgetRequest, ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets/{_budget.Id}", request);

            if (response?.Success == true && response.Data != null)
            {
                ApplyBudget(response.Data);
                await JSRuntime.InvokeVoidAsync("alert", "התקציב נשמר בהצלחה");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בשמירה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירה: {ex.Message}");
        }
    }

    private async Task CalculateBudget()
    {
        if (_budget == null || !_budget.CanEdit)
            return;

        try
        {
            var response = await ApiService.PostAsync<object, ApiResponse<CalculateYearlyBudgetResultDto>>(
                $"yearly-budgets/{_budget.Id}/calculate", new { });

            if (response?.Success == true && response.Data != null)
            {
                _calculateResult = response.Data;
                ApplyBudget(response.Data.Budget);
                _showCalculateResult = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בחישוב");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בחישוב: {ex.Message}");
        }
    }

    private void CloseCalculateResult()
    {
        _showCalculateResult = false;
    }

    private async Task LockBudget()
    {
        if (_budget == null || !_budget.CanLock)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם לנעול את גרסת התקציב? לא ניתן יהיה לערוך אותה לאחר הנעילה.");
        if (!confirmed)
            return;

        try
        {
            var response = await ApiService.PutAsync<object, ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets/{_budget.Id}/lock", new { });

            if (response?.Success == true && response.Data != null)
            {
                ApplyBudget(response.Data);
                await JSRuntime.InvokeVoidAsync("alert", "התקציב ננעל");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בנעילה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בנעילה: {ex.Message}");
        }
    }

    private async Task CreateNewVersion()
    {
        if (_budget == null || !_budget.CanCreateNewVersion)
            return;

        try
        {
            var response = await ApiService.PostAsync<object, ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets/new-version?yearId={YearId}", new { });

            if (response?.Success == true && response.Data != null)
            {
                ApplyBudget(response.Data);
                await JSRuntime.InvokeVoidAsync("alert", $"נוצרה גרסה {_budget.Version}");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה ביצירת גרסה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה ביצירת גרסה: {ex.Message}");
        }
    }

    private async Task DeleteBudget()
    {
        if (_budget == null || !_budget.CanDelete)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם למחוק את גרסת התקציב?");
        if (!confirmed)
            return;

        try
        {
            var response = await ApiService.PutAsync<object, ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets/{_budget.Id}/delete", new { });

            if (response?.Success == true)
            {
                if (response.Data != null)
                {
                    ApplyBudget(response.Data);
                }
                else
                {
                    await LoadLastBudgetAsync();
                }
                await JSRuntime.InvokeVoidAsync("alert", "הגרסה נמחקה");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה במחיקה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה במחיקה: {ex.Message}");
        }
    }

    private void NavigateBack() => Navigation.NavigateTo($"/year/{YearId}");

    private static string StatusLabel(string status) => status switch
    {
        "open" => "פתוח",
        "locked" => "נעול",
        "deleted" => "מחוק",
        _ => status
    };

    private static string FormatVersionOption(YearlyBudgetVersionItemDto v)
    {
        var label = $"גרסה {v.Version} — {StatusLabel(v.Status)}";
        if (v.IsLastVersion)
            label += " (אחרונה)";
        return label;
    }

    private static string GetMonthLabel(int month) => month switch
    {
        1 => "ינואר",
        2 => "פברואר",
        3 => "מרץ",
        4 => "אפריל",
        5 => "מאי",
        6 => "יוני",
        7 => "יולי",
        8 => "אוגוסט",
        9 => "ספטמבר",
        10 => "אוקטובר",
        11 => "נובמבר",
        12 => "דצמבר",
        _ => month.ToString()
    };
