@page "/hebrew-years"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="school-title-section">
    <h1 class="page-title">ניהול שנות לימודים</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="hebrew_years_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                      OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <SecureButton ActionName="hebrew_years_back" ScreenName="@PageName" FunctionName="NavigateBack"
                      OnClick="NavigateBack" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
    </div>

    <div class="content-card">
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען...</div>
        }
        else
        {
            <div class="table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>פעולות</th>
                            <th>שנה</th>
                            <th>תאריך התחלה</th>
                            <th>תאריך סיום</th>
                            <th>נוכחית</th>
                            <th>קודמת</th>
                            <th>פעילה</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var year in _years)
                        {
                            <tr>
                                <td>
                                    <SecureButton ActionName="hebrew_years_edit" ScreenName="@PageName" FunctionName="EditYear"
                                                  OnClick="() => ShowEditDialog(year)" CssClass="btn-icon" Title="ערוך" HideIfNoAccess="true">
                                        <img src="/images/edit_icon.png" alt="ערוך" class="action-icon-natural">
                                    </SecureButton>
                                </td>
                                <td>@year.YearName</td>
                                <td>@(year.StartDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(year.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@(year.IsCurrent ? "כן" : "לא")</td>
                                <td>@(year.IsPrevious ? "כן" : "לא")</td>
                                <td>@(year.IsActive ? "כן" : "לא")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (_showFormDialog && _editYear != null)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>עריכת @(_editYear.YearName)</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div class="form-group">
                        <label>תאריך התחלה</label>
                        <InputDate class="form-control" @bind-Value="_formStartDate" />
                    </div>
                    <div class="form-group">
                        <label>תאריך סיום</label>
                        <InputDate class="form-control" @bind-Value="_formEndDate" />
                    </div>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" @bind="_formIsCurrent" /> שנה נוכחית</label>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" @bind="_formIsPrevious" /> שנה קודמת</label>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" @bind="_formIsActive" /> פעילה</label>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveYear" disabled="@_isSaving">@(_isSaving ? "שומר..." : "שמור")</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "hebrew_years";

    private List<YearDto> _years = new();
    private bool _isLoading = true;
    private bool _showFormDialog;
    private bool _isSaving;
    private string _formError = string.Empty;
    private YearDto? _editYear;
    private DateTime? _formStartDate;
    private DateTime? _formEndDate;
    private bool _formIsCurrent;
    private bool _formIsPrevious;
    private bool _formIsActive = true;

    protected override async Task OnPageInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        var response = await ApiService.GetAsync<ApiResponse<List<YearDto>>>("years/admin");
        _years = response?.Data ?? new();
        _isLoading = false;
    }

    private async Task RefreshData() => await LoadDataAsync();

    private void ShowEditDialog(YearDto year)
    {
        _editYear = year;
        _formStartDate = year.StartDate?.ToDateTime(TimeOnly.MinValue);
        _formEndDate = year.EndDate?.ToDateTime(TimeOnly.MinValue);
        _formIsCurrent = year.IsCurrent;
        _formIsPrevious = year.IsPrevious;
        _formIsActive = year.IsActive;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog() => _showFormDialog = false;

    private async Task SaveYear()
    {
        if (_editYear == null) return;

        _isSaving = true;
        _formError = string.Empty;

        try
        {
            var response = await ApiService.PutAsync<UpdateHebrewYearRequest, ApiResponse<object>>(
                $"years/{_editYear.Id}",
                new UpdateHebrewYearRequest
                {
                    StartDate = _formStartDate.HasValue ? DateOnly.FromDateTime(_formStartDate.Value) : null,
                    EndDate = _formEndDate.HasValue ? DateOnly.FromDateTime(_formEndDate.Value) : null,
                    IsCurrent = _formIsCurrent,
                    IsPrevious = _formIsPrevious,
                    IsActive = _formIsActive
                });

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירה";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo("/maindashboard");
}
