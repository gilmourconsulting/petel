@page "/year/{YearId:int}"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="yearmanagement_entitlements_upload" ScreenName="@PageName" FunctionName="ShowEntitlementUploadDialog"
                  OnClick="ShowEntitlementUploadDialog" CssClass="context-btn" HideIfNoAccess="true">
        העלאת זכאויות מוסדיות
    </SecureButton>

    <SecureButton ActionName="yearmanagement_salary_dept_map" ScreenName="@PageName" FunctionName="NavigateToDeptMap"
                  OnClick="NavigateToDeptMap" CssClass="context-btn" HideIfNoAccess="true">
        מיפוי מחלקות שכר
    </SecureButton>

    <SecureButton ActionName="yearmanagement_salary_month_summary" ScreenName="@PageName" FunctionName="NavigateToSalarySummary"
                  OnClick="NavigateToSalarySummary" CssClass="context-btn" HideIfNoAccess="true">
        סיכום שכר מול תקציב
    </SecureButton>

    <SecureButton ActionName="yearmanagement_salary_anomalies" ScreenName="@PageName" FunctionName="NavigateToSalaryAnomalies"
                  OnClick="NavigateToSalaryAnomalies" CssClass="context-btn" HideIfNoAccess="true">
        חריגות שכר
    </SecureButton>

    <SecureButton ActionName="yearmanagement_meitar_month_summary" ScreenName="@PageName" FunctionName="NavigateToMeitarSummary"
                  OnClick="NavigateToMeitarSummary" CssClass="context-btn" HideIfNoAccess="true">
        סיכום מיתר מול תקציב
    </SecureButton>

    <SecureButton ActionName="yearmanagement_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לדף הבית
    </SecureButton>
</div>

<EntitlementUploadModal @ref="_entitlementUploadModal" YearId="YearId" YearName="@_yearName" />

<div class="main-container">
    <div class="students-content">
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען...</div>
        }
        else
        {
            <div class="page-title-section">
                <h1 class="page-title">@_yearName</h1>
            </div>

            <!-- Summary dashboard — also the navigation to each subject -->
            <div style="max-width: 1100px; margin: 20px auto 0;">
                <div class="summary-grid" style="margin-bottom: 0;">
                    <SecureButton ActionName="yearmanagement_assistants" ScreenName="@PageName" FunctionName="NavigateToAssistants"
                                  OnClick="NavigateToAssistants" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">סייעות</div>
                            <div class="summary-value">@_summary.AssistantCount</div>
                        </div>
                    </SecureButton>

                    <SecureButton ActionName="yearmanagement_entitlements" ScreenName="@PageName" FunctionName="NavigateToEntitlements"
                                  OnClick="NavigateToEntitlements" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">זכאויות</div>
                            <div class="summary-value">@_summary.EntitlementCount</div>
                            <div class="summary-extra">@_summary.EntitlementAllocatedPercent.ToString("0.#")% מוקצה</div>
                        </div>
                    </SecureButton>

                    <SecureButton ActionName="yearmanagement_yearly_budget" ScreenName="@PageName" FunctionName="NavigateToYearlyBudget"
                                  OnClick="NavigateToYearlyBudget" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">תקציב (₪)</div>
                            <div class="summary-value">@(_summary.Budget != null ? _summary.Budget.TotalAmount.ToString("N0") : "—")</div>
                            <div class="summary-extra">
                                @if (_summary.Budget != null)
                                {
                                    <text>@_summary.Budget.TotalHours.ToString("N0") שעות · גרסה @_summary.Budget.Version</text>
                                }
                                else
                                {
                                    <text>אין תקציב</text>
                                }
                            </div>
                        </div>
                    </SecureButton>

                    <SecureButton ActionName="yearmanagement_salaries_view" ScreenName="@PageName" FunctionName="NavigateToSalaries"
                                  OnClick="NavigateToSalaries" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">שכר מתחילת השנה (₪)</div>
                            <div class="summary-value">@_summary.SalaryYtdTotal.ToString("N0")</div>
                            <div class="summary-extra">@LastSalaryMonthLabel</div>
                        </div>
                    </SecureButton>

                    <SecureButton ActionName="yearmanagement_meitar_view" ScreenName="@PageName" FunctionName="NavigateToMeitarData"
                                  OnClick="NavigateToMeitarData" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">מיתר</div>
                            <div class="summary-value">@_summary.MeitarMonthCount</div>
                            <div class="summary-extra">חודשים מיובאים</div>
                        </div>
                    </SecureButton>

                    <SecureButton ActionName="yearmanagement_org_units" ScreenName="@PageName" FunctionName="NavigateToOrgUnits"
                                  OnClick="NavigateToOrgUnits" CssClass="summary-card summary-card-clickable year-hub-card" HideIfNoAccess="true">
                        <div class="summary-info">
                            <div class="summary-label">בתי ספר וגנים</div>
                            <div class="summary-value">רשימת שנה</div>
                        </div>
                    </SecureButton>
                </div>

                @if (_showVsBudgetPanel)
                {
                    <div class="content-card" style="margin-top: 24px;">
                        <h2 style="font-size: 1.15em; margin-bottom: 12px;">סיכום מול תקציב</h2>
                        <BudgetVsSummaryPanel Comparisons="_comparisons"
                                              Months="_comparisonMonths"
                                              HebrewYearId="YearId" />
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "yearmanagement";

    private string _yearName  = "";
    private bool   _isLoading = true;
    private YearHubSummaryDto _summary = new();
    private EntitlementUploadModal? _entitlementUploadModal;
    private bool _showVsBudgetPanel;
    private List<YearlyBudgetComparisonDto> _comparisons = new();
    private List<(int PeriodYear, int PeriodMonth)> _comparisonMonths = new();
    private DateOnly? _yearStart;
    private DateOnly? _yearEnd;

    private string LastSalaryMonthLabel =>
        _summary.LastSalaryPeriodYear.HasValue && _summary.LastSalaryPeriodMonth.HasValue
            ? $"חודש אחרון: {GetMonthLabel(_summary.LastSalaryPeriodMonth.Value)} {_summary.LastSalaryPeriodYear}"
            : "לא הועלה שכר";

    protected override async Task OnPageInitializedAsync()
    {
        await LoadYearAsync();
        await LoadSummaryDataAsync();
        await LoadVsBudgetAsync();
        _isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await LoadYearAsync();
            await LoadSummaryDataAsync();
            await LoadVsBudgetAsync();
        }
    }

    private async Task LoadSummaryDataAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<YearHubSummaryDto>>(
                $"years/{YearId}/hub-summary");
            _summary = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading summary data: {ex.Message}");
            _summary = new();
        }
    }

    private async Task LoadVsBudgetAsync()
    {
        _showVsBudgetPanel = false;
        _comparisons = new();
        _comparisonMonths = new();

        try
        {
            var allowed = await ActionSecurity.VerifyActionAsync(
                actionName: "yearmanagement_yearly_budget",
                screenName: PageName,
                functionName: "NavigateToYearlyBudget",
                eventType: "BUTTON_VISIBLE_CHECK",
                reference: PageName);
            if (!allowed)
                return;

            var response = await ApiService.GetAsync<ApiResponse<YearlyBudgetDto>>(
                $"yearly-budgets?yearId={YearId}");
            if (response?.Success != true || response.Data == null)
                return;

            _comparisons = response.Data.Comparisons ?? new();
            _comparisonMonths = BuildComparisonMonths(response.Data);
            _showVsBudgetPanel = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading vs-budget panel: {ex.Message}");
            _showVsBudgetPanel = false;
        }
    }

    private List<(int PeriodYear, int PeriodMonth)> BuildComparisonMonths(YearlyBudgetDto budget)
    {
        var fromBudget = (budget.MonthDetails ?? new List<YearlyBudgetMonthDetailDto>())
            .Select(m => (m.PeriodYear, m.PeriodMonth))
            .Distinct()
            .OrderBy(m => m.PeriodYear)
            .ThenBy(m => m.PeriodMonth)
            .ToList();
        if (fromBudget.Count > 0)
            return fromBudget;

        if (_yearStart is null || _yearEnd is null)
            return new();

        var start = new DateOnly(_yearStart.Value.Year, _yearStart.Value.Month, 1);
        var end = new DateOnly(_yearEnd.Value.Year, _yearEnd.Value.Month, 1);
        if (end < start)
            return new();

        var months = new List<(int PeriodYear, int PeriodMonth)>();
        for (var cursor = start; cursor <= end; cursor = cursor.AddMonths(1))
            months.Add((cursor.Year, cursor.Month));
        return months;
    }

    private static string GetMonthLabel(int month) => month switch
    {
        1 => "ינואר",
        2 => "פברואר",
        3 => "מרץ",
        4 => "אפריל",
        5 => "מאי",
        6 => "יוני",
        7 => "יולי",
        8 => "אוגוסט",
        9 => "ספטמבר",
        10 => "אוקטובר",
        11 => "נובמבר",
        12 => "דצמבר",
        _ => month.ToString()
    };

    private async Task LoadYearAsync()
    {
        try
        {
            var year = await ApiService.GetAsync<YearDto>($"years/{YearId}");
            _yearName = year?.YearName ?? "";
            _yearStart = year?.StartDate;
            _yearEnd = year?.EndDate;
            await StoreYearInSession();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading year name: {ex.Message}");
            _yearStart = null;
            _yearEnd = null;
        }
    }

    private async Task StoreYearInSession()
    {
        try
        {
            await ApiService.PostAsync<object, object>("session/property", new { key = "SelectedYearId",   value = YearId.ToString() });
            await ApiService.PostAsync<object, object>("session/property", new { key = "SelectedYearName", value = _yearName });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error storing year in session: {ex.Message}");
        }
    }

    private void NavigateToAssistants()    => Navigation.NavigateTo($"/year/{YearId}/assistants");
    private void NavigateToEntitlements()  => Navigation.NavigateTo($"/year/{YearId}/entitlements");
    private void NavigateToYearlyBudget()  => Navigation.NavigateTo($"/year/{YearId}/yearly-budget");
    private void NavigateToSalaries()      => Navigation.NavigateTo($"/salaries?fromYear={YearId}");
    private void NavigateToMeitarData()    => Navigation.NavigateTo($"/meitar-data?fromYear={YearId}");
    private void NavigateToDeptMap()       => Navigation.NavigateTo($"/salary-department-mappings?fromYear={YearId}");
    private void NavigateToSalarySummary() => Navigation.NavigateTo($"/salaries/month-summary?fromYear={YearId}");
    private void NavigateToSalaryAnomalies() => Navigation.NavigateTo($"/salaries/anomalies?fromYear={YearId}");
    private void NavigateToMeitarSummary() => Navigation.NavigateTo($"/meitar-data/month-summary?fromYear={YearId}");
    private void NavigateToOrgUnits() => Navigation.NavigateTo($"/year/{YearId}/org-units");
    private void NavigateBack()            => Navigation.NavigateTo("/maindashboard");
    private void ShowEntitlementUploadDialog() => _entitlementUploadModal?.Show(YearId, _yearName);
}
