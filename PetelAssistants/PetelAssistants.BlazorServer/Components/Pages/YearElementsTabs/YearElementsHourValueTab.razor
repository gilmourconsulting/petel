@using PetelAssistants.BlazorServer.DTOs
@using PetelAssistants.BlazorServer.Models
@inject ApiService ApiService
@inject IJSRuntime JSRuntime

<div style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; margin-bottom: 20px;">
    <div style="display: flex; flex-direction: column; gap: 4px;">
        <label style="font-size: 0.82em; font-weight: 600;">שנת לימודים</label>
        <select class="form-control" style="min-width: 200px;"
                value="@_selectedYearId"
                @onchange="OnYearChanged"
                disabled="@_isLoading">
            @if (_years.Count == 0)
            {
                <option value="0">אין שנים</option>
            }
            else
            {
                @foreach (var year in _years)
                {
                    <option value="@year.Id">@year.YearName@(year.IsCurrent ? " (נוכחית)" : "")</option>
                }
            }
        </select>
    </div>
</div>

@if (_isLoading)
{
    <div class="loading-spinner">טוען...</div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="error-message">@_error</div>
}
else if (_selectedYearId <= 0)
{
    <div style="color: var(--text-muted);">בחר שנת לימודים להגדרת ערך שעה.</div>
}
else
{
    <p style="color: var(--text-muted); font-size: 0.9em; margin-bottom: 12px;">
        ערך כספי לשעת תקציב לשנת הלימודים — משותף לכל סוגי הסייעות בחישוב התקציב השנתי.
    </p>
    <div style="display: flex; flex-direction: column; gap: 4px; max-width: 280px;">
        <label style="font-size: 0.82em; font-weight: 600;">ערך שעה (₪)</label>
        <input type="number" class="form-control" step="0.0001" min="0"
               @bind="_hourValue" @bind:event="onchange" />
    </div>
}

@code {
    [Parameter] public string ScreenName { get; set; } = "year_elements";

    private List<YearDto> _years = new();
    private int _selectedYearId;
    private decimal _hourValue;
    private bool _isLoading = true;
    private bool _isSaving;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public async Task RefreshAsync() => await LoadAsync(keepYear: true);

    public async Task SaveAsync()
    {
        if (_selectedYearId <= 0 || _isSaving)
            return;

        if (_hourValue < 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "ערך שעה חייב להיות אי-שלילי");
            return;
        }

        _isSaving = true;
        try
        {
            var request = new UpsertBudgetHourValueRequest
            {
                HebrewYearId = _selectedYearId,
                HourValue = _hourValue
            };

            var response = await ApiService.PutAsync<UpsertBudgetHourValueRequest, ApiResponse<BudgetHourValueDto>>(
                "budget-hour-values", request);

            if (response?.Success == true)
            {
                _hourValue = response.Data?.HourValue ?? _hourValue;
                await JSRuntime.InvokeVoidAsync("alert", "ערך השעה נשמר בהצלחה");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בשמירה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירה: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task LoadAsync(bool keepYear = false)
    {
        _isLoading = true;
        _error = string.Empty;
        try
        {
            var yearsResponse = await ApiService.GetAsync<ApiResponse<List<YearDto>>>("Years/admin");
            _years = (yearsResponse?.Data ?? new())
                .Where(y => y.IsActive)
                .OrderByDescending(y => y.IsCurrent)
                .ThenByDescending(y => y.Id)
                .ToList();

            if (!keepYear || !_years.Any(y => y.Id == _selectedYearId))
            {
                _selectedYearId = _years.FirstOrDefault(y => y.IsCurrent)?.Id
                    ?? _years.FirstOrDefault()?.Id
                    ?? 0;
            }

            if (_selectedYearId > 0)
                await LoadValueAsync();
            else
                _hourValue = 0;
        }
        catch (Exception ex)
        {
            _error = $"שגיאה בטעינה: {ex.Message}";
            _hourValue = 0;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var yearId))
            return;

        _selectedYearId = yearId;
        _isLoading = true;
        _error = string.Empty;
        try
        {
            await LoadValueAsync();
        }
        catch (Exception ex)
        {
            _error = $"שגיאה בטעינה: {ex.Message}";
            _hourValue = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadValueAsync()
    {
        var response = await ApiService.GetAsync<ApiResponse<BudgetHourValueDto>>(
            $"budget-hour-values?yearId={_selectedYearId}");

        if (response?.Success != true)
        {
            _error = response?.Message ?? "שגיאה בטעינת ערך שעה";
            _hourValue = 0;
            return;
        }

        _hourValue = response.Data?.HourValue ?? 0;
    }
}
