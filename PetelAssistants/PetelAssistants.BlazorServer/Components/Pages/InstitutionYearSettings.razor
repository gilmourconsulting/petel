@page "/year/{YearId:int}/institution-year-settings"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="institution_year_settings_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן
    </SecureButton>
    <SecureButton ActionName="institution_year_settings_save" ScreenName="@PageName" FunctionName="Save"
                  OnClick="Save" CssClass="context-btn" HideIfNoAccess="true">
        שמור
    </SecureButton>
    <SecureButton ActionName="institution_year_settings_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        חזרה לניהול שנה
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">הגדרות מוסד לשנה @(_yearName != "" ? $"- {_yearName}" : "")</h1>
        </div>
        <div class="content-card">
            <p style="color: var(--text-muted); font-size: 0.9em; margin-bottom: 16px;">
                ימי לימוד בשבוע, שעות שבועיות והשתתפות ביום לימודים ארוך (יוח״א) לכל מוסד בשנת הלימודים.
            </p>

            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <div class="error-message">@_error</div>
            }
            else if (_items.Count == 0)
            {
                <div class="no-data-message">לא נמצאו מוסדות פעילים</div>
            }
            else
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>סמל</th>
                                <th>שם מוסד</th>
                                <th>סוג</th>
                                <th>ימי לימוד בשבוע</th>
                                <th>שעות שבועיות</th>
                                <th>יום לימודים ארוך</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _items)
                            {
                                <tr>
                                    <td>@(item.InstitutionSymbol ?? "—")</td>
                                    <td>@item.InstitutionName</td>
                                    <td>@GetTypeLabel(item.InstitutionType)</td>
                                    <td>
                                        <input type="number" class="form-control" style="min-width: 90px; max-width: 120px;"
                                               step="0.5" min="0" max="7"
                                               @bind="item.SchoolDaysPerWeek" @bind:event="onchange" />
                                    </td>
                                    <td>
                                        <input type="number" class="form-control" style="min-width: 90px; max-width: 120px;"
                                               step="0.01" min="0"
                                               @bind="item.WeeklyHours" @bind:event="onchange" />
                                    </td>
                                    <td style="text-align: center;">
                                        <input type="checkbox" @bind="item.HasExtendedSchoolDay" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int YearId { get; set; }

    protected override string PageName => "institution_year_settings";

    private string _yearName = "";
    private bool _isLoading = true;
    private bool _isSaving;
    private string _error = string.Empty;
    private List<InstitutionYearSettingsDto> _items = new();

    protected override async Task OnPageInitializedAsync()
    {
        await LoadYearAsync();
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_isLoading)
        {
            await LoadYearAsync();
            await LoadDataAsync();
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    private async Task LoadYearAsync()
    {
        try
        {
            var year = await ApiService.GetAsync<YearDto>($"years/{YearId}");
            _yearName = year?.YearName ?? "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading year: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = string.Empty;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<InstitutionYearSettingsDto>>>(
                $"institution-year-settings?yearId={YearId}");
            if (response?.Success == true)
                _items = response.Data ?? new();
            else
            {
                _error = response?.Message ?? "שגיאה בטעינת נתונים";
                _items = new();
            }
        }
        catch (Exception ex)
        {
            _error = $"שגיאה בטעינה: {ex.Message}";
            _items = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Save()
    {
        if (_isSaving || _items.Count == 0)
            return;

        foreach (var item in _items)
        {
            if (item.SchoolDaysPerWeek < 0 || item.SchoolDaysPerWeek > 7)
            {
                await JSRuntime.InvokeVoidAsync("alert", "ימי לימוד בשבוע חייבים להיות בין 0 ל-7");
                return;
            }
            if (item.WeeklyHours < 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "שעות שבועיות חייבות להיות אי-שליליות");
                return;
            }
        }

        _isSaving = true;
        try
        {
            var request = new UpsertInstitutionYearSettingsRequest
            {
                YearId = YearId,
                Items = _items.Select(i => new InstitutionYearSettingsItemRequest
                {
                    InstitutionId = i.InstitutionId,
                    SchoolDaysPerWeek = i.SchoolDaysPerWeek,
                    WeeklyHours = i.WeeklyHours,
                    HasExtendedSchoolDay = i.HasExtendedSchoolDay
                }).ToList()
            };

            var response = await ApiService.PutAsync<UpsertInstitutionYearSettingsRequest, ApiResponse<object>>(
                "institution-year-settings", request);

            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "הגדרות המוסדות נשמרו בהצלחה");
                await LoadDataAsync();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בשמירה");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירה: {ex.Message}");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo($"/year/{YearId}");

    private static string GetTypeLabel(string type) =>
        string.Equals(type, "kindergarten", StringComparison.OrdinalIgnoreCase) ? "גן ילדים" : "בית ספר";
}
