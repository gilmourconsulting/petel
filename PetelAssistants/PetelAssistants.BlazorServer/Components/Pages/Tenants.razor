@page "/tenants"
@layout MainLayout
@inherits SecurePageBase
@inject ApiService ApiService
@inject SessionStateService SessionStateService

<div class="school-title-section">
    <h1 class="page-title">ניהול רשויות</h1>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="tenants_refresh" ScreenName="@PageName" FunctionName="RefreshData" OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <SecureButton ActionName="tenants_create" ScreenName="@PageName" FunctionName="ShowCreateDialog" OnClick="ShowCreateDialog" CssClass="context-btn">
            הוסף רשות חדשה
        </SecureButton>
        <SecureButton ActionName="tenants_maindashboard" ScreenName="@PageName" FunctionName="NavigateToMainDashboard" OnClick="NavigateToMainDashboard" CssClass="context-navigation-btn">
            חזרה לדף ראשי
        </SecureButton>
    </div>

    <div class="students-content">
        <div class="content-card">
            <h2 class="page-title">רשימת רשויות</h2>

            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתוני רשויות...</div>
            }
            else if (_tenants.Count == 0)
            {
                <div class="no-data-message">לא נמצאו רשויות</div>
            }
            else
            {
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>פעולות</th>
                                <th>שם רשות</th>
                                <th>סוג</th>
                                <th>משתמשים פעילים</th>
                                <th>סטטוס</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tenant in _tenants)
                            {
                                <tr class="@(tenant.IsActive ? "" : "row-inactive")">
                                    <td class="actions-cell">
                                        <SecureButton ActionName="tenants_edit" ScreenName="@PageName" FunctionName="EditTenant"
                                                      ActionParams="@($"tenantId={tenant.Id}")"
                                                      OnClick="() => ShowEditDialog(tenant)" CssClass="btn-icon" Title="עריכה" HideIfNoAccess="true">
                                            <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural" />
                                        </SecureButton>
                                        <SecureButton ActionName="tenants_manageusers" ScreenName="@PageName" FunctionName="ManageUsers"
                                                      ActionParams="@($"tenantId={tenant.Id}")"
                                                      OnClick="() => ManageUsers(tenant)" CssClass="btn-icon btn-users" Title="ניהול משתמשים" HideIfNoAccess="true">
                                            <img src="/images/users_icon.png" alt="משתמשים" class="action-icon-natural" />
                                        </SecureButton>
                                        @if (tenant.IsActive)
                                        {
                                            <SecureButton ActionName="tenants_deactivate" ScreenName="@PageName" FunctionName="DeactivateTenant"
                                                          ActionParams="@($"tenantId={tenant.Id}")"
                                                          OnClick="() => DeactivateTenant(tenant)" CssClass="btn-icon btn-danger" Title="השבת רשות" HideIfNoAccess="true">
                                                <img src="/images/deactivate_icon.png" alt="השבת" class="action-icon-natural" />
                                            </SecureButton>
                                        }
                                        else
                                        {
                                            <SecureButton ActionName="tenants_activate" ScreenName="@PageName" FunctionName="ActivateTenant"
                                                          ActionParams="@($"tenantId={tenant.Id}")"
                                                          OnClick="() => ActivateTenant(tenant)" CssClass="btn-icon btn-success" Title="הפעל רשות" HideIfNoAccess="true">
                                                <img src="/images/activate_icon.png" alt="הפעל" class="action-icon-natural" />
                                            </SecureButton>
                                        }
                                    </td>
                                    <td>@tenant.Name</td>
                                    <td>@(tenant.EntityTypeName ?? "—")</td>
                                    <td>@tenant.UserCount</td>
                                    <td>
                                        <span class="status-badge @(tenant.IsActive ? "status-active" : "status-inactive")">
                                            @(tenant.IsActive ? "פעיל" : "לא פעיל")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ── Create / Edit Modal ────────────────────────────────────────────────── *@
@if (_showFormDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editTenant == null ? "הוספת רשות חדשה" : "עריכת רשות")</h3>
                <button class="modal-close" @onclick="CloseDialog">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>שם רשות <span class="required">*</span></label>
                    <input type="text" class="form-control" @bind="_formName" placeholder="שם הרשות" />
                </div>
                <div class="form-group">
                    <label>סוג רשות</label>
                    <select class="form-control" @bind="_formEntityTypeId">
                        <option value="">— ללא סוג —</option>
                        @foreach (var type in _entityTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="error-message">@_formError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">ביטול</button>
                <button class="btn btn-primary" @onclick="SaveTenant" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמור")
                </button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "tenants";

    private List<TenantDto> _tenants = new();
    private List<EntityTypeDto> _entityTypes = new();
    private bool _isLoading = true;

    private bool _showFormDialog = false;
    private bool _isSaving = false;
    private string _formError = string.Empty;
    private TenantDto? _editTenant;
    private string _formName = string.Empty;
    private int? _formEntityTypeId;

    protected override async Task OnPageInitializedAsync()
    {
        await Task.WhenAll(LoadDataAsync(), LoadEntityTypesAsync());
    }

    private async Task LoadDataAsync()
    {
        try
        {
            _isLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<TenantDto>>>("tenants");
            _tenants = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tenants: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEntityTypesAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<EntityTypeDto>>>("tenants/types");
            _entityTypes = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entity types: {ex.Message}");
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    private void ShowCreateDialog()
    {
        _editTenant = null;
        _formName = string.Empty;
        _formEntityTypeId = null;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void ShowEditDialog(TenantDto tenant)
    {
        _editTenant = tenant;
        _formName = tenant.Name;
        _formEntityTypeId = tenant.EntityTypeId;
        _formError = string.Empty;
        _showFormDialog = true;
    }

    private void CloseDialog()
    {
        _showFormDialog = false;
        _formError = string.Empty;
    }

    private async Task SaveTenant()
    {
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "שם רשות הוא שדה חובה";
            return;
        }

        _isSaving = true;
        _formError = string.Empty;

        try
        {
            ApiResponse<object>? response;

            if (_editTenant == null)
            {
                response = await ApiService.PostAsync<CreateTenantRequest, ApiResponse<object>>(
                    "tenants",
                    new CreateTenantRequest { Name = _formName, EntityTypeId = _formEntityTypeId });
            }
            else
            {
                response = await ApiService.PutAsync<UpdateTenantRequest, ApiResponse<object>>(
                    $"tenants/{_editTenant.Id}",
                    new UpdateTenantRequest { Name = _formName, EntityTypeId = _formEntityTypeId });
            }

            if (response?.Success == true)
            {
                CloseDialog();
                await LoadDataAsync();
            }
            else
            {
                _formError = response?.Message ?? "שגיאה בשמירת הרשות";
            }
        }
        catch (Exception ex)
        {
            _formError = $"שגיאה: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeactivateTenant(TenantDto tenant)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"האם לבטל את הרשות '{tenant.Name}'?"))
            return;

        try
        {
            var response = await ApiService.PutAsync<object, ApiResponse<object>>($"tenants/{tenant.Id}/deactivate", new { });
            if (response?.Success == true)
                await LoadDataAsync();
            else
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהשבתת הרשות");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}");
        }
    }

    private async Task ActivateTenant(TenantDto tenant)
    {
        try
        {
            var response = await ApiService.PutAsync<object, ApiResponse<object>>($"tenants/{tenant.Id}/activate", new { });
            if (response?.Success == true)
                await LoadDataAsync();
            else
                await JSRuntime.InvokeVoidAsync("alert", response?.Message ?? "שגיאה בהפעלת הרשות");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה: {ex.Message}");
        }
    }

    private async Task ManageUsers(TenantDto tenant)
    {
        try
        {
            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "AdminSelectedEntityId", value = tenant.Id.ToString() });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting tenant context: {ex.Message}");
        }
        Navigation.NavigateTo("/users");
    }

    private void NavigateToMainDashboard() => Navigation.NavigateTo("/maindashboard");
}
