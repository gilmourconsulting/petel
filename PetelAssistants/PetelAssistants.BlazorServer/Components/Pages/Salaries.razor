@page "/salaries"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    @if (_returnYearId.HasValue)
    {
        <SecureButton ActionName="yearmanagement_salary_upload" ScreenName="@PageName" FunctionName="ShowSalaryUploadDialog"
                      OnClick="ShowSalaryUploadDialog" CssClass="context-btn" HideIfNoAccess="true">
            העלאת קובץ שכר
        </SecureButton>
    }
    else
    {
        <SecureButton ActionName="maindashboard_salary_upload" ScreenName="@PageName" FunctionName="ShowSalaryUploadDialog"
                      OnClick="ShowSalaryUploadDialog" CssClass="context-btn" HideIfNoAccess="true">
            העלאת קובץ שכר
        </SecureButton>
    }
    <SecureButton ActionName="salaries_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="salaries_recheck" ScreenName="@PageName" FunctionName="RecheckData"
                  OnClick="RecheckData" CssClass="context-btn" Disabled="_isRechecking">
        @(_isRechecking ? "בודק..." : "בדיקת התאמות מחדש")
    </SecureButton>
    <SecureButton ActionName="salaries_month_summary" ScreenName="@PageName" FunctionName="NavigateToMonthSummary"
                  OnClick="NavigateToMonthSummary" CssClass="context-btn" HideIfNoAccess="true">
        סיכום מול תקציב
    </SecureButton>
    <SecureButton ActionName="salaries_anomalies" ScreenName="@PageName" FunctionName="NavigateToAnomalies"
                  OnClick="NavigateToAnomalies" CssClass="context-btn" HideIfNoAccess="true">
        חריגות שכר
    </SecureButton>
    <SecureButton ActionName="salaries_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        @(_returnYearId.HasValue ? "חזרה לניהול שנה" : _returnGregorianYear.HasValue ? "חזרה לניהול שנה לועזית" : "חזרה לדף הבית")
    </SecureButton>
</div>

<SalaryUploadModal @ref="_salaryUploadModal" OnUploadComplete="RefreshData" />

<div class="main-container">
    <div class="students-content">
        <div class="page-title-section">
            <h1 class="page-title">נתוני שכר</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                @if (_items.Count > 0)
                {
                    <div class="summary-grid" style="margin-bottom: 16px;">
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_items.Count</div>
                                <div class="summary-label">סה"כ רשומות שכר</div>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_items.Sum(i => i.TotalSalary).ToString("N0")</div>
                                <div class="summary-label">סה"כ שכר (₪)</div>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_items.Select(i => i.NationalId).Distinct().Count()</div>
                                <div class="summary-label">ת"ז ייחודיות</div>
                            </div>
                        </div>
                        <div class="summary-card summary-card-clickable" @onclick="ShowUnmatched"
                             title="הצג רק רשומות שלא נמצאה עבורן התאמה לאדם">
                            <div class="summary-info">
                                <div class="summary-value">@UnmatchedItems.Count()</div>
                                <div class="summary-label">לא קיימים בטבלת האנשים</div>
                                <div class="summary-extra">₪ @UnmatchedItems.Sum(i => i.TotalSalary).ToString("N0")</div>
                            </div>
                        </div>
                        <div class="summary-card summary-card-clickable" @onclick="ShowNoAllocation"
                             title="הצג רק רשומות מאומתות ללא שיבוץ פעיל בתקופה">
                            <div class="summary-info">
                                <div class="summary-value">@NoAllocationItems.Count()</div>
                                <div class="summary-label">מאומתים ללא שיבוץ לתקופה</div>
                                <div class="summary-extra">₪ @NoAllocationItems.Sum(i => i.TotalSalary).ToString("N0")</div>
                            </div>
                        </div>
                        <div class="summary-card">
                            <div class="summary-info">
                                <div class="summary-value">@_items.Count(i => i.HasIdWarning)</div>
                                <div class="summary-label">אזהרות ת"ז</div>
                            </div>
                        </div>
                    </div>
                }

                <div class="filter-bar" style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;">
                    @if (!_returnYearId.HasValue && !_returnGregorianYear.HasValue && _years.Count > 0)
                    {
                        <div style="display: flex; flex-direction: column; gap: 4px; align-self: flex-start;">
                            <label style="font-size: 0.82em; font-weight: 600;">שנת לימודים</label>
                            <select class="form-control" style="min-width: 180px;"
                                    @bind="_selectedYearId" @bind:event="onchange" @bind:after="OnSchoolYearChanged">
                                @foreach (var year in _years)
                                {
                                    <option value="@year.Id">@year.YearName</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="salary-month-buttons">
                        @foreach (var period in _schoolMonths)
                        {
                            var year = period.Year;
                            var month = period.Month;
                            <button type="button"
                                    class="salary-month-btn @(_filterYear == year && _filterMonth == month ? "active" : null)"
                                    @onclick="() => SelectMonth(year, month)">
                                <span class="month-name">@GetMonthName(month)</span>
                                <span class="month-total">₪ @GetMonthTotal(year, month).ToString("N0")</span>
                            </button>
                        }
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">ת"ז</label>
                        <input type="text" class="form-control" style="min-width: 140px;"
                               @bind="_filterNationalId" @bind:event="oninput"
                               placeholder="חיפוש ת״ז..." />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">מחלקה</label>
                        <input type="text" class="form-control" style="min-width: 140px;"
                               @bind="_filterDepartment" @bind:event="oninput"
                               placeholder="קוד או שם..." />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">התאמה לאדם</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterMatched" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="yes">מאומת</option>
                            <option value="no">לא מאומת</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">שיבוץ לתקופה</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterAllocation" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="yes">עם שיבוץ</option>
                            <option value="no">ללא שיבוץ</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">אזהרת ת"ז</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterIdWarning" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="yes">עם אזהרה</option>
                            <option value="no">ללא אזהרה</option>
                        </select>
                    </div>
                    <label style="display: flex; align-items: center; gap: 6px; font-size: 0.82em; font-weight: 600; align-self: flex-end; padding-bottom: 6px;">
                        <input type="checkbox" @bind="_filterAnomaliesOnly" />
                        חריגות בלבד
                    </label>
                    @if (HasActiveClientFilters)
                    {
                        <button class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearClientFilters">נקה סינון</button>
                    }
                    </div>
                </div>

                @if (_items.Count > 0)
                {
                    <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                        מציג @FilteredItems.Count מתוך @_items.Count רשומות
                        · סה״כ שכר: @FilteredItems.Sum(i => i.TotalSalary).ToString("N2")
                    </div>
                }

                @if (FilteredItems.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו נתוני שכר לתקופה זו</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>חריגה</th>
                                    <th>מזהה</th>
                                    <th @onclick='() => SortTable("NationalId")' style="cursor:pointer">
                                        ת"ז @GetSortArrow("NationalId")
                                    </th>
                                    <th @onclick='() => SortTable("MatchedPersonName")' style="cursor:pointer">
                                        שם @GetSortArrow("MatchedPersonName")
                                    </th>
                                    <th @onclick='() => SortTable("DepartmentId")' style="cursor:pointer">
                                        מחלקה @GetSortArrow("DepartmentId")
                                    </th>
                                    <th>שם מחלקה</th>
                                    <th @onclick='() => SortTable("PositionPercentage")' style="cursor:pointer">
                                        אחוז משרה @GetSortArrow("PositionPercentage")
                                    </th>
                                    <th @onclick='() => SortTable("TotalSalary")' style="cursor:pointer">
                                        שכר כולל @GetSortArrow("TotalSalary")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr>
                                        <td>
                                            @if (_anomaliesBySalaryId.TryGetValue(item.Id, out var anomaly))
                                            {
                                                <button type="button" class="btn-icon salary-anomaly-bell"
                                                        title="הצג חריגת שכר"
                                                        @onclick="() => ShowAnomaly(anomaly)">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                                         viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                        <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm6-6V11a6 6 0 1 0-12 0v5l-1.7 1.7A1 1 0 0 0 5 20h14a1 1 0 0 0 .7-1.7L18 16z"/>
                                                    </svg>
                                                </button>
                                            }
                                        </td>
                                        <td>
                                            <EntityFocusLink Screen="@EntityFocus.AssistantsScreen"
                                                             YearId="@_selectedYearId"
                                                             Id="@item.MatchedPersonId" />
                                        </td>
                                        <td style="@(item.HasIdWarning ? "color: var(--color-danger); font-weight: 600;" : null)">@item.NationalId</td>
                                        <td>@(item.MatchedPersonName ?? "—")</td>
                                        <td>@item.DepartmentId</td>
                                        <td>@(item.DepartmentName ?? "—")</td>
                                        <td>@item.PositionPercentage.ToString("0.##")%</td>
                                        <td>@item.TotalSalary.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (_showRecheckSummary)
{
    <div class="modal-overlay" @onclick="CloseRecheckSummary">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>סיכום בדיקת התאמות</h3>
                <button class="modal-close" @onclick="CloseRecheckSummary">&times;</button>
            </div>
            <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                @if (!string.IsNullOrEmpty(_recheckError))
                {
                    <div class="error-message">@_recheckError</div>
                }
                else if (_recheckNewlyMatched.Count == 0 &&
                         _recheckAllocationsAdded.Count == 0 &&
                         _recheckAllocationsRemoved.Count == 0)
                {
                    <div>לא נמצאו שינויים — כל הנתונים עדכניים.</div>
                }
                else
                {
                    @if (_recheckNewlyMatched.Count > 0)
                    {
                        <div style="margin-bottom: 14px;">
                            <div style="font-weight: 600; margin-bottom: 4px;">
                                רשומות שהותאמו לאדם (@_recheckNewlyMatched.Count)
                            </div>
                            <ul style="margin: 0; padding-inline-start: 20px;">
                                @foreach (var item in _recheckNewlyMatched)
                                {
                                    <li>@item.NationalId — @(item.MatchedPersonName ?? "ללא שם")</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (_recheckAllocationsAdded.Count > 0)
                    {
                        <div style="margin-bottom: 14px;">
                            <div style="font-weight: 600; margin-bottom: 4px;">
                                רשומות שנוסף להן שיבוץ לתקופה (@_recheckAllocationsAdded.Count)
                            </div>
                            <ul style="margin: 0; padding-inline-start: 20px;">
                                @foreach (var item in _recheckAllocationsAdded)
                                {
                                    <li>@item.NationalId — @(item.MatchedPersonName ?? "ללא שם")</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (_recheckAllocationsRemoved.Count > 0)
                    {
                        <div style="margin-bottom: 14px;">
                            <div style="font-weight: 600; margin-bottom: 4px;">
                                רשומות שהוסר מהן שיבוץ לתקופה (@_recheckAllocationsRemoved.Count)
                            </div>
                            <ul style="margin: 0; padding-inline-start: 20px;">
                                @foreach (var item in _recheckAllocationsRemoved)
                                {
                                    <li>@item.NationalId — @(item.MatchedPersonName ?? "ללא שם")</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseRecheckSummary">סגור</button>
            </div>
        </div>
    </div>
}

@if (_showAnomalyModal && _selectedAnomaly != null)
{
    <div class="modal-overlay" @onclick="CloseAnomalyModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>חריגת שכר</h3>
                <button class="modal-close" @onclick="CloseAnomalyModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group"><label>מזהה סייעת</label>
                    <div>
                        <EntityFocusLink Screen="@EntityFocus.AssistantsScreen"
                                         YearId="@_selectedYearId"
                                         Id="@_selectedAnomaly.MatchedPersonId" />
                    </div>
                </div>
                <div class="form-group"><label>ת"ז</label><div>@_selectedAnomaly.NationalId</div></div>
                <div class="form-group">
                    <label>מחלקה</label>
                    <div>
                        @_selectedAnomaly.DepartmentId
                        @if (!string.IsNullOrEmpty(_selectedAnomaly.DepartmentName))
                        {
                            <span> (@_selectedAnomaly.DepartmentName)</span>
                        }
                    </div>
                </div>
                <div class="form-group"><label>% משרה</label><div>@_selectedAnomaly.PositionPercentage.ToString("N2")</div></div>
                <div class="form-group"><label>שכר</label><div>@_selectedAnomaly.TotalSalary.ToString("N2")</div></div>
                <div class="form-group"><label>סייעת</label><div>@(_selectedAnomaly.MatchedPersonName ?? "—")</div></div>
                <div class="form-group"><label>סוג ממופה</label><div>@(_selectedAnomaly.MappedAssistantTypeName ?? "—")</div></div>
                <div class="form-group"><label>סוג הקצאה</label><div>@(_selectedAnomaly.AllocationAssistantTypeName ?? "—")</div></div>
                <div class="form-group"><label>סיבה</label><div>@_selectedAnomaly.Message</div></div>
                <div class="form-group"><label>סטטוס</label><div>@(_selectedAnomaly.StatusName ?? "—")</div></div>
                <div class="form-group"><label>הערה</label><div>@(string.IsNullOrWhiteSpace(_selectedAnomaly.Notes) ? "—" : _selectedAnomaly.Notes)</div></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAnomalyModal">סגור</button>
            </div>
        </div>
    </div>
}

@code {
    protected override string PageName => "salaries";

    [SupplyParameterFromQuery(Name = "fromYear")]
    public int? FromYear { get; set; }

    [SupplyParameterFromQuery(Name = "fromGregorianYear")]
    public int? FromGregorianYear { get; set; }

    private List<SalaryListItemDto> _items = new();
    private bool _isLoading = true;
    private int? _returnYearId;
    private int? _returnGregorianYear;
    private int _selectedYearId;
    private List<YearDto> _years = new();
    private List<(int Year, int Month)> _schoolMonths = new();
    private Dictionary<(int Year, int Month), decimal> _monthTotals = new();

    private bool _isRechecking;
    private bool _showRecheckSummary;
    private string _recheckError = "";
    private List<SalaryListItemDto> _recheckNewlyMatched = new();
    private List<SalaryListItemDto> _recheckAllocationsAdded = new();
    private List<SalaryListItemDto> _recheckAllocationsRemoved = new();

    private Dictionary<int, SalaryAnomalyDto> _anomaliesBySalaryId = new();
    private bool _showAnomalyModal;
    private SalaryAnomalyDto? _selectedAnomaly;
    private SalaryUploadModal? _salaryUploadModal;

    private int _filterYear;
    private int _filterMonth;
    private string _filterNationalId = "";
    private string _filterDepartment = "";
    private string _filterMatched = "";
    private string _filterIdWarning = "";
    private string _filterAllocation = "";
    private bool _filterAnomaliesOnly;

    private string _sortColumn = "NationalId";
    private bool _sortAscending = true;

    private static readonly string[] MonthNames =
    {
        "", "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני",
        "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר"
    };

    private bool HasActiveClientFilters =>
        !string.IsNullOrWhiteSpace(_filterNationalId) ||
        !string.IsNullOrWhiteSpace(_filterDepartment) ||
        !string.IsNullOrEmpty(_filterMatched) ||
        !string.IsNullOrEmpty(_filterIdWarning) ||
        !string.IsNullOrEmpty(_filterAllocation) ||
        _filterAnomaliesOnly;

    private IEnumerable<SalaryListItemDto> UnmatchedItems =>
        _items.Where(i => !i.MatchedPersonId.HasValue);

    private IEnumerable<SalaryListItemDto> NoAllocationItems =>
        _items.Where(i => i.MatchedPersonId.HasValue && !i.HasAllocationForPeriod);

    private List<SalaryListItemDto> FilteredItems
    {
        get
        {
            IEnumerable<SalaryListItemDto> query = _items;

            if (!string.IsNullOrWhiteSpace(_filterNationalId))
            {
                var term = _filterNationalId.Trim();
                query = query.Where(i => i.NationalId.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filterDepartment))
            {
                var term = _filterDepartment.Trim();
                query = query.Where(i =>
                    i.DepartmentId.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(i.DepartmentName) &&
                     i.DepartmentName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (_filterMatched == "yes")
                query = query.Where(i => i.MatchedPersonId.HasValue);
            else if (_filterMatched == "no")
                query = query.Where(i => !i.MatchedPersonId.HasValue);

            if (_filterIdWarning == "yes")
                query = query.Where(i => i.HasIdWarning);
            else if (_filterIdWarning == "no")
                query = query.Where(i => !i.HasIdWarning);

            if (_filterAllocation == "yes")
                query = query.Where(i => i.MatchedPersonId.HasValue && i.HasAllocationForPeriod);
            else if (_filterAllocation == "no")
                query = query.Where(i => i.MatchedPersonId.HasValue && !i.HasAllocationForPeriod);

            if (_filterAnomaliesOnly)
                query = query.Where(i => _anomaliesBySalaryId.ContainsKey(i.Id));

            query = _sortColumn switch
            {
                "NationalId" => _sortAscending
                    ? query.OrderBy(i => i.NationalId)
                    : query.OrderByDescending(i => i.NationalId),
                "MatchedPersonName" => _sortAscending
                    ? query.OrderBy(i => i.MatchedPersonName ?? "")
                    : query.OrderByDescending(i => i.MatchedPersonName ?? ""),
                "DepartmentId" => _sortAscending
                    ? query.OrderBy(i => i.DepartmentId)
                    : query.OrderByDescending(i => i.DepartmentId),
                "PositionPercentage" => _sortAscending
                    ? query.OrderBy(i => i.PositionPercentage)
                    : query.OrderByDescending(i => i.PositionPercentage),
                "TotalSalary" => _sortAscending
                    ? query.OrderBy(i => i.TotalSalary)
                    : query.OrderByDescending(i => i.TotalSalary),
                _ => query
            };

            return query.ToList();
        }
    }

    protected override async Task OnPageInitializedAsync()
    {
        _returnYearId = FromYear;
        _returnGregorianYear = FromGregorianYear;
        await LoadSchoolYearAsync();
        RebuildMonths();
        PickDefaultMonth();
        await LoadMonthTotalsAsync();
        await LoadDataAsync();
    }

    private async Task LoadSchoolYearAsync()
    {
        if (_returnGregorianYear.HasValue)
            return;

        try
        {
            if (_returnYearId.HasValue)
            {
                var year = await ApiService.GetAsync<YearDto>($"years/{_returnYearId.Value}");
                if (year != null)
                {
                    _years = new List<YearDto> { year };
                    _selectedYearId = year.Id;
                }
            }
            else
            {
                var context = await ApiService.GetAsync<YearContextDto>("years/context");
                _years = context?.AllYears ?? new();
                _selectedYearId = context?.CurrentYear?.Id ?? _years.FirstOrDefault()?.Id ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school year: {ex.Message}");
            _years = new();
        }
    }

    private YearDto? SelectedYear => _years.FirstOrDefault(y => y.Id == _selectedYearId);

    private void RebuildMonths()
    {
        _schoolMonths = new();
        if (_returnGregorianYear.HasValue)
        {
            var y = _returnGregorianYear.Value;
            for (var m = 1; m <= 12; m++)
                _schoolMonths.Add((y, m));
            return;
        }

        var year = SelectedYear;
        if (year?.StartDate is null || year.EndDate is null)
            return;

        var start = new DateOnly(year.StartDate.Value.Year, year.StartDate.Value.Month, 1);
        var end = new DateOnly(year.EndDate.Value.Year, year.EndDate.Value.Month, 1);
        if (end < start)
            return;

        for (var cursor = start; cursor <= end; cursor = cursor.AddMonths(1))
            _schoolMonths.Add((cursor.Year, cursor.Month));
    }

    private void PickDefaultMonth()
    {
        if (_schoolMonths.Count == 0)
            return;

        var previous = DateTime.Today.AddMonths(-1);
        foreach (var month in _schoolMonths)
        {
            if (month.Year == previous.Year && month.Month == previous.Month)
            {
                _filterYear = month.Year;
                _filterMonth = month.Month;
                return;
            }
        }

        var todayKey = DateTime.Today.Year * 12 + DateTime.Today.Month;
        var last = _schoolMonths[^1];
        if (last.Year * 12 + last.Month < todayKey)
        {
            _filterYear = last.Year;
            _filterMonth = last.Month;
        }
        else
        {
            _filterYear = _schoolMonths[0].Year;
            _filterMonth = _schoolMonths[0].Month;
        }
    }

    private async Task OnSchoolYearChanged()
    {
        RebuildMonths();
        PickDefaultMonth();
        await LoadMonthTotalsAsync();
        await LoadDataAsync();
    }

    private async Task SelectMonth(int year, int month)
    {
        if (_filterYear == year && _filterMonth == month)
            return;
        _filterYear = year;
        _filterMonth = month;
        await LoadDataAsync(showSpinner: false);
    }

    private async Task LoadMonthTotalsAsync()
    {
        _monthTotals = new();
        if (_schoolMonths.Count == 0)
            return;

        try
        {
            var from = _schoolMonths[0];
            var to = _schoolMonths[^1];
            var response = await ApiService.GetAsync<ApiResponse<List<SalaryMonthTotalDto>>>(
                $"salaries/month-totals?fromYear={from.Year}&fromMonth={from.Month}&toYear={to.Year}&toMonth={to.Month}");
            foreach (var row in response?.Data ?? new())
                _monthTotals[(row.PeriodYear, row.PeriodMonth)] = row.TotalSalary;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading salary month totals: {ex.Message}");
        }
    }

    private decimal GetMonthTotal(int year, int month) =>
        _monthTotals.TryGetValue((year, month), out var total) ? total : 0;

    private async Task LoadDataAsync(bool showSpinner = true)
    {
        if (showSpinner)
            _isLoading = true;
        try
        {
            var salariesTask = ApiService.GetAsync<ApiResponse<List<SalaryListItemDto>>>(
                $"salaries?year={_filterYear}&month={_filterMonth}");
            var anomaliesTask = ApiService.GetAsync<ApiResponse<List<SalaryAnomalyDto>>>(
                $"salary-anomalies?year={_filterYear}&month={_filterMonth}");
            await Task.WhenAll(salariesTask, anomaliesTask);

            _items = salariesTask.Result?.Data ?? new();
            _anomaliesBySalaryId = (anomaliesTask.Result?.Data ?? new())
                .Where(a => a.SalaryId.HasValue)
                .GroupBy(a => a.SalaryId!.Value)
                .ToDictionary(g => g.Key, g => g.First());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading salaries: {ex.Message}");
            _items = new();
            _anomaliesBySalaryId = new();
        }
        finally
        {
            if (showSpinner)
                _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadMonthTotalsAsync();
        await LoadDataAsync();
    }

    /// <summary>
    /// Re-runs matching on the server for the period — person matching for unmatched rows and
    /// allocation matching (stored matched_allocation_id) for all matched rows — then reloads
    /// the data and shows a summary of the changes relative to the currently displayed rows:
    /// newly matched persons and allocations added/removed for the period.
    /// </summary>
    private async Task RecheckData()
    {
        _isRechecking = true;
        _recheckError = "";
        try
        {
            var oldState = _items.ToDictionary(
                i => i.Id,
                i => (i.MatchedPersonId, i.HasAllocationForPeriod));

            await ApiService.PostAsync<object, ApiResponse<object>>(
                $"salaries/recheck?year={_filterYear}&month={_filterMonth}", new { });

            await LoadDataAsync();

            _recheckNewlyMatched = _items
                .Where(i => i.MatchedPersonId.HasValue &&
                            oldState.TryGetValue(i.Id, out var old) &&
                            !old.MatchedPersonId.HasValue)
                .ToList();

            _recheckAllocationsAdded = _items
                .Where(i => i.HasAllocationForPeriod &&
                            oldState.TryGetValue(i.Id, out var old) &&
                            !old.HasAllocationForPeriod)
                .ToList();

            _recheckAllocationsRemoved = _items
                .Where(i => !i.HasAllocationForPeriod &&
                            oldState.TryGetValue(i.Id, out var old) &&
                            old.HasAllocationForPeriod)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rechecking salaries: {ex.Message}");
            _recheckError = "שגיאה בבדיקת הנתונים. נסה שוב.";
            _recheckNewlyMatched = new();
            _recheckAllocationsAdded = new();
            _recheckAllocationsRemoved = new();
        }
        finally
        {
            _isRechecking = false;
            _showRecheckSummary = true;
        }
    }

    private void CloseRecheckSummary() => _showRecheckSummary = false;

    private void ShowAnomaly(SalaryAnomalyDto anomaly)
    {
        _selectedAnomaly = anomaly;
        _showAnomalyModal = true;
    }

    private void CloseAnomalyModal()
    {
        _showAnomalyModal = false;
        _selectedAnomaly = null;
    }

    private void ClearClientFilters()
    {
        _filterNationalId = "";
        _filterDepartment = "";
        _filterMatched = "";
        _filterIdWarning = "";
        _filterAllocation = "";
        _filterAnomaliesOnly = false;
    }

    private void ShowUnmatched()
    {
        _filterMatched = "no";
        _filterAllocation = "";
    }

    private void ShowNoAllocation()
    {
        _filterAllocation = "no";
        _filterMatched = "";
    }

    private void NavigateBack()
    {
        if (_returnGregorianYear.HasValue)
            Navigation.NavigateTo($"/gregorian/{_returnGregorianYear.Value}");
        else if (_returnYearId.HasValue)
            Navigation.NavigateTo($"/year/{_returnYearId.Value}");
        else
            Navigation.NavigateTo("/maindashboard");
    }

    private string PeriodQuery
    {
        get
        {
            var qs = $"year={_filterYear}&month={_filterMonth}&yearId={_selectedYearId}";
            if (_returnGregorianYear.HasValue)
                qs += $"&fromGregorianYear={_returnGregorianYear.Value}";
            else if (_returnYearId.HasValue)
                qs += $"&fromYear={_returnYearId.Value}";
            return qs;
        }
    }

    private void NavigateToMonthSummary() => Navigation.NavigateTo($"/salaries/month-summary?{PeriodQuery}");
    private void NavigateToAnomalies() => Navigation.NavigateTo($"/salaries/anomalies?{PeriodQuery}");

    private void ShowSalaryUploadDialog() => _salaryUploadModal?.Show();

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private static string GetMonthName(int month) =>
        month is >= 1 and <= 12 ? MonthNames[month] : month.ToString();
}
