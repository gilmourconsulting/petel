@page "/salaries"
@layout MainLayout
@inherits SecurePageBase
@using PetelAssistants.BlazorServer.Models
@using PetelAssistants.BlazorServer.DTOs
@inject ApiService ApiService

<div class="context-buttons-section">
    <SecureButton ActionName="salaries_refresh" ScreenName="@PageName" FunctionName="RefreshData"
                  OnClick="RefreshData" CssClass="context-btn">
        רענן נתונים
    </SecureButton>
    <SecureButton ActionName="salaries_back" ScreenName="@PageName" FunctionName="NavigateBack"
                  OnClick="NavigateBack" CssClass="context-navigation-btn">
        @(_returnYearId.HasValue ? "חזרה לניהול שנה" : "חזרה לדף הבית")
    </SecureButton>
</div>

<div class="main-container">
    <div class="students-content">
        <div class="school-title-section">
            <h1 class="page-title">נתוני שכר</h1>
        </div>
        <div class="content-card">
            @if (_isLoading)
            {
                <div class="loading-spinner">טוען נתונים...</div>
            }
            else
            {
                <div class="filter-bar" style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">שנה</label>
                        <input type="number" class="form-control" style="width: 100px;"
                               @bind="_filterYear" @bind:event="onchange" @bind:after="OnPeriodChanged"
                               min="2000" max="2100" />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">חודש</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterMonth" @bind:event="onchange" @bind:after="OnPeriodChanged">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@GetMonthLabel(m)</option>
                            }
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">ת"ז</label>
                        <input type="text" class="form-control" style="min-width: 140px;"
                               @bind="_filterNationalId" @bind:event="oninput"
                               placeholder="חיפוש ת״ז..." />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">מחלקה</label>
                        <input type="text" class="form-control" style="min-width: 140px;"
                               @bind="_filterDepartment" @bind:event="oninput"
                               placeholder="קוד או שם..." />
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">התאמה לאדם</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterMatched" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="yes">מאומת</option>
                            <option value="no">לא מאומת</option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 0.82em; font-weight: 600;">אזהרת ת"ז</label>
                        <select class="form-control" style="min-width: 120px;"
                                @bind="_filterIdWarning" @bind:event="onchange">
                            <option value="">הכל</option>
                            <option value="yes">עם אזהרה</option>
                            <option value="no">ללא אזהרה</option>
                        </select>
                    </div>
                    @if (HasActiveClientFilters)
                    {
                        <button class="btn btn-secondary" style="align-self: flex-end;" @onclick="ClearClientFilters">נקה סינון</button>
                    }
                </div>

                @if (_items.Count > 0)
                {
                    <div style="margin-bottom: 12px; color: var(--text-muted); font-size: 0.9em;">
                        מציג @FilteredItems.Count מתוך @_items.Count רשומות
                        · סה״כ שכר: @FilteredItems.Sum(i => i.TotalSalary).ToString("N2")
                    </div>
                }

                @if (FilteredItems.Count == 0)
                {
                    <div class="no-data-message">לא נמצאו נתוני שכר לתקופה זו</div>
                }
                else
                {
                    <div class="table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th @onclick='() => SortTable("NationalId")' style="cursor:pointer">
                                        ת"ז @GetSortArrow("NationalId")
                                    </th>
                                    <th @onclick='() => SortTable("MatchedPersonName")' style="cursor:pointer">
                                        שם מאומת @GetSortArrow("MatchedPersonName")
                                    </th>
                                    <th @onclick='() => SortTable("DepartmentId")' style="cursor:pointer">
                                        מחלקה @GetSortArrow("DepartmentId")
                                    </th>
                                    <th>שם מחלקה</th>
                                    <th @onclick='() => SortTable("PositionPercentage")' style="cursor:pointer">
                                        אחוז משרה @GetSortArrow("PositionPercentage")
                                    </th>
                                    <th @onclick='() => SortTable("TotalSalary")' style="cursor:pointer">
                                        שכר כולל @GetSortArrow("TotalSalary")
                                    </th>
                                    <th>אזהרת ת"ז</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in FilteredItems)
                                {
                                    <tr class="@(item.HasIdWarning ? "row-inactive" : "")">
                                        <td>@item.NationalId</td>
                                        <td>@(item.MatchedPersonName ?? "—")</td>
                                        <td>@item.DepartmentId</td>
                                        <td>@(item.DepartmentName ?? "—")</td>
                                        <td>@item.PositionPercentage.ToString("0.##")%</td>
                                        <td>@item.TotalSalary.ToString("N2")</td>
                                        <td>
                                            @if (item.HasIdWarning)
                                            {
                                                <span class="status-badge status-inactive">אזהרה</span>
                                            }
                                            else
                                            {
                                                <span>—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    protected override string PageName => "salaries";

    [SupplyParameterFromQuery(Name = "fromYear")]
    public int? FromYear { get; set; }

    private List<SalaryListItemDto> _items = new();
    private bool _isLoading = true;
    private int? _returnYearId;

    private int _filterYear;
    private int _filterMonth;
    private string _filterNationalId = "";
    private string _filterDepartment = "";
    private string _filterMatched = "";
    private string _filterIdWarning = "";

    private string _sortColumn = "NationalId";
    private bool _sortAscending = true;

    private static readonly string[] MonthNames =
    {
        "", "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני",
        "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר"
    };

    private bool HasActiveClientFilters =>
        !string.IsNullOrWhiteSpace(_filterNationalId) ||
        !string.IsNullOrWhiteSpace(_filterDepartment) ||
        !string.IsNullOrEmpty(_filterMatched) ||
        !string.IsNullOrEmpty(_filterIdWarning);

    private List<SalaryListItemDto> FilteredItems
    {
        get
        {
            IEnumerable<SalaryListItemDto> query = _items;

            if (!string.IsNullOrWhiteSpace(_filterNationalId))
            {
                var term = _filterNationalId.Trim();
                query = query.Where(i => i.NationalId.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filterDepartment))
            {
                var term = _filterDepartment.Trim();
                query = query.Where(i =>
                    i.DepartmentId.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(i.DepartmentName) &&
                     i.DepartmentName.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            if (_filterMatched == "yes")
                query = query.Where(i => i.MatchedPersonId.HasValue);
            else if (_filterMatched == "no")
                query = query.Where(i => !i.MatchedPersonId.HasValue);

            if (_filterIdWarning == "yes")
                query = query.Where(i => i.HasIdWarning);
            else if (_filterIdWarning == "no")
                query = query.Where(i => !i.HasIdWarning);

            query = _sortColumn switch
            {
                "NationalId" => _sortAscending
                    ? query.OrderBy(i => i.NationalId)
                    : query.OrderByDescending(i => i.NationalId),
                "MatchedPersonName" => _sortAscending
                    ? query.OrderBy(i => i.MatchedPersonName ?? "")
                    : query.OrderByDescending(i => i.MatchedPersonName ?? ""),
                "DepartmentId" => _sortAscending
                    ? query.OrderBy(i => i.DepartmentId)
                    : query.OrderByDescending(i => i.DepartmentId),
                "PositionPercentage" => _sortAscending
                    ? query.OrderBy(i => i.PositionPercentage)
                    : query.OrderByDescending(i => i.PositionPercentage),
                "TotalSalary" => _sortAscending
                    ? query.OrderBy(i => i.TotalSalary)
                    : query.OrderByDescending(i => i.TotalSalary),
                _ => query
            };

            return query.ToList();
        }
    }

    protected override async Task OnPageInitializedAsync()
    {
        _returnYearId = FromYear;
        var previous = DateTime.Today.AddMonths(-1);
        _filterYear = previous.Year;
        _filterMonth = previous.Month;
        await LoadDataAsync();
    }

    private async Task OnPeriodChanged()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            var response = await ApiService.GetAsync<ApiResponse<List<SalaryListItemDto>>>(
                $"salaries?year={_filterYear}&month={_filterMonth}");
            _items = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading salaries: {ex.Message}");
            _items = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshData() => await LoadDataAsync();

    private void ClearClientFilters()
    {
        _filterNationalId = "";
        _filterDepartment = "";
        _filterMatched = "";
        _filterIdWarning = "";
    }

    private void NavigateBack()
    {
        if (_returnYearId.HasValue)
            Navigation.NavigateTo($"/year/{_returnYearId.Value}");
        else
            Navigation.NavigateTo("/maindashboard");
    }

    private void SortTable(string column)
    {
        if (_sortColumn == column)
            _sortAscending = !_sortAscending;
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetSortArrow(string column)
    {
        if (_sortColumn != column) return "";
        return _sortAscending ? "▲" : "▼";
    }

    private static string GetMonthLabel(int month) =>
        month is >= 1 and <= 12 ? $"{month} - {MonthNames[month]}" : month.ToString();
}
