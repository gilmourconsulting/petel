@inject ApiService ApiService
@inject IJSRuntime JSRuntime
@using Petel.BlazorCore.Services
@using PetelAssistants.BlazorServer.DTOs

<div class="tenant-selector-wrapper">
    <div class="tenant-selector-label">רשות פעילה:</div>
    @if (_isLoading)
    {
        <span class="tenant-selector-loading">טוען רשויות...</span>
    }
    else if (_tenants.Count == 0)
    {
        <span class="tenant-selector-empty">אין רשויות זמינות</span>
    }
    else
    {
        <select class="tenant-selector-select" value="@_selectedTenantId" @onchange="OnSelectionChanged">
            <option value="">— בחר רשות —</option>
            @foreach (var tenant in _tenants)
            {
                <option value="@tenant.Id">
                    @tenant.Name @(tenant.EntityTypeName != null ? $"({tenant.EntityTypeName})" : "")
                    @(!tenant.IsActive ? " [לא פעיל]" : "")
                </option>
            }
        </select>
        @if (_selectedTenant != null)
        {
            <span class="tenant-selector-badge @(_selectedTenant.IsActive ? "active" : "inactive")">
                @_selectedTenant.Name
            </span>
        }
    }
</div>

@code {
    [Parameter] public EventCallback<int> TenantChanged { get; set; }
    [Parameter] public EventCallback<TenantDto?> TenantObjectChanged { get; set; }

    private List<TenantDto> _tenants = new();
    private int    _selectedTenantId;
    private TenantDto? _selectedTenant;
    private bool   _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
        await LoadCurrentSelectionAsync();
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            _isLoading = true;
            var response = await ApiService.GetAsync<ApiResponse<List<TenantDto>>>("tenants");
            _tenants = response?.Data ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tenants: {ex.Message}");
            _tenants = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCurrentSelectionAsync()
    {
        try
        {
            var response = await ApiService.GetAsync<SessionPropertyResponse>("session/property/AdminSelectedEntityId");
            if (response != null && int.TryParse(response.Value, out int id))
            {
                _selectedTenantId = id;
                _selectedTenant = _tenants.FirstOrDefault(t => t.Id == id);
            }
        }
        catch
        {
            // No selection stored — fine
        }
    }

    private async Task OnSelectionChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int newId) || newId == 0)
        {
            _selectedTenantId = 0;
            _selectedTenant   = null;
            return;
        }

        try
        {
            var result = await ApiService.PostAsync<SessionPropertyRequest, object>(
                "session/property",
                new SessionPropertyRequest { Key = "AdminSelectedEntityId", Value = newId.ToString() });

            _selectedTenantId = newId;
            _selectedTenant   = _tenants.FirstOrDefault(t => t.Id == newId);

            await TenantChanged.InvokeAsync(newId);
            await TenantObjectChanged.InvokeAsync(_selectedTenant);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving tenant selection: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בשמירת בחירת הרשות");
        }
    }

    public TenantDto? SelectedTenant => _selectedTenant;
    public int SelectedTenantId => _selectedTenantId;

    private class SessionPropertyRequest
    {
        public string Key   { get; set; } = string.Empty;
        public string? Value { get; set; }
    }

    private class SessionPropertyResponse
    {
        public string? Key   { get; set; }
        public string? Value { get; set; }
    }
}
