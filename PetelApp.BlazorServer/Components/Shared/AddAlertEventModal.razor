@using System.ComponentModel.DataAnnotations
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject IJSRuntime JSRuntime

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="HandleOverlayClick">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(IsEvent ? "הוספת אירוע חדש" : "הוספת התראה חדשה")</h2>
                <button class="modal-close" @onclick="Close">×</button>
            </div>
            <div class="modal-body">
                <EditForm Model="@_formData" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    
                    <!-- Description Field -->
                    <div class="form-group">
                        <label for="description">תיאור *</label>
                        <InputTextArea id="description" 
                                       @bind-Value="_formData.Description" 
                                       rows="4" 
                                       class="form-control"
                                       placeholder="@($"הזן תיאור {(IsEvent ? "האירוע" : "ההתראה")}")" />
                        <ValidationMessage For="@(() => _formData.Description)" />
                    </div>

                    @if (IsEvent)
                    {
                        <!-- Event Date Field -->
                        <div class="form-group">
                            <label for="eventDate">תאריך אירוע *</label>
                            <InputDate id="eventDate" 
                                       @bind-Value="_eventDate" 
                                       class="form-control" />
                        </div>

                        <!-- Event Time Field -->
                        <div class="form-group">
                            <label for="eventTime">שעת אירוע</label>
                            <input type="time" 
                                   id="eventTime" 
                                   value="@_eventTimeString" 
                                   @onchange="@((ChangeEventArgs e) => _eventTimeString = e.Value?.ToString() ?? "00:00")"
                                   class="form-control" />
                        </div>
                    }

                    <div class="modal-actions">
                        <button type="submit" class="btn-primary" disabled="@_isSaving">
                            @(_isSaving ? "שומר..." : "שמור")
                        </button>
                        <button type="button" class="btn-secondary" @onclick="Close">ביטול</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsEvent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private AlertFormData _formData = new();
    private bool _isSaving = false;
    private string _eventTimeString = "00:00";
    private DateTime _eventDate = DateTime.Today;

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            // Reset form when modal opens
            _formData = new AlertFormData();
            _eventTimeString = "00:00";
            _eventDate = DateTime.Today;
        }
    }

    private async Task HandleSubmit()
    {
        _isSaving = true;
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "נדרש אימות");
                return;
            }

            // Determine alert level based on context
            var alertLevel = DetermineAlertLevel(session);

            // Ask distribution questions if needed
            var distribution = await AskDistributionQuestions(alertLevel);
            if (distribution == null)
            {
                _isSaving = false;
                return; // User cancelled
            }

            // Prepare event date/time
            DateTime? eventDateTime = null;
            if (IsEvent)
            {
                var time = TimeSpan.TryParse(_eventTimeString, out var t) ? t : TimeSpan.Zero;
                eventDateTime = _eventDate.Add(time);
            }

            // Create alert
            var requestBody = new
            {
                alertType = 2,  // Manual
                alertLevel = alertLevel,
                description = _formData.Description,
                status = 1,  // New
                isEvent = IsEvent,
                eventDate = eventDateTime,
                distributeToOwned = distribution.DistributeToOwned,
                distributeToSchools = distribution.DistributeToSchools
            };

            await ApiService.PostAsync<object, object>("alerts", requestBody);

            await JSRuntime.InvokeVoidAsync("alert", $"{(IsEvent ? "האירוע" : "ההתראה")} נוסף בהצלחה");

            await Close();

            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving alert: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בשמירת ההתראה. אנא נסה שוב.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private int DetermineAlertLevel(SessionData session)
    {
        // On school dashboard (when SelectedSchoolId exists), always level 7 (school)
        // This will need to be checked in the actual implementation
        var entityTypeId = int.Parse(session.EntityTypeId);

        switch (entityTypeId)
        {
            case 1:  // Ministry
                return 7;
            case 5:  // School network
                return 3;
            case 6:  // Owner
                return 2;
            default:
                return 7;
        }
    }

    private async Task<DistributionFlags?> AskDistributionQuestions(int alertLevel)
    {
        var flags = new DistributionFlags();

        // Question 1: For owner level (2) - distribute to owned entities
        if (alertLevel == 2)
        {
            var result = await JSRuntime.InvokeAsync<bool>("confirm", "להפיץ לכל הבעליות?");
            flags.DistributeToOwned = result;
        }

        // Question 2: For owner (2) or network (3) - distribute to schools
        if (alertLevel == 2 || alertLevel == 3)
        {
            var result = await JSRuntime.InvokeAsync<bool>("confirm", "להפיץ לכל מוסדות החינוך?");
            flags.DistributeToSchools = result;
        }

        return flags;
    }

    private async Task Close()
    {
        IsVisible = false;
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private void HandleOverlayClick()
    {
        // Close modal when clicking on overlay
        _ = Close();
    }

    private class AlertFormData
    {
        [Required(ErrorMessage = "תיאור הוא שדה חובה")]
        public string Description { get; set; } = string.Empty;
    }

    private class DistributionFlags
    {
        public bool DistributeToOwned { get; set; }
        public bool DistributeToSchools { get; set; }
    }
}
