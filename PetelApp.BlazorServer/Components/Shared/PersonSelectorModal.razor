@using PetelApp.BlazorServer.DTOs
@inject ApiService ApiService

@if (_isVisible)
{
    <div class="modal-overlay" @onclick="Cancel">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 600px; max-height: 80vh; overflow-y: auto;">
            <div class="modal-header">
                <h3>@_title</h3>
                <button type="button" class="close-btn" @onclick="Cancel">&times;</button>
            </div>
            
            @if (_step == SelectionStep.Choice && _currentPerson != null)
            {
                <div class="modal-body">
                    <div style="margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 4px; direction: rtl;">
                        <div style="font-weight: 600; margin-bottom: 5px;">איש קשר נוכחי:</div>
                        <div style="color: #495057;">@_currentPerson.FirstName @_currentPerson.LastName</div>
                        @if (!string.IsNullOrEmpty(_currentPerson.Position))
                        {
                            <div style="color: #6c757d; font-size: 0.9em;">תפקיד: @_currentPerson.Position</div>
                        }
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <button type="button" class="dialog-btn" style="background: #007bff; width: 100%;" @onclick="ShowUpdateContact">
                            עדכון פרטי התקשרות
                        </button>
                        <button type="button" class="dialog-btn" style="background: #28a745; width: 100%;" @onclick="ShowSearch">
                            החלפת איש קשר
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
                </div>
            }
            else if (_step == SelectionStep.Choice && _currentPerson == null)
            {
                <div class="modal-body">
                    <div style="margin-bottom: 20px; padding: 15px; background: #fff3cd; border-radius: 4px; direction: rtl;">
                        <div style="color: #856404;">לא הוגדר איש קשר</div>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <button type="button" class="dialog-btn" style="background: #28a745; width: 100%;" @onclick="ShowSearch">
                            בחירת איש קשר
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
                </div>
            }
            else if (_step == SelectionStep.UpdateContact)
            {
                <div class="modal-body">
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">שם פרטי:</label>
                        <input type="text" class="form-control" value="@_currentPerson?.FirstName" readonly 
                               style="background: #e9ecef; cursor: not-allowed;" />
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">שם משפחה:</label>
                        <input type="text" class="form-control" value="@_currentPerson?.LastName" readonly 
                               style="background: #e9ecef; cursor: not-allowed;" />
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">טלפון:</label>
                        <div style="display: flex; gap: 8px; direction: ltr;">
                            <input type="text" class="form-control" @bind="_phonePrefix" placeholder="קידומת" maxlength="7"
                                   style="width: 100px; text-align: left;" />
                            <input type="text" class="form-control" @bind="_phoneNumber" placeholder="מספר טלפון" maxlength="10"
                                   style="flex: 1; text-align: left;" />
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">דוא"ל:</label>
                        <input type="email" class="form-control" @bind="_email" placeholder="example@domain.com"
                               style="direction: ltr; text-align: left;" />
                    </div>
                </div>
                <div class="modal-footer" style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
                    <button type="button" class="dialog-btn save" @onclick="SaveContactUpdate">אישור</button>
                </div>
            }
            else if (_step == SelectionStep.Search)
            {
                <div class="modal-body">
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">חיפוש לפי שם:</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" class="form-control" @bind="_searchFirstName" placeholder="שם פרטי" 
                                   style="flex: 1; direction: rtl;" @onkeyup="OnSearchKeyUp" />
                            <input type="text" class="form-control" @bind="_searchLastName" placeholder="שם משפחה" 
                                   style="flex: 1; direction: rtl;" @onkeyup="OnSearchKeyUp" />
                            <button type="button" class="dialog-btn" style="background: #007bff; padding: 8px 20px;" @onclick="SearchPersons">
                                חפש
                            </button>
                        </div>
                    </div>
                    
                    @if (_isLoading)
                    {
                        <div style="padding: 20px; text-align: center; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 15px;">
                            מחפש...
                        </div>
                    }
                    else if (_searchResults.Any())
                    {
                        <div style="max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 15px;">
                            @foreach (var person in _searchResults)
                            {
                                <div @onclick="() => SelectPerson(person)"
                                     style="padding: 12px; cursor: pointer; border-bottom: 1px solid #f0f0f0; text-align: right; direction: rtl;
                                            @(_hoveredPersonId == person.Id ? "background-color: #f0f0f0;" : "")"
                                     @onmouseover="@(() => _hoveredPersonId = person.Id)"
                                     @onmouseout="@(() => _hoveredPersonId = null)">
                                    <div style="font-weight: 600; margin-bottom: 4px;">@person.FirstName @person.LastName</div>
                                    @if (!string.IsNullOrEmpty(person.Position))
                                    {
                                        <div style="color: #6c757d; font-size: 0.9em; margin-bottom: 2px;">תפקיד: @person.Position</div>
                                    }
                                    @if (!string.IsNullOrEmpty(person.PhoneNumber))
                                    {
                                        <div style="color: #6c757d; font-size: 0.9em; direction: ltr; text-align: right;">
                                            טלפון: @($"{person.PhoneNumberPrefix}-{person.PhoneNumber}")
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_hasSearched)
                    {
                        <div style="padding: 20px; text-align: center; color: #6c757d; border: 1px solid #dee2e6; border-radius: 4px; margin-bottom: 15px;">
                            לא נמצאו תוצאות
                        </div>
                    }
                    
                    <div style="text-align: center; padding: 10px;">
                        <button type="button" class="dialog-btn" style="background: #28a745;" @onclick="ShowNewPerson">
                            + איש קשר חדש
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
                </div>
            }
            else if (_step == SelectionStep.NewPerson)
            {
                <div class="modal-body">
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">שם פרטי: <span style="color: red;">*</span></label>
                        <input type="text" class="form-control" @bind="_newFirstName" placeholder="הזן שם פרטי" 
                               style="direction: rtl;" />
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">שם משפחה: <span style="color: red;">*</span></label>
                        <input type="text" class="form-control" @bind="_newLastName" placeholder="הזן שם משפחה" 
                               style="direction: rtl;" />
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">טלפון:</label>
                        <div style="display: flex; gap: 8px; direction: ltr;">
                            <input type="text" class="form-control" @bind="_newPhonePrefix" placeholder="קידומת" maxlength="7"
                                   style="width: 100px; text-align: left;" />
                            <input type="text" class="form-control" @bind="_newPhoneNumber" placeholder="מספר טלפון" maxlength="10"
                                   style="flex: 1; text-align: left;" />
                        </div>
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">דוא"ל:</label>
                        <input type="email" class="form-control" @bind="_newEmail" placeholder="example@domain.com"
                               style="direction: ltr; text-align: left;" />
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; font-weight: 600;">תפקיד:</label>
                        <input type="text" class="form-control" value="@_newPosition" readonly 
                               style="background: #e9ecef; cursor: not-allowed; direction: rtl;" />
                    </div>
                </div>
                <div class="modal-footer" style="display: flex; gap: 10px; justify-content: flex-end;">
                    <button type="button" class="dialog-btn cancel" @onclick="Cancel">ביטול</button>
                    <button type="button" class="dialog-btn save" @onclick="SaveNewPerson">שמירה</button>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum SelectionStep
    {
        Choice,
        UpdateContact,
        Search,
        NewPerson
    }

    public class PersonInfo
    {
        public int? Id { get; set; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? Position { get; set; }
        public string? PhoneNumber { get; set; }
        public string? PhoneNumberPrefix { get; set; }
        public string? Email { get; set; }
    }

    private bool _isVisible = false;
    private SelectionStep _step = SelectionStep.Choice;
    private string _title = "";
    private PersonInfo? _currentPerson;
    private string _searchFirstName = "";
    private string _searchLastName = "";
    private string _phoneNumber = "";
    private string _phonePrefix = "";
    private string _email = "";
    private bool _isLoading = false;
    private bool _hasSearched = false;
    private List<PersonInfo> _searchResults = new();
    private int? _hoveredPersonId = null;
    
    // New person fields
    private string _newFirstName = "";
    private string _newLastName = "";
    private string _newPhoneNumber = "";
    private string _newPhonePrefix = "";
    private string _newEmail = "";
    private string _newPosition = "";
    
    private TaskCompletionSource<PersonInfo?>? _tcs;

    public async Task<PersonInfo?> ShowAsync(string title, PersonInfo? currentPerson)
    {
        _title = title;
        _currentPerson = currentPerson;
        _step = SelectionStep.Choice;
        _searchFirstName = "";
        _searchLastName = "";
        _searchResults.Clear();
        _hasSearched = false;
        
        // Initialize contact fields if current person exists
        if (currentPerson != null)
        {
            _phoneNumber = currentPerson.PhoneNumber ?? "";
            _phonePrefix = currentPerson.PhoneNumberPrefix ?? "";
            _email = currentPerson.Email ?? "";
        // Initialize new person fields
        _newFirstName = "";
        _newLastName = "";
        _newPhoneNumber = "";
        _newPhonePrefix = "";
        _newEmail = "";
        _newPosition = currentPerson?.Position ?? "";
        
        }
        else
        {
            _phoneNumber = "";
            _phonePrefix = "";
            _email = "";
        }
        
        _isVisible = true;
        
        _tcs = new TaskCompletionSource<PersonInfo?>();
        StateHasChanged();
        
        return await _tcs.Task;
    }

    private void ShowUpdateContact()
    {
        _step = SelectionStep.UpdateContact;
        StateHasChanged();
    }

    private void ShowSearch()
    {
        _step = SelectionStep.Search;
        _searchResults.Clear();
        _hasSearched = false;
        StateHasChanged();
    }

    private void ShowNewPerson()
    {
        _step = SelectionStep.NewPerson;
        _newFirstName = "";
        _newLastName = "";
        _newPhoneNumber = "";
        _newPhonePrefix = "";
        _newEmail = "";
        StateHasChanged();
    }

    private async Task SaveNewPerson()
    {
        if (string.IsNullOrWhiteSpace(_newFirstName) || string.IsNullOrWhiteSpace(_newLastName))
        {
            // TODO: Show validation message
            return;
        }

        try
        {
            // TODO: Call API to create new person
            // For now, create a temporary PersonInfo object
            var newPerson = new PersonInfo
            {
                Id = null, // Will be assigned by backend
                FirstName = _newFirstName,
                LastName = _newLastName,
                PhoneNumber = _newPhoneNumber,
                PhoneNumberPrefix = _newPhonePrefix,
                Email = _newEmail,
                Position = _newPosition
            };

            _isVisible = false;
            _tcs?.SetResult(newPerson);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating new person: {ex.Message}");
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPersons();
        }
    }

    private async Task SearchPersons()
    {
        if (string.IsNullOrWhiteSpace(_searchFirstName) && string.IsNullOrWhiteSpace(_searchLastName))
        {
            // Show alert or message
            return;
        }

        _isLoading = true;
        _hasSearched = false;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>();
            if (!string.IsNullOrWhiteSpace(_searchFirstName))
                queryParams.Add($"firstName={Uri.EscapeDataString(_searchFirstName)}");
            if (!string.IsNullOrWhiteSpace(_searchLastName))
                queryParams.Add($"lastName={Uri.EscapeDataString(_searchLastName)}");

            var response = await ApiService.GetAsync<ApiResponse<List<PersonInfo>>>(
                $"persons/search?{string.Join("&", queryParams)}"
            );

            if (response?.Success == true && response.Data != null)
            {
                _searchResults = response.Data;
            }
            else
            {
                _searchResults.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching persons: {ex.Message}");
            _searchResults.Clear();
        }
        finally
        {
            _isLoading = false;
            _hasSearched = true;
            StateHasChanged();
        }
    }

    private async Task SaveContactUpdate()
    {
        if (_currentPerson == null) return;

        try
        {
            // TODO: Call API to update person contact details
            // For now, just update the local object and return it
            _currentPerson.PhoneNumber = _phoneNumber;
            _currentPerson.PhoneNumberPrefix = _phonePrefix;
            _currentPerson.Email = _email;

            _isVisible = false;
            _tcs?.SetResult(_currentPerson);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating contact: {ex.Message}");
        }
    }

    private void SelectPerson(PersonInfo person)
    {
        _isVisible = false;
        _tcs?.SetResult(person);
        StateHasChanged();
    }

    private void Cancel()
    {
        _isVisible = false;
        _tcs?.SetResult(null);
        StateHasChanged();
    }
}
