@inherits LayoutComponentBase
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject ApiService ApiService

<div class="app-container">
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="top-bar-left">
            <div class="system-logo-section">
                <div class="system-logo" @onclick="NavigateToMainDashboard" style="cursor: pointer;" title="חזור למסך הראשי">
                    <img src="/images/petel_logo.png" alt="לוגו המערכת" />
                </div>
            </div>
        </div>

        <div class="top-bar-center">
            <div class="app-title">מערכת לניהול אגרות תלמידי חוץ</div>
        </div>

        <div class="top-bar-right">
            <div class="user-section">
                <div class="user-name" id="userName">@_username</div>
            </div>

            <div class="entity-section">
                <div class="entity-logo" id="entityLogo">🏢</div>
                <div class="entity-info">
                    <div class="entity-name" id="entityName">@_entityName</div>
                    <div class="entity-type" id="entityType">@_entityType</div>
                </div>
            </div>

            <button class="logout-btn" @onclick="Logout">🚪 יציאה</button>
        </div>
    </div>

    <!-- Main Container -->
    <div class="main-container">
        <!-- Side Menu (LEFT side) -->
        <NavMenu />
        
        <!-- Main Content Area -->
        <div class="main-content">
            <div id="dynamicContent">
                @Body
            </div>
        </div>
    </div>

    <!-- System Footer -->
    <div class="system-footer">
        <div class="footer-content">
            <div class="system-logo">
                <img src="/images/petel_logo.png" alt="לוגו המערכת" />
            </div>
            <span id="systemVersion">מערכת פט"ל | גרסה @_systemVersion</span>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    אירעה שגיאה לא מטופלת.
    <a href="." class="reload">טען מחדש</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _systemVersion = "1.0";
    private string _entityName = "";
    private string _entityType = "";
    private string _username = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadHeaderInfo();
        await LoadSystemVersion();
    }

    private async Task LoadHeaderInfo()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session != null)
            {
                _username = session.UserFullName ?? session.Username;
                _entityName = session.EntityName ?? "שם הישות";
                _entityType = session.EntityTypeName ?? "סוג הישות";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading header info: {ex.Message}");
        }
    }

    private async Task LoadSystemVersion()
    {
        try
        {
            var attributes = await ApiService.GetAsync<List<SystemAttributeDto>>("systemattributes");
            if (attributes != null)
            {
                var versionAttr = attributes.FirstOrDefault(a => a.Name == "System Version");
                if (versionAttr != null)
                {
                    _systemVersion = versionAttr.Value ?? "1.0";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading system version: {ex.Message}");
        }
    }

    private void Logout()
    {
        // TODO: Call logout endpoint and clear session
        Navigation.NavigateTo("/login", forceLoad: true);
    }
    
    private void NavigateToMainDashboard()
    {
        Navigation.NavigateTo("/maindashboard");
    }
}
