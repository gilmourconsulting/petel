@inherits LayoutComponentBase
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject ApiService ApiService
@inject AuthenticationService AuthService
@inject SessionTimeoutService TimeoutService
@inject IJSRuntime JSRuntime

<AuthenticationGuard>
    <SessionTimeoutWarning />
    
    <div class="app-container">
        <!-- Top Bar -->
        <div class="top-bar">
        <div class="top-bar-left">
            <div class="system-logo-section">
                <div class="system-logo" @onclick="NavigateToMainDashboard" style="cursor: pointer; @_logoStyle" title="חזור למסך הראשי">
                    <img src="@_topLogo" alt="לוגו המערכת" />
                </div>
                @if (_showDebugButton)
                {
                    <button class="debug-btn" @onclick="ShowSessionDebug" title="הצג נתוני סשן">
                        🔍 Debug Session
                    </button>
                }
            </div>
        </div>

        <div class="top-bar-center">
            <div class="app-title">מערכת לניהול אגרות תלמידי חוץ</div>
        </div>

        <div class="top-bar-right">
            <div class="user-section">
                <div class="user-name" id="userName">@_username</div>
            </div>

            <div class="entity-section">
                <div class="entity-logo" id="entityLogo">🏢</div>
                <div class="entity-info">
                    <div class="entity-name" id="entityName">@_entityName</div>
                    <div class="entity-type" id="entityType">@_entityType</div>
                </div>
            </div>

            <button class="logout-btn" @onclick="Logout">🚪 יציאה</button>
        </div>
    </div>

    <!-- Main Container -->
    <div class="main-container">
        <!-- Side Menu (LEFT side) -->
        <NavMenu />
        
        <!-- Main Content Area -->
        <div class="main-content" id="mainContentScroller">
            <div id="dynamicContent">
                @Body
            </div>
        </div>
    </div>

    <!-- System Footer -->
    <div class="system-footer">
        <div class="footer-content">
            <div class="system-logo">
                <img src="@_systemLogo" alt="לוגו המערכת" />
            </div>
            <span id="systemVersion">מערכת פט"ל | גרסה @_systemVersion</span>
        </div>
    </div>
</div>

<!-- Debug Modal -->
@if (_showDebugModal)
{
    <div class="debug-modal" style="display: block;" @onclick="CloseDebugModal">
        <div class="debug-modal-content" @onclick:stopPropagation="true">
            <div class="debug-modal-header">
                <h3>נתוני סשן נוכחי</h3>
                <span class="debug-modal-close" @onclick="CloseDebugModal">&times;</span>
            </div>
            <div class="debug-json-container">
                @if (_debugDataLoading)
                {
                    <p>טוען נתוני סשן...</p>
                }
                else
                {
                    <pre>@_debugData</pre>
                }
            </div>
            <div style="margin-top: 15px; text-align: center;">
                <button @onclick="RefreshDebugData" class="btn-secondary">רענן נתונים</button>
                <button @onclick="CloseDebugModal" class="btn-secondary" style="margin-right: 10px;">סגור</button>
            </div>
        </div>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    אירעה שגיאה לא מטופלת.
    <a href="." class="reload">טען מחדש</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string _systemVersion = "1.0";
    private string _entityName = "";
    private string _entityType = "";
    private string _username = "";
    private bool _showDebugButton = false;
    private bool _showDebugModal = false;
    private bool _debugDataLoading = false;
    private string _debugData = string.Empty;
    private string _systemLogo = "/images/petel_logo.png";
    private string _nativLogo = "/images/nativ-logo.png";

    private string _topLogo = "/images/petel_logo.png";
    private string _logoStyle = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadHeaderInfo();
        await LoadSystemVersion();
        await CheckDebugButtonVisibility();
        await LoadSystemLogo();
    }

    private async Task LoadHeaderInfo()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session != null)
            {
                _username = session.UserFullName ?? session.Username;
                _entityName = session.EntityName ?? "שם הישות";
                _entityType = session.EntityTypeName ?? "סוג הישות";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading header info: {ex.Message}");
        }
    }

    private async Task LoadSystemVersion()
    {
        try
        {
            var attributes = await ApiService.GetAsync<List<SystemAttributeDto>>("systemattributes");
            if (attributes != null)
            {
                var versionAttr = attributes.FirstOrDefault(a => a.Name == "System Version");
                if (versionAttr != null)
                {
                    _systemVersion = versionAttr.Value ?? "1.0";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading system version: {ex.Message}");
        }
    }

    private async Task CheckDebugButtonVisibility()
    {
        try
        {
            var attributes = await ApiService.GetAsync<List<SystemAttributeDto>>("systemattributes");
            if (attributes != null)
            {
                var debugAttr = attributes.FirstOrDefault(a => a.Id == 9999 || a.Name == "Show debug button");
                if (debugAttr != null)
                {
                    _showDebugButton = debugAttr.Value?.ToLower() == "true" || debugAttr.Value == "1";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error checking debug button visibility: {ex.Message}");
        }
    }

    private async Task LoadSystemLogo()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session == null || string.IsNullOrEmpty(session.EntityId))
            {
                Console.WriteLine("No entity ID in session");
                return;
            }

            var distributorData = await ApiService.GetAsync<DistributorResponse>($"entities/{session.EntityId}/distributor");
            if (distributorData != null && distributorData.Distributor == "Nativ")
            {
                _topLogo = _nativLogo;
                _logoStyle = "width: 175px; height: auto;";
                Console.WriteLine("✅ System logo set to Nativ");
            }
            else
            {
                Console.WriteLine("✅ Using default Petel logo");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading system logo: {ex.Message}");
            // Silently fail - keep default logo
        }
    }

    private async Task ShowSessionDebug()
    {
        _showDebugModal = true;
        _debugDataLoading = true;
        StateHasChanged();
        
        await LoadDebugData();
    }

    private async Task LoadDebugData()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();
            
            // Get session properties
            var sessionProperties = new Dictionary<string, string>();
            string? propertiesError = null;
            try
            {
                sessionProperties = await ApiService.GetAsync<Dictionary<string, string>>("session/properties") ?? new();
            }
            catch (Exception ex)
            {
                propertiesError = ex.Message;
            }
            
            // Get user actions
            var userActions = new List<object>();
            string? userActionsError = null;
            try
            {
                userActions = await ApiService.GetAsync<List<object>>("security/user-actions") ?? new();
            }
            catch (Exception ex)
            {
                userActionsError = ex.Message;
            }

            var debugData = new
            {
                sessionInfo = session,
                sessionProperties = new
                {
                    properties = sessionProperties,
                    error = propertiesError
                },
                userRoles = session?.Roles ?? new List<int>(),
                userActions = new
                {
                    count = userActions.Count,
                    actions = userActions,
                    error = userActionsError
                }
            };

            _debugData = System.Text.Json.JsonSerializer.Serialize(debugData, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true,
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
        }
        catch (Exception ex)
        {
            _debugData = $"שגיאה בטעינת נתוני סשן: {ex.Message}";
        }
        finally
        {
            _debugDataLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDebugData()
    {
        _debugDataLoading = true;
        StateHasChanged();
        await LoadDebugData();
    }

    private void CloseDebugModal()
    {
        _showDebugModal = false;
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }
    
    private void NavigateToMainDashboard()
    {
        Navigation.NavigateTo("/maindashboard");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize session timeout after first render
            await TimeoutService.InitializeAsync();
            
            // Initialize scroll recalculation observer
            await InitializeScrollObserver();
        }
    }

    private async Task InitializeScrollObserver()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("LayoutHelpers.initializeScrollObserver");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing scroll observer: {ex.Message}");
        }
    }

    // DTO for distributor response
    private class DistributorResponse
    {
        public string Distributor { get; set; } = string.Empty;
    }
}

</AuthenticationGuard>