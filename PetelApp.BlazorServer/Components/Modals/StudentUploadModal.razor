@using Microsoft.AspNetCore.Components.Forms
@using PetelApp.BlazorServer.Services
@inject ApiService ApiService
@inject IJSRuntime JSRuntime

@if (_isVisible)
{
    <div class="modal-overlay" style="display: flex;">
        <div class="modal-content" style="max-width: 800px; width: 90%;">
            <div class="modal-header">
                <div id="uploadModalTitle">@_modalTitle</div>
                <button class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (_currentStep == UploadStep.FileSelection)
                {
                    <!-- Step 1: File Selection -->
                    <div>
                        <div class="form-group">
                            <label for="studentFile">בחר קובץ (CSV, XLS, XLSX) *</label>
                            <div class="file-input-wrapper">
                                <InputFile id="studentFile" OnChange="OnFileSelected" accept=".csv,.xls,.xlsx" style="display: none;" />
                                <button type="button" class="btn-file-select" @onclick="TriggerFileInput">
                                    <span>@_fileNameDisplay</span>
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_statusMessage))
                        {
                            <div class="upload-status upload-status-@_statusType" style="margin-top: 10px;">
                                @((MarkupString)_statusMessage.Replace("\n", "<br>"))
                            </div>
                        }
                    </div>
                }
                else if (_currentStep == UploadStep.ColumnMapping)
                {
                    <!-- Step 2: Column Mapping -->
                    <div>
                        <p style="margin-bottom: 15px; color: #666; direction: rtl;">
                            התאם את העמודות בקובץ לשדות המערכת. המערכת זיהתה אוטומטית את השדות המתאימים, אך ניתן לשנות את המיפוי.
                        </p>
                        <div style="max-height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px;">
                            <table class="mapping-table" style="width: 100%; border-collapse: collapse;">
                                <thead style="position: sticky; top: 0; background: #f8f9fa; z-index: 1;">
                                    <tr style="border-bottom: 2px solid #dee2e6;">
                                        <th style="padding: 12px; text-align: right; font-weight: bold;">עמודה בקובץ</th>
                                        <th style="padding: 12px; text-align: right; font-weight: bold;">שדה במערכת</th>
                                    </tr>
                                </thead>
                                <tbody style="direction: rtl;">
                                    @foreach (var header in _fileHeaders)
                                    {
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td style="padding: 12px; font-weight: bold;">@header</td>
                                            <td style="padding: 12px;">
                                                <select class="form-control mapping-select" 
                                                        value="@GetMappingValue(header)"
                                                        @onchange="e => UpdateMapping(header, e.Value?.ToString())">
                                                    <option value="">-- לא ממופה --</option>
                                                    @foreach (var field in _availableFields)
                                                    {
                                                        <option value="@field.Key">@field.Value</option>
                                                    }
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!string.IsNullOrEmpty(_statusMessage))
                        {
                            <div class="upload-status upload-status-@_statusType" style="margin-top: 15px;">
                                @((MarkupString)_statusMessage.Replace("\n", "<br>"))
                            </div>
                        }
                    </div>
                }
                else if (_currentStep == UploadStep.UploadComplete)
                {
                    <!-- Step 3: Upload Complete -->
                    <div class="upload-status upload-status-@_statusType">
                        @((MarkupString)_statusMessage.Replace("\n", "<br>"))
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (_currentStep == UploadStep.FileSelection)
                {
                    <button type="button" class="btn-secondary" @onclick="CloseModal">ביטול</button>
                    <button type="button" class="btn-primary" @onclick="HandleFileSelection" disabled="@_isProcessing">
                        @(_isProcessing ? "מעבד..." : "המשך")
                    </button>
                }
                else if (_currentStep == UploadStep.ColumnMapping)
                {
                    <button type="button" class="btn-secondary" @onclick="CloseModal">ביטול</button>
                    <button type="button" class="btn-secondary" @onclick="BackToFileSelection">חזרה</button>
                    <button type="button" class="btn-primary" @onclick="HandleFileUpload" disabled="@_isProcessing">
                        @(_isProcessing ? "מעלה..." : "העלה קובץ")
                    </button>
                }
                else if (_currentStep == UploadStep.UploadComplete)
                {
                    <button type="button" class="btn-primary" @onclick="CloseAndRefresh">אישור</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private enum UploadStep
    {
        FileSelection,
        ColumnMapping,
        UploadComplete
    }

    [Parameter] public EventCallback OnUploadComplete { get; set; }

    private bool _isVisible = false;
    private UploadStep _currentStep = UploadStep.FileSelection;
    private string _modalTitle = "העלאת קובץ תלמידים";
    private string _fileNameDisplay = "לא נבחר קובץ";
    private string _statusMessage = string.Empty;
    private string _statusType = "info";
    private bool _isProcessing = false;

    private IBrowserFile? _selectedFile;
    private byte[]? _fileContent;
    private string _fileContentType = string.Empty;
    private string _fileName = string.Empty;
    private List<string> _fileHeaders = new();
    private Dictionary<string, string> _availableFields = new();
    private Dictionary<string, string> _columnMappings = new();

    public void Show()
    {
        _isVisible = true;
        ResetModal();
        StateHasChanged();
    }

    private void CloseModal()
    {
        _isVisible = false;
        ResetModal();
        StateHasChanged();
    }

    private async Task CloseAndRefresh()
    {
        _isVisible = false;
        ResetModal();
        await OnUploadComplete.InvokeAsync();
        StateHasChanged();
    }

    private void ResetModal()
    {
        _currentStep = UploadStep.FileSelection;
        _modalTitle = "העלאת קובץ תלמידים";
        _fileNameDisplay = "לא נבחר קובץ";
        _statusMessage = string.Empty;
        _statusType = "info";
        _isProcessing = false;
        _selectedFile = null;
        _fileContent = null;
        _fileContentType = string.Empty;
        _fileName = string.Empty;
        _fileHeaders.Clear();
        _availableFields.Clear();
        _columnMappings.Clear();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _fileNameDisplay = _selectedFile?.Name ?? "לא נבחר קובץ";
        _fileName = _selectedFile?.Name ?? string.Empty;
        _fileContentType = _selectedFile?.ContentType ?? "application/octet-stream";
        _statusMessage = string.Empty;
        StateHasChanged();
    }

    private async Task TriggerFileInput()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('studentFile').click()");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error triggering file input: {ex.Message}");
        }
    }

    private async Task HandleFileSelection()
    {
        if (_selectedFile == null)
        {
            _statusMessage = "אנא בחר קובץ";
            _statusType = "error";
            StateHasChanged();
            return;
        }

        _isProcessing = true;
        _statusMessage = "קורא קובץ...";
        _statusType = "loading";
        StateHasChanged();

        try
        {
            // Read file content into memory once
            const long maxFileSize = 10 * 1024 * 1024; // 10MB
            using var stream = _selectedFile.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            _fileContent = memoryStream.ToArray();

            // Prepare file for preview
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(_fileContent);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_fileContentType);
            content.Add(fileContent, "file", _fileName);

            var response = await ApiService.PostMultipartAsync<PreviewResponse>(
                "studentsfileupload/preview",
                content);

            if (response != null && response.Success)
            {
                _fileHeaders = response.Headers ?? new List<string>();
                _availableFields = response.AvailableFields ?? new Dictionary<string, string>();
                
                // Apply suggested mappings
                if (response.SuggestedMappings != null)
                {
                    _columnMappings = new Dictionary<string, string>(response.SuggestedMappings);
                }

                _currentStep = UploadStep.ColumnMapping;
                _modalTitle = "מיפוי עמודות";
                _statusMessage = string.Empty;
            }
            else
            {
                _statusMessage = $"❌ שגיאה: {response?.Message ?? "לא ניתן לקרוא את הקובץ"}";
                _statusType = "error";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"❌ שגיאה בקריאת הקובץ: {ex.Message}";
            _statusType = "error";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private void BackToFileSelection()
    {
        _currentStep = UploadStep.FileSelection;
        _modalTitle = "העלאת קובץ תלמידים";
        _statusMessage = string.Empty;
        StateHasChanged();
    }

    private async Task HandleFileUpload()
    {
        if (_fileContent == null)
        {
            _statusMessage = "לא נבחר קובץ";
            _statusType = "error";
            StateHasChanged();
            return;
        }

        // Create reverse mapping (system field -> file column)
        var reverseMapping = new Dictionary<string, string>();
        foreach (var kvp in _columnMappings)
        {
            if (!string.IsNullOrEmpty(kvp.Value) && kvp.Value != "ignore")
            {
                reverseMapping[kvp.Value] = kvp.Key;
            }
        }

        // Validate required fields (excluding optional fields: gender, street, house_number, post_code)
        var requiredFields = new[] { "id_number", "first_name", "last_name", "start_date", "end_date", 
            "city", "sending_council" };
        var mappedFields = reverseMapping.Keys.ToList();

        // Check class mapping - must be EITHER class name OR (level + number), not both
        var hasClassName = mappedFields.Contains("class");
        var hasClassLevel = mappedFields.Contains("class_level");
        var hasClassNumber = mappedFields.Contains("class_number");
        var hasClassParts = hasClassLevel && hasClassNumber;

        // ✅ Prevent mapping both class name AND level/number
        if (hasClassName && (hasClassLevel || hasClassNumber))
        {
            var errorMsg = "❌ שגיאה: לא ניתן למפות גם כיתה (שם מלא) וגם שכבה/מספר כיתה\n\n";
            errorMsg += "יש לבחור אחת מהאפשרויות הבאות:\n";
            errorMsg += "• כיתה (שם מלא) - לדוגמה: \"א1\", \"ב2\"\n";
            errorMsg += "• כיתה (שכבה) + מספר כיתה (מקבילה) - לדוגמה: שכבה=\"א\", מספר=\"1\"";

            _statusMessage = errorMsg;
            _statusType = "error";
            StateHasChanged();
            return;
        }

        if (!hasClassName && !hasClassParts)
        {
            var errorMsg = "❌ שגיאה: יש למפות כיתה בדרך אחת מהאפשרויות הבאות:\n";
            errorMsg += "• כיתה (שם מלא) - לדוגמה: \"א1\", \"ב2\"\n";
            errorMsg += "• כיתה (שכבה) + מספר כיתה (מקבילה) - לדוגמה: שכבה=\"א\", מספר=\"1\"";

            if (hasClassLevel && !hasClassNumber)
                errorMsg += "\n\n⚠️ מופתה רק שכבה, חסר מספר כיתה";
            else if (!hasClassLevel && hasClassNumber)
                errorMsg += "\n\n⚠️ מופה רק מספר כיתה, חסרה שכבה";

            _statusMessage = errorMsg;
            _statusType = "error";
            StateHasChanged();
            return;
        }

        var missingFields = requiredFields.Where(f => !mappedFields.Contains(f)).ToList();
        if (missingFields.Any())
        {
            var fieldLabels = string.Join(", ", missingFields.Select(f => _availableFields.ContainsKey(f) ? _availableFields[f] : f));
            _statusMessage = $"❌ שגיאה: שדות חובה לא ממופים: {fieldLabels}";
            _statusType = "error";
            StateHasChanged();
            return;
        }

        _isProcessing = true;
        _statusMessage = "מעלה קובץ...";
        _statusType = "loading";
        StateHasChanged();

        try
        {
            // Get session properties
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedSchoolYearId");
            var schoolIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedSchoolId");
            var hebrewYearResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearValue");

            if (schoolYearIdResponse == null || !schoolYearIdResponse.TryGetValue("value", out var schoolYearId))
            {
                _statusMessage = "לא נבחרה שנת לימודים. אנא בחר שנת לימודים ונסה שנית.";
                _statusType = "error";
                _isProcessing = false;
                StateHasChanged();
                return;
            }

            var schoolId = schoolIdResponse?.GetValueOrDefault("value") ?? "";
            var hebrewYear = hebrewYearResponse?.GetValueOrDefault("value") ?? "";

            // Prepare multipart form data using stored file content
            using var content = new MultipartFormDataContent();
            var fileContent = new ByteArrayContent(_fileContent);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_fileContentType);
            content.Add(fileContent, "file", _fileName);
            content.Add(new StringContent(schoolYearId), "schoolYearId");
            content.Add(new StringContent(schoolId), "schoolId");
            content.Add(new StringContent(hebrewYear), "hebrewYear");
            content.Add(new StringContent(System.Text.Json.JsonSerializer.Serialize(reverseMapping)), "mappingJson");

            var response = await ApiService.PostMultipartAsync<UploadResponse>(
                "studentsfileupload/upload",
                content);

            if (response != null && response.Success)
            {
                var summaryMessage = $"✅ הקובץ עובד בהצלחה!<br><br>" +
                    $"📊 סיכום העלאה:<br>" +
                    $"➕ נוצרו: {response.Created}<br>" +
                    $"✏️ עודכנו: {response.Updated}<br>" +
                    $"➖ ללא שינוי: {response.Unchanged}<br>";

                if (response.Errors > 0)
                {
                    summaryMessage += $"<br>❌ שגיאות: {response.Errors}";
                    if (response.Details?.ErrorList != null && response.Details.ErrorList.Any())
                    {
                        // ✅ Show all errors with scrollable container
                        var errorItems = string.Join("", response.Details.ErrorList.Select(e => $"<div style='padding: 8px; border-bottom: 1px solid #f0f0f0; background: #fff3cd;'>{e}</div>"));
                        summaryMessage += $"<br><br><div style='font-weight: bold; margin-bottom: 10px;'>⚠️ רשימת שגיאות:</div>" +
                            $"<div style='max-height: 300px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px; background: white; direction: rtl;'>{errorItems}</div>";
                    }
                }

                _statusMessage = summaryMessage;
                _statusType = "success";
                _currentStep = UploadStep.UploadComplete;
            }
            else
            {
                _statusMessage = $"❌ שגיאה: {response?.Message ?? "העלאת הקובץ נכשלה"}";
                _statusType = "error";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"❌ שגיאה בהעלאת הקובץ: {ex.Message}";
            _statusType = "error";
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private string GetMappingValue(string header)
    {
        return _columnMappings.GetValueOrDefault(header, string.Empty);
    }

    private void UpdateMapping(string header, string? systemField)
    {
        if (string.IsNullOrEmpty(systemField))
        {
            _columnMappings.Remove(header);
        }
        else
        {
            _columnMappings[header] = systemField;
        }
    }

    // DTOs for API responses
    private class PreviewResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public List<string>? Headers { get; set; }
        public Dictionary<string, string>? AvailableFields { get; set; }
        public Dictionary<string, string>? SuggestedMappings { get; set; }
    }

    private class UploadResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public int Created { get; set; }
        public int Updated { get; set; }
        public int Unchanged { get; set; }
        public int Errors { get; set; }
        public UploadDetails? Details { get; set; }
    }

    private class UploadDetails
    {
        public List<string>? ErrorList { get; set; }
    }
}
