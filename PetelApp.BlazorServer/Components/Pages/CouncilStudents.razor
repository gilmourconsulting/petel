@page "/councilstudents"
@layout MainLayout
@inherits SecurePageBase
@using PetelApp.BlazorServer.DTOs
@using PetelApp.BlazorServer.Services
@inject ApiService ApiService
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="councilstudents_refresh" OnClick="RefreshData" CssClass="context-btn">
            רענן נתונים
        </SecureButton>
        <div class="context-spacer"></div>
        <SecureButton ActionName="councilstudents_councilsummary" OnClick="NavigateBackToCouncilSummary" CssClass="context-navigation-btn">
            חזרה לסיכום רשויות
        </SecureButton>
    </div>

    <!-- Main content -->
    <div class="students-content">
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">תלמידי רשות - @_councilName</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="dashboard-cards-wrapper" style="margin-bottom: 20px;">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <!-- Total Students Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">👥</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_totalStudents</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">סה"כ תלמידים</div>
                    </div>
                </div>

                <!-- Total Schools Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">🏫</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_totalSchools</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">בתי ספר</div>
                    </div>
                </div>

                <!-- Total Amount Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">💰</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 1.2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_totalAmount.ToString("N2") ₪</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">סה"כ סכום</div>
                    </div>
                </div>

                <!-- Average Amount Card -->
                <div class="summary-card" style="min-width: 200px; background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);">
                    <div style="font-size: 40px; opacity: 0.8;">📊</div>
                    <div style="flex: 1; text-align: right;">
                        <div style="font-size: 1.2em; font-weight: 700; color: #2c3e50; line-height: 1; margin-bottom: 5px;">@_avgAmount.ToString("N2") ₪</div>
                        <div style="font-size: 0.9em; color: #666; font-weight: 500;">ממוצע לתלמיד</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Students Table Section -->
        <div class="content-card">
            <div class="detail-card expanded">
                <div class="detail-card-header">
                    <h2 class="detail-card-title">רשימת תלמידים</h2>
                </div>
                <div class="detail-card-content" style="min-height: 400px; max-height: none;">
                    @if (_isLoading)
                    {
                        <div class="loading-spinner">טוען נתוני תלמידים...</div>
                    }
                    else if (_students == null || _students.Count == 0)
                    {
                        <div class="no-data-message">לא נמצאו תלמידים לרשות זו</div>
                    }
                    else
                    {
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.IdNumber))" style="cursor: pointer;">
                                            תז @GetSortArrow(nameof(CouncilStudentDto.IdNumber))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.FirstName))" style="cursor: pointer;">
                                            שם פרטי @GetSortArrow(nameof(CouncilStudentDto.FirstName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.LastName))" style="cursor: pointer;">
                                            שם משפחה @GetSortArrow(nameof(CouncilStudentDto.LastName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.Gender))" style="cursor: pointer;">
                                            מגדר @GetSortArrow(nameof(CouncilStudentDto.Gender))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.SchoolName))" style="cursor: pointer;">
                                            בית ספר @GetSortArrow(nameof(CouncilStudentDto.SchoolName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.ClassName))" style="cursor: pointer;">
                                            כיתה @GetSortArrow(nameof(CouncilStudentDto.ClassName))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.Status))" style="cursor: pointer;">
                                            סטטוס @GetSortArrow(nameof(CouncilStudentDto.Status))
                                        </th>
                                        <th @onclick="() => SortTable(nameof(CouncilStudentDto.Cost))" style="cursor: pointer;">
                                            סכום @GetSortArrow(nameof(CouncilStudentDto.Cost))
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in _students)
                                    {
                                        <tr>
                                            <td>
                                                <SecureButton ActionName="councilstudents_viewstudent" OnClick="() => ViewStudent(student.Id)" CssClass="btn-icon" Title="צפה בפרטי תלמיד">
                                                    <img src="/images/view_icon.png" alt="צפייה" class="action-icon-natural">
                                                </SecureButton>
                                            </td>
                                            <td>@student.IdNumber</td>
                                            <td>@student.FirstName</td>
                                            <td>@student.LastName</td>
                                            <td>@GetGenderDisplay(student.Gender)</td>
                                            <td>@student.SchoolName</td>
                                            <td>@student.ClassName</td>
                                            <td>@student.Status</td>
                                            <td>@(student.Cost?.ToString("N2") ?? "0.00") ₪</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override string PageName => "councilstudents";
    
    private List<CouncilStudentDto> _students = new();
    private bool _isLoading = true;
    private string _councilName = string.Empty;
    private string _yearDisplay = string.Empty;
    private int _totalStudents = 0;
    private int _totalSchools = 0;
    private decimal _totalAmount = 0;
    private decimal _avgAmount = 0;

    private string _sortColumn = nameof(CouncilStudentDto.LastName);
    private bool _sortAscending = true;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            // Get council info from session
            var councilIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedCouncilId");
            
            if (councilIdResponse == null || !councilIdResponse.TryGetValue("value", out var councilIdStr))
            {
                await JSRuntime.InvokeVoidAsync("alert", "לא נבחרה רשות");
                Navigation.NavigateTo("/councilsummary");
                return;
            }

            var councilId = int.Parse(councilIdStr);

            // Get council name from session
            var councilNameResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedCouncilName");
            
            if (councilNameResponse != null && councilNameResponse.TryGetValue("value", out var councilName))
            {
                _councilName = councilName;
            }

            // Get year display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedYearValue");
            
            if (yearValueResponse != null && yearValueResponse.TryGetValue("value", out var yearValue))
            {
                _yearDisplay = $"שנת לימודים: {yearValue}";
            }

            // Get year ID from session
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedYearId");
            
            int? yearId = null;
            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                yearId = int.Parse(yearIdStr);
            }

            // Load students by council
            var endpoint = yearId.HasValue
                ? $"students/by-council?councilId={councilId}&yearId={yearId.Value}"
                : $"students/by-council?councilId={councilId}";

            var response = await ApiService.GetAsync<CouncilStudentsResponse>(endpoint);

            if (response?.Success == true && response.Data != null)
            {
                _students = response.Data;
                CalculateSummary();
                ApplySort();
            }
            else
            {
                _students = new List<CouncilStudentDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading council students: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת תלמידי הרשות: {ex.Message}");
            _students = new List<CouncilStudentDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CalculateSummary()
    {
        _totalStudents = _students.Count;
        _totalSchools = _students.Select(s => s.SchoolName).Where(s => !string.IsNullOrEmpty(s)).Distinct().Count();
        _totalAmount = _students.Sum(s => s.Cost ?? 0);
        _avgAmount = _totalStudents > 0 ? _totalAmount / _totalStudents : 0;
    }

    private void SortTable(string columnName)
    {
        if (_sortColumn == columnName)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = columnName;
            _sortAscending = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        if (_students == null || _students.Count == 0) return;

        _students = _sortColumn switch
        {
            nameof(CouncilStudentDto.IdNumber) => _sortAscending
                ? _students.OrderBy(s => s.IdNumber).ToList()
                : _students.OrderByDescending(s => s.IdNumber).ToList(),
            nameof(CouncilStudentDto.FirstName) => _sortAscending
                ? _students.OrderBy(s => s.FirstName).ToList()
                : _students.OrderByDescending(s => s.FirstName).ToList(),
            nameof(CouncilStudentDto.LastName) => _sortAscending
                ? _students.OrderBy(s => s.LastName).ToList()
                : _students.OrderByDescending(s => s.LastName).ToList(),
            nameof(CouncilStudentDto.Gender) => _sortAscending
                ? _students.OrderBy(s => s.Gender).ToList()
                : _students.OrderByDescending(s => s.Gender).ToList(),
            nameof(CouncilStudentDto.SchoolName) => _sortAscending
                ? _students.OrderBy(s => s.SchoolName).ToList()
                : _students.OrderByDescending(s => s.SchoolName).ToList(),
            nameof(CouncilStudentDto.ClassName) => _sortAscending
                ? _students.OrderBy(s => s.ClassName).ToList()
                : _students.OrderByDescending(s => s.ClassName).ToList(),
            nameof(CouncilStudentDto.Status) => _sortAscending
                ? _students.OrderBy(s => s.Status).ToList()
                : _students.OrderByDescending(s => s.Status).ToList(),
            nameof(CouncilStudentDto.Cost) => _sortAscending
                ? _students.OrderBy(s => s.Cost ?? 0).ToList()
                : _students.OrderByDescending(s => s.Cost ?? 0).ToList(),
            _ => _students
        };
    }

    private string GetSortArrow(string columnName)
    {
        if (_sortColumn != columnName) return string.Empty;
        return _sortAscending ? "▲" : "▼";
    }

    private async Task RefreshData()
    {
        await LoadData();
    }

    private async Task ViewStudent(int studentId)
    {
        try
        {
            // Find student in current data to get schoolYearId
            var student = _students.FirstOrDefault(s => s.Id == studentId);
            if (student == null)
            {
                Console.WriteLine($"❌ Student not found: {studentId}");
                return;
            }

            // Store student ID and school year ID in session
            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "SelectedStudentId", value = studentId.ToString() });

            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "SelectedSchoolYearId", value = student.SchoolYearId.ToString() });

            // Store navigation context for back button
            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "NavigationSource", value = "councilstudents" });

            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "NavigationSourceTitle", value = "תלמידי רשות" });

            // Store student data as JSON (for compatibility with existing student page logic)
            var studentData = new
            {
                id = student.Id,
                idNumber = student.IdNumber,
                name = $"{student.FirstName} {student.LastName}".Trim(),
                firstName = student.FirstName,
                lastName = student.LastName,
                gender = student.Gender,
                schoolYearId = student.SchoolYearId,
                schoolName = student.SchoolName,
                className = student.ClassName,
                startDate = student.StartDate?.ToString("dd/MM/yyyy"),
                endDate = student.EndDate?.ToString("dd/MM/yyyy"),
                cost = student.Cost,
                status = student.Status,
                sendingCouncil = _councilName
            };

            await ApiService.PostAsync<object, object>(
                "session/property",
                new { key = "SelectedStudentData", value = System.Text.Json.JsonSerializer.Serialize(studentData) });

            Navigation.NavigateTo("/student");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error navigating to student: {ex.Message}");
        }
    }

    private void NavigateBackToCouncilSummary()
    {
        Navigation.NavigateTo("/councilsummary");
    }

    private string GetGenderDisplay(int? gender)
    {
        return gender switch
        {
            1 => "זכר",
            2 => "נקבה",
            _ => ""
        };
    }
}
