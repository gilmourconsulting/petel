    private async Task LoadDefaultEndHour()
    {
        try
        {
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                var yearId = int.Parse(yearIdStr);
                var response = await ApiService.GetAsync<SchoolAttributeTypesResponse>($"schoolattributes/attribute-types/{yearId}");

                if (response?.Success == true && response.Data != null)
                {
                    var endHourAttr = response.Data.FirstOrDefault(a => a.Id == 8);
                    if (endHourAttr != null && !string.IsNullOrEmpty(endHourAttr.Name))
                    {
                        var timeParts = endHourAttr.Name.Split(':');
                        if (timeParts.Length >= 2)
                        {
                            _classModalHour = int.Parse(timeParts[0]);
                            _classModalMinute = int.Parse(timeParts[1]);
                            return;
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading default end hour: {ex.Message}");
        }

        // Fallback to 13:00
        _classModalHour = 13;
        _classModalMinute = 0;
    }

    private void AdjustTime(bool isHour, int delta)
    {
        if (isHour)
        {
            _classModalHour += delta;
            if (_classModalHour < 0) _classModalHour = 23;
            if (_classModalHour > 23) _classModalHour = 0;
        }
        else
        {
            _classModalMinute += delta;
            if (_classModalMinute < 0) _classModalMinute = 59;
            if (_classModalMinute > 59) _classModalMinute = 0;
        }
    }

    private void ClearEndTime()
    {
        _classModalHour = 0;
        _classModalMinute = 0;
    }

    private void CloseClassModal()
