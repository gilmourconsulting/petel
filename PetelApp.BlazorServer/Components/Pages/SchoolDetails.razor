    private void CloseTrackModal()
    {
        _showTrackModal = false;
        _availableTracks.Clear();
        _availableLevels.Clear();
        _trackLevelConstraints.Clear();
    }

    private async Task OnClassChanged()
    {
        // Reset dependent dropdowns
        _availableTracks.Clear();
        _availableLevels.Clear();
        _trackLevelConstraints.Clear();
        _hoursConstraintText = "";
        _hoursErrorText = "";
        _showHoursError = false;
        
        if (_trackModalClassId == 0)
        {
            if (!_isEditingTrack)
            {
                _trackModalTrackId = 0;
                _trackModalLevelId = null;
            }
            StateHasChanged();
            return;
        }

        try
        {
            _trackModalTracksLoading = true;
            StateHasChanged();

            // Get class level
            var selectedClass = _classes.FirstOrDefault(c => c.Id == _trackModalClassId);
            if (selectedClass == null)
            {
                Console.WriteLine($"❌ Class not found: {_trackModalClassId}");
                return;
            }

            var classLevel = selectedClass.Level.Replace("\"", "״").Replace("'", "׳");
            
            // Get year ID
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            if (yearIdResponse == null || !yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                Console.WriteLine("❌ Failed to get SelectedYearId");
                return;
            }

            var yearId = int.Parse(yearIdStr);
            Console.WriteLine($"📚 Loading tracks for year {yearId} and class level {classLevel}");

            // Load tracks filtered by class level
            var response = await ApiService.GetAsync<TracksResponse>(
                $"tracks/by-year/{yearId}/class-level/{Uri.EscapeDataString(classLevel)}"
            );

            if (response?.Success == true && response.Data != null)
            {
                _availableTracks = response.Data;
                Console.WriteLine($"✅ Loaded {_availableTracks.Count} tracks");
                
                // If editing and track is already selected, load its levels
                if (_isEditingTrack && _trackModalTrackId > 0)
                {
                    await OnTrackChanged();
                }
            }
            else
            {
                Console.WriteLine($"❌ Failed to load tracks: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading tracks: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading tracks: {ex.Message}");
        }
        finally
        {
            _trackModalTracksLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnTrackChanged()
    {
        // Reset dependent dropdown
        _availableLevels.Clear();
        _trackLevelConstraints.Clear();
        _hoursConstraintText = "";
        _hoursErrorText = "";
        _showHoursError = false;

        if (_trackModalTrackId == 0)
        {
            if (!_isEditingTrack)
            {
                _trackModalLevelId = null;
            }
            StateHasChanged();
            return;
        }

        try
        {
            _trackModalLevelsLoading = true;
            StateHasChanged();

            Console.WriteLine($"📚 Loading track levels for track {_trackModalTrackId}");

            // Load track levels
            var response = await ApiService.GetAsync<TrackLevelsResponse>(
                $"tracklevels/by-track/{_trackModalTrackId}"
            );

            if (response?.Success == true && response.Data != null)
            {
                _availableLevels = response.Data;
                Console.WriteLine($"✅ Loaded {_availableLevels.Count} track levels");

                // Store constraints
                _trackLevelConstraints.Clear();
                foreach (var level in _availableLevels)
                {
                    _trackLevelConstraints[level.Id] = (level.MinHours, level.MaxHours);
                }

                // If editing and level is already selected, show its constraints
                if (_isEditingTrack && _trackModalLevelId.HasValue)
                {
                    OnLevelChanged();
                }
            }
            else
            {
                Console.WriteLine($"❌ Failed to load track levels: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading track levels: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading track levels: {ex.Message}");
        }
        finally
        {
            _trackModalLevelsLoading = false;
            StateHasChanged();
        }
    }

    private void OnLevelChanged()
    {
        _hoursErrorText = "";
        _showHoursError = false;

        if (!_trackModalLevelId.HasValue || _trackModalLevelId.Value == 0)
        {
            _hoursConstraintText = "";
            StateHasChanged();
            return;
        }

        if (_trackLevelConstraints.TryGetValue(_trackModalLevelId.Value, out var constraints))
        {
            var minText = $"מינימום: {constraints.minHours}";
            var maxText = constraints.maxHours.HasValue ? $", מקסימום: {constraints.maxHours.Value}" : "";
            _hoursConstraintText = $"({minText}{maxText})";
            
            // Validate current hours value
            ValidateHours();
        }
        
        StateHasChanged();
    }

    private void OnHoursInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var hours))
        {
            _trackModalHours = hours;
            ValidateHours();
        }
    }

    private void ValidateHours()
    {
        if (!_trackModalLevelId.HasValue || _trackModalLevelId.Value == 0)
        {
            _showHoursError = false;
            return;
        }

        if (!_trackLevelConstraints.TryGetValue(_trackModalLevelId.Value, out var constraints))
        {
            _showHoursError = false;
            return;
        }

        var hours = (int)_trackModalHours;

        if (hours < constraints.minHours)
        {
            _hoursErrorText = $"מספר השעות חייב להיות לפחות {constraints.minHours}";
            _showHoursError = true;
        }
        else if (constraints.maxHours.HasValue && hours > constraints.maxHours.Value)
        {
            _hoursErrorText = $"מספר השעות לא יכול לעבור {constraints.maxHours.Value}";
            _showHoursError = true;
        }
        else
        {
            _showHoursError = false;
        }
        
        StateHasChanged();
    }

