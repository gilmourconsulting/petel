@page "/schooldetails"
@layout MainLayout
@inherits SecurePageBase
@using PetelApp.BlazorServer.DTOs
@using PetelApp.BlazorServer.Services
@using PetelApp.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime



<div class="main-container">

    <div class="context-buttons-section">
        <div class="context-spacer"></div>
        <SecureButton ActionName="schooldetails_backToSchoolDashboard" ScreenName="@PageName" FunctionName="NavigateToSchoolDashboard" 
                      OnClick="NavigateToSchoolDashboard" CssClass="context-navigation-btn" Title="לדף בית הספר">
            לדף בית הספר
        </SecureButton>
    </div>

    <div class="students-content">
        <div class="school-title-section">
            <div class="page-title-container">
                <div class="page-title">@_schoolName</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
        </div>
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען נתוני בית ספר...</div>
        }
        else
        {
            <div class="content-card">
                <!-- School Details Card -->
                <div class="detail-card @(_schoolDetailsExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolDetailsExpanded = !_schoolDetailsExpanded"
                        style="cursor: pointer;">
                        <div class="detail-card-title">פרטי בית הספר</div>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _schoolDetailsEditMode = !_schoolDetailsEditMode"
                                title="עריכת פרטי בית ספר">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolDetailsExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolDetailsExpanded ? "block" : "none");">
                        <SchoolDetailsForm SchoolData="@_schoolDetails" 
                            Characterizations="@_characterizations"
                            Councils="@_councils"
                            IsEditMode="@_schoolDetailsEditMode"
                            OnSave="SaveSchoolDetails" />
                    </div>
                </div>

                <!-- School Classes Card -->
                <div class="detail-card @(_schoolClassesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolClassesExpanded = !_schoolClassesExpanded"
                        style="cursor: pointer;">
                        <div class="detail-card-title">כיתות</div>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _classesEditMode = !_classesEditMode" title="עריכת כיתות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_classesEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddClassModal"
                                    title="הוסף כיתה" style="display: @(_schoolClassesExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolClassesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolClassesExpanded ? "block" : "none");">
                        <SchoolClassesTable Classes="@_classes" IsEditMode="@_classesEditMode" OnEdit="EditClass"
                            OnDelete="DeleteClass" />
                    </div>
                </div>

                <!-- School Attributes Card -->
                <div class="detail-card @(_schoolAttributesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolAttributesExpanded = !_schoolAttributesExpanded"
                        style="cursor: pointer;">
                        <div class="detail-card-title">מאפייני בית ספר</div>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _attributesEditMode = !_attributesEditMode" title="עריכת מאפיינים">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolAttributesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolAttributesExpanded ? "block" : "none");">
                        <SchoolAttributesForm Attributes="@_attributes" AttributeTypes="@_attributeTypes"
                            IsEditMode="@_attributesEditMode" IsLoading="@_attributesLoading" OnSave="SaveAttributes" />
                    </div>
                </div>

                <!-- School Tracks Card -->
                <div class="detail-card @(_schoolTracksExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolTracksExpanded = !_schoolTracksExpanded"
                        style="cursor: pointer;">
                        <div class="detail-card-title">מגמות</div>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _tracksEditMode = !_tracksEditMode" title="עריכת מגמות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_tracksEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddTrackModal"
                                    title="הוסף מגמה" style="display: @(_schoolTracksExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolTracksExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolTracksExpanded ? "block" : "none");">
                        <SchoolTracksTable Tracks="@_tracks" IsEditMode="@_tracksEditMode" OnEdit="EditTrack"
                            OnDelete="DeleteTrack" />
                    </div>
                </div>

                <!-- Additional Study Programs Card -->
                <div class="detail-card @(_additionalStudyExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _additionalStudyExpanded = !_additionalStudyExpanded"
                        style="cursor: pointer;">
                        <div class="detail-card-title">תל״ן (תכנית לימודים נוספת)</div>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _additionalStudyEditMode = !_additionalStudyEditMode" title="עריכת תל״ן">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_additionalStudyEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddProgramModal"
                                    title="הוסף תל״ן" style="display: @(_additionalStudyExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_additionalStudyExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_additionalStudyExpanded ? "block" : "none");">
                        <AdditionalStudyProgramsTable Programs="@_additionalStudyPrograms"
                            IsEditMode="@_additionalStudyEditMode" OnEdit="EditProgram" OnDelete="DeleteProgram"
                            OnViewHistory="ViewProgramHistory" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Class Modal -->
@if (_showClassModal)
{
    <div class="modal-overlay" @onclick="CloseClassModal">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>@(_isEditingClass ? "עריכת כיתה" : "הוספת כיתה חדשה")</div>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="classLevel">שכבה:</label>
                    <select id="classLevel" class="form-control" @bind="_classModalData.Level">
                        <option value="">בחר שכבה...</option>
                        @foreach (var level in _gradeLevels)
                        {
                            <option value="@level">@level</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="classNumber">מספר כיתה:</label>
                    <input type="text" id="classNumber" class="form-control" placeholder="הזן מספר כיתה"
                        @bind="_classModalData.ClassNumber">
                </div>

                <div class="form-group">
                    <label>
                        שעת סיום:
                        <span class="text-muted" style="font-size: 0.85em;">(אופציונלי)</span>
                    </label>

                    <div class="d-flex gap-2 align-center" style="direction: ltr;">
                        <!-- Hour Spinner -->
                        <div class="d-flex flex-column align-center">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(true, 1)">▲</button>
                            <input type="text" value="@_classModalHour.ToString("00")" maxlength="2" readonly class="time-input">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(true, -1)">▼</button>
                            <small class="text-muted mt-1">שעה</small>
                        </div>

                        <span class="time-separator">:</span>

                        <!-- Minute Spinner -->
                        <div class="d-flex flex-column align-center">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(false, 1)">▲</button>
                            <input type="text" value="@_classModalMinute.ToString("00")" maxlength="2" readonly class="time-input">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(false, -1)">▼</button>
                            <small class="text-muted mt-1">דקות</small>
                        </div>

                        <!-- Clear Button -->
                        <button type="button" @onclick="ClearEndTime" class="btn-secondary" style="margin-right: 10px;">נקה</button>
                    </div>

                    <small class="text-muted d-block mt-1" style="direction: rtl;">
                        לדוגמה: 14:30
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveClassModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseClassModal">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Track Modal -->
@if (_showTrackModal)
{
    <div class="modal-overlay" @onclick="CloseTrackModal">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>@(_isEditingTrack ? "עריכת מגמה" : "הוספת מגמה חדשה")</div>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="trackClass">כיתה:</label>
                    <select id="trackClass" class="form-control" @bind="_trackModalClassId" @bind:after="OnClassChanged">
                        <option value="0">בחר כיתה...</option>
                        @foreach (var cls in _classes)
                        {
                            <option value="@cls.Id" data-level="@cls.Level">@cls.Level @cls.ClassNumber</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="trackTrack">מגמה:</label>
                    <select id="trackTrack" class="form-control" @bind="_trackModalTrackId" @bind:after="OnTrackChanged" disabled="@(_trackModalTracksLoading || !_availableTracks.Any())">
                        @if (_trackModalTracksLoading)
                        {
                            <option value="0">טוען מגמות...</option>
                        }
                        else if (!_availableTracks.Any())
                        {
                            <option value="0">@(_trackModalClassId > 0 ? "אין מגמות זמינות" : "בחר תחילה כיתה...")</option>
                        }
                        else
                        {
                            <option value="0">בחר מגמה...</option>
                            @foreach (var track in _availableTracks)
                            {
                                <option value="@track.Id">@track.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="trackLevel">רמת מגמה:</label>
                    <select id="trackLevel" class="form-control" @bind="_trackModalLevelId" @bind:after="OnLevelChanged" disabled="@(_trackModalLevelsLoading || !_availableLevels.Any())">
                        @if (_trackModalLevelsLoading)
                        {
                            <option value="0">טוען רמות...</option>
                        }
                        else if (!_availableLevels.Any())
                        {
                            <option value="0">@(_trackModalTrackId > 0 ? "אין רמות זמינות" : "בחר תחילה מגמה...")</option>
                        }
                        else
                        {
                            <option value="0">בחר רמת מגמה...</option>
                            @foreach (var level in _availableLevels)
                            {
                                <option value="@level.Id">@level.LevelName</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="trackHours">
                        מספר שעות:
                        @if (!string.IsNullOrEmpty(_hoursConstraintText))
                        {
                            <span style="color: #6c757d; font-weight: normal; font-size: 0.9em;">@_hoursConstraintText</span>
                        }
                    </label>
                    <input type="number" id="trackHours" class="form-control" placeholder="הזן מספר שעות"
                        min="0" step="1" @bind="_trackModalHours" @oninput="OnHoursInput">
                    @if (_showHoursError)
                    {
                        <div style="color: #dc3545; font-size: 0.85em; margin-top: 5px;">@_hoursErrorText</div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveTrackModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseTrackModal">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Additional Study Program Modal -->
@if (_showProgramModal)
{
    <div class="modal-overlay" @onclick="CloseProgramModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 600px; max-height: 90vh; overflow-y: auto;">
            <div class="modal-header" style="padding: 12px 20px;">
                <div style="margin: 0; display: inline-block;">@(_isEditingProgram ? "עריכת תל״ן" : "הוספת תל״ן חדש")</div>
                @if (!string.IsNullOrEmpty(_programUpdatedInfo))
                {
                    <span style="margin-right: 15px; font-size: 0.85em; color: #666;">@_programUpdatedInfo</span>
                }
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="programClass">כיתה: <span style="color: red;">*</span></label>
                    <select id="programClass" class="form-control" @bind="_programModalData.ClassId" @bind:after="OnProgramClassChanged">
                        <option value="0">בחר כיתה</option>
                        @foreach (var cls in _classes)
                        {
                            <option value="@cls.Id">@cls.Level @cls.ClassNumber</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="programName">שם התל״ן: <span style="color: red;">*</span></label>
                    <input type="text" id="programName" class="form-control" placeholder="הזן שם תל״ן"
                        @bind="_programModalData.Name">
                </div>

                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <label for="programHours">שעות שבועיות: <span style="color: red;">*</span></label>
                        <input type="number" id="programHours" class="form-control" placeholder="מספר שעות"
                            min="0" step="0.5" @bind="_programModalData.WeeklyHours" @bind:after="OnWeeklyHoursChanged">
                    </div>
                    <div style="flex: 1;">
                        <label for="programSessions">מספר מפגשים: <span style="color: red;">*</span></label>
                        <input type="number" id="programSessions" class="form-control" placeholder="מספר מפגשים"
                            min="1" @bind="_programModalData.NumberOfSessions" @bind:after="OnSessionsChanged">
                        <small class="text-muted">@_sessionsRemarkText</small>
                    </div>
                </div>

                <div class="form-group">
                    <label for="programStudents">מספר תלמידים: <span style="color: red;">*</span></label>
                    <div style="display: flex; gap: 8px; align-items: flex-start;">
                        <input type="number" id="programStudents" class="form-control" placeholder="מספר תלמידים"
                            min="1" @bind="_programModalData.NumberOfStudents" @bind:after="OnStudentCountChanged" style="flex: 1;">
                        <button type="button" class="btn btn-secondary" @onclick="UpdateStudentCountFromClass" 
                            title="עדכן לפי מספר תלמידים בכיתה" style="white-space: nowrap; padding: 8px 12px;">
                            <img src="/images/view_icon.png" alt="עדכן" class="action-icon-natural" style="vertical-align: middle;">
                            <span style="margin-right: 4px;">עדכן מכיתה</span>
                        </button>
                    </div>
                </div>

                <!-- Calculation Mode Toggle -->
                <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px;">
                    <label style="display: block; margin-bottom: 10px; font-weight: 600; font-size: 15px;">אופן חישוב:</label>
                    <div style="display: flex; gap: 20px;">
                        <label style="display: flex; align-items: center; cursor: pointer;">
                            <input type="radio" name="calculationMode" value="totalCost" 
                                checked="@(_calculationMode == "totalCost")"
                                @onchange="@(() => ChangeCalculationMode("totalCost"))"
                                style="margin-left: 8px; cursor: pointer;">
                            <span>לפי עלות כוללת</span>
                        </label>
                        <label style="display: flex; align-items: center; cursor: pointer;">
                            <input type="radio" name="calculationMode" value="hourlyCost"
                                checked="@(_calculationMode == "hourlyCost")"
                                @onchange="@(() => ChangeCalculationMode("hourlyCost"))"
                                style="margin-left: 8px; cursor: pointer;">
                            <span>לפי עלות שעתית</span>
                        </label>
                    </div>
                    <small style="color: #6c757d; display: block; margin-top: 8px;">
                        עלות כוללת = שעות שבועיות × מספר מפגשים × עלות שעתית
                    </small>
                </div>

                <!-- Cost and Hourly Cost side by side -->
                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <label for="programCost">
                            עלות:
                            <span style="color: #6c757d; font-size: 0.85em;">@_costLabel</span>
                        </label>
                        <input type="number" id="programCost" class="form-control" placeholder="עלות כוללת"
                            min="0" step="0.01" @bind="_programModalData.Cost" @bind:after="OnCostChanged"
                            readonly="@(_calculationMode == "hourlyCost")"
                            style="direction: ltr; text-align: left; background-color: @(_calculationMode == "hourlyCost" ? "#f8f9fa" : "#fff");">
                        <small style="color: #6c757d; display: block; margin-top: 4px;">@_costHint</small>
                    </div>
                    <div style="flex: 1;">
                        <label for="programHourlyCost">
                            עלות שעתית:
                            <span style="color: #6c757d; font-size: 0.85em;">@_hourlyCostLabel</span>
                        </label>
                        <input type="number" id="programHourlyCost" class="form-control" placeholder="עלות לשעה"
                            min="0" step="0.01" @bind="_programModalData.HourlyCost" @bind:after="OnHourlyCostChanged"
                            readonly="@(_calculationMode == "totalCost")"
                            style="direction: ltr; text-align: left; background-color: @(_calculationMode == "totalCost" ? "#f8f9fa" : "#fff");">
                        <small style="color: #6c757d; display: block; margin-top: 4px;">@_hourlyCostHint</small>
                    </div>
                </div>

                <!-- Approved Amount and Approval Status side by side -->
                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <label for="programApproved">סכום מאושר:</label>
                        <input type="number" id="programApproved" class="form-control" placeholder="הזן סכום מאושר"
                            min="0" step="0.01" @bind="_programModalData.ApprovedAmount" @bind:after="OnApprovedAmountChanged"
                            style="direction: ltr; text-align: left;">
                        <small style="color: #6c757d; display: block; margin-top: 4px;">סכום בש"ח</small>
                    </div>
                    <div style="flex: 1;">
                        <label for="programApprovalStatus">סטטוס אישור:</label>
                        <select id="programApprovalStatus" class="form-control" @bind="_programModalData.ApprovalStatus">
                            <option value="0">לא מאושר</option>
                            <option value="1">מאושר</option>
                            <option value="2">אישור חריג</option>
                        </select>
                    </div>
                </div>

                <!-- Maximum Price Display -->
                @if (_maxAllowedPrice.HasValue)
                {
                    <div style="margin-bottom: 15px; padding: 10px; background-color: #e7f3ff; border: 1px solid #b3d9ff; border-radius: 4px;">
                        <label style="display: block; font-weight: 600; color: #004085; margin-bottom: 5px;">
                            סכום מקסימלי מותר:
                        </label>
                        <div style="font-size: 18px; font-weight: bold; color: #004085;">
                            @_maxAllowedPrice.Value.ToString("C2")
                            @if (_maxPriceTierStudents != _programModalData.NumberOfStudents && _maxPriceTierStudents > 0)
                            {
                                <br />
                                <small style="font-size: 0.85em; font-weight: normal;">
                                    (מבוסס על @_maxPriceTierStudents תלמידים)
                                </small>
                            }
                        </div>
                    </div>
                }

                <!-- Validation Error -->
                @if (_showValidationError)
                {
                    <div style="padding: 10px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 4px; color: #721c24; margin-bottom: 15px;">
                        <strong>שגיאה:</strong> @_validationErrorText
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveProgramModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseProgramModal">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Version History Modal -->
@if (_showVersionHistoryModal)
{
    <div class="modal-overlay" @onclick="CloseVersionHistoryModal">
        <div class="modal-content" @onclick:stopPropagation="true" style="max-width: 800px; max-height: 80vh; overflow-y: auto;">
            <div class="modal-header">
                <div>היסטוריית גרסאות - תל״ן</div>
            </div>
            <div class="modal-body">
                @if (_versionHistoryLoading)
                {
                    <div class="loading-spinner">טוען היסטוריה...</div>
                }
                else if (_versionHistory.Any())
                {
                    @foreach (var version in _versionHistory)
                    {
                        <div class="version-card" style="
                            border: 1px solid #dee2e6;
                            border-radius: 4px;
                            padding: 15px;
                            margin-bottom: 10px;
                            background: @(version.IsLastVersion ? "#e7f3ff" : "#f8f9fa");
                            direction: rtl;
                        ">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <div><strong>@version.CreatedAt.ToString("g", new System.Globalization.CultureInfo("he-IL"))</strong></div>
                                @if (version.IsLastVersion)
                                {
                                    <span style="background: #28a745; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.85em;">גרסה נוכחית</span>
                                }
