@page "/schooldetails"
@layout MainLayout
@using PetelApp.BlazorServer.DTOs
@using PetelApp.BlazorServer.Services
@using PetelApp.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="school-title-section">
    <div class="page-title-container">
        <div class="page-title">@_schoolName</div>
        <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
        <div class="left-spacer"></div>
    </div>
</div>

<div class="main-container">
    <div class="context-buttons-section">
        <div class="context-spacer"></div>
        <button class="context-navigation-btn" @onclick="NavigateToSchoolDashboard" title="לדף בית הספר">
            לדף בית הספר
        </button>
    </div>

    <div class="students-content">
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען נתוני בית ספר...</div>
        }
        else
        {
            <div class="content-card">
                <!-- School Details Card -->
                <div class="detail-card @(_schoolDetailsExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolDetailsExpanded = !_schoolDetailsExpanded" style="cursor: pointer;">
                        <h2 class="detail-card-title">פרטי בית הספר</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => _schoolDetailsEditMode = !_schoolDetailsEditMode" title="עריכת פרטי בית ספר">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolDetailsExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolDetailsExpanded ? "block" : "none");">
                        <SchoolDetailsForm 
                            SchoolData="@_schoolDetails"
                            IsEditMode="@_schoolDetailsEditMode"
                            OnSave="SaveSchoolDetails" />
                    </div>
                </div>

                <!-- School Classes Card -->
                <div class="detail-card @(_schoolClassesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolClassesExpanded = !_schoolClassesExpanded" style="cursor: pointer;">
                        <h2 class="detail-card-title">כיתות</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => _classesEditMode = !_classesEditMode" title="עריכת כיתות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_classesEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddClassModal" title="הוסף כיתה" style="display: @(_schoolClassesExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolClassesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolClassesExpanded ? "block" : "none");">
                        <SchoolClassesTable 
                            Classes="@_classes"
                            IsEditMode="@_classesEditMode"
                            OnEdit="EditClass"
                            OnDelete="DeleteClass" />
                    </div>
                </div>

                <!-- School Attributes Card -->
                <div class="detail-card @(_schoolAttributesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolAttributesExpanded = !_schoolAttributesExpanded" style="cursor: pointer;">
                        <h2 class="detail-card-title">מאפייני בית ספר</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => _attributesEditMode = !_attributesEditMode" title="עריכת מאפיינים">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolAttributesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolAttributesExpanded ? "block" : "none");">
                        <SchoolAttributesForm
                            Attributes="@_attributes"
                            AttributeTypes="@_attributeTypes"
                            IsEditMode="@_attributesEditMode"
                            IsLoading="@_attributesLoading"
                            OnSave="SaveAttributes" />
                    </div>
                </div>

                <!-- School Tracks Card -->
                <div class="detail-card @(_schoolTracksExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolTracksExpanded = !_schoolTracksExpanded" style="cursor: pointer;">
                        <h2 class="detail-card-title">מגמות</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => _tracksEditMode = !_tracksEditMode" title="עריכת מגמות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_tracksEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddTrackModal" title="הוסף מגמה" style="display: @(_schoolTracksExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolTracksExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolTracksExpanded ? "block" : "none");">
                        <SchoolTracksTable
                            Tracks="@_tracks"
                            IsEditMode="@_tracksEditMode"
                            OnEdit="EditTrack"
                            OnDelete="DeleteTrack" />
                    </div>
                </div>

                <!-- Additional Study Programs Card -->
                <div class="detail-card @(_additionalStudyExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _additionalStudyExpanded = !_additionalStudyExpanded" style="cursor: pointer;">
                        <h2 class="detail-card-title">תל״ן (תכנית לימודים נוספת)</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true" @onclick="() => _additionalStudyEditMode = !_additionalStudyEditMode" title="עריכת תל״ן">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_additionalStudyEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddProgramModal" title="הוסף תל״ן" style="display: @(_additionalStudyExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_additionalStudyExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_additionalStudyExpanded ? "block" : "none");">
                        <AdditionalStudyProgramsTable
                            Programs="@_additionalStudyPrograms"
                            IsEditMode="@_additionalStudyEditMode"
                            OnEdit="EditProgram"
                            OnDelete="DeleteProgram"
                            OnViewHistory="ViewProgramHistory" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _isLoading = true;
    private string _schoolName = "ניהול בית ספר";
    private string _yearDisplay = string.Empty;

    // Card expansion states
    private bool _schoolDetailsExpanded = true;
    private bool _schoolClassesExpanded = false;
    private bool _schoolAttributesExpanded = false;
    private bool _schoolTracksExpanded = false;
    private bool _additionalStudyExpanded = false;

    // Edit mode states
    private bool _schoolDetailsEditMode = false;
    private bool _classesEditMode = false;
    private bool _attributesEditMode = false;
    private bool _tracksEditMode = false;
    private bool _additionalStudyEditMode = false;

    // Loading states
    private bool _attributesLoading = true;

    // Data
    private SchoolDetailsDto? _schoolDetails;
    private List<SchoolClassDto> _classes = new();
    private List<SchoolAttributeDto> _attributes = new();
    private List<SchoolAttributeTypeDto> _attributeTypes = new();
    private List<SchoolTrackDto> _tracks = new();
    private List<AdditionalStudyProgramDto> _additionalStudyPrograms = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            // Get school year display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedYearValue");
            if (yearValueResponse != null && yearValueResponse.TryGetValue("value", out var yearValue))
            {
                _yearDisplay = $"שנת לימודים: {yearValue}";
            }

            // Get school name from session
            var schoolNameResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedSchoolName");
            if (schoolNameResponse != null && schoolNameResponse.TryGetValue("value", out var schoolName))
            {
                _schoolName = schoolName;
            }

            // Get Hebrew year ID for attribute types
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedYearId");
            int? yearId = null;
            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                yearId = int.Parse(yearIdStr);
            }

            // Get school year ID
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedSchoolYearId");
            
            if (schoolYearIdResponse != null && schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                var schoolYearId = int.Parse(schoolYearIdStr);

                // Load attribute types first (needs Hebrew year ID)
                if (yearId.HasValue)
                {
                    await LoadSchoolAttributeTypes(yearId.Value);
                }

                // Load all other data (uses school year ID)
                await Task.WhenAll(
                    LoadSchoolDetails(schoolYearId),
                    LoadSchoolClasses(schoolYearId),
                    LoadSchoolAttributes(schoolYearId),
                    LoadSchoolTracks(schoolYearId),
                    LoadAdditionalStudyPrograms(schoolYearId)
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתוני בית ספר: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSchoolDetails(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolDetailsResponse>(
                $"school/by-year/{schoolYearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _schoolDetails = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school details: {ex.Message}");
        }
    }

    private async Task LoadSchoolClasses(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolClassesResponse>(
                $"schoolclasses/by-school-year/{schoolYearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _classes = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading classes: {ex.Message}");
        }
    }

    private async Task LoadSchoolAttributeTypes(int yearId)
    {
        try
        {
            Console.WriteLine($"🔍 Loading attribute types for Hebrew year ID: {yearId}");
            
            var response = await ApiService.GetAsync<SchoolAttributeTypesResponse>(
                $"schoolattributes/attribute-types/{yearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _attributeTypes = response.Data;
                Console.WriteLine($"✅ Loaded {_attributeTypes.Count} attribute types");
                foreach (var attrType in _attributeTypes)
                {
                    Console.WriteLine($"  - {attrType.HebrewName} ({attrType.AttributeValueType})");
                }
            }
            else
            {
                Console.WriteLine($"⚠️ Failed to load attribute types: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading attribute types: {ex.Message}");
        }
        finally
        {
            _attributesLoading = false;
        }
    }

    private async Task LoadSchoolAttributes(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolAttributesResponse>(
                $"schoolattributes/by-school-year/{schoolYearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _attributes = response.Data;
                Console.WriteLine($"✅ Loaded {_attributes.Count} school attributes");
            }
            else
            {
                Console.WriteLine($"⚠️ Failed to load attributes: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading attributes: {ex.Message}");
        }
    }

    private async Task LoadSchoolTracks(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolTracksResponse>(
                $"schooltracks/by-school-year/{schoolYearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _tracks = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
        }
    }

    private async Task LoadAdditionalStudyPrograms(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<AdditionalStudyProgramsResponse>(
                $"schooladditionalstudyprograms/by-school-year/{schoolYearId}");
            
            if (response?.Success == true && response.Data != null)
            {
                _additionalStudyPrograms = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading additional study programs: {ex.Message}");
        }
    }

    private async Task SaveSchoolDetails(SchoolDetailsDto details)
    {
        try
        {
            var response = await ApiService.PutAsync<SchoolDetailsDto, ApiResponse<object>>(
                $"school/details/{details.Id}",
                details);

            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "פרטי בית הספר נשמרו בהצלחה");
                _schoolDetailsEditMode = false;
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת פרטי בית הספר: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving school details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת פרטי בית הספר: {ex.Message}");
        }
    }

    private async Task SaveAttributes(List<SchoolAttributeDto> attributes)
    {
        try
        {
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
                "session/property/SelectedSchoolYearId");
            
            if (schoolYearIdResponse != null && schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                var schoolYearId = int.Parse(schoolYearIdStr);

                var response = await ApiService.PutAsync<List<SchoolAttributeDto>, ApiResponse<object>>(
                    $"schoolattributes/{schoolYearId}",
                    attributes);

                if (response?.Success == true)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "מאפייני בית הספר נשמרו בהצלחה");
                    _attributesEditMode = false;
                    await LoadData();
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת מאפיינים: {response?.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving attributes: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת מאפיינים: {ex.Message}");
        }
    }

    private async Task ShowAddClassModal()
    {
        await JSRuntime.InvokeVoidAsync("alert", "הוספת כיתה - ממשק מלא בפיתוח");
    }

    private async Task EditClass(SchoolClassDto classDto)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"עריכת כיתה {classDto.ClassName} - ממשק מלא בפיתוח");
    }

    private async Task DeleteClass(int classId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם למחוק כיתה זו?");
        if (!confirmed) return;

        try
        {
            var success = await ApiService.DeleteAsync($"schoolclasses/{classId}");

            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "הכיתה נמחקה בהצלחה");
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה במחיקת כיתה");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting class: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה במחיקת כיתה: {ex.Message}");
        }
    }

    private async Task ShowAddProgramModal()
    {
        await JSRuntime.InvokeVoidAsync("alert", "הוספת תל״ן - ממשק מלא בפיתוח");
    }

    private async Task EditProgram(AdditionalStudyProgramDto program)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"עריכת תל״ן {program.Name} - ממשק מלא בפיתוח");
    }

    private async Task DeleteProgram(int programId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם למחוק תל״ן זה?");
        if (!confirmed) return;

        try
        {
            var success = await ApiService.DeleteAsync($"additionalstudyprograms/{programId}");

            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "התל״ן נמחק בהצלחה");
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה במחיקת תל״ן");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting program: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה במחיקת תל״ן: {ex.Message}");
        }
    }

    private async Task ShowAddTrackModal()
    {
        await JSRuntime.InvokeVoidAsync("alert", "הוספת מגמה - ממשק מלא בפיתוח");
    }

    private async Task EditTrack(SchoolTrackDto track)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"עריכת מגמה {track.Track} - ממשק מלא בפיתוח");
    }

    private async Task DeleteTrack(int trackId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם למחוק מגמה זו?");
        if (!confirmed) return;

        try
        {
            var success = await ApiService.DeleteAsync($"schooltracks/{trackId}");

            if (success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "המגמה נמחקה בהצלחה");
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "שגיאה במחיקת מגמה");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting track: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה במחיקת מגמה: {ex.Message}");
        }
    }

    private async Task ViewProgramHistory(int masterId)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"היסטוריית גרסאות עבור תכנית {masterId} - בפיתוח");
    }

    private void NavigateToSchoolDashboard()
    {
        Navigation.NavigateTo("/schooldashboard");
    }
}
