    private async Task UpdateApprovalStatusBasedOnValidation()
    {
        // Only auto-update if this is a new program (not editing)
        if (_isEditingProgram)
        {
            return;
        }

        // Check if sessions is below required
        var sessionsBelowRequired = _programModalData.NumberOfSessions < _requiredSessions;
        
        // Check if approved amount exceeds max allowed
        var approvedExceedsMax = false;
        if (_programModalData.ApprovedAmount.HasValue && 
            _programModalData.ApprovedAmount.Value > 0 && 
            _maxAllowedPrice.HasValue && 
            _programModalData.WeeklyHours > 0)
        {
            var maxAllowed = _maxAllowedPrice.Value * _programModalData.WeeklyHours;
            approvedExceedsMax = _programModalData.ApprovedAmount.Value > maxAllowed;
        }

        // Set approval status based on validation
        if (sessionsBelowRequired || approvedExceedsMax)
        {
            _programModalData.ApprovalStatus = 0;  // Not approved
        }
        else
        {
            _programModalData.ApprovalStatus = 1;  // Approved
        }
        
        StateHasChanged();
    }

    private async Task ValidateApprovedAmount()
    {
        _showValidationError = false;
        
        if (!_programModalData.ApprovedAmount.HasValue || _programModalData.ApprovedAmount.Value == 0 || !_maxAllowedPrice.HasValue)
        {
            return;
        }
        
        var maxAllowed = _maxAllowedPrice.Value * _programModalData.WeeklyHours;
        
        if (_programModalData.ApprovedAmount.Value > maxAllowed)
        {
            _validationErrorText = $"הסכום המאושר ({_programModalData.ApprovedAmount.Value:C2}) עולה על הסכום המקסימלי המותר ({maxAllowed:C2})";
            _showValidationError = true;
        }
        
        StateHasChanged();
    }

