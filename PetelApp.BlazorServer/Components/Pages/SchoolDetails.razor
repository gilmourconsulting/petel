    private async Task LoadSessionsRemark()
    {
        try
        {
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                var yearId = int.Parse(yearIdStr);
                var response = await ApiService.GetAsync<Dictionary<string, object>>(
                    $"schoolyearattributes/year/{yearId}/attribute/additional_study_sessions_required"
                );
                
                if (response != null && response.TryGetValue("data", out var dataObj))
                {
                    var data = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(dataObj.ToString() ?? "{}");
                    if (data != null && data.TryGetValue("value", out var value))
                    {
                        if (int.TryParse(value.ToString(), out int sessions))
                        {
                            _requiredSessions = sessions;
                            _sessionsRemarkText = $"מספר מפגשים נדרש: {sessions}";
                            return;
                        }
                    }
                }
            }
        }
        catch
        {
            // Fallback to default
        }
        
        _requiredSessions = 30;
        _sessionsRemarkText = "ברירת מחדל: 30 מפגשים";
    }

