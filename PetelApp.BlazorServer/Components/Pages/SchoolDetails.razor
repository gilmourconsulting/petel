@page "/schooldetails"
@layout MainLayout
@using PetelApp.BlazorServer.DTOs
@using PetelApp.BlazorServer.Services
@using PetelApp.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionStateService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime



<div class="main-container">

    <div class="context-buttons-section">
        <div class="context-spacer"></div>
        <button class="context-navigation-btn" @onclick="NavigateToSchoolDashboard" title="לדף בית הספר">
            לדף בית הספר
        </button>
    </div>

    <div class="students-content">
        <div class="school-title-section">
            <div class="page-title-container">
                <div class="page-title">@_schoolName</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
        </div>
        @if (_isLoading)
        {
            <div class="loading-spinner">טוען נתוני בית ספר...</div>
        }
        else
        {
            <div class="content-card">
                <!-- School Details Card -->
                <div class="detail-card @(_schoolDetailsExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolDetailsExpanded = !_schoolDetailsExpanded"
                        style="cursor: pointer;">
                        <h2 class="detail-card-title">פרטי בית הספר</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _schoolDetailsEditMode = !_schoolDetailsEditMode"
                                title="עריכת פרטי בית ספר">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolDetailsExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolDetailsExpanded ? "block" : "none");">
                        <SchoolDetailsForm SchoolData="@_schoolDetails" IsEditMode="@_schoolDetailsEditMode"
                            OnSave="SaveSchoolDetails" />
                    </div>
                </div>

                <!-- School Classes Card -->
                <div class="detail-card @(_schoolClassesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolClassesExpanded = !_schoolClassesExpanded"
                        style="cursor: pointer;">
                        <h2 class="detail-card-title">כיתות</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _classesEditMode = !_classesEditMode" title="עריכת כיתות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_classesEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddClassModal"
                                    title="הוסף כיתה" style="display: @(_schoolClassesExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolClassesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolClassesExpanded ? "block" : "none");">
                        <SchoolClassesTable Classes="@_classes" IsEditMode="@_classesEditMode" OnEdit="EditClass"
                            OnDelete="DeleteClass" />
                    </div>
                </div>

                <!-- School Attributes Card -->
                <div class="detail-card @(_schoolAttributesExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolAttributesExpanded = !_schoolAttributesExpanded"
                        style="cursor: pointer;">
                        <h2 class="detail-card-title">מאפייני בית ספר</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _attributesEditMode = !_attributesEditMode" title="עריכת מאפיינים">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            <button class="collapse-toggle">@(_schoolAttributesExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolAttributesExpanded ? "block" : "none");">
                        <SchoolAttributesForm Attributes="@_attributes" AttributeTypes="@_attributeTypes"
                            IsEditMode="@_attributesEditMode" IsLoading="@_attributesLoading" OnSave="SaveAttributes" />
                    </div>
                </div>

                <!-- School Tracks Card -->
                <div class="detail-card @(_schoolTracksExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _schoolTracksExpanded = !_schoolTracksExpanded"
                        style="cursor: pointer;">
                        <h2 class="detail-card-title">מגמות</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _tracksEditMode = !_tracksEditMode" title="עריכת מגמות">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_tracksEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddTrackModal"
                                    title="הוסף מגמה" style="display: @(_schoolTracksExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_schoolTracksExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_schoolTracksExpanded ? "block" : "none");">
                        <SchoolTracksTable Tracks="@_tracks" IsEditMode="@_tracksEditMode" OnEdit="EditTrack"
                            OnDelete="DeleteTrack" />
                    </div>
                </div>

                <!-- Additional Study Programs Card -->
                <div class="detail-card @(_additionalStudyExpanded ? "expanded" : "collapsed")">
                    <div class="detail-card-header" @onclick="() => _additionalStudyExpanded = !_additionalStudyExpanded"
                        style="cursor: pointer;">
                        <h2 class="detail-card-title">תל״ן (תכנית לימודים נוספת)</h2>
                        <div class="card-header-actions">
                            <button class="btn-icon" @onclick:stopPropagation="true"
                                @onclick="() => _additionalStudyEditMode = !_additionalStudyEditMode" title="עריכת תל״ן">
                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                            </button>
                            @if (_additionalStudyEditMode)
                            {
                                <button class="btn-icon" @onclick:stopPropagation="true" @onclick="ShowAddProgramModal"
                                    title="הוסף תל״ן" style="display: @(_additionalStudyExpanded ? "inline-flex" : "none");">
                                    <img src="/images/Plus icon.png" alt="הוסף" class="action-icon-natural">
                                </button>
                            }
                            <button class="collapse-toggle">@(_additionalStudyExpanded ? "×" : "+")</button>
                        </div>
                    </div>
                    <div class="detail-card-content" style="display: @(_additionalStudyExpanded ? "block" : "none");">
                        <AdditionalStudyProgramsTable Programs="@_additionalStudyPrograms"
                            IsEditMode="@_additionalStudyEditMode" OnEdit="EditProgram" OnDelete="DeleteProgram"
                            OnViewHistory="ViewProgramHistory" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Class Modal -->
@if (_showClassModal)
{
    <div class="modal-overlay" @onclick="CloseClassModal">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_isEditingClass ? "עריכת כיתה" : "הוספת כיתה חדשה")</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="classLevel">שכבה:</label>
                    <select id="classLevel" class="form-control" @bind="_classModalData.Level">
                        <option value="">בחר שכבה...</option>
                        @foreach (var level in _gradeLevels)
                        {
                            <option value="@level">@level</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="classNumber">מספר כיתה:</label>
                    <input type="text" id="classNumber" class="form-control" placeholder="הזן מספר כיתה"
                        @bind="_classModalData.ClassNumber">
                </div>

                <div class="form-group">
                    <label>
                        שעת סיום:
                        <span class="text-muted" style="font-size: 0.85em;">(אופציונלי)</span>
                    </label>

                    <div class="d-flex gap-2 align-center" style="direction: ltr;">
                        <!-- Hour Spinner -->
                        <div class="d-flex flex-column align-center">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(true, 1)">▲</button>
                            <input type="text" value="@_classModalHour.ToString("00")" maxlength="2" readonly class="time-input">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(true, -1)">▼</button>
                            <small class="text-muted mt-1">שעה</small>
                        </div>

                        <span class="time-separator">:</span>

                        <!-- Minute Spinner -->
                        <div class="d-flex flex-column align-center">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(false, 1)">▲</button>
                            <input type="text" value="@_classModalMinute.ToString("00")" maxlength="2" readonly class="time-input">
                            <button type="button" class="time-spinner-btn" @onclick="() => AdjustTime(false, -1)">▼</button>
                            <small class="text-muted mt-1">דקות</small>
                        </div>

                        <!-- Clear Button -->
                        <button type="button" @onclick="ClearEndTime" class="btn-secondary" style="margin-right: 10px;">נקה</button>
                    </div>

                    <small class="text-muted d-block mt-1" style="direction: rtl;">
                        לדוגמה: 14:30
                    </small>
                </div>
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveClassModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseClassModal">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Track Modal -->
@if (_showTrackModal)
{
    <div class="modal-overlay" @onclick="CloseTrackModal">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_isEditingTrack ? "עריכת מגמה" : "הוספת מגמה חדשה")</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="trackClass">כיתה:</label>
                    <select id="trackClass" class="form-control" @bind="_trackModalClassId">
                        <option value="0">בחר כיתה...</option>
                        @foreach (var cls in _classes)
                        {
                            <option value="@cls.Id">@cls.Level @cls.ClassNumber</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="trackTrack">מגמה:</label>
                    <input type="number" id="trackTrack" class="form-control" placeholder="מזהה מגמה"
                        @bind="_trackModalTrackId">
                    <small class="text-muted">הזן מזהה מגמה זמני (יש לפתח dropdown מלא עם מגמות)</small>
                </div>

                <div class="form-group">
                    <label for="trackLevel">רמת מגמה (אופציונלי):</label>
                    <input type="number" id="trackLevel" class="form-control" placeholder="מזהה רמה"
                        @bind="_trackModalLevelId">
                    <small class="text-muted">הזן מזהה רמה זמני (יש לפתח dropdown מלא עם רמות)</small>
                </div>

                <div class="form-group">
                    <label for="trackHours">מספר שעות:</label>
                    <input type="number" id="trackHours" class="form-control" placeholder="הזן מספר שעות"
                        min="0" step="0.5" @bind="_trackModalHours">
                </div>
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveTrackModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseTrackModal">ביטול</button>
            </div>
        </div>
    </div>
}

<!-- Additional Study Program Modal -->
@if (_showProgramModal)
{
    <div class="modal-overlay" @onclick="CloseProgramModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_isEditingProgram ? "עריכת תל״ן" : "הוספת תל״ן חדש")</h3>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="programClass">כיתה: <span style="color: red;">*</span></label>
                    <select id="programClass" class="form-control" @bind="_programModalData.ClassId">
                        <option value="0">בחר כיתה</option>
                        @foreach (var cls in _classes)
                        {
                            <option value="@cls.Id">@cls.Level @cls.ClassNumber</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="programName">שם התל״ן: <span style="color: red;">*</span></label>
                    <input type="text" id="programName" class="form-control" placeholder="הזן שם תל״ן"
                        @bind="_programModalData.Name">
                </div>

                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <label for="programHours">שעות שבועיות: <span style="color: red;">*</span></label>
                        <input type="number" id="programHours" class="form-control" placeholder="מספר שעות"
                            min="0" step="0.5" @bind="_programModalData.WeeklyHours">
                    </div>
                    <div style="flex: 1;">
                        <label for="programSessions">מספר מפגשים: <span style="color: red;">*</span></label>
                        <input type="number" id="programSessions" class="form-control" placeholder="מספר מפגשים"
                            min="1" @bind="_programModalData.Sessions">
                        <small class="text-muted">ברירת מחדל: 30 מפגשים</small>
                    </div>
                </div>

                <div class="form-group">
                    <label for="programStudents">מספר תלמידים: <span style="color: red;">*</span></label>
                    <input type="number" id="programStudents" class="form-control" placeholder="מספר תלמידים"
                        min="1" @bind="_programModalData.NumberOfStudents">
                </div>

                <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                    <div style="flex: 1;">
                        <label for="programCost">עלות:</label>
                        <input type="number" id="programCost" class="form-control" placeholder="עלות"
                            min="0" step="0.01" @bind="_programModalData.Cost" style="direction: ltr; text-align: left;">
                    </div>
                    <div style="flex: 1;">
                        <label for="programHourlyCost">עלות שעתית:</label>
                        <input type="number" id="programHourlyCost" class="form-control" placeholder="עלות שעתית"
                            min="0" step="0.01" @bind="_programModalData.HourlyCost" style="direction: ltr; text-align: left;">
                    </div>
                </div>

                <div class="form-group">
                    <label for="programApproved">סכום מאושר:</label>
                    <input type="number" id="programApproved" class="form-control" placeholder="סכום מאושר"
                        min="0" step="0.01" @bind="_programModalData.ApprovedAmount" style="direction: ltr; text-align: left;">
                </div>
            </div>
            <div class="modal-footer">
                <button class="dialog-btn save" @onclick="SaveProgramModal">אישור</button>
                <button class="dialog-btn cancel" @onclick="CloseProgramModal">ביטול</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string _schoolName = "ניהול בית ספר";
    private string _yearDisplay = string.Empty;

    // Card expansion states
    private bool _schoolDetailsExpanded = true;
    private bool _schoolClassesExpanded = false;
    private bool _schoolAttributesExpanded = false;
    private bool _schoolTracksExpanded = false;
    private bool _additionalStudyExpanded = false;

    // Edit mode states
    private bool _schoolDetailsEditMode = false;
    private bool _classesEditMode = false;
    private bool _attributesEditMode = false;
    private bool _tracksEditMode = false;
    private bool _additionalStudyEditMode = false;

    // Loading states
    private bool _attributesLoading = true;

    // Data
    private SchoolDetailsDto? _schoolDetails;
    private List<SchoolClassDto> _classes = new();
    private List<SchoolAttributeDto> _attributes = new();
    private List<SchoolAttributeTypeDto> _attributeTypes = new();
    private List<SchoolTrackDto> _tracks = new();
    private List<AdditionalStudyProgramDto> _additionalStudyPrograms = new();

    // Class modal state
    private bool _showClassModal = false;
    private bool _isEditingClass = false;
    private SchoolClassDto _classModalData = new();
    private int _classModalHour = 13;
    private int _classModalMinute = 0;
    private string[] _gradeLevels = new[] { "א", "ב", "ג", "ד", "ה", "ו", "ז", "ח", "ט", "י", "י״א", "י״ב" };

    // Track modal state
    private bool _showTrackModal = false;
    private bool _isEditingTrack = false;
    private int _trackModalClassId = 0;
    private int _trackModalTrackId = 0;
    private int? _trackModalLevelId = null;
    private decimal _trackModalHours = 0;
    private int _trackModalId = 0;

    // Additional Study Program modal state
    private bool _showProgramModal = false;
    private bool _isEditingProgram = false;
    private AdditionalStudyProgramDto _programModalData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            // Get school year display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            "session/property/SelectedYearValue");
            if (yearValueResponse != null && yearValueResponse.TryGetValue("value", out var yearValue))
            {
                _yearDisplay = $"שנת לימודים: {yearValue}";
            }

            // Get school name from session
            var schoolNameResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            "session/property/SelectedSchoolName");
            if (schoolNameResponse != null && schoolNameResponse.TryGetValue("value", out var schoolName))
            {
                _schoolName = schoolName;
            }

            // Get Hebrew year ID for attribute types
            var yearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            "session/property/SelectedYearId");
            int? yearId = null;
            if (yearIdResponse != null && yearIdResponse.TryGetValue("value", out var yearIdStr))
            {
                yearId = int.Parse(yearIdStr);
            }

            // Get school year ID
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
            "session/property/SelectedSchoolYearId");

            if (schoolYearIdResponse != null && schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                var schoolYearId = int.Parse(schoolYearIdStr);

                // Load attribute types first (needs Hebrew year ID)
                if (yearId.HasValue)
                {
                    await LoadSchoolAttributeTypes(yearId.Value);
                }

                // Load all other data (uses school year ID)
                await Task.WhenAll(
                LoadSchoolDetails(schoolYearId),
                LoadSchoolClasses(schoolYearId),
                LoadSchoolAttributes(schoolYearId),
                LoadSchoolTracks(schoolYearId),
                LoadAdditionalStudyPrograms(schoolYearId)
                );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בטעינת נתוני בית ספר: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadSchoolDetails(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolDetailsResponse>(
            $"school/by-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                _schoolDetails = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school details: {ex.Message}");
        }
    }

    private async Task LoadSchoolClasses(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolClassesResponse>(
            $"schoolclasses/by-school-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                _classes = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading classes: {ex.Message}");
        }
    }

    private async Task LoadSchoolAttributeTypes(int yearId)
    {
        try
        {
            Console.WriteLine($"🔍 Loading attribute types for Hebrew year ID: {yearId}");

            var response = await ApiService.GetAsync<SchoolAttributeTypesResponse>(
            $"schoolattributes/attribute-types/{yearId}");

            if (response?.Success == true && response.Data != null)
            {
                _attributeTypes = response.Data;
                Console.WriteLine($"✅ Loaded {_attributeTypes.Count} attribute types");
                foreach (var attrType in _attributeTypes)
                {
                    Console.WriteLine($" - {attrType.HebrewName} ({attrType.AttributeValueType})");
                }
            }
            else
            {
                Console.WriteLine($"⚠️ Failed to load attribute types: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading attribute types: {ex.Message}");
        }
        finally
        {
            _attributesLoading = false;
        }
    }

    private async Task LoadSchoolAttributes(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolAttributesResponse>(
            $"schoolattributes/by-school-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                _attributes = response.Data;
                Console.WriteLine($"✅ Loaded {_attributes.Count} school attributes");
            }
            else
            {
                Console.WriteLine($"⚠️ Failed to load attributes: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading attributes: {ex.Message}");
        }
    }

    private async Task LoadSchoolTracks(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<SchoolTracksResponse>(
            $"schooltracks/by-school-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                _tracks = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
        }
    }

    private async Task LoadAdditionalStudyPrograms(int schoolYearId)
    {
        try
        {
            var response = await ApiService.GetAsync<AdditionalStudyProgramsResponse>(
            $"schooladditionalstudyprograms/by-school-year/{schoolYearId}");

            if (response?.Success == true && response.Data != null)
            {
                _additionalStudyPrograms = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading additional study programs: {ex.Message}");
        }
    }

    private async Task SaveSchoolDetails(SchoolDetailsDto details)
    {
        try
        {
            var response = await ApiService.PutAsync<SchoolDetailsDto, ApiResponse<object>>(
            $"school/details/{details.Id}",
            details);

            if (response?.Success == true)
            {
                await JSRuntime.InvokeVoidAsync("alert", "פרטי בית הספר נשמרו בהצלחה");
                _schoolDetailsEditMode = false;
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת פרטי בית הספר: {response?.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving school details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת פרטי בית הספר: {ex.Message}");
        }
    }

    private async Task SaveAttributes(List<SchoolAttributeDto> attributes)
    {
        try
        {
            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>(
