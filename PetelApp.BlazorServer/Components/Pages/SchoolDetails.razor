    private async Task SaveClassModal()
    {
        // Validate required fields
        if (string.IsNullOrWhiteSpace(_classModalData.Level) || string.IsNullOrWhiteSpace(_classModalData.ClassNumber))
        {
            await JSRuntime.InvokeVoidAsync("alert", "נא למלא את כל השדות הנדרשים");
            return;
        }

        // Normalize Hebrew quotes
        _classModalData.Level = _classModalData.Level.Replace("\"", "״").Replace("'", "׳");

        // Check for duplicates
        var exists = _classes.Any(c =>
            c.Id != _classModalData.Id &&
            c.Level == _classModalData.Level &&
            c.ClassNumber == _classModalData.ClassNumber
        );

        if (exists)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"כיתה {_classModalData.Level} {_classModalData.ClassNumber} כבר קיימת");
            return;
        }

        try
        {
            // Build end hour string
            var endHourStr = $"{_classModalHour:00}:{_classModalMinute:00}:00";

            var schoolYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedSchoolYearId");
            if (schoolYearIdResponse != null && schoolYearIdResponse.TryGetValue("value", out var schoolYearIdStr))
            {
                var schoolYearId = int.Parse(schoolYearIdStr);

                if (_isEditingClass)
                {
                    // Update existing class
                    var updateRequest = new
                    {
                        level = _classModalData.Level,
                        classNumber = _classModalData.ClassNumber,
                        endHour = endHourStr
                    };

                    var response = await ApiService.PutAsync<object, ApiResponse<object>>(
                        $"schoolclasses/{_classModalData.Id}",
                        updateRequest
                    );

                    if (response?.Success == true)
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "הכיתה עודכנה בהצלחה");
                        _showClassModal = false;
                        await LoadSchoolClasses(schoolYearId);
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בעדכון כיתה: {response?.Message}");
                    }
                }
                else
                {
                    // Create new class
                    var createRequest = new
                    {
                        schoolYearId = schoolYearId,
                        level = _classModalData.Level,
                        classNumber = _classModalData.ClassNumber,
                        endHour = endHourStr
                    };

                    var response = await ApiService.PostAsync<object, ApiResponse<object>>(
                        "schoolclasses",
                        createRequest
                    );

                    if (response?.Success == true)
                    {
                        await JSRuntime.InvokeVoidAsync("alert", "הכיתה נוספה בהצלחה");
                        _showClassModal = false;
                        await LoadSchoolClasses(schoolYearId);
                    }
                    else
                    {
                        await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בהוספת כיתה: {response?.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error saving class: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", $"שגיאה בשמירת כיתה: {ex.Message}");
        }
    }

