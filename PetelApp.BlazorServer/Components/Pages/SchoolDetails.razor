                }
                else
                {
                    var createRequest = new
                    {
                        schoolYearId = schoolYearId,
                        trackId = _trackModalTrackId,
                        trackLevelId = _trackModalLevelId,
                        classId = _trackModalClassId,
                        weeklyHours = _trackModalHours
                    };

