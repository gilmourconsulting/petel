    private void UpdateCalculationModeLabels()
    {
        if (_calculationMode == "totalCost")
        {
            _costLabel = "";
            _hourlyCostLabel = "(מחושב אוטומטית)";
            _costHint = "עלות כוללת בש\"ח";
            _hourlyCostHint = "מחושב: עלות ÷ (שעות × מפגשים)";
        }
        else
        {
            _costLabel = "(מחושב אוטומטית)";
            _hourlyCostLabel = "";
            _costHint = "מחושב: שעות × מפגשים × עלות שעתית";
            _hourlyCostHint = "עלות שעתית בש\"ח";
        }
    }

    private async Task RecalculateCosts()
    {
        var hours = _programModalData.WeeklyHours;
        var sessions = _programModalData.NumberOfSessions;
        
        if (hours <= 0 || sessions <= 0) return;
        
        if (_calculationMode == "totalCost")
        {
            // Calculate hourly cost from total cost
            if (_programModalData.Cost.HasValue && _programModalData.Cost.Value > 0)
            {
                _programModalData.HourlyCost = Math.Round(_programModalData.Cost.Value / (hours * sessions), 2);
            }
        }
        else
        {
            // Calculate total cost from hourly cost
            if (_programModalData.HourlyCost.HasValue && _programModalData.HourlyCost.Value > 0)
            {
                _programModalData.Cost = Math.Round(_programModalData.HourlyCost.Value * hours * sessions, 2);
            }
        }
        
        // Check if sessions affects approval status
        await UpdateApprovalStatusBasedOnValidation();
        
        StateHasChanged();
    }

