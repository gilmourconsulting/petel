@page "/security-test"
@layout MainLayout
@inherits SecurePageBase
@using PetelApp.BlazorServer.Components.Shared
@inject IJSRuntime JSRuntime

<div class="main-container">
    <div class="content-card">
        <h1 style="margin-bottom: 30px;">🧪 Security System Test Page</h1>
        
        <div style="background: #fff3cd; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #ffc107;">
            <h3 style="margin: 0 0 10px 0;">⚠️ Testing Page - Auto-Create Feature</h3>
            <p style="margin: 0;">
                This page tests the security system's auto-create feature.
                Clicking the buttons below will create new actions in the database if they don't exist.
            </p>
        </div>

        <div style="display: grid; gap: 20px; max-width: 800px;">
            <!-- Test 1: Basic Action -->
            <div class="test-section">
                <h3>Test 1: Basic Action (Will Auto-Create)</h3>
                <p>Action: <code>securitytest_basicAction</code></p>
                <SecureButton
                    ActionName="securitytest_basicAction"
                    ScreenName="@PageName"
                    FunctionName="TestBasicAction"
                    OnClick="TestBasicAction"
                    CssClass="btn-primary">
                    Test Basic Action
                </SecureButton>
                @if (_test1Result != null)
                {
                    <div class="test-result">@_test1Result</div>
                }
            </div>

            <!-- Test 2: Action with Parameters -->
            <div class="test-section">
                <h3>Test 2: Action with Parameters</h3>
                <p>Action: <code>securitytest_actionWithParams</code></p>
                <SecureButton
                    ActionName="securitytest_actionWithParams"
                    ScreenName="@PageName"
                    FunctionName="TestActionWithParams"
                    ActionParams="testId=123,testName=TestUser"
                    OnClick="TestActionWithParams"
                    CssClass="btn-primary">
                    Test Action with Parameters
                </SecureButton>
                @if (_test2Result != null)
                {
                    <div class="test-result">@_test2Result</div>
                }
            </div>

            <!-- Test 3: Hide If No Access -->
            <div class="test-section">
                <h3>Test 3: Hide Button If No Access</h3>
                <p>Action: <code>securitytest_hiddenAction</code></p>
                <p style="color: #666; font-size: 14px;">
                    This button should be hidden if you don't have permission (after auto-create).
                </p>
                <SecureButton
                    ActionName="securitytest_hiddenAction"
                    ScreenName="@PageName"
                    FunctionName="TestHiddenAction"
                    OnClick="TestHiddenAction"
                    HideIfNoAccess="true"
                    CssClass="btn-primary">
                    Test Hidden Action
                </SecureButton>
                @if (_test3Result != null)
                {
                    <div class="test-result">@_test3Result</div>
                }
            </div>

            <!-- Test 4: Disabled State -->
            <div class="test-section">
                <h3>Test 4: Disabled Button</h3>
                <p>Action: <code>securitytest_disabledAction</code></p>
                <div style="margin-bottom: 10px;">
                    <label>
                        <input type="checkbox" @bind="_enableTest4" />
                        Enable Button
                    </label>
                </div>
                <SecureButton
                    ActionName="securitytest_disabledAction"
                    ScreenName="@PageName"
                    FunctionName="TestDisabledAction"
                    OnClick="TestDisabledAction"
                    Disabled="@(!_enableTest4)"
                    CssClass="btn-primary">
                    Test Disabled Action
                </SecureButton>
                @if (_test4Result != null)
                {
                    <div class="test-result">@_test4Result</div>
                }
            </div>

            <!-- Test 5: Execute Secure Action Helper -->
            <div class="test-section">
                <h3>Test 5: ExecuteSecureActionAsync Helper</h3>
                <p>Action: <code>securitytest_helperAction</code></p>
                <button class="btn-primary" @onclick="TestSecureActionHelper">
                    Test Helper Method
                </button>
                @if (_test5Result != null)
                {
                    <div class="test-result">@_test5Result</div>
                }
            </div>
        </div>

        <!-- Database Verification Instructions -->
        <div style="margin-top: 40px; padding: 20px; background: #e7f3ff; border-radius: 8px; border: 1px solid #2196F3;">
            <h3 style="margin: 0 0 15px 0;">📊 Database Verification</h3>
            <p style="margin: 0 0 10px 0;">After clicking the buttons, verify in database:</p>
            <pre style="background: white; padding: 15px; border-radius: 4px; overflow-x: auto;">
SELECT id, action_name, description, is_active, created_at
FROM petel_schema.system_actions
WHERE action_name LIKE 'securitytest_%'
ORDER BY id DESC;</pre>
            
            <p style="margin: 15px 0 10px 0;"><strong>Expected Results:</strong></p>
            <ul style="margin: 0; padding-right: 20px;">
                <li>Actions auto-created with status = ACTIVE</li>
                <li>Description contains "Auto-created: securitytest_..."</li>
                <li>No role assignments (should deny access)</li>
                <li>Audit log entries created in action_audit_logs table</li>
            </ul>

            <p style="margin: 15px 0 10px 0;"><strong>Check Audit Logs:</strong></p>
            <pre style="background: white; padding: 15px; border-radius: 4px; overflow-x: auto;">
SELECT aal.*, sa.action_name, u.username
FROM petel_schema.action_audit_logs aal
JOIN petel_schema.system_actions sa ON aal.action_id = sa.id
JOIN petel_schema.users u ON aal.user_id = u.id
WHERE sa.action_name LIKE 'securitytest_%'
ORDER BY aal.created_at DESC
LIMIT 10;</pre>
        </div>

        <!-- Grant Permission Instructions -->
        <div style="margin-top: 20px; padding: 20px; background: #d4edda; border-radius: 8px; border: 1px solid #28a745;">
            <h3 style="margin: 0 0 15px 0;">✅ Grant Permission (After Auto-Create)</h3>
            <p style="margin: 0 0 10px 0;">To grant yourself access to the auto-created actions:</p>
            <pre style="background: white; padding: 15px; border-radius: 4px; overflow-x: auto;">
-- 1. Get your role ID
SELECT r.id, r.role_name
FROM petel_schema.roles r
JOIN petel_schema.user_roles ur ON r.id = ur.role_id
WHERE ur.user_id = YOUR_USER_ID;

-- 2. Get action IDs
SELECT id, action_name
FROM petel_schema.system_actions
WHERE action_name LIKE 'securitytest_%';

-- 3. Grant permission
INSERT INTO petel_schema.roles_actions (role_id, action_id, created_at)
VALUES 
    (YOUR_ROLE_ID, ACTION_ID_1, CURRENT_TIMESTAMP),
    (YOUR_ROLE_ID, ACTION_ID_2, CURRENT_TIMESTAMP),
    (YOUR_ROLE_ID, ACTION_ID_3, CURRENT_TIMESTAMP);

-- 4. Refresh the page and test again - buttons should now work!</pre>
        </div>
    </div>
</div>

<style>
    .test-section {
        padding: 20px;
        background: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .test-section h3 {
        margin: 0 0 10px 0;
        color: #333;
    }

    .test-section p {
        margin: 0 0 15px 0;
        color: #666;
    }

    .test-section code {
        background: white;
        padding: 2px 8px;
        border-radius: 4px;
        color: #e83e8c;
        font-family: 'Courier New', monospace;
    }

    .test-result {
        margin-top: 15px;
        padding: 15px;
        background: white;
        border-radius: 4px;
        border-left: 4px solid #2196F3;
        font-family: 'Courier New', monospace;
        font-size: 14px;
    }

    .btn-primary {
        padding: 10px 20px;
        background: #2196F3;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 500;
    }

    .btn-primary:hover:not(:disabled) {
        background: #1976D2;
    }

    .btn-primary:disabled {
        background: #ccc;
        cursor: not-allowed;
    }
</style>

@code {
    protected override string PageName => "securitytest";

    private string? _test1Result;
    private string? _test2Result;
    private string? _test3Result;
    private string? _test4Result;
    private string? _test5Result;
    private bool _enableTest4 = false;

    private async Task TestBasicAction()
    {
        _test1Result = $"✅ Action executed successfully at {DateTime.Now:HH:mm:ss}";
        await JSRuntime.InvokeVoidAsync("alert", "Test 1: Basic Action - Success!");
        StateHasChanged();
    }

    private async Task TestActionWithParams()
    {
        _test2Result = $"✅ Action with parameters executed at {DateTime.Now:HH:mm:ss}\nParameters were logged in audit trail";
        await JSRuntime.InvokeVoidAsync("alert", "Test 2: Action with Parameters - Success!\nCheck audit logs for parameters.");
        StateHasChanged();
    }

    private async Task TestHiddenAction()
    {
        _test3Result = $"✅ Hidden action executed at {DateTime.Now:HH:mm:ss}\nIf you see this, you have permission!";
        await JSRuntime.InvokeVoidAsync("alert", "Test 3: Hidden Action - Success!\nThis button should have been hidden if you had no permission.");
        StateHasChanged();
    }

    private async Task TestDisabledAction()
    {
        _test4Result = $"✅ Disabled action executed at {DateTime.Now:HH:mm:ss}";
        await JSRuntime.InvokeVoidAsync("alert", "Test 4: Disabled Action - Success!");
        StateHasChanged();
    }

    private async Task TestSecureActionHelper()
    {
        _test5Result = "🔄 Executing with helper method...";
        StateHasChanged();

        var executed = await ExecuteSecureActionAsync(
            actionName: "securitytest_helperAction",
            functionName: "TestSecureActionHelper",
            action: async () =>
            {
                await Task.Delay(500); // Simulate work
                _test5Result = $"✅ Helper method executed successfully at {DateTime.Now:HH:mm:ss}\nUsed ExecuteSecureActionAsync from SecurePageBase";
            },
            actionParams: "method=helper,testId=999"
        );

        if (!executed)
        {
            _test5Result = "❌ Permission denied by helper method";
        }

        StateHasChanged();
    }
}
