@page "/settings"
@inherits SecurePageBase
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject TokenService TokenService
@inject NavigationManager Navigation

<div class="main-container">
    <div class="content-card">
        <h2>הגדרות משתמש</h2>

        @if (_message != null)
        {
            <div class="@(_messageType == "success" ? "success-alert" : "error-alert")">
                @_message
            </div>
        }

        <!-- User Information -->
        <div class="settings-section">
            <h3>פרטי משתמש</h3>
            <div class="form-row">
                <div class="form-group">
                    <label>שם משתמש</label>
                    <input type="text" class="form-input" value="@_username" disabled />
                </div>
                <div class="form-group">
                    <label>שם מלא</label>
                    <input type="text" class="form-input" value="@_fullName" disabled />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>ישות</label>
                    <input type="text" class="form-input" value="@_entityName" disabled />
                </div>
                <div class="form-group">
                    <label>סוג ישות</label>
                    <input type="text" class="form-input" value="@_entityType" disabled />
                </div>
            </div>
        </div>

        <!-- Change Password -->
        <div class="settings-section">
            <h3>שינוי סיסמה</h3>
            <div class="form-group">
                <label for="currentPassword">סיסמה נוכחית *</label>
                <input type="password" id="currentPassword" @bind="_currentPassword" class="form-input" />
            </div>
            <div class="form-group">
                <label for="newPassword">סיסמה חדשה *</label>
                <input type="password" id="newPassword" @bind="_newPassword" class="form-input" />
            </div>
            <div class="form-group">
                <label for="confirmPassword">אימות סיסמה חדשה *</label>
                <input type="password" id="confirmPassword" @bind="_confirmPassword" class="form-input" />
            </div>
            <button class="btn-primary" @onclick="ChangePassword" disabled="@_isChangingPassword">
                @if (_isChangingPassword)
                {
                    <span>משנה סיסמה...</span>
                }
                else
                {
                    <span>שנה סיסמה</span>
                }
            </button>
        </div>

        <!-- OTP Settings -->
        <div class="settings-section">
            <h3>אימות דו-שלבי (OTP)</h3>
            <div class="form-group">
                <label>
                    <input type="checkbox" @bind="_otpEnabled" disabled />
                    <span>אפשר אימות דו-שלבי</span>
                </label>
                <p class="help-text">אימות דו-שלבי מוסיף שכבת אבטחה נוספת לחשבון שלך</p>
            </div>
            @if (_otpEnabled)
            {
                <div class="info-box">
                    <p>אימות דו-שלבי מופעל. סרוק את קוד ה-QR באפליקציית Authenticator שלך.</p>
                </div>
            }
        </div>

        <!-- Session Information -->
        <div class="settings-section">
            <h3>מידע על הפעלה נוכחית</h3>
            <div class="info-grid">
                <div class="info-item">
                    <strong>זמן התחברות:</strong>
                    <span>@_loginTime</span>
                </div>
                <div class="info-item">
                    <strong>פעילות אחרונה:</strong>
                    <span>@_lastActivity</span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="settings-actions">
            <button class="btn-secondary" @onclick="NavigateBack">חזור</button>
            <button class="btn-danger" @onclick="Logout">התנתק</button>
        </div>
    </div>
</div>

@code {
    private string _username = "";
    private string _fullName = "";
    private string _entityName = "";
    private string _entityType = "";
    private string _loginTime = "";
    private string _lastActivity = "";
    
    private bool _otpEnabled = false;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _isChangingPassword = false;
    
    private string? _message;
    private string _messageType = "error";

    // REQUIRED by SecurePageBase
    protected override string PageName => "settings";

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _username = session.Username;
        _fullName = session.UserFullName;
        _entityName = session.EntityName;
        _entityType = session.EntityTypeName;
        _loginTime = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
        _lastActivity = DateTime.Now.ToString("HH:mm:ss");
    }

    private async Task ChangePassword()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _message = "נא להזין סיסמה נוכחית";
            _messageType = "error";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _message = "נא להזין סיסמה חדשה";
            _messageType = "error";
            return;
        }

        if (_newPassword.Length < 8)
        {
            _message = "הסיסמה חייבת להכיל לפחות 8 תווים";
            _messageType = "error";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _message = "הסיסמאות אינן תואמות";
            _messageType = "error";
            return;
        }

        _isChangingPassword = true;

        try
        {
            var request = new
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword
            };

            var response = await ApiService.PostAsync("auth/change-password", request);
            
            if (response.IsSuccessStatusCode)
            {
                _message = "הסיסמה שונתה בהצלחה";
                _messageType = "success";
                _currentPassword = "";
                _newPassword = "";
                _confirmPassword = "";
            }
            else
            {
                _message = "שגיאה בשינוי סיסמה";
                _messageType = "error";
            }
        }
        catch (Exception ex)
        {
            _message = $"שגיאה: {ex.Message}";
            _messageType = "error";
        }
        finally
        {
            _isChangingPassword = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/maindashboard");
    }

    private async Task Logout()
    {
        await TokenService.ClearTokenAsync();
        SessionState.ClearSession();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

<style>
    .settings-section {
        margin-bottom: 30px;
        padding: 20px;
        background: var(--card-background, #f8f9fa);
        border-radius: 8px;
    }

    .settings-section h3 {
        margin-bottom: 20px;
        color: var(--primary-color, #2c3e50);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-bottom: 15px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 15px;
    }

    .info-item {
        padding: 15px;
        background: white;
        border-radius: 6px;
        border: 1px solid var(--border-color, #dee2e6);
    }

    .info-item strong {
        display: block;
        margin-bottom: 5px;
        color: var(--primary-color, #2c3e50);
    }

    .info-box {
        padding: 15px;
        background: #e3f2fd;
        border: 1px solid #2196f3;
        border-radius: 6px;
        color: #1976d2;
    }

    .help-text {
        margin-top: 5px;
        font-size: 0.9rem;
        color: var(--text-secondary, #6c757d);
    }

    .settings-actions {
        display: flex;
        gap: 15px;
        justify-content: flex-start;
        margin-top: 30px;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-danger:hover {
        background: #c82333;
    }

    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .action-card {
        padding: 30px 20px;
        background: var(--card-background, #f8f9fa);
        border: 2px solid var(--border-color, #dee2e6);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }

    .action-card:hover {
        background: var(--primary-color, #2c3e50);
        color: white;
        border-color: var(--primary-color, #2c3e50);
    }

    .action-icon {
        font-size: 2rem;
        margin-bottom: 10px;
    }

    .action-label {
        font-weight: 600;
    }
</style>
