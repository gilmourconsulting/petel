@page "/schooldashboard"
@layout MainLayout
@using PetelApp.BlazorServer.DTOs
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <button class="context-btn" @onclick="NavigateToStudents">תלמידים</button>
        <button class="context-btn" @onclick="NavigateToSchoolDetails">פרטי בית ספר</button>
        <button class="context-btn" @onclick="NavigateToSchoolDocuments">מסמכים בית ספריים</button>
        <div class="context-spacer"></div>
        @if (_showBackToSchoolList)
        {
            <button class="context-navigation-btn" @onclick="NavigateBackToSchoolList" title="לרשימת בתי הספר">
                לרשימת בתי הספר
            </button>
        }
        <button class="context-navigation-btn" @onclick="NavigateToMainDashboard" title="חזרה למסך הראשי">
            חזרה למסך הראשי
        </button>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-flex-row">
        <!-- School Title Section -->
        <div class="content-header">
            <div class="page-title-container">
                <div class="page-title">@_schoolTitle</div>
                <div class="text-branded" style="text-align: center;">@_yearDisplay</div>
                <div class="left-spacer"></div>
            </div>
            <div class="dashboard-cards-wrapper">
                <!-- Alerts Card -->
                <div class="dashboard-card" id="alertsCard">
                    <div class="dashboard-card-header">
                        <div class="dashboard-card-icon">🔔</div>
                        <div class="dashboard-card-title">התראות</div>
                        <img src="/images/Plus icon.png" alt="הוספה" class="dashboard-card-plus"
                            @onclick="() => ShowAddModal(false)" title="הוספת התראה חדשה" style="cursor: pointer;" />
                    </div>
                    <div class="internal-cards-container">
                        @if (_alertsLoading)
                        {
                            <div class="loading-message">טוען התראות...</div>
                        }
                        else if (_alerts.Count == 0)
                        {
                            <div class="no-data-message">אין התראות להצגה</div>
                        }
                        else
                        {
                            @foreach (var alert in _alerts)
                            {
                                <div class="internal-card">
                                    <div class="internal-card-content">@alert.Description</div>
                                    <div class="internal-card-footer">
                                        <span class="internal-card-date">@alert.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Events Card -->
                <div class="dashboard-card" id="eventsCard">
                    <div class="dashboard-card-header">
                        <div class="dashboard-card-icon">🗓</div>
                        <div class="dashboard-card-title">אירועים</div>
                        <img src="/images/Plus icon.png" alt="הוספה" class="dashboard-card-plus"
                            @onclick="() => ShowAddModal(true)" title="הוספת אירוע חדש" style="cursor: pointer;" />
                    </div>
                    <div class="internal-cards-container">
                        @if (_eventsLoading)
                        {
                            <div class="loading-message">טוען אירועים...</div>
                        }
                        else if (_events.Count == 0)
                        {
                            <div class="no-data-message">אין אירועים להצגה</div>
                        }
                        else
                        {
                            @foreach (var evt in _events)
                            {
                                <div class="internal-card">
                                    <div class="internal-card-content">@evt.Description</div>
                                    <div class="internal-card-footer">
                                        <span class="internal-card-date">@(evt.EventDate?.ToString("dd/MM/yyyy") ??
                                                                            evt.CreatedAt.ToString("dd/MM/yyyy"))</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AlertDto> _alerts = new();
    private List<AlertDto> _events = new();
    private bool _alertsLoading = true;
    private bool _eventsLoading = true;
    private bool _showBackToSchoolList = false;

    private string _schoolTitle = "לוח בקרה של בית ספר";
    private string _yearDisplay = "";
    private string _schoolId = "";

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await ConfigureContextButtons(session);
        await LoadSchoolTitle();
        await ResolveSelectedSchoolYearId();
        await LoadData();
    }

    private async Task ConfigureContextButtons(SessionData session)
    {
        var entityTypeId = int.Parse(session.EntityTypeId);

        // Show "Back to School List" button for multi-school entities only
        _showBackToSchoolList = entityTypeId != 1 && entityTypeId != 4;

        Console.WriteLine($"📋 Entity type: {entityTypeId}, Show back button: {_showBackToSchoolList}");
    }

    private async Task LoadSchoolTitle()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();

            // Get year value for display
            var yearValueResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearValue");
            _yearDisplay = yearValueResponse?["value"] ?? "";

            // Get school name from session
            var schoolNameResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedSchoolName");
            var schoolName = schoolNameResponse?["value"] ?? session?.EntityName ?? "";

            _schoolTitle = $"{schoolName}";

            Console.WriteLine($"🏫 School title: {_schoolTitle}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school title: {ex.Message}");
            _schoolTitle = "לוח בקרה של בית ספר";
        }
    }

    private async Task ResolveSelectedSchoolYearId()
    {
        try
        {
            var selectedYearIdResponse = await ApiService.GetAsync<Dictionary<string, string>>("session/property/SelectedYearId");
            var selectedYearId = selectedYearIdResponse?["value"];

            var selectedSchoolIdResponse = await ApiService.GetAsync<Dictionary<string,
            string>>("session/property/SelectedSchoolId");
            var selectedSchoolId = selectedSchoolIdResponse?["value"];

            Console.WriteLine($"🔎 Resolving SelectedSchoolYearId: yearId={selectedYearId}, schoolId={selectedSchoolId}");

            if (string.IsNullOrEmpty(selectedYearId) || string.IsNullOrEmpty(selectedSchoolId))
            {
                Console.WriteLine("⚠ Missing SelectedYearId or SelectedSchoolId; skipping school_year lookup");
                return;
            }

            var schoolYear = await ApiService.GetAsync<SchoolYearLookupDto>(
            $"schoolYears/by-year-and-school?yearId={selectedYearId}&schoolId={selectedSchoolId}");

            if (schoolYear?.Id > 0)
            {
                await ApiService.PostAsync<object, object>("session/property", new
                {
                    key = "SelectedSchoolYearId",
                    value = schoolYear.Id.ToString()
                });

                Console.WriteLine($"✅ Stored SelectedSchoolYearId in session: {schoolYear.Id}");
            }
            else
            {
                Console.WriteLine("⚠ school_year not found for given yearId/schoolId");

                await ApiService.PostAsync<object, object>("session/property", new
                {
                    key = "SelectedSchoolYearId",
                    value = ""
                });
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error resolving SelectedSchoolYearId: {ex.Message}");
        }
    }

    private async Task LoadData()
    {
        try
        {
            var session = await SessionState.GetSessionAsync();
            var entityTypeId = int.Parse(session.EntityTypeId);

            // Determine which school ID to use
            if (entityTypeId == 5)
            {
                // Multi-school network - use SelectedSchoolId
                var selectedSchoolIdResponse = await ApiService.GetAsync<Dictionary<string,
                string>>("session/property/SelectedSchoolId");
                _schoolId = selectedSchoolIdResponse?["value"] ?? "";

                if (string.IsNullOrEmpty(_schoolId))
                {
                    Console.WriteLine("⚠️ No SelectedSchoolId in session");
                    return;
                }
            }
            else
            {
                // Single school - use entity ID
                _schoolId = session.EntityId;
            }

            Console.WriteLine($"🏫 Loading alerts for school: {_schoolId}");

            await Task.WhenAll(LoadAlerts(), LoadEvents());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private async Task LoadAlerts()
    {
        _alertsLoading = true;
        try
        {
            if (!string.IsNullOrEmpty(_schoolId))
            {
                _alerts = await ApiService.GetAsync<List<AlertDto>>($"alerts/entity/{_schoolId}?isEvent=false") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading alerts: {ex.Message}");
        }
        finally
        {
            _alertsLoading = false;
        }
    }

    private async Task LoadEvents()
    {
        _eventsLoading = true;
        try
        {
            if (!string.IsNullOrEmpty(_schoolId))
            {
                _events = await ApiService.GetAsync<List<AlertDto>>($"alerts/entity/{_schoolId}?isEvent=true") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading events: {ex.Message}");
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    private async Task ShowAddModal(bool isEvent)
    {
        await JSRuntime.InvokeVoidAsync("alert", isEvent ? "הוספת אירוע - בפיתוח" : "הוספת התראה - בפיתוח");
    }

    private void NavigateToStudents()
    {
        Navigation.NavigateTo("/students");
    }

    private void NavigateToSchoolDetails()
    {
        Navigation.NavigateTo("/schooldetails");
    }

    private void NavigateToSchoolDocuments()
    {
        Navigation.NavigateTo("/schooldocuments");
    }

    private void NavigateBackToSchoolList()
    {
        Navigation.NavigateTo("/schoollist");
    }

    private void NavigateToMainDashboard()
    {
        Navigation.NavigateTo("/maindashboard");
    }
}