@page "/maindashboard"
@layout MainLayout
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation

<!-- Context Buttons Section (RIGHT side) -->
<div class="context-buttons-section">
    <button class="context-btn" @onclick="PreviousYear">@_previousYearName</button>
    <button class="context-btn active" @onclick="CurrentYear">@_currentYearName</button>
    @if (_nextYearId > 0)
    {
        <button class="context-btn" @onclick="NextYear">@_nextYearName</button>
    }
    <div class="context-spacer"></div>
    @if (_showEntityDetailsButton)
    {
        <button class="context-navigation-btn" @onclick="NavigateToEntityDetails">פרטי ישות</button>
    }
</div>

<!-- Dashboard Content (LEFT side, takes flex: 1) -->
<div class="dashboard-flex-row">
    <div class="dashboard-cards-wrapper">
        <!-- Alerts Card -->
        <div class="dashboard-card" id="alertsCard">
            <div class="dashboard-card-header">
                <div class="dashboard-card-icon">🔔</div>
                <div class="dashboard-card-title">התראות</div>
            </div>
            <div class="internal-cards-container">
                @if (_alertsLoading)
                {
                    <div class="loading-message">טוען התראות...</div>
                }
                else if (_alerts.Count == 0)
                {
                    <div class="no-data-message">אין התראות להצגה</div>
                }
                else
                {
                    @foreach (var alert in _alerts)
                    {
                        <div class="internal-card">
                            <div class="internal-card-content">@alert.Description</div>
                            <div class="internal-card-footer">
                                <span class="internal-card-date">@alert.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
        <!-- Events Card -->
        <div class="dashboard-card" id="eventsCard">
            <div class="dashboard-card-header">
                <div class="dashboard-card-icon">🗓</div>
                <div class="dashboard-card-title">אירועים</div>
            </div>
            <div class="internal-cards-container">
                @if (_eventsLoading)
                {
                    <div class="loading-message">טוען אירועים...</div>
                }
                else if (_events.Count == 0)
                {
                    <div class="no-data-message">אין אירועים להצגה</div>
                }
                else
                {
                    @foreach (var evt in _events)
                    {
                        <div class="internal-card">
                            <div class="internal-card-content">@evt.Description</div>
                            <div class="internal-card-footer">
                                <span class="internal-card-date">@(evt.EventDate?.ToString("dd/MM/yyyy") ?? evt.CreatedAt.ToString("dd/MM/yyyy"))</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<AlertDto> _alerts = new();
    private List<AlertDto> _events = new();
    private bool _alertsLoading = true;
    private bool _eventsLoading = true;
    private bool _showEntityDetailsButton = false;

    private int _previousYearId;
    private int _currentYearId;
    private int _nextYearId;
    
    private string _previousYearName = "שנה קודמת";
    private string _currentYearName = "שנה נוכחית";
    private string _nextYearName = "שנה הבאה";

    protected override async Task OnInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // Show entity details button for schools (entityTypeId !== 1 and !== 4)
        _showEntityDetailsButton =  session.EntityTypeId != "1" && session.EntityTypeId != "4";

        await LoadData();
    }

    private async Task LoadData()
    {
        await LoadSchoolYears();
        await LoadAlerts();
        await LoadEvents();
    }

    private async Task LoadSchoolYears()
    {
        try
        {
            var attributes = await ApiService.GetAsync<List<SystemAttributeDto>>("systemattributes");
            if (attributes != null)
            {
                var prev = attributes.FirstOrDefault(a => a.Name == "Previous Year");
                var curr = attributes.FirstOrDefault(a => a.Name == "Current Year");
                var next = attributes.FirstOrDefault(a => a.Name == "Next Year");

                if (prev != null)
                {
                    _previousYearId = prev.ForeignId ?? 0;
                    _previousYearName = prev.Value;
                }
                
                if (curr != null)
                {
                    _currentYearId = curr.ForeignId ?? 0;
                    _currentYearName = curr.Value;
                }
                
                if (next?.ForeignId != null)
                {
                    _nextYearId = next.ForeignId.Value;
                    _nextYearName = next.Value;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task LoadAlerts()
    {
        _alertsLoading = true;
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session != null)
            {
                _alerts = await ApiService.GetAsync<List<AlertDto>>($"alerts/entity/{session.EntityId}?isEvent=false") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _alertsLoading = false;
        }
    }

    private async Task LoadEvents()
    {
        _eventsLoading = true;
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session != null)
            {
                _events = await ApiService.GetAsync<List<AlertDto>>($"alerts/entity/{session.EntityId}?isEvent=true") ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    
    private void NavigateToEntityDetails()
    {
        Navigation.NavigateTo("/entitydetails");
    }
    private void PreviousYear() => Console.WriteLine("Previous year clicked");
    private void CurrentYear() => Console.WriteLine("Current year clicked");
    private void NextYear() => Console.WriteLine("Next year clicked");
}
