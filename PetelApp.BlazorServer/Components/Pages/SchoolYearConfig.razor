@page "/schoolyearconfig"
@layout MainLayout
@inherits SecurePageBase
@using PetelApp.BlazorServer.DTOs
@using PetelApp.BlazorServer.Components.Shared
@using PetelApp.BlazorServer.Components.Modals
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="main-container">
    <div class="context-buttons-section">
        <SecureButton ActionName="schoolyearconfig_refreshData" ScreenName="@PageName" FunctionName="RefreshData" 
                      OnClick="RefreshData" CssClass="context-btn">רענן נתונים</SecureButton>
        <div class="context-spacer"></div>
        <SecureButton ActionName="schoolyearconfig_navigateBack" ScreenName="@PageName" FunctionName="NavigateBack" 
                      OnClick="NavigateBack" CssClass="context-navigation-btn">חזור</SecureButton>
    </div>

    <div class="content-card">
        <h2>ניהול שנות לימוד</h2>

        @if (_loading)
        {
            <div class="loading-spinner">טוען...</div>
        }
        else
        {
            @if (_years.Count == 0)
            {
                <div class="info-message">אין שנות לימוד להצגה</div>
            }
            else
            {
                <div class="year-selection-section">
                    <label for="yearSelect" class="form-label">בחר שנת לימודים:</label>
                    <select id="yearSelect" @onchange="HandleYearChange" class="form-select">
                        <option value="">-- בחר שנה --</option>
                        @foreach (var year in _years)
                        {
                            <option value="@year.Id">@year.YearName</option>
                        }
                    </select>
                </div>

                @if (_selectedYearId > 0)
                {
                    <div class="content-card">
                        <div class="tabs-header">
                            <button class="tab-button @(_activeTab == "documents" ? "active" : "")" @onclick='() => SwitchTab("documents")'>מסמכים</button>
                            <button class="tab-button @(_activeTab == "pricing" ? "active" : "")" @onclick='() => SwitchTab("pricing")'>רכיבי תמחור</button>
                            <button class="tab-button @(_activeTab == "tracks" ? "active" : "")" @onclick='() => SwitchTab("tracks")'>מגמות</button>
                            <button class="tab-button @(_activeTab == "studyprograms" ? "active" : "")" @onclick='() => SwitchTab("studyprograms")'>תוכניות לימוד נוספות</button>
                            <button class="tab-button @(_activeTab == "schoolattributes" ? "active" : "")" @onclick='() => SwitchTab("schoolattributes")'>מאפייני בתי ספר</button>
                        </div>

                        <!-- Tab Content - Documents -->
                        <div class="tab-content" style="display: @(_activeTab == "documents" ? "block" : "none");">
                            <div class="detail-card @(_documentsExpanded ? "expanded" : "collapsed")">
                                <div class="detail-card-header" @onclick="() => _documentsExpanded = !_documentsExpanded">
                                    <div class="detail-card-title">סוגי מסמכים</div>
                                    <div class="card-header-actions">
                                        <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                            @(_documentsExpanded ? "×" : "+")
                                        </button>
                                    </div>
                                </div>
                                <div class="detail-card-content">
                                    @if (_documentsExpanded)
                                    {
                                        @if (_loadingTabData)
                                        {
                                            <div class="loading-spinner">טוען...</div>
                                        }
                                        else if (_documentTypes.Count == 0)
                                        {
                                            <div class="info-message">אין סוגי מסמכים לשנה זו</div>
                                        }
                                        else
                                        {
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>מזהה</th>
                                                            <th>שם</th>
                                                            <th>רמה</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var doc in _documentTypes)
                                                        {
                                                            <tr>
                                                                <td>@doc.Id</td>
                                                                <td>@doc.Name</td>
                                                                <td>@doc.Level</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Tab Content - Pricing -->
                        <div class="tab-content" style="display: @(_activeTab == "pricing" ? "block" : "none");">
                            <!-- Pricing Elements Card -->
                            <div class="detail-card @(_pricingExpanded ? "expanded" : "collapsed")" style="margin-bottom: 20px;">
                                <div class="detail-card-header" @onclick="() => _pricingExpanded = !_pricingExpanded">
                                    <div class="detail-card-title">רכיבי תמחור</div>
                                    <div class="card-header-actions">
                                        <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                            @(_pricingExpanded ? "×" : "+")
                                        </button>
                                    </div>
                                </div>
                                <div class="detail-card-content">
                                    @if (_pricingExpanded)
                                    {
                                        @if (_loadingTabData)
                                        {
                                            <div class="loading-spinner">טוען...</div>
                                        }
                                        else if (_pricingElements.Count == 0)
                                        {
                                            <div class="info-message">אין רכיבי תמחור לשנה זו</div>
                                        }
                                        else
                                        {
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>סדר</th>
                                                            <th>שם</th>
                                                            <th>כותרת</th>
                                                            <th>תיאור</th>
                                                            <th>רמת חישוב</th>
                                                            <th>תכונה לבדיקה</th>
                                                            <th>תאריך יצירה</th>
                                                            <th>פעולות</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var elem in _pricingElements.OrderBy(e => e.SortOrder))
                                                        {
                                                            <tr>
                                                                <td>@elem.SortOrder</td>
                                                                <td>@elem.Name</td>
                                                                <td>@elem.Title</td>
                                                                <td>@elem.Description</td>
                                                                <td>@elem.CalculationLevel</td>
                                                                <td>@elem.AttributeToCheck</td>
                                                                <td>@elem.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                                                <td>
                                                                    <button class="btn-icon" @onclick="() => SelectPricingElement(elem.Id, elem.Name)" title="הצג קטגוריות">
                                                                        <img src="images/view_icon.png" alt="צפייה" class="action-icon-natural">
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Pricing Categories Card (shown when element selected) -->
                            @if (_selectedPricingElementId.HasValue)
                            {
                                <div class="detail-card @(_pricingCategoriesExpanded ? "expanded" : "collapsed")">
                                    <div class="detail-card-header" @onclick="() => _pricingCategoriesExpanded = !_pricingCategoriesExpanded">
                                        <div class="detail-card-title">קטגוריות תמחור - @_selectedPricingElementName</div>
                                        <div class="card-header-actions">
                                            <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                                @(_pricingCategoriesExpanded ? "×" : "+")
                                            </button>
                                        </div>
                                    </div>
                                    <div class="detail-card-content">
                                        @if (_pricingCategoriesExpanded)
                                        {
                                            @if (_loadingCategories)
                                            {
                                                <div class="loading-spinner">טוען...</div>
                                            }
                                            else if (_pricingCategories.Count == 0)
                                            {
                                                <div class="info-message">אין קטגוריות תמחור לרכיב זה</div>
                                            }
                                            else
                                            {
                                                <div class="table-container">
                                                    <table class="data-table">
                                                        <thead>
                                                            <tr>
                                                                <th>קטגוריה</th>
                                                                <th>רמה נמוכה ביותר</th>
                                                                <th>מחיר</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var cat in _pricingCategories.OrderBy(c => c.Category))
                                                            {
                                                                <tr>
                                                                    <td>@cat.Category</td>
                                                                    <td>@(cat.IsLowestLevel ? "כן" : "לא")</td>
                                                                    <td>@(cat.Price?.ToString("N2") ?? "-") ₪</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Tab Content - Tracks -->
                        <div class="tab-content" style="display: @(_activeTab == "tracks" ? "block" : "none");">
                            <div class="detail-card @(_tracksExpanded ? "expanded" : "collapsed")">
                                <div class="detail-card-header" @onclick="() => _tracksExpanded = !_tracksExpanded">
                                    <div class="detail-card-title">מגמות</div>
                                    <div class="card-header-actions">
                                        <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                            @(_tracksExpanded ? "×" : "+")
                                        </button>
                                    </div>
                                </div>
                                <div class="detail-card-content">
                                    @if (_tracksExpanded)
                                    {
                                        @if (_loadingTabData)
                                        {
                                            <div class="loading-spinner">טוען...</div>
                                        }
                                        else if (_tracks.Count == 0)
                                        {
                                            <div class="info-message">אין מגמות להצגה</div>
                                        }
                                        else
                                        {
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>שם מגמה</th>
                                                            <th>זמין לכיתות</th>
                                                            <th>תאריך יצירה</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var track in _tracks)
                                                        {
                                                            <tr>
                                                                <td>@track.TrackName</td>
                                                                <td>@track.AvailableForGrades</td>
                                                                <td>@track.CreatedAt?.ToString("dd/MM/yyyy")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Tab Content - Study Programs -->
                        <div class="tab-content" style="display: @(_activeTab == "studyprograms" ? "block" : "none");">
                            <div class="detail-card @(_studyProgramsExpanded ? "expanded" : "collapsed")">
                                <div class="detail-card-header" @onclick="() => _studyProgramsExpanded = !_studyProgramsExpanded">
                                    <div class="detail-card-title">תוכניות לימוד נוספות</div>
                                    <div class="card-header-actions">
                                        <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                            @(_studyProgramsExpanded ? "×" : "+")
                                        </button>
                                    </div>
                                </div>
                                <div class="detail-card-content">
                                    @if (_studyProgramsExpanded)
                                    {
                                        @if (_loadingTabData)
                                        {
                                            <div class="loading-spinner">טוען...</div>
                                        }
                                        else if (_studyPrograms.Count == 0)
                                        {
                                            <div class="info-message">אין תוכניות לימוד להצגה</div>
                                        }
                                        else
                                        {
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>מזהה</th>
                                                            <th>מספר תלמידים</th>
                                                            <th>מחיר מקסימלי</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var program in _studyPrograms)
                                                        {
                                                            <tr>
                                                                <td>@program.Id</td>
                                                                <td>@program.Students</td>
                                                                <td>@(program.Price.HasValue ? $"₪{program.Price.Value:F2}" : "-")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Tab Content - School Attributes -->
                        <div class="tab-content" style="display: @(_activeTab == "schoolattributes" ? "block" : "none");">
                            <div class="detail-card @(_schoolAttributesExpanded ? "expanded" : "collapsed")">
                                <div class="detail-card-header" @onclick="() => _schoolAttributesExpanded = !_schoolAttributesExpanded">
                                    <div class="detail-card-title">סוגי מאפיינים לשנת לימודים</div>
                                    <div class="card-header-actions">
                                        <button class="collapse-toggle" aria-label="הרחב/כווץ">
                                            @(_schoolAttributesExpanded ? "×" : "+")
                                        </button>
                                    </div>
                                </div>
                                <div class="detail-card-content">
                                    @if (_schoolAttributesExpanded)
                                    {
                                        @if (_loadingTabData)
                                        {
                                            <div class="loading-spinner">טוען...</div>
                                        }
                                        else if (_schoolAttributes.Count == 0)
                                        {
                                            <div class="info-message">אין מאפיינים להצגה</div>
                                        }
                                        else
                                        {
                                            <div class="table-container">
                                                <table class="data-table">
                                                    <thead>
                                                        <tr>
                                                            <th>שם המאפיין</th>
                                                            <th>סוג</th>
                                                            <th>סדר</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var attr in _schoolAttributes.OrderBy(a => a.SortOrder))
                                                        {
                                                            <tr>
                                                                <td>@attr.HebrewName</td>
                                                                <td>@attr.AttributeValueType</td>
                                                                <td>@attr.SortOrder</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="@(_messageType == "success" ? "success-alert" : "error-alert")">
                @_message
            </div>
        }
    </div>
</div>

@code {
    private List<SchoolYearDto> _years = new();
    private List<SchoolAttributeDto> _schoolAttributes = new();
    private List<DocumentTypeDto> _documentTypes = new();
    private List<PricingElementDto> _pricingElements = new();
    private List<PricingCategoryDto> _pricingCategories = new();
    private List<TrackDto> _tracks = new();
    private List<StudyProgramDto> _studyPrograms = new();
    
    private int? _selectedPricingElementId;
    private string _selectedPricingElementName = string.Empty;
    private bool _loadingCategories = false;
    
    private int _selectedYearId = 0;
    private SchoolYearDto? _selectedYear;
    private string _activeTab = "documents";
    
    private bool _loading = true;
    private bool _loadingTabData = false;
    private string? _message;
    private string _messageType = "success";

    // Collapsible card states
    private bool _documentsExpanded = true;
    private bool _pricingExpanded = true;
    private bool _pricingCategoriesExpanded = true;
    private bool _tracksExpanded = true;
    private bool _studyProgramsExpanded = true;
    private bool _schoolAttributesExpanded = true;

    // REQUIRED by SecurePageBase
    protected override string PageName => "schoolyearconfig";

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadYears();
    }

    private async Task LoadYears()
    {
        _loading = true;
        try
        {
            _years = await ApiService.GetAsync<List<SchoolYearDto>>("schoolyearconfig/hebrew-years") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school years: {ex.Message}");
            _message = "שגיאה בטעינת נתונים";
            _messageType = "error";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleYearChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int yearId))
        {
            _selectedYearId = yearId;
            _selectedYear = _years.FirstOrDefault(y => y.Id == yearId);
            _activeTab = "documents";
            await LoadTabData(_activeTab);
        }
        else
        {
            _selectedYearId = 0;
            _selectedYear = null;
            ClearAllData();
        }
        StateHasChanged();
    }

    private void ClearAllData()
    {
        _schoolAttributes.Clear();
        _documentTypes.Clear();
        _pricingElements.Clear();
        _tracks.Clear();
        _studyPrograms.Clear();
    }

    private async Task SwitchTab(string tabName)
    {
        _activeTab = tabName;
        await LoadTabData(tabName);
        StateHasChanged();
    }

    private async Task LoadTabData(string tabName)
    {
        if (_selectedYearId <= 0) return;

        _loadingTabData = true;
        try
        {
            switch (tabName)
            {
                case "documents":
                    await LoadDocumentTypes();
                    break;
                case "pricing":
                    await LoadPricingElements();
                    break;
                case "tracks":
                    await LoadTracks();
                    break;
                case "studyprograms":
                    await LoadStudyPrograms();
                    break;
                case "schoolattributes":
                    await LoadSchoolAttributes();
                    break;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tab data for {tabName}: {ex.Message}");
        }
        finally
        {
            _loadingTabData = false;
        }
    }

    private async Task LoadDocumentTypes()
    {
        try
        {
            var endpoint = $"documents/document-types/{_selectedYearId}";
            _documentTypes = await ApiService.GetAsync<List<DocumentTypeDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading document types: {ex.Message}");
            _documentTypes = new();
        }
    }

    private async Task LoadPricingElements()
    {
        try
        {
            var endpoint = $"schoolyearconfig/pricing-elements/{_selectedYearId}";
            _pricingElements = await ApiService.GetAsync<List<PricingElementDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pricing elements: {ex.Message}");
            _pricingElements = new();
        }
    }

    private async Task SelectPricingElement(int elementId, string elementName)
    {
        Console.WriteLine($"Selected pricing element: {elementId} - {elementName}");
        
        _selectedPricingElementId = elementId;
        _selectedPricingElementName = elementName;
        _pricingCategoriesExpanded = true;
        
        await LoadPricingCategories(elementId);
        StateHasChanged();
    }

    private async Task LoadPricingCategories(int elementId)
    {
        _loadingCategories = true;
        try
        {
            var endpoint = $"schoolyearconfig/pricing-categories/{elementId}";
            _pricingCategories = await ApiService.GetAsync<List<PricingCategoryDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading pricing categories: {ex.Message}");
            _pricingCategories = new();
        }
        finally
        {
            _loadingCategories = false;
        }
    }

    private async Task LoadTracks()
    {
        try
        {
            var endpoint = $"schoolyearconfig/tracks/{_selectedYearId}";
            _tracks = await ApiService.GetAsync<List<TrackDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracks: {ex.Message}");
            _tracks = new();
        }
    }

    private async Task LoadStudyPrograms()
    {
        try
        {
            var endpoint = $"schoolyearconfig/study-programs?yearId={_selectedYearId}";
            _studyPrograms = await ApiService.GetAsync<List<StudyProgramDto>>(endpoint) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading study programs: {ex.Message}");
            _studyPrograms = new();
        }
    }

    private async Task LoadSchoolAttributes()
    {
        try
        {
            var endpoint = $"schoolattributes/attribute-types/{_selectedYearId}";
            var response = await ApiService.GetAsync<SchoolAttributeResponse>(endpoint);
            
            if (response?.Success == true && response.Data != null)
            {
                _schoolAttributes = response.Data;
            }
            else
            {
                _schoolAttributes = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading school attributes: {ex.Message}");
            _schoolAttributes = new();
        }
    }

    private async Task RefreshData()
    {
        await LoadYears();
        if (_selectedYearId > 0)
        {
            await LoadTabData(_activeTab);
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/maindashboard");
    }

    private class SchoolYearDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("hebrewYear")]
        public string YearName { get; set; } = string.Empty;
    }

    private class DocumentTypeDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;
        
        [System.Text.Json.Serialization.JsonPropertyName("level")]
        public string Level { get; set; } = string.Empty;
        
        [System.Text.Json.Serialization.JsonPropertyName("yearId")]
        public int YearId { get; set; }
    }

    private class PricingElementDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;
        
        [System.Text.Json.Serialization.JsonPropertyName("title")]
        public string? Title { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("description")]
        public string? Description { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("sortOrder")]
        public int SortOrder { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("calculationLevel")]
        public string? CalculationLevel { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("attributeToCheck")]
        public string? AttributeToCheck { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("createdAt")]
        public DateTime? CreatedAt { get; set; }
    }

    private class PricingCategoryDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("category")]
        public int Category { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("isLowestLevel")]
        public bool IsLowestLevel { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("price")]
        public decimal? Price { get; set; }
    }

    private class TrackDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("trackName")]
        public string TrackName { get; set; } = string.Empty;
        
        [System.Text.Json.Serialization.JsonPropertyName("availableForGrades")]
        public string? AvailableForGrades { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("createdAt")]
        public DateTime? CreatedAt { get; set; }
    }

    private class StudyProgramDto
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public int Id { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("students")]
        public int Students { get; set; }
        
        [System.Text.Json.Serialization.JsonPropertyName("price")]
        public decimal? Price { get; set; }
    }

