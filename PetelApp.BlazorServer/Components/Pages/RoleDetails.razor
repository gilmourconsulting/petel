    private void FilterActions()
    {
        if (_roleData?.Actions == null) return;

        var searchTerm = _searchTerm?.ToLower() ?? string.Empty;
        
        if (string.IsNullOrEmpty(searchTerm))
        {
            _filteredActions = _roleData.Actions;
        }
        else
        {
            _filteredActions = _roleData.Actions
                .Where(a => (a.DisplayName?.ToLower().Contains(searchTerm) ?? false) ||
                           (a.Reference?.ToLower().Contains(searchTerm) ?? false) ||
                           (a.ActionTypeName?.ToLower().Contains(searchTerm) ?? false))
                .ToList();
        }
    }

