@page "/entitydetails"
@layout MainLayout
@inherits SecurePageBase
@using PetelApp.BlazorServer.Components.Shared
@inject ApiService ApiService
@inject SessionStateService SessionState
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime



<div class="main-container">
    <!-- Context buttons -->
    <div class="context-buttons-section">
        <SecureButton ActionName="entitydetails_backToDashboard" ScreenName="@PageName" FunctionName="BackToDashboard" 
                      OnClick="BackToDashboard" CssClass="context-navigation-btn">חזרה ללוח בקרה</SecureButton>
    </div>

    <!-- Main content -->
    <div class="students-content">
        <!-- Entity Details Title Section -->
        <div class="school-title-section">
            <h1 class="page-title">@_pageTitle</h1>
        </div>
        
        <div class="content-card">
            <!-- Entity Details Card -->
            <div class="detail-card expanded">
                <div class="detail-card-header">
                    <h2 class="detail-card-title">
                        פרטי ישות
                        @if (_hasUnsavedChanges)
                        {
                            <span class="unsaved-indicator"
                                style="color: #dc3545; font-size: 0.9em; margin-right: 10px; font-weight: normal;">(שינויים
                                לא נשמרו)</span>
                        }
                    </h2>
                    <div class="card-header-actions">
                        <button class="btn-icon" @onclick="ToggleEditMode">
                            <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                        </button>
                    </div>
                </div>
                <div class="detail-card-content">
                    @if (_isLoading)
                    {
                        <div class="loading-spinner">טוען...</div>
                    }
                    else if (_entityDetails != null)
                    {
                        <div class="detail-fields-grid">
                            <!-- Basic Information Section -->
                            <div class="detail-section">
                                <h4 class="detail-section-title">פרטים בסיסיים</h4>
                                <div>
                                    <p class="detail-field">
                                        <span class="detail-field-label">שם:</span>
                                        @if (_isEditMode)
                                        {
                                            <input type="text" class="form-input-text" @bind="_editModel.Name" @oninput="MarkAsChanged" />
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.Name ?? "לא זמין")</span>
                                        }
                                    </p>

                                    <p class="detail-field">
                                        <span class="detail-field-label">בעלות:</span>
                                        @if (_isEditMode)
                                        {
                                            <select class="form-input-select" @bind="_editModel.OwnerId" @bind:after="MarkAsChanged"
                                                disabled="@_isOwnerDropdownLocked"
                                                style="@(_isOwnerDropdownLocked ? "background-color: #e9ecef; cursor: not-allowed;" : "")">
                                                <option value="">בחר בעלות...</option>
                                                @foreach (var owner in _potentialOwners)
                                                {
                                                    <option value="@owner.Id">@owner.Name</option>
                                                }
                                            </select>
                                            @if (_isOwnerDropdownLocked)
                                            {
                                                <span style="color: #6c757d; font-size: 0.85em; margin-right: 5px;">(נעול - מוגבל
                                                    לגוף הנוכחי)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.OwnerName ?? "לא זמין")</span>
                                        }
                                    </p>

                                    <p class="detail-field">
                                        <span class="detail-field-label">סוג ישות:</span>
                                        @if (_isEditMode)
                                        {
                                            <select class="form-input-select" @bind="_editModel.EntityTypeId" @bind:after="MarkAsChanged">
                                                <option value="0">בחר סוג ישות...</option>
                                                @foreach (var type in _entityTypes.Where(t => new[] { 3, 5, 6 }.Contains(t.Id)))
                                                {
                                                    <option value="@type.Id">@type.Name</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.EntityTypeDescription ?? "לא זמין")</span>
                                        }
                                    </p>

                                    <p class="detail-field">
                                        <span class="detail-field-label">מספר עוסק / ח.פ:</span>
                                        @if (_isEditMode)
                                        {
                                            <input type="text" class="form-input-number" @bind="_editModel.TaxNumber" @oninput="MarkAsChanged"
                                                placeholder="הזן מספר עוסק" />
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.TaxNumber ?? "לא זמין")</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <!-- Address and Contact Section -->
                            <div class="detail-section">
                                <h4 class="detail-section-title">כתובת ויצירת קשר</h4>
                                <div>
                                    <p class="detail-field">
                                        <span class="detail-field-label">כתובת:</span>
                                        <span class="detail-field-value">@(_entityDetails.Address ?? "לא זמין")</span>
                                        @if (_isEditMode)
                                        {
                                            <button class="btn-icon" @onclick="ShowAddressModal" title="עריכת כתובת">
                                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                                            </button>
                                        }
                                    </p>

                                    <p class="detail-field">
                                        <span class="detail-field-label">טלפון:</span>
                                        @if (_isEditMode)
                                        {
                                            <input type="tel" class="form-input-tel" @bind="_editModel.Phone" @oninput="MarkAsChanged"
                                                placeholder="02-1234567" />
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.Phone ?? "לא זמין")</span>
                                        }
                                    </p>

                                    <p class="detail-field">
                                        <span class="detail-field-label">דוא"ל:</span>
                                        @if (_isEditMode)
                                        {
                                            <input type="email" class="form-input-email" @bind="_editModel.Email" @oninput="MarkAsChanged"
                                                placeholder="entity@example.com" />
                                        }
                                        else
                                        {
                                            <span class="detail-field-value">@(_entityDetails.Email ?? "לא זמין")</span>
                                        }
                                    </p>
                                </div>
                            </div>

                            <!-- Contact Persons Section -->
                            <div class="detail-section">
                                <h4 class="detail-section-title">אנשי קשר</h4>
                                <div>
                                    <p class="detail-field">
                                        <span class="detail-field-label">איש קשר:</span>
                                        <span class="detail-field-value">@(_entityDetails.ContactPersonName ?? "לא זמין")</span>
                                        @if (_isEditMode)
                                        {
                                            <button class="btn-icon" @onclick="ShowContactPersonModal" title="עריכת איש קשר"
                                                style="margin-right: 10px;">
                                                <img src="/images/edit_icon.png" alt="עריכה" class="action-icon-natural">
                                            </button>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private EntityDetailsDto? _entityDetails;
    private EntityUpdateDto _editModel = new();
    private List<EntityTypeDto> _entityTypes = new();
    private List<OwnerOptionDto> _potentialOwners = new();
    private bool _isOwnerDropdownLocked = false;
    private bool _isEditMode = false;
    private bool _isLoading = true;
    private bool _hasUnsavedChanges = false;
    private string _pageTitle = "פרטי ישות";
    private int _currentUserEntityTypeId;

    // REQUIRED by SecurePageBase
    protected override string PageName => "entitydetails";

    protected override async Task OnPageInitializedAsync()
    {
        var session = await SessionState.GetSessionAsync();
        if (session == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (int.TryParse(session.EntityTypeId, out int entityTypeId))
        {
            _currentUserEntityTypeId = entityTypeId;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            var session = await SessionState.GetSessionAsync();
            if (session == null) return;

            // Load entity types and owners first
            await Task.WhenAll(LoadEntityTypes(), LoadPotentialOwners());

            // Load entity details
            if (int.TryParse(session.EntityId, out int entityId))
            {
                _entityDetails = await ApiService.GetAsync<EntityDetailsDto>($"entitydetails/{entityId}");

                if (_entityDetails != null)
                {
                    UpdatePageTitle();
                    InitializeEditModel();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entity details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בטעינת פרטי הישות");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEntityTypes()
    {
        try
        {
            _entityTypes = await ApiService.GetAsync<List<EntityTypeDto>>("entities/entity-types") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading entity types: {ex.Message}");
        }
    }

    private async Task LoadPotentialOwners()
    {
        try
        {
            var response = await ApiService.GetAsync<OwnerOptionsResponseDto>("entities/owner-options");
            if (response != null && response.Success)
            {
                _potentialOwners = response.OwnerOptions;
                _isOwnerDropdownLocked = response.IsLocked;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading owners: {ex.Message}");
        }
    }

    private void UpdatePageTitle()
    {
        if (_entityDetails != null)
        {
            _pageTitle = $"פרטי - {_entityDetails.Name} - {_entityDetails.EntityTypeDescription}";
        }
    }

    private void InitializeEditModel()
    {
        if (_entityDetails == null) return;

        _editModel = new EntityUpdateDto
        {
            Name = _entityDetails.Name,
            EntityTypeId = _entityDetails.EntityTypeId,
            OwnerId = _entityDetails.OwnerId,
            Phone = _entityDetails.Phone ?? string.Empty,
            Email = _entityDetails.Email ?? string.Empty,
            TaxNumber = _entityDetails.TaxNumber ?? string.Empty,
            ContactPersonId = _entityDetails.ContactPersonId,
            IsActive = _entityDetails.IsActive,
            Street = _entityDetails.Street ?? string.Empty,
            HouseNumber = _entityDetails.HouseNumber ?? string.Empty,
            City = _entityDetails.City ?? string.Empty,
            PostCode = _entityDetails.PostCode ?? string.Empty
        };
    }

    private async Task ToggleEditMode()
    {
        if (!_isEditMode)
        {
            // Entering edit mode
            _isEditMode = true;
            _hasUnsavedChanges = false;
            InitializeEditModel();
            Console.WriteLine("✏️ Entity details edit mode: ON");
        }
        else
        {
            // Save changes
            await SaveChanges();
        }
    }

    private async Task CancelEdit()
    {
        if (_hasUnsavedChanges)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "יש לך שינויים שלא נשמרו. האם אתה בטוח שברצונך לבטל?");
            if (!confirmed) return;
        }

        _isEditMode = false;
        _hasUnsavedChanges = false;
        InitializeEditModel();
        Console.WriteLine("❌ Entity details edit mode cancelled");
    }

    private void MarkAsChanged()
    {
        _hasUnsavedChanges = true;
        Console.WriteLine("📝 Entity details field changed");
    }

    private async Task SaveChanges()
    {
        if (!ValidateForm()) return;

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "האם אתה בטוח שברצונך לשמור את השינויים בפרטי הישות?");
        if (!confirmed) return;

        try
        {
            if (_entityDetails == null) return;

            var response = await ApiService.PutAsync<EntityUpdateDto, object>($"entitydetails/{_entityDetails.Id}", _editModel);

            if (response != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "פרטי הישות עודכנו בהצלחה");
                _hasUnsavedChanges = false;
                _isEditMode = false;

                // Reload data to reflect changes
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving entity details: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "שגיאה בשמירת פרטי הישות");
        }
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_editModel.Name))
        {
            JSRuntime.InvokeVoidAsync("alert", "נא להזין שם ישות");
            return false;
        }

        if (_editModel.EntityTypeId == 0)
        {
            JSRuntime.InvokeVoidAsync("alert", "נא לבחור סוג ישות");
            return false;
        }

        if (!string.IsNullOrWhiteSpace(_editModel.Email) &&
        !System.Text.RegularExpressions.Regex.IsMatch(_editModel.Email, @"^[^\s@]+@[^\s@]+\.[^\s@]+$"))
        {
            JSRuntime.InvokeVoidAsync("alert", "כתובת דוא\"ל לא תקינה");
            return false;
        }

        return true;
    }

    private void BackToDashboard()
    {
        Navigation.NavigateTo("/maindashboard");
    }

    private async Task ShowAddressModal()
    {
        await JSRuntime.InvokeVoidAsync("alert", "עריכת כתובת - בפיתוח");
    }

    private async Task ShowContactPersonModal()
    {
        await JSRuntime.InvokeVoidAsync("alert", "עריכת איש קשר - בפיתוח");
    }
}