[Unit]
Description=PetelATH API
After=network.target

[Service]
WorkingDirectory=/opt/petel/ath-api
ExecStart=/usr/bin/dotnet PetelATH.Api.dll
Restart=always
RestartSec=5
EnvironmentFile=-/etc/petel/ath-api.env
Environment=ASPNETCORE_URLS=http://127.0.0.1:5082
Environment=ASPNETCORE_ENVIRONMENT=Staging
User=ec2-user
KillSignal=SIGINT
SyslogIdentifier=ath-api

[Install]
WantedBy=multi-user.target
